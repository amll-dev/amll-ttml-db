<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Still the Same"/><amll:meta key="artists" value="塞壬唱片-MSR"/><amll:meta key="artists" value="Adam Gubman"/><amll:meta key="artists" value="Chad Reisser"/><amll:meta key="album" value="Still the Same"/><amll:meta key="ncmMusicId" value="2699921361"/><amll:meta key="ttmlAuthorGithub" value="110718921"/><amll:meta key="ttmlAuthorGithubLogin" value="Moon-Tide-10"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Adam Gubman</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:31.284"><div begin="50.298" end="3:31.284"><p begin="50.298" end="53.300" itunes:key="L1" ttm:agent="v1"><span begin="50.298" end="50.555">When</span> <span begin="50.555" end="50.802">you</span> <span begin="50.802" end="51.074">hear</span> <span begin="51.074" end="51.356">the</span> <span begin="51.356" end="52.429">clock</span> <span begin="52.429" end="53.300">tick</span><span ttm:role="x-translation" xml:lang="zh-CN">倾听秒针嘀嗒声响</span></p><p begin="53.400" end="55.549" itunes:key="L2" ttm:agent="v1"><span begin="53.400" end="53.782">Time</span> <span begin="53.782" end="54.316">moving</span> <span begin="54.316" end="55.549">backwards</span><span ttm:role="x-translation" xml:lang="zh-CN">时光倒流回淌</span></p><p begin="55.549" end="58.769" itunes:key="L3" ttm:agent="v1"><span begin="55.549" end="56.769">Cherished</span> <span begin="56.769" end="57.564">memories</span> <span begin="57.564" end="57.844">we</span> <span begin="57.844" end="58.769">hold</span><span ttm:role="x-translation" xml:lang="zh-CN">记忆珍存掌上</span></p><p begin="58.832" end="1:01.871" itunes:key="L4" ttm:agent="v1"><span begin="58.832" end="59.734">Cradling</span> <span begin="59.734" end="59.975">the</span> <span begin="59.975" end="1:00.850">past</span> <span begin="1:01.000" end="1:01.871">last</span><span ttm:role="x-translation" xml:lang="zh-CN">轻拥过往</span></p><p begin="1:02.078" end="1:03.822" itunes:key="L5" ttm:agent="v1"><span begin="1:02.078" end="1:02.398">Time</span> <span begin="1:02.398" end="1:02.726">we&apos;re</span> <span begin="1:02.726" end="1:03.822">together</span><span ttm:role="x-translation" xml:lang="zh-CN">末次我们共度</span></p><p begin="1:04.252" end="1:07.291" itunes:key="L6" ttm:agent="v1"><span begin="1:04.252" end="1:04.885">Moments</span> <span begin="1:04.885" end="1:05.668">between</span> <span begin="1:05.668" end="1:06.131">move</span> <span begin="1:06.131" end="1:06.277">too</span> <span begin="1:06.277" end="1:07.291">fast</span><span ttm:role="x-translation" xml:lang="zh-CN">时光消逝匆忙</span></p><p begin="1:07.291" end="1:10.538" itunes:key="L7" ttm:agent="v1"><span begin="1:07.291" end="1:08.103">Smiling</span> <span begin="1:08.103" end="1:08.430">through</span> <span begin="1:08.430" end="1:08.683">the</span> <span begin="1:08.683" end="1:09.649">years</span> <span begin="1:09.649" end="1:10.538">tears</span><span ttm:role="x-translation" xml:lang="zh-CN">笑纹藏年岁，与泪同酿</span></p><p begin="1:10.658" end="1:12.695" itunes:key="L8" ttm:agent="v1"><span begin="1:10.658" end="1:11.161">This</span> <span begin="1:11.161" end="1:11.352">is</span> <span begin="1:11.352" end="1:11.613">my</span> <span begin="1:11.613" end="1:12.029">brave</span> <span begin="1:12.029" end="1:12.695">face</span><span ttm:role="x-translation" xml:lang="zh-CN">作我的武装</span></p><p begin="1:12.920" end="1:15.940" itunes:key="L9" ttm:agent="v1"><span begin="1:12.920" end="1:14.050">Lonliness</span> <span begin="1:14.059" end="1:14.263">don&apos;t</span> <span begin="1:14.263" end="1:14.502">you</span> <span begin="1:14.502" end="1:15.093">come</span> <span begin="1:15.093" end="1:15.940">round!</span><span ttm:role="x-translation" xml:lang="zh-CN">寂寞先生，请绕道而行！</span></p><p begin="1:16.155" end="1:19.110" itunes:key="L10" ttm:agent="v1"><span begin="1:16.155" end="1:16.486">I</span> <span begin="1:16.486" end="1:16.770">won&apos;t</span> <span begin="1:16.770" end="1:17.293">push</span> <span begin="1:17.293" end="1:18.000">away</span> <span begin="1:18.382" end="1:19.110">stay</span><span ttm:role="x-translation" xml:lang="zh-CN">心门不再闭掩</span></p><p begin="1:19.455" end="1:21.318" itunes:key="L11" ttm:agent="v1"><span begin="1:19.455" end="1:20.000">Letters</span> <span begin="1:20.000" end="1:20.208">to</span> <span begin="1:20.208" end="1:21.318">tombstones</span><span ttm:role="x-translation" xml:lang="zh-CN">信笺寄往彼岸</span></p><p begin="1:21.318" end="1:24.345" itunes:key="L12" ttm:agent="v1"><span begin="1:21.318" end="1:21.597">It</span> <span begin="1:21.597" end="1:22.170">doesn&apos;t</span> <span begin="1:22.170" end="1:22.438">have</span> <span begin="1:22.438" end="1:22.702">to</span> <span begin="1:22.702" end="1:23.246">be</span> <span begin="1:23.246" end="1:23.519">this</span> <span begin="1:23.519" end="1:24.333">way!</span><span ttm:role="x-translation" xml:lang="zh-CN">墨迹未干前故事尚可重演！</span></p><p begin="1:26.725" end="1:28.889" itunes:key="L13" ttm:agent="v1"><span begin="1:26.726" end="1:27.037">I&apos;ve</span> <span begin="1:27.037" end="1:27.288">made</span> <span begin="1:27.288" end="1:27.563">up</span> <span begin="1:27.563" end="1:27.828">my</span> <span begin="1:27.828" end="1:28.889">mind</span><span ttm:role="x-translation" xml:lang="zh-CN">我抉择已定</span></p><p begin="1:28.929" end="1:32.000" itunes:key="L14" ttm:agent="v1"><span begin="1:28.929" end="1:29.191">I&apos;m</span> <span begin="1:29.191" end="1:29.788">choo</span><span begin="1:29.788" end="1:30.185">sing</span> <span begin="1:30.185" end="1:30.649">happi</span><span begin="1:30.649" end="1:31.553">ness!</span><span ttm:role="x-translation" xml:lang="zh-CN">将拥抱欢欣</span></p><p begin="1:32.153" end="1:35.134" itunes:key="L15" ttm:agent="v1"><span begin="1:32.153" end="1:32.388">And</span> <span begin="1:32.388" end="1:32.466">I</span> <span begin="1:32.466" end="1:32.858">guess</span> <span begin="1:32.858" end="1:33.015">it</span> <span begin="1:33.015" end="1:33.461">doesnt</span> <span begin="1:33.461" end="1:33.785">mean</span> <span begin="1:33.785" end="1:34.156">things</span> <span begin="1:34.156" end="1:34.450">have</span> <span begin="1:34.450" end="1:35.134">changed</span><span ttm:role="x-translation" xml:lang="zh-CN">而我明白 蜕变不曾动摇本真</span></p><p begin="1:35.134" end="1:36.483" itunes:key="L16" ttm:agent="v1"><span begin="1:35.134" end="1:35.434">When</span> <span begin="1:35.434" end="1:35.679">you&apos;re</span> <span begin="1:35.679" end="1:36.483">changing</span><span ttm:role="x-translation" xml:lang="zh-CN">即便物是人非</span></p><p begin="1:36.483" end="1:38.380" itunes:key="L17" ttm:agent="v1"><span begin="1:36.483" end="1:36.628">The</span> <span begin="1:36.628" end="1:37.151">world</span> <span begin="1:37.282" end="1:38.380">rearranging</span><span ttm:role="x-translation" xml:lang="zh-CN">天地斗转星移</span></p><p begin="1:38.590" end="1:40.551" itunes:key="L18" ttm:agent="v1"><span begin="1:38.590" end="1:39.065">I</span> <span begin="1:39.065" end="1:39.472">still</span> <span begin="1:39.472" end="1:39.743">feel</span> <span begin="1:39.743" end="1:39.914">the</span> <span begin="1:39.914" end="1:40.551">same</span><span ttm:role="x-translation" xml:lang="zh-CN">我依然如旧</span></p><p begin="1:40.729" end="1:50.500" itunes:key="L19" ttm:agent="v1"><span begin="1:40.729" end="1:40.950">And</span> <span begin="1:40.950" end="1:41.075">I</span> <span begin="1:41.075" end="1:41.452">guess</span> <span begin="1:41.452" end="1:41.613">it</span> <span begin="1:41.613" end="1:42.096">doesnt</span> <span begin="1:42.096" end="1:42.418">mean</span> <span begin="1:42.418" end="1:42.791">things</span> <span begin="1:42.791" end="1:43.088">have</span> <span begin="1:43.088" end="1:43.835">changed</span><span ttm:role="x-translation" xml:lang="zh-CN">而我明白 浮沉始终未易初心</span></p><p begin="1:43.832" end="1:45.112" itunes:key="L20" ttm:agent="v1"><span begin="1:43.832" end="1:44.085">When</span> <span begin="1:44.085" end="1:44.347">you&apos;re</span> <span begin="1:44.347" end="1:45.112">breaking</span><span ttm:role="x-translation" xml:lang="zh-CN">纵使支离破碎</span></p><p begin="1:45.112" end="1:47.289" itunes:key="L21" ttm:agent="v1"><span begin="1:45.112" end="1:45.415">Giv</span><span begin="1:45.415" end="1:45.922">e</span> <span begin="1:45.922" end="1:46.357">more</span> <span begin="1:46.357" end="1:46.497">than</span> <span begin="1:46.497" end="1:47.289">taking</span><span ttm:role="x-translation" xml:lang="zh-CN">施予胜过索回</span></p><p begin="1:47.289" end="1:49.726" itunes:key="L22" ttm:agent="v1"><span begin="1:47.289" end="1:48.793">Happiness</span> <span begin="1:48.793" end="1:49.726">explained</span><span ttm:role="x-translation" xml:lang="zh-CN">幸福终得解</span></p><p begin="1:50.706" end="1:52.850" itunes:key="L23" ttm:agent="v1"><span begin="1:50.706" end="1:50.814">It</span> <span begin="1:50.814" end="1:51.048">doesn&apos;t</span> <span begin="1:51.048" end="1:51.290">mean</span> <span begin="1:51.290" end="1:51.575">things</span> <span begin="1:51.575" end="1:51.842">have</span> <span begin="1:51.842" end="1:52.304">chan</span><span begin="1:52.304" end="1:52.651">ged</span><span ttm:role="x-translation" xml:lang="zh-CN">韶光仍流连</span></p><p begin="1:53.063" end="1:54.820" itunes:key="L24" ttm:agent="v1"><span begin="1:53.063" end="1:53.180">It</span> <span begin="1:53.180" end="1:53.375">doesn&apos;t</span> <span begin="1:53.375" end="1:53.534">mean</span> <span begin="1:53.534" end="1:53.745">things</span> <span begin="1:53.745" end="1:54.029">have</span> <span begin="1:54.029" end="1:54.481">chan</span><span begin="1:54.481" end="1:54.820">ged</span><span ttm:role="x-translation" xml:lang="zh-CN">山川犹旧容</span></p><p begin="1:54.989" end="1:58.250" itunes:key="L25" ttm:agent="v1"><span begin="1:54.989" end="1:55.132">It</span> <span begin="1:55.132" end="1:55.410">doesn&apos;t</span> <span begin="1:55.410" end="1:55.671">mean</span> <span begin="1:55.671" end="1:55.935">things</span> <span begin="1:55.935" end="1:56.205">have</span> <span begin="1:56.205" end="1:56.759">chan</span><span begin="1:56.759" end="1:57.174">ged</span><span ttm:role="x-translation" xml:lang="zh-CN">世事未更迭</span></p><p begin="1:58.154" end="2:01.078" itunes:key="L26" ttm:agent="v1"><span begin="1:58.154" end="1:58.392">And</span> <span begin="1:58.392" end="1:58.481">I</span> <span begin="1:58.481" end="1:58.807">guess</span> <span begin="1:58.807" end="1:58.940">it</span> <span begin="1:58.940" end="1:59.445">doesnt</span> <span begin="1:59.445" end="1:59.717">mean</span> <span begin="1:59.717" end="1:59.972">things</span> <span begin="1:59.972" end="2:00.194">have</span> <span begin="2:00.194" end="2:01.000">changed</span><span ttm:role="x-translation" xml:lang="zh-CN">我想这不意味着沧海桑田</span></p><p begin="2:01.078" end="2:02.430" itunes:key="L27" ttm:agent="v1"><span begin="2:01.078" end="2:01.378">When</span> <span begin="2:01.378" end="2:01.634">you&apos;re</span> <span begin="2:01.634" end="2:02.430">changing</span><span ttm:role="x-translation" xml:lang="zh-CN">即使物是人非</span></p><p begin="2:02.430" end="2:04.434" itunes:key="L28" ttm:agent="v1"><span begin="2:02.430" end="2:02.824">Worl</span><span begin="2:02.824" end="2:03.241">d</span> <span begin="2:03.241" end="2:04.434">rearranging</span><span ttm:role="x-translation" xml:lang="zh-CN">天地斗转星移</span></p><p begin="2:04.603" end="2:08.000" itunes:key="L29" ttm:agent="v1"><span begin="2:04.603" end="2:05.007">I</span> <span begin="2:05.007" end="2:05.807">still</span> <span begin="2:05.807" end="2:06.203">feel</span> <span begin="2:06.203" end="2:06.655">the</span> <span begin="2:06.655" end="2:07.147">same</span><span ttm:role="x-translation" xml:lang