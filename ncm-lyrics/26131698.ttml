<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="恋文"/><amll:meta key="artists" value="やなぎなぎ"/><amll:meta key="album" value="Rewrite Original SoundTrack"/><amll:meta key="isrc" value="JPE451300710"/><amll:meta key="ncmMusicId" value="26131698"/><amll:meta key="qqMusicId" value="1885005"/><amll:meta key="spotifyId" value="37qGmjNLuWOmQr2s1fQpCU"/><amll:meta key="appleMusicId" value="848264455"/><amll:meta key="ttmlAuthorGithubLogin" value="Mrs4s"/><amll:meta key="credit0" value="作词: 都乃河勇人"/><amll:meta key="credit1" value="作曲: 折戸伸治"/><amll:meta key="credit2" value="编曲: MANYO"/></metadata></head><body dur="5:52.920"><div begin="29.573" end="5:52.920"><p begin="29.573" end="35.568" itunes:key="L1" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="29.573" end="29.980">て</span></span></span><span begin="29.980" end="30.753">を</span><span begin="30.753" end="31.593">つ</span><span begin="31.593" end="32.000">な</span><span begin="32.000" end="32.403">い</span><span begin="32.403" end="32.780">で</span><span tts:ruby="container"><span tts:ruby="base">歩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="32.780" end="34.053">ある</span></span></span><span begin="34.053" end="34.443">く</span><span begin="34.443" end="34.703">こ</span><span begin="34.703" end="35.568">と</span><span ttm:role="x-translation">牵着手并肩同行</span><span ttm:role="x-roman">te o tsunaide aruku koto</span></p><p begin="36.893" end="41.708" itunes:key="L2" ttm:agent="v1"><span begin="36.893" end="37.313">た</span><span begin="37.313" end="37.623">だ</span><span begin="37.623" end="38.143">そ</span><span begin="38.143" end="38.523">れ</span><span begin="38.523" end="38.943">だ</span><span begin="38.943" end="39.383">け</span><span begin="39.383" end="39.763">も</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="39.763" end="40.153">で</span></span></span><span tts:ruby="container"><span tts:ruby="base">来</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="40.153" end="40.403">き</span></span></span><span begin="40.403" end="40.773">な</span><span begin="40.773" end="40.983">く</span><span begin="40.983" end="41.708">て</span><span ttm:role="x-translation">就连这般小事也无法做到</span><span ttm:role="x-roman">tada sore dake mo dekinakute</span></p><p begin="43.463" end="48.438" itunes:key="L3" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">戻</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="43.463" end="44.253">もど</span></span></span><span begin="44.253" end="44.673">れ</span><span begin="44.673" end="45.100">な</span><span begin="45.100" end="45.483">い</span><span tts:ruby="container"><span tts:ruby="base">時</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="45.483" end="46.303">とき</span></span></span><span begin="46.303" end="46.983">は</span><span tts:ruby="container"><span tts:ruby="base">過</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="46.983" end="47.513">す</span></span></span><span begin="47.513" end="47.743">ぎ</span><span begin="47.743" end="48.438">て</span><span ttm:role="x-translation">无法挽回的时光悄然流逝</span><span ttm:role="x-roman">modorenai toki wa sugite</span></p><p begin="49.473" end="54.908" itunes:key="L4" ttm:agent="v1"><span begin="49.473" end="50.023">そ</span><span begin="50.023" end="50.393">の</span><span begin="50.393" end="50.823">ま</span><span begin="50.823" end="51.240">ま</span><span tts:ruby="container"><span tts:ruby="base">終</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="51.240" end="51.633">お</span></span></span><span begin="51.633" end="52.033">わ</span><span begin="52.033" end="52.403">る</span><span tts:ruby="container"><span tts:ruby="base">気</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="52.403" end="52.813">き</span></span></span><span begin="52.813" end="53.163">が</span><span begin="53.163" end="53.663">し</span><span begin="53.663" end="54.053">て</span><span begin="54.053" end="54.908">た</span><span ttm:role="x-translation">曾以为一切便会就此终结</span><span ttm:role="x-roman">sono mama owaru ki ga shiteta</span></p><p begin="55.683" end="1:01.720" itunes:key="L5" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">二</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="55.683" end="56.923">ふた</span></span></span><span tts:ruby="container"><span tts:ruby="base">人</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="56.923" end="57.720">り</span></span></span><span tts:ruby="container"><span tts:ruby="base">歩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="57.720" end="58.553">ある</span></span></span><span begin="58.553" end="58.943">く</span><span tts:ruby="container"><span tts:ruby="base">帰</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="58.943" end="1:00.203">かえ</span></span></span><span begin="1:00.203" end="1:00.603">り</span><span tts:ruby="container"><span tts:ruby="base">道</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:00.603" end="1:01.720">みち</span></span></span><span ttm:role="x-translation">两人一同走过的归途</span><span ttm:role="x-roman">futari aruku kaerimichi</span></p><p begin="1:03.020" end="1:07.948" itunes:key="L6" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">終</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:03.020" end="1:03.483">お</span></span></span><span begin="1:03.483" end="1:03.883">わ</span><span begin="1:03.883" end="1:04.263">ら</span><span begin="1:04.263" end="1:04.673">ず</span><span tts:ruby="container"><span tts:ruby="base">続</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:04.673" end="1:05.500">つづ</span></span></span><span begin="1:05.500" end="1:05.873">い</span><span begin="1:05.873" end="1:06.260">て</span><span begin="1:06.260" end="1:06.413">ほ</span><span begin="1:06.413" end="1:06.903">し</span><span begin="1:06.903" end="1:07.113">く</span><span begin="1:07.113" end="1:07.948">て</span><span ttm:role="x-translation">多希望永远不要走到尽头</span><span ttm:role="x-roman">owarazu tsuzuite hoshikute</span></p><p begin="1:09.593" end="1:14.938" itunes:key="L7" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">道</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:09.593" end="1:10.423">みち</span></span></span><span begin="1:10.423" end="1:10.833">の</span><span tts:ruby="container"><span tts:ruby="base">傍</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:10.833" end="1:11.633">はた</span></span></span><span begin="1:11.633" end="1:11.923">に</span><span tts:ruby="container"><span tts:ruby="base">咲</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:11.923" end="1:12.433">さ</span></span></span><span begin="1:12.433" end="1:13.213">く</span><span begin="1:13.213" end="1:13.560">よ</span><span begin="1:13.560" end="1:13.883">う</span><span begin="1:13.883" end="1:14.938">な</span><span ttm:role="x-translation">宛如绽放在路畔的</span><span ttm:role="x-roman">michi no hata ni saku yō na</span></p><p begin="1:15.693" end="1:20.028" itunes:key="L8" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">青</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:15.693" end="1:16.520">あお</span></span></span><span begin="1:16.520" end="1:16.843">い</span><span tts:ruby="container"><span tts:ruby="base">花</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:16.843" end="1:18.073">はな</span></span></span><span tts:ruby="container"><span tts:ruby="base">一</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:18.073" end="1:18.753">ひと</span></span></span><span begin="1:18.753" end="1:20.028">つ</span><span ttm:role="x-translation">一朵蓝色花儿</span><span ttm:role="x-roman">aoi hana hitotsu</span></p><p begin="1:22.073" end="1:27.858" itunes:key="L9" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:22.073" end="1:22.713">しょう</span></span></span><span tts:ruby="container"><span tts:ruby="base">失</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:22.713" end="1:23.903">しつ</span></span></span><span tts:ruby="container"><span tts:ruby="base">點</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:23.903" end="1:24.713">てん</span></span></span><span begin="1:24.713" end="1:24.963">の</span><span tts:ruby="container"><span tts:ruby="base">境</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:24.963" end="1:26.753">さかい</span></span></span><span tts:ruby="container"><span tts:ruby="base">目</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:26.753" end="1:26.973">め</span></span></span><span begin="1:26.973" end="1:27.858">に</span><span ttm:role="x-translation">在消失点的交界处</span><span ttm:role="x-roman">shōshitsuten no sakaime ni</span></p><p begin="1:28.720" end="1:33.968" itunes:key="L10" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">貴</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:28.720" end="1:29.153">あ</span></span></span><span tts:ruby="container"><span tts:ruby="base">方</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:29.153" end="1:29.960">なた</span></span></span><span begin="1:29.960" end="1:30.423">の</span><span tts:ruby="container"><span tts:ruby="base">姿</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:30.423" end="1:31.983">すがた</span></span></span><span begin="1:31.983" end="1:32.800">が</span><span tts:ruby="container"><span tts:ruby="base">映</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:32.800" end="1:33.513">うつ</span></span></span><span begin="1:33.513" end="1:33.968">る</span><span ttm:role="x-translation">映出你的身影</span><span ttm:role="x-roman">anata no sugata ga utsuru</span></p><p begin="1:34.463" end="1:41.178" itunes:key="L11" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">私</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:34.463" end="1:35.673">わたし</span></span></span><span begin="1:35.673" end="1:35.903">の</span><span tts:ruby="container"><span tts:ruby="base">暗</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:35.903" end="1:36.940">くら</span></span></span><span begin="1:36.940" end="1:37.433">い</span><span tts:ruby="container"><span tts:ruby="base">部</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:37.433" end="1:38.183">へ</span></span></span><span tts:ruby="container"><span tts:ruby="base">屋</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:38.183" end="1:38.583">や</span></span></span><span begin="1:38.583" end="1:39.223">の</span><span tts:ruby="container"><span tts:ruby="base">窓</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:39.223" end="1:40.253">まど</span></span></span><span tts:ruby="container"><span tts:ruby="base">辺</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:40.253" end="1:41.178">べ</span></span></span><span ttm:role="x-translation">在我昏暗房间的窗边</span><span ttm:role="x-roman">watashi no kurai heya no madobe</span></p><p begin="1:41.780" end="1:47.488" itunes:key="L12" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">暖</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:41.780" end="1:43.023">あたた</span></span></span><span begin="1:43.023" end="1:43.473">か</span><span begin="1:43.473" end="1:43.893">な</span><span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:43.893" end="1:44.973">ひかり</span></span></span><span tts:ruby="container"><span tts:ruby="base">射</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:44.973" end="1:45.533">さ</span></span></span><span begin="1:45.533" end="1:45.873">し</span><span begin="1:45.873" end="1:47.488">た</span><span ttm:role="x-translation">洒下了温暖的光芒</span><span ttm:role="x-roman">atatakana hikari sashita</span></p><p begin="1:51.593" end="1:57.548" itunes:key="L13" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">忘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:51.593" end="1:52.420">わす</span></span></span><span begin="1:52.420" end="1:52.833">れ</span><span begin="1:52.833" end="1:53.043">た</span><span tts:ruby="container"><span tts:ruby="base">時</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:53.043" end="1:54.063">とき</span></span></span><span begin="1:54.063" end="1:54.453">の</span><span tts:ruby="container"><span tts:ruby="base">彼</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:54.453" end="1:55.273">かな</span></span></span><span tts:ruby="container"><span tts:ruby="base">方</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:55.273" end="1:56.113">た</span></span></span><span begin="1:56.113" end="1:57.548">に</span><span ttm:role="x-translation">纵使在被遗忘的时光彼端</span><span ttm:role="x-roman">wasureta toki no kanata ni</span></p><p begin="1:58.053" end="2:03.100" itunes:key="L14" ttm:agent="v1"><span begin="1:58.053" end="1:58.553">す</span><span begin="1:58.553" end="1:58.953">べ</span><span begin="1:58.953" end="1:59.383">て</span><span begin="1:59.383" end="1:59.580">が</span><span tts:ruby="container"><span tts:ruby="base">置</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:59.580" end="2:00.163">お</span></span></span><span begin="2:00.163" end="2:00.473">き</span><span begin="2:00.473" end="2:01.013">さ</span><span begin="2:01.013" end="2:01.433">ら</span><span begin="2:01.433" end="2:02.003">れ</span><span begin="2:02.003" end="2:02.263">て</span><span begin="2:02.263" end="2:03.100">も</span><span ttm:role="x-translation">一切都被抛在身后</span><span ttm:role="x-roman">subete ga okisararete mo</span></p><p begin="2:03.613" end="2:10.768" itunes:key="L15" ttm:agent="v1"><span begin="2:03.613" end="2:04.073">ずっ</span><span begin="2:04.073" end="2:04.663">と</span><span tts:ruby="container"><span tts:ruby="base">大</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:04.663" end="2:05.773">だい</span></span></span><span tts:ruby="container"><span tts:ruby="base">好</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:05.773" end="2:06.013">す</span></span></span><span begin="2:06.013" end="2:06.273">き</span><span begin="2:06.273" end="2:06.873">だ</span><span begin="2:06.873" end="2:07.543">か</span><span begin="2:07.543" end="2:07.953">ら</span><span tts:ruby="container"><span tts:ruby="base">忘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:07.953" end="2:09.163">わす</span></span></span><span begin="2:09.163" end="2:09.373">れ</span><span begin="2:09.373" end="2:09.600">な</span><span begin="2:09.600" end="2:10.233">い</span><span begin="2:10.233" end="2:10.768">よ</span><span ttm:role="x-translation">因我始终深爱着你 绝不会遗忘</span><span ttm:role="x-roman">zutto daisuki dakara wasurenai yo</span></p><p begin="2:11.180" end="2:19.618" itunes:key="L16" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">今</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:11.180" end="2:12.440">いま</span></span></span><span begin="2:12.440" end="2:12.853">は</span><span begin="2:12.853" end="2:13.493">た</span><span begin="2:13.493" end="2:14.003">だ</span><span begin="2:14.003" end="2:14.493">さ</span><span begin="2:14.493" end="2:14.910">よ</span><span begin="2:14.910" end="2:15.343">う</span><span begin="2:15.343" end="2:16.113">な</span><span begin="2:16.113" end="2:17.098">ら</span><span begin="2:17.313" end="2:17.533">だ</span><span begin="2:17.533" end="2:19.618">け</span><span ttm:role="x-translation">只是如今 唯有道一声再见</span><span ttm:role="x-roman">ima wa tada sayōnara dake</span></p><p begin="2:33.640" end="2:39.908" itunes:key="L17" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">今</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:33.640" end="2:34.943">いま</span></span></span><span begin="2:34.943" end="2:35.663">こ</span><span begin="2:35.663" end="2:36.103">こ</span><span begin="2:36.103" end="2:36.480">で</span><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:36.480" end="2:36.893">い</span></span></span><span begin="2:36.893" end="2:37.313">き</span><span begin="2:37.313" end="2:38.183">て</span><span begin="2:38.183" end="2:38.553">る</span><span begin="2:38.553" end="2:38.783">こ</span><span begin="2:38.783" end="2:39.908">と</span><span ttm:role="x-translation">此刻在此活着的意义</span><span ttm:role="x-roman">ima koko de ikiteru koto</span></p><p begin="2:40.980" end="2:46.080" itunes:key="L18" ttm:agent="v1"><span begin="2:40.980" end="2:41.453">あ</span><span begin="2:41.453" end="2:41.813">な</span><span begin="2:41.813" end="2:42.213">た</span><span begin="2:42.213" end="2:42.680">が</span><span tts:ruby="container"><span tts:ruby="base">教</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:42.680" end="2:43.440">おし</span></span></span><span begin="2:43.440" end="2:43.823">え</span><span begin="2:43.823" end="2:44.253">て</span><span begin="2:44.253" end="2:44.493">く</span><span begin="2:44.493" end="2:44.873">れ</span><span begin="2:44.873" end="2:45.103">た</span><span begin="2:45.103" end="2:46.080">ね</span><span ttm:role="x-translation">是你教会了我吧</span><span ttm:role="x-roman">anata ga oshiete kureta ne</span></p><p begin="2:47.523" end="2:52.878" itunes:key="L19" ttm:agent="v1"><span begin="2:47.523" end="2:47.933">た</span><span begin="2:47.933" end="2:48.380">と</span><span begin="2:48.380" end="2:48.763">え</span><span begin="2:48.763" end="2:49.180">ど</span><span begin="2:49.180" end="2:49.583">ん</span><span begin="2:49.583" end="2:49.953">な</span><span tts:ruby="container"><span tts:ruby="base">過</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:49.953" end="2:50.383">か</span></span></span><span tts:ruby="container"><span tts:ruby="base">酷</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:50.383" end="2:51.613">こく</span></span></span><span begin="2:51.613" end="2:51.863">で</span><span begin="2:51.863" end="2:52.878">も</span><span ttm:role="x-translation">哪怕命运再怎么残酷</span><span ttm:role="x-roman">tatoe donna kakoku demo</span></p><p begin="2:53.603" end="2:59.180" itunes:key="L20" ttm:agent="v1"><span begin="2:53.603" end="2:54.033">ふ</span><span begin="2:54.033" end="2:54.483">た</span><span begin="2:54.483" end="2:54.883">り</span><span begin="2:54.883" end="2:55.300">で</span><span begin="2:55.300" end="2:55.703">い</span><span begin="2:55.703" end="2:56.103">れ</span><span begin="2:56.103" end="2:56.533">ば</span><span tts:ruby="container"><span tts:ruby="base">笑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:56.533" end="2:57.340">わら</span></span></span><span begin="2:57.340" end="2:57.743">え</span><span begin="2:57.743" end="2:58.193">る</span><span begin="2:58.193" end="2:59.180">と</span><span ttm:role="x-translation">只要两人相伴便能展露笑颜</span><span ttm:role="x-roman">futari de ireba waraeru to</span></p><p begin="2:59.823" end="3:06.018" itunes:key="L21" ttm:agent="v1"><span begin="2:59.823" end="3:00.173">い</span><span begin="3:00.173" end="3:01.003">つ</span><span begin="3:01.003" end="3:01.813">か</span><span begin="3:01.813" end="3:02.273">こ</span><span begin="3:02.273" end="3:02.713">の</span><span tts:ruby="container"><span tts:ruby="base">世</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:02.713" end="3:03.043">よ</span></span></span><span begin="3:03.043" end="3:03.480">が</span><span tts:ruby="container"><span tts:ruby="base">終</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:03.480" end="3:04.303">お</span></span></span><span begin="3:04.303" end="3:04.883">わっ</span><span begin="3:04.883" end="3:06.018">て</span><span ttm:role="x-translation">总有一天这世界终结</span><span ttm:role="x-roman">itsuka kono yo ga owatte</span></p><p begin="3:07.113" end="3:12.338" itunes:key="L22" ttm:agent="v1"><span begin="3:07.113" end="3:07.563">ふ</span><span begin="3:07.563" end="3:07.993">た</span><span begin="3:07.993" end="3:08.363">り</span><span tts:ruby="container"><span tts:ruby="base">別</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:08.363" end="3:09.203">わか</span></span></span><span begin="3:09.203" end="3:09.613">れ</span><span begin="3:09.613" end="3:09.853">て</span><span begin="3:09.853" end="3:10.403">し</span><span begin="3:10.403" end="3:11.003">まっ</span><span begin="3:11.003" end="3:11.200">て</span><span begin="3:11.200" end="3:12.338">も</span><span ttm:role="x-translation">就算我们终将天各一方</span><span ttm:role="x-roman">futari wakarete shimatte mo</span></p><p begin="3:13.660" end="3:19.028" itunes:key="L23" ttm:agent="v1"><span begin="3:13.660" end="3:14.073">い</span><span begin="3:14.073" end="3:14.503">つ</span><span begin="3:14.503" end="3:14.863">か</span><span begin="3:14.863" end="3:15.733">きっ</span><span begin="3:15.733" end="3:16.133">と</span><span begin="3:16.133" end="3:16.503">ま</span><span begin="3:16.503" end="3:17.260">た</span><span tts:ruby="container"><span tts:ruby="base">會</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:17.260" end="3:17.720">あ</span></span></span><span begin="3:17.720" end="3:17.973">え</span><span begin="3:17.973" end="3:19.028">る</span><span ttm:role="x-translation">有朝一日也定能再度重逢</span><span ttm:role="x-roman">itsuka kitto mata aeru</span></p><p begin="3:19.763" end="3:24.638" itunes:key="L24" ttm:agent="v1"><span begin="3:19.763" end="3:20.203">あ</span><span begin="3:20.203" end="3:20.583">な</span><span begin="3:20.583" end="3:21.020">た</span><span begin="3:21.020" end="3:21.273">は</span><span begin="3:21.273" end="3:21.700">そ</span><span begin="3:21.700" end="3:22.243">う</span><span tts:ruby="container"><span tts:ruby="base">言っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:22.243" end="3:22.853">い</span></span></span><span begin="3:22.853" end="3:24.638">た</span><span ttm:role="x-translation">你曾这样说过</span><span ttm:role="x-roman">anata wa sō itta</span></p><p begin="3:26.260" end="3:31.998" itunes:key="L25" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">終</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:26.260" end="3:26.713">お</span></span></span><span begin="3:26.713" end="3:26.933">わ</span><span begin="3:26.933" end="3:27.513">り</span><span begin="3:27.513" end="3:27.933">が</span><span tts:ruby="container"><span tts:ruby="base">來</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:27.933" end="3:28.353">く</span></span></span><span begin="3:28.353" end="3:28.763">る</span><span tts:ruby="container"><span tts:ruby="base">星</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:28.763" end="3:29.563">ほし</span></span></span><span begin="3:29.563" end="3:30.383">の</span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:30.383" end="3:31.003">なか</span></span></span><span begin="3:31.003" end="3:31.998">で</span><span ttm:role="x-translation">在终将迎向终焉的星球上</span><span ttm:role="x-roman">owari ga kuru hoshi no naka de</span></p><p begin="3:32.800" end="3:38.120" itunes:key="L26" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">青</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:32.800" end="3:33.500">あお</span></span></span><span begin="3:33.500" end="3:34.073">い</span><span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:34.073" end="3:35.553">ひかり</span></span></span><span tts:ruby="container"><span tts:ruby="base">探</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:35.553" end="3:36.763">さが</span></span></span><span begin="3:36.763" end="3:37.333">し</span><span begin="3:37.333" end="3:37.533">て</span><span begin="3:37.533" end="3:38.120">る</span><span ttm:role="x-translation">寻觅着那一抹蓝光</span><span ttm:role="x-roman">aoi hikari sagashiteru</span></p><p begin="3:38.583" end="3:45.040" itunes:key="L27" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">私</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:38.583" end="3:39.773">わたし</span></span></span><span begin="3:39.773" end="3:39.963">の</span><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:39.963" end="3:41.580">こころ</span></span></span><span begin="3:41.580" end="3:42.213">に</span><span tts:ruby="container"><span tts:ruby="base">重</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:42.213" end="3:43.253">かさ</span></span></span><span begin="3:43.253" end="3:44.273">なっ</span><span begin="3:44.273" end="3:45.040">て</span><span ttm:role="x-translation">与我的心相互交叠</span><span ttm:role="x-roman">watashi no kokoro ni kasanatte</span></p><p begin="3:45.880" end="3:51.440" itunes:key="L28" ttm:agent="v1"><span begin="3:45.880" end="3:46.333">あ</span><span begin="3:46.333" end="3:46.713">な</span><span begin="3:46.713" end="3:47.153">た</span><span begin="3:47.153" end="3:47.513">の</span><span tts:ruby="container"><span tts:ruby="base">鼓</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:47.513" end="3:47.963">こ</span></span></span><span tts:ruby="container"><span tts:ruby="base">動</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:47.963" end="3:48.743">どう</span></span></span><span tts:ruby="container"><span tts:ruby="base">聞</span><spa