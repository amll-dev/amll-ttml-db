<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="どうして…"/><amll:meta key="artists" value="めらみぽっぷ"/><amll:meta key="album" value="宴"/><amll:meta key="ncmMusicId" value="850775"/><amll:meta key="qqMusicId" value="0025luBu4W3Aam"/><amll:meta key="spotifyId" value="5ztm51HtrekrUutiNixaoe"/><amll:meta key="appleMusicId" value="1528308481"/><amll:meta key="ttmlAuthorGithubLogin" value="Mrs4s"/></metadata></head><body dur="5:42.880"><div begin="1:14.880" end="5:42.880"><p begin="1:14.880" end="1:23.260" itunes:key="L1" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">翳</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:14.880" end="1:15.180">か</span><span tts:ruby="text" begin="1:15.180" end="1:15.460">げ</span></span></span><span begin="1:15.460" end="1:15.860">る</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:16.020" end="1:16.300">ひ</span></span></span><span tts:ruby="container"><span tts:ruby="base">暮</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:16.300" end="1:16.620">ぐ</span></span></span><span begin="1:16.620" end="1:16.880">れ</span><span begin="1:16.880" end="1:17.240">に</span><span begin="1:17.440" end="1:18.300">ふ</span><span begin="1:18.300" end="1:18.660">と</span><span tts:ruby="container"><span tts:ruby="base">向</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:18.660" end="1:18.860">む</span><span tts:ruby="text" begin="1:18.860" end="1:19.200">か</span></span></span><span begin="1:19.200" end="1:19.460">う</span><span tts:ruby="container"><span tts:ruby="base">眼</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:19.740" end="1:20.540">ま</span><span tts:ruby="text" begin="1:20.540" end="1:20.840">な</span></span></span><span tts:ruby="container"><span tts:ruby="base">差</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:20.840" end="1:21.140">ざ</span></span></span><span begin="1:21.140" end="1:21.440">し</span><span begin="1:21.440" end="1:21.700">の</span><span tts:ruby="container"><span tts:ruby="base">先</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:21.700" end="1:22.020">さ</span><span tts:ruby="text" begin="1:22.020" end="1:23.260">き</span></span></span><span ttm:role="x-translation">暮色渐暗时 诧然抬首 遥望落霞之彼</span><span ttm:role="x-roman">kageru higure ni futo mukau manazashi no saki</span></p><p begin="1:24.020" end="1:32.800" itunes:key="L2" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:24.020" end="1:24.320">こ</span><span tts:ruby="text" begin="1:24.320" end="1:24.620">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">葉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:24.620" end="1:24.860">ば</span></span></span><span begin="1:24.860" end="1:25.180">を</span><span tts:ruby="container"><span tts:ruby="base">失</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:25.180" end="1:25.420">な</span></span></span><span begin="1:25.420" end="1:25.700">く</span><span begin="1:25.700" end="1:26.040">し</span><span begin="1:26.040" end="1:26.300">た</span><span begin="1:26.580" end="1:27.053">景</span><span begin="1:27.053" end="1:27.760">色</span><span begin="1:27.760" end="1:28.040">の</span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:28.040" end="1:28.340">な</span><span tts:ruby="text" begin="1:28.340" end="1:28.620">か</span></span></span><span begin="1:28.900" end="1:29.720">あ</span><span begin="1:29.720" end="1:30.320">な</span><span begin="1:30.320" end="1:30.580">た</span><span begin="1:30.580" end="1:30.880">は</span><span tts:ruby="container"><span tts:ruby="base">居</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:30.880" end="1:31.180">い</span></span></span><span begin="1:31.180" end="1:32.800">て</span><span ttm:role="x-translation">难以言喻的风景之中 浮现出的 是你的身影</span><span ttm:role="x-roman">kotoba o nakushita keshiki no naka anata wa ite</span></p><p begin="1:35.440" end="1:44.160" itunes:key="L3" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">人</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:35.440" end="1:35.760">ひ</span><span tts:ruby="text" begin="1:35.760" end="1:36.020">と</span></span></span><span begin="1:36.020" end="1:36.320">は</span><span tts:ruby="container"><span tts:ruby="base">儚</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:36.320" end="1:36.580">は</span><span tts:ruby="text" begin="1:36.580" end="1:36.880">か</span><span tts:ruby="text" begin="1:36.880" end="1:37.160">な</span></span></span><span begin="1:37.160" end="1:37.480">く</span><span begin="1:37.480" end="1:37.800">も</span><span tts:ruby="container"><span tts:ruby="base">雪</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:38.060" end="1:38.880">ゆ</span><span tts:ruby="text" begin="1:38.880" end="1:39.180">き</span></span></span><span begin="1:39.180" end="1:39.420">の</span><span begin="1:39.420" end="1:39.740">よ</span><span begin="1:39.740" end="1:40.340">う</span><span begin="1:40.340" end="1:41.140">に</span><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:41.140" end="1:41.420">き</span></span></span><span begin="1:41.420" end="1:41.760">え</span><span begin="1:41.760" end="1:41.980">ゆ</span><span begin="1:41.980" end="1:42.300">く</span><span begin="1:42.300" end="1:42.600">も</span><span begin="1:42.600" end="1:43.140">の</span><span begin="1:43.140" end="1:43.480">な</span><span begin="1:43.480" end="1:43.740">ら</span><span begin="1:43.740" end="1:44.160">ば</span><span ttm:role="x-translation">若岁月流年 虚妄如雪 终将迎来消弭</span><span ttm:role="x-roman">hito wa hakanaku mo yuki no yō ni kieyuku mono naraba</span></p><p begin="1:44.580" end="1:54.100" itunes:key="L4" ttm:agent="v1"><span begin="1:44.580" end="1:44.900">こ</span><span begin="1:44.900" end="1:45.310">の</span><span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:45.310" end="1:45.720">お</span><span tts:ruby="text" begin="1:45.720" end="1:46.020">も</span></span></span><span begin="1:46.020" end="1:46.300">い</span><span begin="1:46.300" end="1:46.583">さ</span><span begin="1:46.583" end="1:47.180">え</span><span begin="1:47.180" end="1:47.740">も</span><span tts:ruby="container"><span tts:ruby="base">諸</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:47.760" end="1:48.013">も</span><span tts:ruby="text" begin="1:48.013" end="1:48.140">ろ</span></span></span><span tts:ruby="container"><span tts:ruby="base">共</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:48.140" end="1:48.600">と</span><span tts:ruby="text" begin="1:48.600" end="1:48.860">も</span></span></span><span begin="1:48.860" end="1:49.260">に</span><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:49.360" end="1:50.320">き</span></span></span><span begin="1:50.320" end="1:50.620">え</span><span begin="1:50.620" end="1:50.840">て</span><span begin="1:50.840" end="1:51.180">し</span><span begin="1:51.180" end="1:51.740">ま</span><span begin="1:51.740" end="1:52.300">え</span><span begin="1:52.300" end="1:52.600">ば</span><span begin="1:52.600" end="1:52.940">い</span><span begin="1:52.940" end="1:54.100">い</span><span ttm:role="x-translation">那便让这份思念 随之一并 逝去又有何不可</span><span ttm:role="x-roman">kono omoi sae mo morotomo ni kiete shimaeba ii</span></p><p begin="1:55.740" end="2:01.160" itunes:key="L5" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">春</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:55.740" end="1:56.040">は</span><span tts:ruby="text" begin="1:56.040" end="1:56.300">る</span></span></span><span begin="1:56.300" end="1:56.580">は</span><span tts:ruby="container"><span tts:ruby="base">旅</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:56.580" end="1:56.900">た</span><span tts:ruby="text" begin="1:56.900" end="1:57.240">び</span></span></span> <span tts:ruby="container"><span tts:ruby="base">朝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:57.440" end="1:57.720">あ</span><span tts:ruby="text" begin="1:57.720" end="1:58.040">さ</span></span></span><span begin="1:58.040" end="1:58.400">に</span><span tts:ruby="container"><span tts:ruby="base">此</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:58.580" end="1:58.923">こ</span></span></span><span tts:ruby="container"><span tts:ruby="base">処</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:58.923" end="1:59.183">こ</span></span></span><span begin="1:59.183" end="1:59.460">を</span><span tts:ruby="container"><span tts:ruby="base">発</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:59.460" end="1:59.720">た</span></span></span><span begin="1:59.720" end="2:00.020">つ</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:00.020" end="2:00.300">ひ</span></span></span><span begin="2:00.300" end="2:00.580">の</span><span begin="2:00.580" end="2:00.880">こ</span><span begin="2:00.880" end="2:01.160">と。</span><span ttm:role="x-translation">于春而启 在那个清晨踏上期待之旅</span><span ttm:role="x-roman">haru wa tabi. asa ni koko o tatsu hi no koto.</span></p><p begin="2:01.160" end="2:05.720" itunes:key="L6" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夏</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:01.160" end="2:01.460">な</span><span tts:ruby="text" begin="2:01.460" end="2:01.800">つ</span></span></span><span begin="2:02.020" end="2:02.300">の</span><span tts:ruby="container"><span tts:ruby="base">度</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:02.300" end="2:02.620">た</span><span tts:ruby="text" begin="2:02.620" end="2:02.880">び</span></span></span> <span begin="2:03.160" end="2:03.760">二</span><span begin="2:03.760" end="2:04.020">人</span><span begin="2:04.020" end="2:04.280">の</span><span tts:ruby="container"><span tts:ruby="base">夜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:04.280" end="2:04.587">よ</span></span></span><span begin="2:04.587" end="2:04.893">を</span><span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:04.893" end="2:05.200">お</span><span tts:ruby="text" begin="2:05.200" end="2:05.440">も</span></span></span><span begin="2:05.440" end="2:05.720">う。</span><span ttm:role="x-translation">逢夏则忆 你我曾共赏过的夜景</span><span ttm:role="x-roman">natsu no tabi. futari no yo o omou.</span></p><p begin="2:05.720" end="2:10.300" itunes:key="L7" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">秋</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:05.720" end="2:06.000">あ</span><span tts:ruby="text" begin="2:06.000" end="2:06.340">き</span></span></span><span begin="2:06.560" end="2:06.840">の</span><span tts:ruby="container"><span tts:ruby="base">闇</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:06.840" end="2:07.140">や</span><span tts:ruby="text" begin="2:07.140" end="2:07.420">み</span></span></span> <span tts:ruby="container"><span tts:ruby="base">夕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:07.760" end="2:08.030">ゆ</span><span tts:ruby="text" begin="2:08.030" end="2:08.300">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">暮</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:08.300" end="2:08.600">ぐ</span><span tts:ruby="text" begin="2:08.600" end="2:08.880">れ</span></span></span><span begin="2:08.880" end="2:09.160">よ</span><span begin="2:09.160" end="2:09.440">り</span><span tts:ruby="container"><span tts:ruby="base">暗</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:09.440" end="2:09.760">く</span><span tts:ruby="text" begin="2:09.760" end="2:10.000">ら</span></span></span><span begin="2:10.000" end="2:10.300">く。</span><span ttm:role="x-translation">秋之暗谧 更胜夕阳西下的哀凄</span><span ttm:role="x-roman">aki no yami. yūgure yori kuraku.</span></p><p begin="2:10.340" end="2:13.933" itunes:key="L8" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">冬</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:10.340" end="2:10.540">ふ</span><span tts:ruby="text" begin="2:10.540" end="2:10.900">ゆ</span></span></span><span begin="2:11.160" end="2:11.420">を</span><span tts:ruby="container"><span tts:ruby="base">呼</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:11.420" end="2:11.760">よ</span></span></span><span begin="2:11.760" end="2:12.060">び</span> <span tts:ruby="container"><span tts:ruby="base">四</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:12.240" end="2:12.580">し</span></span></span><span tts:ruby="container"><span tts:ruby="base">季</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:12.580" end="2:12.880">き</span></span></span><span begin="2:12.880" end="2:13.180">は</span><span begin="2:13.180" end="2:13.440">め</span><span begin="2:13.440" end="2:13.720">ぐ</span><span begin="2:13.720" end="2:13.933">り。</span><span ttm:role="x-translation">冬被呼醒 又转过一轮四季</span><span ttm:role="x-roman">fuyu o yobi. shiki wa meguri.</span></p><p begin="2:13.933" end="2:19.420" itunes:key="L9" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">桜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:13.933" end="2:14.300">さ</span><span tts:ruby="text" begin="2:14.300" end="2:14.600">く</span><span tts:ruby="text" begin="2:14.600" end="2:14.860">ら</span></span></span><span tts:ruby="container"><span tts:ruby="base">舞</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:14.860" end="2:15.180">ま</span></span></span><span begin="2:15.180" end="2:15.560">う</span> <span tts:ruby="container"><span tts:ruby="base">華</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:15.720" end="2:16.060">は</span><span tts:ruby="text" begin="2:16.060" end="2:16.320">な</span></span></span><span begin="2:16.320" end="2:16.680">や</span><span begin="2:16.860" end="2:17.160">か</span><span begin="2:17.160" end="2:17.420">な</span><span tts:ruby="container"><span tts:ruby="base">宴</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:17.420" end="2:17.740">う</span><span tts:ruby="text" begin="2:17.740" end="2:18.040">た</span><span tts:ruby="text" begin="2:18.040" end="2:18.280">げ</span></span></span><span begin="2:18.280" end="2:18.560">の</span><span begin="2:18.560" end="2:18.840">最</span><span begin="2:18.840" end="2:19.420">中。</span><span ttm:role="x-translation">樱花乱舞 点缀着盛大宴会的高潮</span><span ttm:role="x-roman">sakura mau. hanayaka na utage no sanaka.</span></p><p begin="2:19.420" end="2:23.960" itunes:key="L10" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">星</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:19.420" end="2:19.720">ほ</span><span tts:ruby="text" begin="2:19.720" end="2:20.020">し</span></span></span><span begin="2:20.260" end="2:20.580">は</span><span tts:ruby="container"><span tts:ruby="base">降</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:20.580" end="2:20.880">ふ</span></span></span><span begin="2:20.880" end="2:21.160">る</span> <span begin="2:21.420" end="2:21.720">あ</span><span begin="2:21.720" end="2:22.020">な</span><span begin="2:22.020" end="2:22.300">た</span><span begin="2:22.300" end="2:22.580">に</span><span tts:ruby="container"><span tts:ruby="base">降</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:22.580" end="2:22.880">ふ</span></span></span><span begin="2:22.880" end="2:23.140">り</span><span tts:ruby="container"><span tts:ruby="base">注</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:23.140" end="2:23.380">そ</span><span tts:ruby="text" begin="2:23.380" end="2:23.720">そ</span></span></span><span begin="2:23.720" end="2:23.960">ぐ。</span><span ttm:role="x-translation">繁星洒落 勾勒出你款款的身姿</span><span ttm:role="x-roman">hoshi wa furu. anata ni furisosogu.</span></p><p begin="2:23.960" end="2:28.600" itunes:key="L11" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">月</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:23.960" end="2:24.300">つ</span><span tts:ruby="text" begin="2:24.300" end="2:24.580">き</span></span></span><span begin="2:24.860" end="2:25.120">が</span><span tts:ruby="container"><span tts:ruby="base">照</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:25.120" end="2:25.440">て</span></span></span><span begin="2:25.440" end="2:25.760">る</span> <span begin="2:26.000" end="2:26.580">二</span><span begin="2:26.580" end="2:26.880">人</span><span begin="2:26.880" end="2:27.160">の</span><span tts:ruby="container"><span tts:ruby="base">影</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:27.160" end="2:27.460">か</span><span tts:ruby="text" begin="2:27.460" end="2:27.680">げ</span></span></span><span tts:ruby="container"><span tts:ruby="base">作</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:27.680" end="2:28.020">つ</span><span tts:ruby="text" begin="2:28.020" end="2:28.320">く</span></span></span><span begin="2:28.320" end="2:28.600">る。</span><span ttm:role="x-translation">月色倾泻 拖曳出两道悠长之影</span><span ttm:role="x-roman">tsuki ga teru. futari no kage tsukuru.</span></p><p begin="2:28.600" end="2:32.579" itunes:key="L12" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">雪</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:28.600" end="2:28.880">ゆ</span><span tts:ruby="text" begin="2:28.880" end="2:29.200">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">積</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:29.400" end="2:29.780">つ</span></span></span><span begin="2:29.780" end="2:30.020">も</span><span begin="2:30.020" end="2:30.300">る</span> <span tts:ruby="container"><span tts:ruby="base">巡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:30.600" end="2:30.920">め</span><span tts:ruby="text" begin="2:30.920" end="2:31.160">ぐ</span></span></span><span begin="2:31.160" end="2:31.460">り</span><span tts:ruby="container"><span tts:ruby="base">巡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:31.460" end="2:31.740">め</span><span tts:ruby="text" begin="2:31.740" end="2:32.040">ぐ</span></span></span><span begin="2:32.040" end="2:32.579">る</span><span ttm:role="x-translation">白雪堆积 一年又一年</span><span ttm:role="x-roman">yuki tsumoru. meguri meguru.</span></p><p begin="2:32.580" end="2:40.060" itunes:key="L13" ttm:agent="v1"><span begin="2:32.580" end="2:32.880">そ</span><span begin="2:32.880" end="2:33.180">れ</span><span begin="2:33.180" end="2:33.980">で</span><span begin="2:33.980" end="2:34.300">も</span><span begin="2:34.300" end="2:34.880">あ</span><span begin="2:34.880" end="2:35.460">な</span><span begin="2:35.460" end="2:36.320">た</span><span begin="2:36.320" end="2:36.620">は</span><span tts:ruby="container"><span tts:ruby="base">遠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:36.620" end="2:37.200">と</span><span tts:ruby="text" begin="2:37.200" end="2:37.720">お</span></span></span><span begin="2:37.720" end="2:40.060">い…</span><span ttm:role="x-translation">然而你却是如此遥不可及</span><span ttm:role="x-roman">soredemo anata wa tōi…</span></p><p begin="2:41.730" end="2:44.000" itunes:key="L14" ttm:agent="v1"><span begin="2:41.730" end="2:41.950">ね</span><span begin="2:41.950" end="2:42.330">ぇ、</span><span begin="2:42.330" end="2:42.680">ど</span><span begin="2:42.680" end="2:43.060">う</span><span begin="2:43.060" end="2:43.440">し</span><span begin="2:43.440" end="2:44.000">て</span><span ttm:role="x-translation">呐，请告诉我</span><span ttm:role="x-roman">nē, dōshite</span></p><p begin="2:44.300" end="2:51.100" itunes:key="L15" ttm:agent="v1"><span begin="2:44.300" end="2:44.600">あ</span><span begin="2:44.600" end="2:45.440">な</span><span begin="2:45.440" end="2:45.740">た</span><span begin="2:45.740" end="2:46.240">は</span><span tts:ruby="container"><span tts:ruby="base">私</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:46.560" end="2:46.900">わ</span><span tts:ruby="text" begin="2:46.900" end="2:47.400">た</span><span tts:ruby="text" begin="2:47.400" end="2:47.760">し</span></span></span><span begin="2:47.760" end="2:48.200">を</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:48.280" end="2:48.580">み</span></span></span><span begin="2:48.580" end="2:48.860">て</span><span begin="2:48.860" end="2:49.180">く</span><span begin="2:49.180" end="2:49.440">れ</span><span begin="2:49.440" end="2:50.020">な</span><span begin="2:50.020" end="2:50.640">い</span><span begin="2:50.640" end="2:51.100">の</span><span ttm:role="x-translation">到底为何 你的眼中没有我的存在呢</span><span ttm:role="x-roman">anata wa watashi o mite kurenai no</span></p><p begin="2:51.420" end="2:59.360" itunes:key="L16" ttm:agent="v1"><span begin="2:51.420" end="2:52.280">あ</span><span begin="2:52.280" end="2:52.600">な</span><span begin="2:52.600" end="2:53.080">た</span><span begin="2:53.400" end="2:53.760">は</span><span tts:ruby="container"><span tts:ruby="base">誰</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:53.760" end="2:54.560">だ</span><span tts:ruby="text" begin="2:54.560" end="2:54.860">れ</span></span></span><span begin="2:54.860" end="2:55.180">を</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:55.530" end="2:55.960">み</span></span></span><span begin="2:55.960" end="2:57.100">て</span><span begin="2:57.100" end="2:57.760">い</span><span begin="2:57.760" end="2:58.000">る</span><span begin="2:58.000" end="2:59.360">の</span><span ttm:role="x-translation">在你的视线彼端的身影又是什么</span><span ttm:role="x-roman">anata wa dare o mite iru no</span></p><p begin="2:59.980" end="3:02.260" itunes:key="L17" ttm:agent="v1"><span begin="2:59.980" end="3:00.290">ね</span><span begin="3:00.290" end="3:00.600">ぇ、</span><span begin="3:00.600" end="3:00.970">ど</span><span begin="3:00.970" end="3:01.313">う</span><span begin="3:01.313" end="3:01.740">し</span><span begin="3:01.740" end="3:02.260">て</span><span ttm:role="x-translation">呐，请告诉我</span><span ttm:role="x-roman">nē, dōshite</span></p><p begin="3:02.560" end="3:09.340" itunes:key="L18" ttm:agent="v1"><span begin="3:02.560" end="3:02.880">あ</span><span begin="3:02.880" end="3:03.740">な</span><span begin="3:03.740" end="3:04.060">た</span><span begin="3:04.060" end="3:04.520">を</span><span begin="3:04.860" end="3:05.120">い</span><span begin="3:05.120" end="3:05.720">つ</span><span begin="3:05.720" end="3:06.000">で</span><span begin="3:06.000" end="3:06.500">も</span><span tts:ruby="container"><span tts:ruby="base">探</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:06.500" end="3:06.880">さ</span><span tts:ruby="text" begin="3:06.880" end="3:07.100">が</span></span></span><span begin="3:07.100" end="3:07.440">し</span><span begin="3:07.440" end="3:07.760">て</span><span begin="3:07.760" end="3:08.300">い</span><span begin="3:08.300" end="3:08.880">る</span><span begin="3:08.880" end="3:09.340">の</span><span ttm:role="x-translation">无时无刻 不在追寻你的身影的我</span><span ttm:role="x-roman">anata o itsudemo sagashite iru no</span></p><p begin="3:09.680" end="3:17.700" itunes:key="L19" ttm:agent="v1"><span begin="3:09.680" end="3:10.580">あ</span><span begin="3:10.580" end="3:10.880">な</span><span begin="3:10.880" end="3:11.400">た</span><span begin="3:11.700" end="3:12.040">は</span><span begin="3:12.040" end="3:12.860">いっ</span><span begin="3:12.860" end="3:13.140">た</span><span begin="3:13.140" end="3:13.420">い</span><span begin="3:13.660" end="3:14.060">ど</span><span begin="3:14.060" end="3:14.260">こ</span><span begin="3:14.260" end="3:15.460">に</span><span begin="3:15.460" end="3:16.040">い</span><span begin="3:16.040" end="3:16.280">る</span><span begin="3:16.280" end="3:17.700">の</span><span ttm:role="x-translation">为什么总是无法得知你的所在呢</span><span ttm:role="x-roman">anata wa ittai doko ni iru no</span></p><p begin="3:18.220" end="3:20.940" itunes:key="L20" ttm:agent="v1"><span begin="3:18.220" end="3:18.470">ね</span><span begin="3:18.470" end="3:18.740">ぇ、</span><span tts:ruby="container"><span tts:ruby="base">誰</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:18.740" end="3:19.640">だ</span><span tts:ruby="text" begin="3:19.640" end="3:19.960">れ</span></span></span><span begin="3:19.960" end="3:20.940">か…</span><span ttm:role="x-translation">呐，谁能…</span><span ttm:role="x-roman">nē, dareka…</span></p><p begin="3:21.740" end="3:25.440" itunes:key="L21" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">教</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:21.740" end="3:22.340">お</span><span tts:ruby="text" begin="3:22.340" end="3:22.900">し</span></span></span><span begin="3:22.900" end="3:23.220">え</span><span begin="3:23.220" end="3:25.440">て…</span><span ttm:role="x-translation">回答我…</span><span ttm:role="x-roman">oshiete…</span></p><p begin="3:31.980" end="3:40.700" itunes:key="L22" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">四</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:31.980" end="3:32.320">し</span></span></span><span tts:ruby="container"><span tts:ruby="base">季</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:32.320" end="3:32.620">き</span></span></span><span begin="3:32.620" end="3:33.140">は</span><span tts:ruby="container"><span tts:ruby="base">移</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:33.140" end="3:33.400">う</span><span tts:ruby="text" begin="3:33.400" end="3:33.740">つ</span></span></span><span begin="3:33.740" end="3:34.040">ろ</span><span begin="3:34.040" end="3:34.320">い</span><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:34.600" end="3:35.440">か</span></span></span><span begin="3:35.440" end="3:35.760">わ</span><span begin="3:35.760" end="3:36.060">れ</span><span begin="3:36.060" end="3:36.340">ど</span><span begin="3:36.340" end="3:36.680">も</span><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:36.880" end="3:37.740">か</span></span></span><span begin="3:37.740" end="3:38.300">わ</span><span begin="3:38.300" end="3:38.580">ら</span><span begin="3:38.580" end="3:38.800">ぬ</span><span begin="3:38.800" end="3:39.160">も</span><span begin="3:39.160" end="3:39.700">の</span><span tts:ruby="container"><span tts:ruby="base">一</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:39.700" end="3:40.000">ひ</span><span tts:ruby="text" begin="3:40.000" end="3:40.280">と</span></span></span><span begin="3:40.280" end="3:40.700">つ</span><span ttm:role="x-translation">任由四季更替 轮转往复 有份事物却依然如故</span><span ttm:role="x-roman">shiki wa utsuroi kawaredomo kawaranu mono hitotsu</span></p><p begin="3:41.200" end="3:50.600" itunes:key="L23" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">幾</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:41.200" end="3:41.500">い</span><span tts:ruby="text" begin="3:41.500" end="3:41.760">く</span></span></span><span tts:ruby="container"><span tts:ruby="base">年</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:41.760" end="3:41.980">と</span><span tts:ruby="text" begin="3:41.980" end="3:42.293">し</span></span></span><span begin="3:42.293" end="3:42.600">も</span><span tts:ruby="container"><span tts:ruby="base">抱</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:42.600" end="3:42.880">い</span><span tts:ruby="text" begin="3:42.880" end="3:43.180">だ</span></span></span><span begin="3:43.180" end="3:43.460">き</span><span tts:ruby="container"><span tts:ruby="base">続</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:43.700" end="3:44.320">つ</span><span tts:ruby="text" begin="3:44.320" end="3:44.580">づ</span></span></span><span begin="3:44.580" end="3:44.880">け</span><span begin="3:44.880" end="3:45.180">た</span><span begin="3:45.180" end="3:45.440">も</span><span begin="3:45.440" end="3:45.720">の</span><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:46.000" end="3:46.880">こ</span><span tts:ruby="text" begin="3:46.880" end="3:47.180">こ</span><span tts:ruby="text" begin="3:47.180" end="3:47.460">ろ</span></span></span><span begin="3:47.460" end="3:47.740">の</span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:47.740" end="3:48.040">な</span><span tts:ruby="text" begin="3:48.040" end="3:48.300">か</span></span></span><span begin="3:48.300" end="3:50.600">に</span><span ttm:role="x-translation">因为累月经年 我早已经 将它埋在心底</span><span ttm:role="x-roman">ikutoshi mo idakitsuzuketa mono kokoro no naka ni</span></p><p begin="3:52.600" end="4:01.300" itunes:key="L24" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">幾</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:52.600" end="3:52.900">い</span><span tts:ruby="text" begin="3:52.900" end="3:53.160">く</span></span></span><span tts:ruby="container"><span tts:ruby="base">度</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:53.160" end="3:53.460">た</span><span tts:ruby="text" begin="3:53.460" end="3:53.740">び</span></span></span><span begin="3:53.740" end="3:53.980">と</span><span tts:ruby="container"><span tts:ruby="base">呼</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:53.980" end="3:54.300">よ</span></span></span><span begin="3:54.300" end="3:54.580">べ</span><span begin="3:54.580" end="3:54.880">ど</span><span tts:ruby="container"><span tts:ruby="base">終</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:55.140" end="3:55.740">つ</span><span tts:ruby="text" begin="3:55.740" end="3:56.043">い</span></span></span><span begin="3:56.043" end="3:56.280">ぞ</span><span tts:ruby="container"><span tts:ruby="base">届</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:56.280" end="3:56.600">と</span><span tts:ruby="text" begin="3:56.600" end="3:56.900">ど</span></span></span><span begin="3:56.900" end="3:57.440">か</span><span begin="3:57.440" end="3:58.200">ぬ</span><span begin="3:58.200" end="3:58.600">こ</span><span begin="3:58.600" end="3:58.860">の</span><span tts:ruby="container"><span tts:ruby="base">儚</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:58.860" end="3:59.140">は</span><span tts:ruby="text" begin="3:59.140" end="3:59.460">か</span><span tts:ruby="text" begin="3:59.460" end="3:59.740">な</span></span></span><span begin="3:59.740" end="4:00.280">き</span><span tts:ruby="container"><span tts:ruby="base">声</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:00.280" end="4:00.580">こ</span><span tts:ruby="text" begin="4:00.580" end="4:00.900">え</span></span></span><span begin="4:00.900" end="4:01.300">は</span><span ttm:role="x-translation">这飘渺的心声 几度地呼喊 但却依然无法传达</span><span ttm:role="x-roman">ikutabi to yobedo tsuizo todokanu kono hakanaki koe wa</span></p><p begin="4:01.680" end="4:11.600" itunes:key="L25" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">宛</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:01.680" end="4:02.020">さ</span><span tts:ruby="text" begin="4:02.020" end="4:02.410">な</span><span tts:ruby="text" begin="4:02.410" end="4:02.760">が</span></span></span><span begin="4:02.760" end="4:03.140">ら</span><span tts:ruby="container"><span tts:ruby="base">詠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:03.140" end="4:03.460">よ</span></span></span><span begin="4:03.460" end="4:03.800">み</span><span tts:ruby="container"><span tts:ruby="base">人</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:03.800" end="4:04.280">ひ</span><span tts:ruby="text" begin="4:04.280" end="4:05.080">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">知</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:05.080" end="4:05.460">し</span></span></span><span begin="4:05.460" end="4:05.700">ら</span><span begin="4:05.700" end="4:06.040">ず</span><span begin="4:06.040" end="4:06.380">の</span><span tts:ruby="container"><span tts:ruby="base">歌</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:06.600" end="4:07.460">う</span><span tts:ruby="text" begin="4:07.460" end="4:07.720">た</span></span></span><span begin="4:07.720" end="4:08.000">の</span><span begin="4:08.000" end="4:08.340">よ</span><span begin="4:08.340" end="4:08.880">う</span><span begin="4:08.880" end="4:09.460">に</span><span tts:ruby="container"><span tts:ruby="base">響</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:09.460" end="4:09.720">ひ</span><span tts:ruby="text" begin="4:09.720" end="4:10.020">び</span></span></span><span begin="4:10.020" end="4:11.600">く</span><span ttm:role="x-translation">宛若无人知晓 失落的歌谣 孤单地在世间回响</span><span ttm:role="x-roman">sanagara yomihito shirazu no uta no yō ni hibiku</span></p><p begin="4:12.880" end="4:18.319" itunes:key="L26" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">魔</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:12.880" end="4:13.160">ま</span></span></span><span begin="4:13.160" end="4:13.440">を</span><span tts:ruby="container"><span tts:ruby="base">封</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:13.440" end="4:13.730">ふ</span><span tts:ruby="text" begin="4:13.730" end="4:14.020">う</span></span></span><span begin="4:14.020" end="4:14.320">じ</span> <span begin="4:14.580" end="4:14.880">あ</span><span begin="4:14.880" end="4:15.140">の</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:15.140" end="4:15.610">ひ</span></span></span> <span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:15.740" end="4:16.000">で</span></span></span><span tts:ruby="container"><span tts:ruby="base">会</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:16.000" end="4:16.340">あ</span></span></span><span begin="4:16.340" end="4:16.600">い</span><span begin="4:16.600" end="4:16.900">は</span><span tts:ruby="container"><span tts:ruby="base">唐</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:16.900" end="4:17.150">と</span><span tts:ruby="text" begin="4:17.150" end="4:17.400">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">突</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:17.400" end="4:17.720">と</span><span tts:ruby="text" begin="4:17.720" end="4:18.020">つ</span></span></span><span begin="4:18.020" end="4:18.319">に</span><span ttm:role="x-translation">封尽妖魔 那一日的相遇是如此的突然</span><span ttm:role="x-roman">ma o fūji. ano hi, deai wa tōtotsu ni.</span></p><p begin="4:18.350" end="4:22.899" itunes:key="L27" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:18.350" end="4:18.630">ゆ</span><span tts:ruby="text" begin="4:18.630" end="4:19.183">め</span></span></span><span begin="4:19.183" end="4:19.480">の</span><span tts:ruby="container"><span tts:ruby="base">時</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:19.480" end="4:19.720">と</span><span tts:ruby="text" begin="4:19.720" end="4:20.020">き</span></span></span> <span tts:ruby="container"><span tts:ruby="base">本</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:20.300" end="4:20.620">ほ</span><span tts:ruby="text" begin="4:20.620" end="4:20.880">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">当</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:20.880" end="4:21.010">と</span><span tts:ruby="text" begin="4:21.010" end="4:21.140">う</span></span></span><span begin="4:21.140" end="4:21.460">に</span><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:21.460" end="4:21.740">ゆ</span><span tts:ruby="text" begin="4:21.740" end="4:22.020">め</span></span></span><span begin="4:22.020" end="4:22.280">の</span><span begin="4:22.280" end="4:22.560">よ</span><span begin="4:22.560" end="4:22.899">う</span><span ttm:role="x-translation">梦起之时 真的就如在梦中一般</span><span ttm:role="x-roman">yume no toki. hontō ni yume no yō.</span></p><p begin="4:22.900" end="4:27.159" itunes:key="L28" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">幻</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:22.900" end="4:23.120">げ</span><span tts:ruby="text" begin="4:23.120" end="4:23.480">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">想</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:23.640" end="4:24.040">そ</span><span tts:ruby="text" begin="4:24.040" end="4:24.300">う</span></span></span><span begin="4:24.300" end="4:24.600">は</span> <span begin="4:24.880" end="4:25.160">ど</span><span begin="4:25.160" end="4:25.460">こ</span><span begin="4:25.460" end="4:25.740">ま</span><span begin="4:25.740" end="4:26.020">で</span><span begin="4:26.020" end="4:26.280">も</span><span tts:ruby="container"><span tts:ruby="base">続</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:26.280" end="4:26.600">つ</span><span tts:ruby="text" begin="4:26.600" end="4:26.860">づ</span></span></span><span begin="4:26.860" end="4:27.159">く</span><span ttm:role="x-translation">幻想之乡 正在无边无际地延展</span><span ttm:role="x-roman">gensō wa. doko made mo tsuzuku.</span></p><p begin="4:27.160" end="4:31.139" itunes:key="L29" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">怪</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:27.160" end="4:27.460">か</span><span tts:ruby="text" begin="4:27.460" end="4:27.740">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">奇</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:27.740" end="4:28.100">き</span></span></span><span begin="4:28.300" end="4:28.579">の</span> <span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:28.580" end="4:28.900">て</span></span></span><span begin="4:28.900" end="4:29.240">に</span><span begin="4:29.440" end="4:29.760">か</span><span begin="4:29.760" end="4:30.040">か</span><span begin="4:30.040" end="4:30.300">る</span><span tts:ruby="container"><span tts:ruby="base">様</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:30.300" end="4:30.580">よ</span><span tts:ruby="text" begin="4:30.580" end="4:30.880">う</span></span></span><span begin="4:30.880" end="4:31.139">で</span><span ttm:role="x-translation">怪奇相谈 仿佛牵着手一样</span><span ttm:role="x-roman">kaiki no. te ni kakaru yō de.</span></p><p begin="4:31.140" end="4:36.619" itunes:key="L30" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">紅</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:31.140" end="4:31.460">あ</span><span tts:ruby="text" begin="4:31.460" end="4:31.720">か</span></span></span><span begin="4:31.720" end="4:32.020">き</span><span tts:ruby="container"><span tts:ruby="base">運</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:32.020" end="4:32.400">う</span><span tts:ruby="text" begin="4:32.400" end="4:32.880">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">命</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:32.880" end="4:33.180">め</span><span tts:ruby="text" begin="4:33.180" end="4:33.460">い</span></span></span><span begin="4:33.460" end="4:33.840">は</span> <span begin="4:33.980" end="4:34.600">二</span><span begin="4:34.600" end="4:34.900">人</span><span begin="4:34.900" end="4:35.160">を</span><span tts:ruby="container"><span tts:ruby="base">定</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:35.160" end="4:35.460">さ</span><span tts:ruby="text" begin="4:35.460" end="4:35.720">だ</span></span></span><span begin="4:35.720" end="4:36.020">む</span><span begin="4:36.020" end="4:36.280">の</span><span begin="4:36.280" end="4:36.619">か</span><span ttm:role="x-translation">暗红命运 可是为你我写下定数</span><span ttm:role="x-roman">akaki unmei wa. futari o sadamu no ka.</span></p><p begin="4:36.620" end="4:41.179" itunes:key="L31" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">妖</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:36.620" end="4:36.900">あ</span><span tts:ruby="text" begin="4:36.900" end="4:37.380">や</span></span></span><span begin="4:37.380" end="4:37.740">し</span><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:37.740" end="4:38.020">ゆ</span><span tts:ruby="text" begin="4:38.020" end="4:38.619">め</span></span></span> <span tts:ruby="container"><span tts:ruby="base">幻</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:38.620" end="4:38.900">ま</span><span tts:ruby="text" begin="4:38.900" end="4:39.160">ぼ</span><span tts:ruby="text" begin="4:39.160" end="4:39.420">ろ</span><span tts:ruby="text" begin="4:39.420" end="4:39.720">し</span></span></span><span begin="4:39.720" end="4:40.020">を</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:40.020" end="4:40.240">み</span></span></span><span begin="4:40.240" end="4:40.580">せ</span><span begin="4:40.580" end="4:40.880">る</span><span begin="4:40.880" end="4:41.179">か</span><span ttm:role="x-translation">妖妖之梦 是否真的看见了幻想</span><span ttm:role="x-roman">ayashi yume. maboroshi o miseru ka.</span></p><p begin="4:41.180" end="4:45.719" itunes:key="L32" ttm:agent="v1"><span begin="4:41.180" end="4:41.440">永</span><span begin="4:41.440" end="4:41.780">久</span><span begin="4:42.053" end="4:42.280">の</span><span tts:ruby="container"><span tts:ruby="base">夜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:42.280" end="4:42.580">よ</span><span tts:ruby="text" begin="4:42.580" end="4:42.880">る</span></span></span> <span begin="4:43.160" end="4:43.460">何</span><span begin="4:43.460" end="4:43.740">処</span><span begin="4:43.740" end="4:44.020">ま</span><span begin="4:44.020" end="4:44.280">で</span><span tts:ruby="container"><span tts:ruby="base">続</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:44.280" end="4:44.620">つ</span><span tts:ruby="text" begin="4:44.620" end="4:44.840">づ</span></span></span><span begin="4:44.840" end="4:45.160">く</span><span begin="4:45.160" end="4:45.420">の</span><span begin="4:45.420" end="4:45.719">か</span><span ttm:role="x-translation">永久之夜 不知将会持续到何时</span><span ttm:role="x-roman">towa no yoru. doko made tsuzuku no ka.</span></p><p begin="4:45.720" end="4:49.623" itunes:key="L33" ttm:agent="v1"><span begin="4:45.720" end="4:45.960">そ</span><span begin="4:45.960" end="4:46.320">し</span><span begin="4:46.580" end="4:46.860">て</span><span tts:ruby="container"><span tts:ruby="base">春</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:46.860" end="4:47.180">は</span><span tts:ruby="text" begin="4:47.180" end="4:47.480">る</span></span></span><span begin="4:47.740" end="4:48.040">は</span><span begin="4:48.040" end="4:48.300">ま</span><span begin="4:48.300" end="4:48.620">た</span><span tts:ruby="container"><span tts:ruby="base">巡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:48.620" end="4:48.900">め</span><span tts:ruby="text" begin="4:48.900" end="4:49.180">ぐ</span></span></span><span begin="4:49.180" end="4:49.623">る</span><span ttm:role="x-translation">之后春天又再次来临</span><span ttm:role="x-roman">soshite haru wa mata meguru.</span></p><p begin="4:49.623" end="4:56.520" itunes:key="L34" ttm:agent="v1"><span begin="4:49.623" end="4:50.020">そ</span><span begin="4:50.020" end="4:50.340">れ</span><span begin="4:50.340" end="4:51.160">で</span><span begin="4:51.160" end="4:51.440">も</span><span begin="4:51.440" end="4:52.020">あ</span><span begin="4:52.020" end="4:52.580">な</span><span begin="4:52.580" end="4:53.440">た</span><span begin="4:53.440" end="4:53.760">は</span><span tts:ruby="container"><span tts:ruby="base">遠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:53.760" end="4:54.340">と</span><span tts:ruby="text" begin="4:54.340" end="4:54.840">お</span></span></span><span begin="4:54.840" end="4:56.520">い…</span><span ttm:role="x-translation">然而你却是如此遥不可及…</span><span ttm:role="x-roman">soredemo anata wa tōi…</span></p><p begin="4:58.820" end="5:01.160" itunes:key="L35" ttm:agent="v1"><span begin="4:58.820" end="4:59.160">ね</span><span begin="4:59.160" end="4:59.480">ぇ、</span><span begin="4:59.480" end="4:59.850">ど</span><span begin="4:59.850" end="5:00.220">う</span><span begin="5:00.220" end="5:00.600">し</span><span begin="5:00.600" end="5:01.160">て</span><span ttm:role="x-translation">呐，请告诉我</span><span ttm:role="x-roman">nē, dōshite</span></p><p begin="5:01.420" end="5:08.200" itunes:key="L36" ttm:agent="v1"><span begin="5:01.420" end="5:01.740">あ</span><span begin="5:01.740" end="5:02.600">な</span><span begin="5:02.600" end="5:02.920">た</span><span begin="5:02.920" end="5:03.440">は</span><span tts:ruby="container"><span tts:ruby="base">私</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:03.700" end="5:04.040">わ</span><span tts:ruby="text" begin="5:04.040" end="5:04.483">た</span><span tts:ruby="text" begin="5:04.483" end="5:04.900">し</span></span></span><span begin="5:04.900" end="5:05.420">を</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:05.420" end="5:05.720">み</span></span></span><span begin="5:05.720" end="5:06.020">て</span><span begin="5:06.020" end="5:06.320">く</span><span begin="5:06.320" end="5:06.600">れ</span><span begin="5:06.600" end="5:07.160">な</span><span begin="5:07.160" end="5:07.740">い</span><span begin="5:07.740" end="5:08.200">の</span><span ttm:role="x-translation">到底为何 你的眼中没有我的存在呢</span><span ttm:role="x-roman">anata wa watashi o mite kurenai no</span></p><p begin="5:08.560" end="5:16.540" itunes:key="L37" ttm:agent="v1"><span begin="5:08.560" end="5:09.420">あ</span><span begin="5:09.420" end="5:09.740">な</span><span begin="5:09.740" end="5:10.300">た</span><span begin="5:10.520" end="5:10.880">は</span><span tts:ruby="container"><span tts:ruby="base">誰</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:10.880" end="5:11.720">だ</span><span tts:ruby="text" begin="5:11.720" end="5:11.960">れ</span></span></span><span begin="5:11.960" end="5:12.320">を</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:12.530" end="5:13.203">み</span></span></span><span begin="5:13.203" end="5:14.220">て</span><span begin="5:14.323" end="5:14.920">い</span><span begin="5:14.920" end="5:15.180">る</span><span begin="5:15.180" end="5:16.540">の</span><span ttm:role="x-translation">在你的视线彼端的身影又是什么</span><span ttm:role="x-roman">anata wa dare o mite iru no</span></p><p begin="5:17.150" end="5:19.380" itunes:key="L38" ttm:agent="v1"><span begin="5:17.150" end="5:17.803">ねぇ</span> <span begin="5:17.803" end="5:18.060">ど</span><span begin="5:18.060" end="5:18.500">う</span><span begin="5:18.500" end="5:18.860">し</span><span begin="5:18.860" end="5:19.380">て</span><span ttm:role="x-translation">呐，请告诉我</span><span ttm:role="x-roman">nē, dōshite</span></p><p begin="5:19.700" end="5:26.480" itunes:key="L39" ttm:agent="v1"><span begin="5:19.700" end="5:20.020">あ</span><span begin="5:20.020" end="5:20.880">な</span><span begin="5:20.880" end="5:21.160">た</span><span begin="5:21.160" end="5:21.680">は</span><span begin="5:22.000" end="5:22.280">い</span><span begin="5:22.280" end="5:22.880">つ</span><span begin="5:22.880" end="5:23.160">で</span><span begin="5:23.160" end="5:23.660">も</span><span tts:ruby="container"><span tts:ruby="base">探</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:23.660" end="5:24.020">さ</span><span tts:ruby="text" begin="5:24.020" end="5:24.260">が</span></span></span><span begin="5:24.260" end="5:24.560">し</span><span begin="5:24.560" end="5:24.880">て</span><span begin="5:24.880" end="5:25.460">い</span><span begin="5:25.460" end="5:26.020">る</span><span begin="5:26.020" end="5:26.480">の</span><span ttm:role="x-translation">无时无刻不在追寻你的身影的我</span><span ttm:role="x-roman">anata wa itsudemo sagashite iru no</span></p><p begin="5:26.820" end="5:34.840" itunes:key="L40" ttm:agent="v1"><span begin="5:26.820" end="5:27.720">あ</span><span begin="5:27.720" end="5:28.040">な</span><span begin="5:28.040" end="5:28.520">た</span><span begin="5:28.860" end="5:29.200">は</span><span begin="5:29.200" end="5:30.063">いっ</span><span begin="5:30.063" end="5:30.330">た</span><span begin="5:30.330" end="5:30.740">い</span><span begin="5:30.860" end="5:31.180">ど</span><span begin="5:31.180" end="5:31.440">こ</span><span begin="5:31.440" end="5:32.260">に</span><span begin="5:32.540" end="5:33.120">い</span><span begin="5:33.120" end="5:33.440">る</span><span begin="5:33.440" end="5:34.840">の</span><span ttm:role="x-translation">为什么总是无法得知你的所在呢</span><span ttm:role="x-roman">anata wa ittai doko ni iru no</span></p><p begin="5:35.523" end="5:38.300" itunes:key="L41" ttm:agent="v1"><span begin="5:35.523" end="5:35.810">ね</span><span begin="5:35.810" end="5:36.073">ぇ、</span><span tts:ruby="container"><span tts:ruby="base">誰</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:36.073" end="5:36.860">だ</span><span tts:ruby="text" begin="5:36.860" end="5:37.160">れ</span></span></span><span begin="5:37.160" end="5:38.300">か…</span><span ttm:role="x-translation">呐，谁能…</span><span ttm:role="x-roman">nē, dareka…</span></p><p begin="5:38.900" end="5:42.880" itunes:key="L42" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">教</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:38.900" end="5:39.320">お</span><span tts:ruby="text" begin="5:39.320" end="5:40.020">し</span></span></span><span begin="5:40.020" end="5:40.380">え</span><span begin="5:40.380" end="5:42.880">て…</span><span ttm:role="x-translation">回答我…</span><span ttm:role="x-roman">oshiete…</span></p></div></body></tt>