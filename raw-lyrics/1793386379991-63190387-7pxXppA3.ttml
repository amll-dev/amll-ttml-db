1:02.204">feel</span> <span begin="1:02.204" end="1:02.531">like</span> <span begin="1:02.750" end="1:03.309">oh</span> <span begin="1:03.309" end="1:03.911">oh</span> <span begin="1:03.911" end="1:04.462">oh</span> <span begin="1:04.462" end="1:05.183">oh</span></p><p begin="1:05.356" end="1:07.209" itunes:key="L15" ttm:agent="v3"><span tts:ruby="container"><span tts:ruby="base">夜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:05.356" end="1:05.594">よ</span><span tts:ruby="text" begin="1:05.594" end="1:05.693">る</span></span></span><span begin="1:05.693" end="1:05.868">に</span><span begin="1:05.868" end="1:06.100">な</span><span begin="1:06.100" end="1:06.209">って</span><span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:06.209" end="1:06.429">お</span><span tts:ruby="text" begin="1:06.429" end="1:06.719">も</span></span></span><span begin="1:06.719" end="1:06.820">い</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:06.820" end="1:06.972">だ</span></span></span><span begin="1:06.972" end="1:07.131">し</span><span begin="1:07.131" end="1:07.209">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">入夜之后 又回想起来</span></p><p begin="1:07.433" end="1:10.236" itunes:key="L16" ttm:agent="v3"><span begin="1:07.433" end="1:07.443">「</span><span tts:ruby="container"><span tts:ruby="base">呪</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:07.443" end="1:07.667">の</span><span tts:ruby="text" begin="1:07.667" end="1:07.850">ろ</span></span></span><span begin="1:07.850" end="1:07.922">い</span><span tts:ruby="container"><span tts:ruby="base">背</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:07.922" end="1:08.134">せ</span></span></span><span tts:ruby="container"><span tts:ruby="base">負</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:08.134" end="1:08.366">お</span></span></span><span begin="1:08.409" end="1:08.629">った</span><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:08.737" end="1:09.076">ぼ</span><span tts:ruby="text" begin="1:09.076" end="1:09.159">く</span></span></span><span begin="1:09.159" end="1:09.318">た</span><span begin="1:09.318" end="1:09.416">ち</span><span begin="1:09.416" end="1:09.739">は</span><span tts:ruby="container"><span tts:ruby="base">今</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:09.739" end="1:09.975">い</span><span tts:ruby="text" begin="1:09.975" end="1:10.226">ま</span></span></span><span begin="1:10.226" end="1:10.236">」</span><span ttm:role="x-translation" xml:lang="zh-Hans">背负诅咒的我们 如今</span><span ttm:role="x-bg" begin="1:08.735" end="1:10.226">(<span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:08.735" end="1:09.075">ぼ</span><span tts:ruby="text" begin="1:09.075" end="1:09.158">く</span></span></span><span begin="1:09.158" end="1:09.318">た</span><span begin="1:09.318" end="1:09.416">ち</span><span begin="1:09.416" end="1:09.738">は</span><span tts:ruby="container"><span tts:ruby="base">今</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:09.738" end="1:09.974">い</span><span tts:ruby="text" begin="1:09.974" end="1:10.226">ま</span></span></span>)</span></p><p begin="1:10.226" end="1:14.477" itunes:key="L17" ttm:agent="v3"><span begin="1:10.226" end="1:10.859">なん</span><span begin="1:10.859" end="1:11.107">て</span><span tts:ruby="container"><span tts:ruby="base">悲</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:11.153" end="1:11.451">か</span><span tts:ruby="text" begin="1:11.451" end="1:11.573">な</span></span></span><span begin="1:11.573" end="1:12.027">し</span><span begin="1:12.027" end="1:12.604">み</span><span begin="1:12.604" end="1:12.772">が</span><span tts:ruby="container"><span tts:ruby="base">積</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:13.131" end="1:13.398">つ</span><span tts:ruby="text" begin="1:13.398" end="1:13.725">も</span></span></span><span begin="1:13.725" end="1:13.944">った</span><span tts:ruby="container"><span tts:ruby="base">時</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:13.944" end="1:14.170">と</span><span tts:ruby="text" begin="1:14.170" end="1:14.230">き</span></span></span><span begin="1:14.230" end="1:14.477">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">如今即使这样的悲伤堆积起来</span></p><p begin="1:14.477" end="1:16.556" itunes:key="L18" ttm:agent="v3"><span tts:ruby="container"><span tts:ruby="base">朝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:14.477" end="1:14.732">あ</span><span tts:ruby="text" begin="1:14.732" end="1:14.895">さ</span></span></span><span begin="1:14.895" end="1:15.081">に</span><span begin="1:15.081" end="1:15.328">な</span><span begin="1:15.328" end="1:15.456">って</span><span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:15.456" end="1:15.594">お</span><span tts:ruby="text" begin="1:15.594" end="1:15.936">も</span></span></span><span begin="1:15.936" end="1:16.038">い</span><span tts:ruby="container"><span tts:ruby="base">返</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:16.038" end="1:16.230">かえ</span></span></span><span begin="1:16.230" end="1:16.356">し</span><span begin="1:16.356" end="1:16.556">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">天亮之后 又重新想起</span></p><p begin="1:16.635" end="1:19.457" itunes:key="L19" ttm:agent="v3"><span tts:ruby="container"><span tts:ruby="base">希</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:16.635" end="1:16.857">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">望</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:16.944" end="1:17.234">ぼう</span></span></span><span tts:ruby="container"><span tts:ruby="base">纏</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:17.234" end="1:17.410">ま</span><span tts:ruby="text" begin="1:17.410" end="1:17.598">と</span></span></span><span begin="1:17.641" end="1:17.850">った</span><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:17.963" end="1:18.296">ぼ</span><span tts:ruby="text" begin="1:18.296" end="1:18.374">く</span></span></span><span begin="1:18.374" end="1:18.569">た</span><span begin="1:18.569" end="1:18.635">ち</span><span begin="1:18.635" end="1:18.972">は</span><span tts:ruby="container"><span tts:ruby="base">今</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:18.972" end="1:19.223">い</span><span tts:ruby="text" begin="1:19.223" end="1:19.457">ま</span></span></span><span ttm:role="x-translation" xml:lang="zh-Hans">身披希望的我们 如今</span><span ttm:role="x-bg" begin="1:17.963" end="1:19.456">(<span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:17.963" end="1:18.296">ぼ</span><span tts:ruby="text" begin="1:18.296" end="1:18.373">く</span></span></span><span begin="1:18.373" end="1:18.568">た</span><span begin="1:18.568" end="1:18.635">ち</span><span begin="1:18.635" end="1:18.971">は</span><span tts:ruby="container"><span tts:ruby="base">今</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:18.971" end="1:19.223">い</span><span tts:ruby="text" begin="1:19.223" end="1:19.456">ま</span></span></span>)</span></p><p begin="1:19.562" end="1:21.967" itunes:key="L20" ttm:agent="v3"><span tts:ruby="container"><span tts:ruby="base">唯</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:19.562" end="1:19.794">ゆ</span><span tts:ruby="text" begin="1:19.794" end="1:19.891">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">一</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:19.891" end="1:20.026">い</span><span tts:ruby="text" begin="1:20.026" end="1:20.288">つ</span></span></span><span tts:ruby="container"><span tts:ruby="base">無</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:20.288" end="1:20.709">む</span></span></span><span tts:ruby="container"><span tts:ruby="base">二</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:20.709" end="1:20.974">に</span></span></span><span begin="1:20.974" end="1:21.176">の</span><span tts:ruby="container"><span tts:ruby="base">弱</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:21.176" end="1:21.592">じゃ</span><span tts:ruby="text" begin="1:21.592" end="1:21.695">く</span></span></span><span tts:ruby="container"><span tts:ruby="base">者</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:21.695" end="1:21.967">しゃ</span></span></span><span ttm:role="x-translation" xml:lang="zh-Hans">是独一无二的弱者</span></p><p begin="1:22.356" end="1:23.731" itunes:key="L21" ttm:agent="v3"><span tts:ruby="container"><span tts:ruby="base">強</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:22.356" end="1:22.501">つ</span><span tts:ruby="text" begin="1:22.501" end="1:22.677">よ</span></span></span><span tts:ruby="container"><span tts:ruby="base">気</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:22.677" end="1:22.873">き</span></span></span><span begin="1:22.873" end="1:23.125">で</span><span begin="1:23.125" end="1:23.389">いい</span><span begin="1:23.389" end="1:23.625">じゃ</span><span begin="1:23.625" end="1:23.731">ん</span><span ttm:role="x-translation" xml:lang="zh-Hans">自信一点也没什么不好</span></p><p begin="1:23.707" end="1:28.740" itunes:key="L22" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">忘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:23.707" end="1:24.070">わ</span><span tts:ruby="text" begin="1:24.070" end="1:24.420">す</span></span></span><span begin="1:24.420" end="1:24.769">れ</span><span begin="1:24.769" end="1:24.992">る</span><span begin="1:24.992" end="1:25.289">こ</span><span begin="1:25.289" end="1:25.614">と</span><span begin="1:25.614" end="1:25.791">で</span> <span tts:ruby="container"><span tts:ruby="base">流</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:25.791" end="1:26.451">な</span><span tts:ruby="text" begin="1:26.451" end="1:27.002">が</span></span></span><span begin="1:27.002" end="1:27.519">れ</span><span tts:ruby="container"><span tts:ruby="base">着</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:27.519" end="1:27.883">つ</span></span></span><span begin="1:27.883" end="1:28.164">い</span><span begin="1:28.164" end="1:28.740">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">因为有所遗忘 才辗转抵达</span><span ttm:role="x-bg" begin="1:25.787" end="1:28.739">(<span tts:ruby="container"><span tts:ruby="base">流</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:25.787" end="1:26.450">な</span><span tts:ruby="text" begin="1:26.450" end="1:27.002">が</span></span></span><span begin="1:27.002" end="1:27.518">れ</span><span tts:ruby="container"><span tts:ruby="base">着</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:27.518" end="1:27.882">つ</span></span></span><span begin="1:27.882" end="1:28.164">い</span><span begin="1:28.164" end="1:28.739">た))</span></span></p><p begin="1:28.790" end="1:33.092" itunes:key="L23" ttm:agent="v1"><span begin="1:28.790" end="1:28.975">な</span><span begin="1:28.975" end="1:29.102">に</span><span begin="1:29.102" end="1:29.267">よ</span><span begin="1:29.267" end="1:29.441">り</span><span begin="1:29.441" end="1:29.884">も</span><span begin="1:29.884" end="1:30.198">ほん</span><span begin="1:30.198" end="1:30.508">と</span><span begin="1:30.508" end="1:30.773">に</span><span tts:ruby="container"><span tts:ruby="base">大</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:30.773" end="1:31.093">た</span><span tts:ruby="text" begin="1:31.093" end="1:31.239">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">切</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:31.239" end="1:31.581">せ</span><span tts:ruby="text" begin="1:31.581" end="1:32.202">つ</span></span></span><span begin="1:32.202" end="1:32.499">な</span><span begin="1:32.499" end="1:32.807">こ</span><span begin="1:32.807" end="1:33.092">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">那些比什么都更重要的事</span></p><p begin="1:33.092" end="1:37.951" itunes:key="L24" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">離</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:33.092" end="1:33.331">は</span><span tts:ruby="text" begin="1:33.331" end="1:33.678">な</span></span></span><span begin="1:33.678" end="1:33.970">れ</span><span begin="1:33.970" end="1:34.222">る</span><span begin="1:34.222" end="1:34.543">た</span><span begin="1:34.543" end="1:34.753">び</span><span begin="1:34.753" end="1:35.001">に</span> <span tts:ruby="container"><span tts:ruby="base">流</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:35.001" end="1:35.672">な</span><span tts:ruby="text" begin="1:35.672" end="1:36.293">が</span></span></span><span begin="1:36.293" end="1:36.757">れ</span><span tts:ruby="container"><span tts:ruby="base">着</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:36.757" end="1:37.167">つ</span></span></span><span begin="1:37.167" end="1:37.382">い</span><span begin="1:37.382" end="1:37.951">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">每一次离别 都让我辗转抵达</span><span ttm:role="x-bg" begin="1:34.999" end="1:37.950">(<span tts:ruby="container"><span tts:ruby="base">流</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:34.999" end="1:35.671">な</span><span tts:ruby="text" begin="1:35.671" end="1:36.293">が</span></span></span><span begin="1:36.293" end="1:36.756">れ</span><span tts:ruby="container"><span tts:ruby="base">着</span><span tts:ruby="textContainer"><spa