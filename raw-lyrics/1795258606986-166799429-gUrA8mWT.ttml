.305" end="5.666">が</span></span></span><span begin="5.666" end="5.934">い</span><span tts:ruby="container"><span tts:ruby="base">叶</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5.934" end="6.157">か</span><span tts:ruby="text" begin="6.157" end="6.352">な</span></span></span><span begin="6.352" end="6.724">え</span><span begin="6.724" end="7.352">て</span><span ttm:role="x-translation" xml:lang="zh-CN">用永恒实现那唯一的希望</span></p><p begin="7.818" end="15.545" itunes:key="L2" ttm:agent="v1"><span begin="7.818" end="8.562">い</span><span begin="8.562" end="8.970">つ</span><span begin="8.970" end="9.258">か</span><span tts:ruby="container"><span tts:ruby="base">未</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="9.258" end="9.454">み</span></span></span><span tts:ruby="container"><span tts:ruby="base">来</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="9.454" end="10.008">ら</span><span tts:ruby="text" begin="10.008" end="10.169">い</span></span></span><span begin="10.169" end="10.675">を</span><span tts:ruby="container"><span tts:ruby="base">胸</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="11.109" end="11.928">む</span><span tts:ruby="text" begin="11.928" end="12.147">ね</span></span></span><span begin="12.147" end="12.372">に</span><span tts:ruby="container"><span tts:ruby="base">抱</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="12.372" end="12.534">だ</span></span></span><span begin="12.534" end="12.686">き</span><span begin="12.686" end="13.405">し</span><span begin="13.405" end="13.606">め</span><span begin="13.606" end="15.545">て</span><span ttm:role="x-translation" xml:lang="zh-CN">心中收束未知明天的方向</span></p><p begin="13.698" end="27.430" itunes:key="L3" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">闇</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="16.108" end="17.426">や</span><span tts:ruby="text" begin="18.198" end="18.574">み</span></span></span><span begin="18.574" end="18.974">の</span><span tts:ruby="container"><span tts:ruby="base">向</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="18.974" end="19.395">む</span></span></span><span begin="19.395" end="20.000">こ</span><span begin="20.000" end="20.229">う</span><span begin="20.229" end="21.060">に</span><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="21.819" end="22.279">き</span></span></span><span begin="22.279" end="22.718">え</span><span begin="22.718" end="23.693">る</span><span begin="23.961" end="24.358">あ</span><span begin="24.358" end="24.761">な</span><span begin="24.761" end="25.191">た</span><span begin="25.191" end="25.551">の</span><span tts:ruby="container"><span tts:ruby="base">声</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="25.551" end="26.042">こ</span><span tts:ruby="text" begin="26.042" end="27.430">え</span></span></span><span ttm:role="x-translation" xml:lang="zh-CN">你的声音消逝在黑暗的远方</span></p><p begin="28.950" end="45.874" itunes:key="L4" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">腕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="28.950" end="29.351">う</span><span tts:ruby="text" begin="29.351" end="30.545">で</span></span></span><span tts:ruby="container"><span tts:ruby="base">伸</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="31.441" end="31.812">の</span></span></span><span begin="31.812" end="32.156">ば</span><span begin="32.156" end="32.622">し</span><span begin="32.622" end="33.186">た</span><span begin="33.186" end="33.469">け</span><span begin="33.469" end="34.338">ど</span><span tts:ruby="container"><span tts:ruby="base">届</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="35.098" end="35.539">と</span><span tts:ruby="text" begin="35.539" end="35.936">ど</span></span></span><span begin="35.936" end="36.565">か</span><span begin="36.565" end="36.749">な</span><span begin="36.749" end="38.390">い</span><span tts:ruby="container"><span tts:ruby="base">影</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="38.390" end="38.811">か</span><span tts:ruby="text" begin="38.811" end="39.263">げ</span></span></span><span begin="39.263" end="39.647">を</span><span tts:ruby="container"><span tts:ruby="base">追</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="39.647" end="40.893">お</span></span></span><span begin="40.893" end="42.538">い</span><span begin="42.538" end="44.210">か</span><span begin="44.210" end="45.874">け</span><span ttm:role="x-translation" xml:lang="zh-CN">伸手也摸不到那飘忽的影像</span></p><p begin="48.355" end="55.359" itunes:key="L5" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">走</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="48.355" end="48.711">は</span><span tts:ruby="text" begin="48.711" end="49.223">し</span></span></span><span begin="49.223" end="50.018">り</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="50.018" end="50.260">だ</span></span></span><span begin="50.260" end="50.536">す</span><span tts:ruby="container"><span tts:ruby="base">世</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="50.536" end="50.801">せ</span></span></span><span tts:ruby="container"><span tts:ruby="base">界</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="50.801" end="51.384">か</span><span tts:ruby="text" begin="51.384" end="51.668">い</span></span></span><span begin="51.668" end="52.075">が</span><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="52.294" end="52.403">こ</span><span tts:ruby="text" begin="52.403" end="52.506">こ</span><span tts:ruby="text" begin="52.506" end="53.066">ろ</span></span></span><span tts:ruby="container"><span tts:ruby="base">傷</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="53.328" end="53.617">き</span><span tts:ruby="text" begin="53.617" end="53.834">ず</span></span></span><span begin="53.834" end="54.138">つ</span><span begin="54.138" end="54.462">け</span><span begin="54.462" end="54.797">て</span><span begin="54.797" end="55.359">も</span><span ttm:role="x-translation" xml:lang="zh-CN">就算心灵被飞转的世界所伤</span></p><p begin="55.804" end="1:01.913" itunes:key="L6" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">握</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="55.804" end="56.636">に</span><span tts:ruby="text" begin="56.636" end="56.953">ぎ</span></span></span><span begin="56.953" end="57.187">る</span><span begin="57.187" end="57.439">そ</span><span begin="57.439" end="58.088">の</span><span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="58.088" end="58.311">て</span></span></span><span begin="58.311" end="58.734">を</span><span tts:ruby="container"><span tts:ruby="base">離</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="59.117" end="59.887">は</span><span tts:ruby="text" begin="59.887" end="1:00.103">な</span></span></span><span begin="1:00.103" end="1:00.348">さ</span><span begin="1:00.348" end="1:00.513">な</span><span begin="1:00.513" end="1:00.773">い</span><span begin="1:00.773" end="1:01.330">で</span><span begin="1:01.330" end="1:01.597">い</span><span begin="1:01.597" end="1:01.913">て</span><span ttm:role="x-translation" xml:lang="zh-CN">紧握的双手是不放弃的希望</span></p><p begin="1:02.211" end="1:08.476" itunes:key="L7" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">果</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:02.211" end="1:02.438">は</span></span></span><span begin="1:02.438" end="1:03.095">て</span><span begin="1:03.095" end="1:03.561">し</span><span begin="1:03.561" end="1:03.864">な</span><span begin="1:03.864" end="1:04.035">く</span><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:04.035" end="1:04.725">そ</span><span tts:ruby="text" begin="1:04.725" end="1:04.922">ら</span></span></span><span begin="1:04.922" end="1:05.545">へ</span><span tts:ruby="container"><span tts:ruby="base">鳴</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:05.545" end="1:05.652">な</span></span></span><span begin="1:05.652" end="1:05.752">り</span><span tts:ruby="container"><span tts:ruby="base">響</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:05.752" end="1:06.546">ひ</span><span tts:ruby="text" begin="1:06.546" end="1:06.906">び</span></span></span><span begin="1:06.906" end="1:07.159">け</span><span begin="1:07.159" end="1:07.261">こ</span><span begin="1:07.261" end="1:07.370">の</span><span tts:ruby="container"><span tts:ruby="base">メロディ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:07.370" end="1:08.476">Melody</span></span></span><span ttm:role="x-translation" xml:lang="zh-CN">响彻在无尽苍穹的旋律</span></p><p begin="1:08.904" end="1:20.210" itunes:key="L8" ttm:agent="v1"><span begin="1:08.904" end="1:09.049">あ</span><span begin="1:09.049" end="1:09.881">ふ</span><span begin="1:09.881" end="1:10.231">れ</span><span begin="1:10.231" end="1:10.496">る</span><span tts:ruby="container"><span tts:ruby="base">涙</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:10.496" end="1:10.722">な</span><span tts:ruby="text" begin="1:10.722" end="1:11.337">み</span><span tts:ruby="text" begin="1:11.337" end="1:11.562">だ</span></span></span><span begin="1:11.562" end="1:12.352">を</span><span tts:ruby="container"><span tts:ruby="base">忘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:12.352" end="1:13.968">わ</span><span tts:ruby="text" begin="1:13.968" end="1:14.427">す</span></span></span><span begin="1:14.427" end="1:14.849">れ</span><span begin="1:14.849" end="1:15.185">は</span><span begin="1:15.185" end="1:15.658">し</span><span begin="1:15.658" end="1:16.110">な</span><span begin="1:16.110" end="1:16.506">い</span><span begin="1:16.506" end="1:20.210">わ</span><span ttm:role="x-translation" xml:lang="zh-CN">不要忘记这满溢的泪水</span></p></div></body></tt>