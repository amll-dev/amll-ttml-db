r="L6">takanaru mune no kodou furi kiru gauge</text><text for="L7">afureru namida wo kechirase</text><text for="L8">yume tsukan de</text><text for="L9">kotoba ni nara nai kinou ni wa kokoro kakushi te ru</text><text for="L10">nakushi ta ito tori kaesu no wa</text><text for="L11">kire ta ido tsunagu you</text><text for="L12">kie ta oto wo tsumu gu</text><text for="L13">yuuki wo yuri okosu</text><text for="L14">wasure taku nai omoi futari no memory</text><text for="L15">anata to tsukuru mirai oboete i te</text><text for="L16">kibou ni hikaru tsubasa mitsuke dasu kara kitto</text><text for="L17">itsuka atarashii sekai ni habatakeru no</text></transliteration></transliterations><songwriters><songwriter>天門</songwriter><songwriter>Tenmon</songwriter><songwriter>酒井伸和</songwriter><songwriter>Nobukazu Sakai</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:48.398"><div begin="14.001" end="3:48.398"><p begin="14.001" end="25.992" itunes:key="L1" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="14.001" end="14.210">ゆ</span><span tts:ruby="text" begin="14.210" end="14.549">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">闇</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="14.549" end="15.150">や</span><span tts:ruby="text" begin="15.150" end="15.473">み</span></span></span><span tts:ruby="container"><span tts:ruby="base">迫</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="15.473" end="16.107">せ</span><span tts:ruby="text" begin="16.107" end="16.732">ま</span></span></span><span begin="16.732" end="17.194">る</span><span tts:ruby="container"><span tts:ruby="base">街</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="17.194" end="17.929">ま</span><span tts:ruby="text" begin="17.929" end="18.108">ち</span></span></span><span begin="18.108" end="18.364">の</span><span tts:ruby="container"><span tts:ruby="base">景</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="18.364" end="18.521">け</span></span></span><span tts:ruby="container"><span tts:ruby="base">色</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="18.521" end="18.984">し</span><span tts:ruby="text" begin="18.984" end="19.188">き</span></span></span><span begin="19.188" end="19.912">に</span> <span tts:ruby="container"><span tts:ruby="base">佇</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="20.392" end="20.990">た</span><span tts:ruby="text" begin="20.990" end="21.480">た</span><span tts:ruby="text" begin="21.480" end="21.968">ず</span></span></span><span begin="21.968" end="22.527">む</span><span tts:ruby="container"><span tts:ruby="base">独</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="22.527" end="23.178">ひ</span><span tts:ruby="text" begin="23.178" end="23.587">と</span></span></span><span begin="23.587" end="24.241">り</span><span begin="24.241" end="25.992">で</span><span ttm:role="x-translation" xml:lang="zh-CN">独自一人寄身于夜暗来袭的大街晚景里</span></p><p begin="26.776" end="32.681" itunes:key="L2" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">霞</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="26.776" end="27.281">か</span><span tts:ruby="text" begin="27.281" end="27.931">す</span></span></span><span begin="27.931" end="28.244">む</span><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="28.244" end="28.920">そ</span><span tts:ruby="text" begin="28.920" end="29.594">ら</span></span></span> <span tts:ruby="container"><span tts:ruby="base">揺</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="29.594" end="29.961">ゆ</span></span></span><span begin="29.961" end="30.772">ら</span><span begin="30.772" end="30.990">ぐ</span><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="30.990" end="31.190">く</span><span tts:ruby="text" begin="31.190" end="31.388">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">気</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="31.388" end="31.723">き</span></span></span><span begin="31.723" end="31.871">さ</span><span begin="31.871" end="32.681">え</span><span ttm:role="x-translation" xml:lang="zh-CN">就连色染晚霞的天空 摇动的空气</span></p><p begin="33.152" end="39.210" itunes:key="L3" ttm:agent="v1"><span begin="33.152" end="33.654">ず</span><span begin="33.654" end="33.791">っ</span><span begin="33.791" end="34.389">と</span><span tts:ruby="container"><span tts:ruby="base">何</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="34.389" end="34.774">な</span><span tts:ruby="text" begin="34.774" end="35.366">に</span></span></span><span begin="35.366" end="36.067">か</span><span tts:ruby="container"><span tts:ruby="base">探</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="36.291" end="36.992">さ</span><span tts:ruby="text" begin="36.992" end="37.445">か</span></span></span><span begin="37.445" end="37.987">し</span><span begin="37.987" end="39.210">て</span><span ttm:role="x-translation" xml:lang="zh-CN">也像是在寻觅着什么</span></p><p begin="39.500" end="45.016" itunes:key="L4" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">沈</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="39.500" end="40.084">し</span><span tts:ruby="text" begin="40.084" end="40.790">ず</span></span></span><span begin="40.790" end="42.143">む</span><span tts:ruby="container"><span tts:ruby="base">暗</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="42.143" end="42.395">く</span><span tts:ruby="text" begin="42.395" end="42.592">ら</span></span></span><span begin="42.592" end="42.795">い</span><span tts:ruby="container"><span tts:ruby="base">夜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="42.795" end="43.382">よ</span><span tts:ruby="text" begin="43.382" end="44.008">る</span></span></span><span begin="44.008" end="45.016">の</span><span ttm:role="x-translation" xml:lang="zh-CN">努力想要奔往</span></p><p begin="45.376" end="52.100" itunes:key="L5" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">向</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="45.376" end="45.589">む</span></span></span><span begin="45.589" end="45.787">こ</span><span begin="45.787" end="45.987">う</span><span begin="45.987" end="47.161">へ</span><span tts:ruby="container"><span tts:ruby="base">走</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="47.161" end="47.532">は</span><span tts:ruby="text" begin="47.532" end="48.176">し</span></span></span><span begin="48.176" end="48.782">り</span><span begin="48.782" end="49.072">だ</span><span begin="49.072" end="52.098">す</span><span ttm:role="x-translation" xml:lang="zh-CN">沉寂黑暗的夜幕的另一边</span></p><p begin="55.528" end="1:07.883" itunes:key="L6" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">高</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="55.528" end="56.184">た</span><span tts:ruby="text" begin="56.184" end="57.193">か</span></span></span><span tts:ruby="container"><span tts:ruby="base">鳴</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="57.193" end="57.795">な</span></span></span><span begin="57.795" end="58.314">る</span><span tts:ruby="container"><span tts:ruby="base">胸</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="58.314" end="58.799">む</span><span tts:ruby="text" begin="58.799" end="59.387">ね</span></span></span><span begin="59.387" end="59.963">の</span><span tts:ruby="container"><span tts:ruby="base">鼓</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="59.963" end="1:00.389">こ</span></span></span><span tts:ruby="container"><span tts:ruby="base">動</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:00.389" end="1:01.149">ど</span><span tts:ruby="text" begin="1:01.149" end="1:01.601">う</span></span></span> <span tts:ruby="container"><span tts:ruby="base">振</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:01.989" end="1:02.593">ふ</span></span></span><span begin="1:02.593" end="1:03.591">り</span><span tts:ruby="container"><span tts:ruby="base">切</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:03.591" end="1:04.237">き</span></span></span><span begin="1:04.237" end="1:04.796">る</span><span tts:ruby="container"><span tts:ruby="base">ゲージ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:04.796" end="1:07.883">Gauge</span></span></span><span ttm:role="x-translation" xml:lang="zh-CN">胸中高扬的鼓动早已超越度量的标尺</span></p><p begin="1:08.386" end="1:14.391" itunes:key="L7" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">溢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:08.386" end="1:09.036">あ</span><span tts:ruby="text" begin="1:09.036" end="1:09.924">ふ</span></span></span><span begin="1:09.924" end="1:10.602">れ</span><span begin="1:10.602" end="1:11.183">る</span><span tts:ruby="container"><span tts:ruby="base">涙</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:11.183" end="1:11.586">な</span><span tts:ruby="text" begin="1:11.586" end="1:12.177">み</span><span tts:ruby="text" begin="1:12.177" end="1:12.739">だ</span></span></span><span begin="1:12.739" end="1:13.193">を</span><span tts:ruby="container"><span tts:ruby="base">蹴</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:13.193" end="1:13.349">け</span></span></span><span tts:ruby="container"><span tts:ruby="base">散</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:13.349" end="1:13.557">ち</span></span></span><span begin="1:13.557" end="1:13.698">ら</span><span begin="1:13.698" end="1:14.391">せ</span><span ttm:role="x-translation" xml:lang="zh-CN">拒绝溢出的眼泪</span></p><p begin="1:14.741" end="1:20.931" itunes:key="L8" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:14.741" end="1:15.368">ゆ</span><span tts:ruby="text" begin="1:15.368" end="1:16.293">め</span></span></span><span begin="1:16.293" end="1:16.972">つ</span><span begin="1:16.972" end="1:17.580">か</span><span begin="1:17.580" end="1:18.006">ん</span><span begin="1:18.006" end="1:20.931">で</span><span ttm:role="x-translation" xml:lang="zh-CN">紧抱梦想</span></p><p begin="2:15.576" end="2:27.903" itunes:key="L9" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:15.576" end="2:16.157">こ</span><span tts:ruby="text" begin="2:16.157" end="2:16.777">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">葉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:16.777" end="2:17.167">ば</span></span></span><span begin="2:17.167" end="2:17.778">に</span><span begin="2:17.778" end="2:18.350">な</span><span begin="2:18.350" end="2:18.778">ら</span><span begin="2:18.778" end="2:19.554">な</span><span begin="2:19.554" end="2:19.776">い</span><span tts:ruby="container"><span tts:ruby="base">昨日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:19.776" end="2:20.018">き</span><span tts:ruby="text" begin="2:20.018" end="2:20.236">の</span><span tts:ruby="text" begin="2:20.236" end="2:20.637">う</span></span></span><span begin="2:20.637" end="2:20.842">に</span><span begin="2:20.842" end="2:21.508">は</span> <span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:21.984" end="2:22.573">こ</span><span tts:ruby="text" begin="2:22.573" end="2:23.200">こ</span><span tts:ruby="text" begin="2:23.200" end="2:23.578">ろ</span></span></span><span tts:ruby="container"><span tts:ruby="base">隠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:23.578" end="2:24.168">か</span><span tts:ruby="text" begin="2:24.168" end="2:24.716">く</span></span></span><span begin="2:24.716" end="2:25.170">し</span><span begin="2:25.170" end="2:25.816">て</span><span begin="2:25.816" end="2:27.903">る</span><span ttm:role="x-translation" xml:lang="zh-CN">将脆弱的心灵 隐藏在无法言喻的过去里</span></p><p begin="2:28.375" end="2:34.289" itunes:key="L10" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">無</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:28.375" end="2:28.982">な</span></span></span><span begin="2:28.982" end="2:29.453">く</span><span begin="2:29.453" end="2:29.963">し</span><span begin="2:29.963" end="2:30.607">た</span><span tts:ruby="container"><span tts:ruby="base">色</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:30.607" end="2:31.159">い</span><span tts:ruby="text" begin="2:31.159" end="2:31.583">ろ</span></span></span> <span begin="2:31.583" end="2:32.379">と</span><span begin="2:32.379" end="2:32.600">り</span><span tts:ruby="container"><span tts:ruby="base">返</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:32.600" end="2:32.754">か</span><span tts:ruby="text" begin="2:32.754" end="2:32.914">え</span></span></span><span begin="2:32.914" end="2:33.358">す</span><span begin="2:33.358" end="2:33.586">の</span><span begin="2:33.586" end="2:34.289">は</span><span ttm:role="x-translation" xml:lang="zh-CN">唤回曾经遗失的色彩</span></p><p begin="2:34.797" end="2:40.992" itunes:key="L11" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">切</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:34.797" end="2:35.378">き</span></span></span><span begin="2:35.378" end="2:35.938">れ</span><span begin="2:35.938" end="2:36.338">た</span><span tts:ruby="container"><span tts:ruby="base">糸</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:36.338" end="2:36.967">い</span><span tts:ruby="text" begin="2:36.967" end="2:37.532">ど</span></span></span><span tts:ruby="container"><span tts:ruby="base">繋</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:37.532" end="2:37.973">つ</span><span tts:ruby="text" begin="2:37.973" end="2:38.582">な</span></span></span><span begin="2:38.582" end="2:39.179">ぐ</span><span begin="2:39.179" end="2:39.529">よ</span><span begin="2:39.529" end="2:40.992">う</span><span ttm:role="x-translation" xml:lang="zh-CN">双手紧牵 不再远离</span></p><p begin="2:41.150" end="2:46.685" itunes:key="L12" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:41.150" end="2:41.798">き</span></span></span><span begin="2:41.798" end="2:42.387">え</span><span begin="2:42.387" end="2:43.752">た</span><span tts:ruby="container"><span tts:ruby="base">音</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:43.752" end="2:43.993">お</span><span tts:ruby="text" begin="2:43.993" end="2:44.172">と</span></span></span><span begin="2:44.172" end="2:44.370">を</span><span tts:ruby="container"><span tts:ruby="base">紡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:44.370" end="2:44.948">つ</span><span tts:ruby="text" begin="2:44.948" end="2:45.589">む</span></span></span><span begin="2:45.589" end="2:46.685">ぐ</span><span ttm:role="x-translation" xml:lang="zh-CN">将消逝的音符 再度编织连缀</span></p><p begin="2:46.976" end="2:54.188" itunes:key="L13" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">勇</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:46.976" end="2:47.201">ゆ</span><span tts:ruby="text" begin="2:47.201" end="2:47.396">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">気</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:47.396" end="2:47.592">き</span></span></span><span begin="2:47.592" end="2:48.554">を</span><span tts:ruby="container"><span tts:ruby="base">揺</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:48.804" end="2:49.183">ゆ</span></span></span><span begin="2:49.183" end="2:49.815">り</span><span tts:ruby="container"><span tts:ruby="base">起</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:49.815" end="2:50.360">お</span></span></span><span begin="2:50.360" end="2:50.699">こ</span><span begin="2:50.699" end="2:54.188">す</span><span ttm:role="x-translation" xml:lang="zh-CN">点滴的勇气 渐渐从心底涌起</span></p><p begin="2:57.126" end="3:09.643" itunes:key="L14" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">忘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:57.126" end="2:57.695">わ</span><span tts:ruby="text" begin="2:57.695" end="2:58.777">す</span></span></span><span begin="2:58.777" end="2:59.396">れ</span><span begin="2:59.396" end="2:59.940">た</span><span begin="2:59.940" end="3:00.360">く</span><span begin="3:00.360" end="3:00.912">な</span><span begin="3:00.912" end="3:01.556">い</span><span tts:ruby="container"><span tts:ruby="base">想</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:01.556" end="3:01.947">お</span><span tts:ruby="text" begin="3:01.947" end="3:02.594">も</span></span></span><span begin="3:02.594" end="3:03.180">い</span> <span tts:ruby="container"><span tts:ruby="base">二人</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:03.608" end="3:04.216">ふ</span><span tts:ruby="text" begin="3:04.216" end="3:05.154">た</span><span tts:ruby="text" begin="3:05.154" end="3:05.784">リ</span></span></span><span begin="3:05.784" end="3:06.373">の</span><span tts:ruby="container"><span tts:ruby="base">メモリー</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:06.373" end="3:09.643">Memory</span></span></span><span ttm:role="x-translation" xml:lang="zh-CN">不愿忘却的思念 那是我们的回忆</span></p><p begin="3:09.979" end="3:22.323" itunes:key="L15" ttm:agent="v1"><span begin="3:09.979" end="3:10.592">あ</span><span begin="3:10.592" end="3:11.569">な</span><span begin="3:11.569" end="3:12.167">た</span><span begin="3:12.167" end="3:12.704">と</span><span tts:ruby="container"><span tts:ruby="base">作</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:12.704" end="3:13.211">つ</span><span tts:ruby="text" begin="3:13.211" end="3:13.844">く</span></span></span><span begin="3:13.844" end="3:14.445">る</span><span tts:ruby="container"><span tts:ruby="base">未</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:14.445" end="3:14.862">み</span></span></span><span tts:ruby="container"><span tts:ruby="base">来</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:14.862" end="3:15.474">ら</span><span tts:ruby="text" begin="3:15.474" end="3:16.010">い</span></span></span> <span tts:ruby="container"><span tts:ruby="base">覚</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:16.389" end="3:17.006">お</span><span tts:ruby="text" begin="3:17.006" end="3:17.945">ぼ</span></span></span><span begin="3:17.945" end="3:18.560">え</span><span begin="3:18.560" end="3:19.185">て</span><span begin="3:19.185" end="3:19.608">い</span><span begin="3:19.608" end="3:22.323">て</span><span ttm:role="x-translation" xml:lang="zh-CN">与你一同编织的未来 铭刻在我的心底</span></p><p begin="3:22.791" end="3:35.505" itunes:key="L16" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">希</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:22.791" end="3:23.449">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">望</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:23.449" end="3:24.267">ぼ</span><span tts:ruby="text" begin="3:24.267" end="3:24.981">う</span></span></span><span begin="3:24.981" end="3:25.494">に</span><span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:25.494" end="3:25.968">ひ</span><span tts:ruby="text" begin="3:25.968" end="3:26.533">か</span></span></span><span begin="3:26.533" end="3:27.086">る</span><span tts:ruby="container"><span tts:ruby="base">翼</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:27.086" end="3:27.593">つ</span><span tts:ruby="text" begin="3:27.593" end="3:28.075">ば</span><span tts:ruby="text" begin="3:28.075" end="3:28.889">さ</span></span></span> <span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:29.189" end="3:29.712">み</span></span></span><span begin="3:29.712" end="3:30.783">つ</span><span begin="3:30.783" end="3:31.594">け</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:31.594" end="3:31.854">だ</span></span></span><span begin="3:31.854" end="3:32.374">す</span><span begin="3:32.374" end="3:32.999">か</span><span begin="3:32.999" end="3:34.145">ら</span><span begin="3:34.392" end="3:34.781">き</span><span begin="3:34.781" end="3:34.987">っ</span><span begin="3:34.987" end="3:35.505">と</span><span ttm:role="x-translation" xml:lang="zh-CN">若能寻找到的羽翼 闪耀着希望之光 就一定可以</span></p><p begin="3:35.585" end="3:48.398" itunes:key="L17" ttm:agent="v1"><span begin="3:35.585" end="3:36.112">い</span><span begin="3:36.112" end="3:37.113">つ</span><span begin="3:37.113" end="3:37.828">か</span><span tts:ruby="container"><span tts:ruby="base">新</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:37.828" end="3:38.292">あ</span><span tts:ruby="text" begin="3:38.292" end="3:38.709">た</span><span tts:ruby="text" begin="3:38.709" end="3:39.213">ら</span></span></span><span begin="3:39.213" end="3:39.938">し</span><span begin="3:39.938" end="3:40.285">い</span><span tts:ruby="container"><span tts:ruby="base">世</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:40.285" end="3:40.574">せ</span></span></span><span tts:ruby="container"><span tts:ruby="base">界</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:40.574" end="3:40.802">か</span><span tts:ruby="text" begin="3:40.802" end="3:41.049">い</span></span></span><span begin="3:41.049" end="3:41.410">に</span> <span begin="3:42.004" end="3:42.591">は</span><span begin="3:42.591" end="3:43.509">ば</span><span begin="3:43.509" end="3:44.160">た</span><span begin="3:44.160" end="3:44.824">け</span><span begin="3:44.824" end="3:45.198">る</span><span begin="3:45.198" end="3:48.398">の</span><span ttm:role="x-translation" xml:lang="zh-CN">在崭新的世界里 展翅翱翔</span></p></div></body></tt>