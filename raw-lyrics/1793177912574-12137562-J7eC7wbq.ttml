<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Imaginary affair"/><amll:meta key="artists" value="KOTOKO"/><amll:meta key="album" value="こなたよりかなたまで"/><amll:meta key="isrc" value="JPZ921705680"/><amll:meta key="ncmMusicId" value="755017"/><amll:meta key="qqMusicId" value="241271948"/><amll:meta key="ttmlAuthorGithubLogin" value="Mrs4s"/></metadata></head><body dur="4:15.040"><div begin="35.633" end="4:15.040"><p begin="35.633" end="40.088" itunes:key="L1" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">陽</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="35.633" end="35.793">ひ</span></span></span><span begin="35.793" end="35.983">だ</span><span begin="35.983" end="36.183">ま</span><span begin="36.183" end="36.533">り</span><span begin="36.533" end="36.720">に</span><span tts:ruby="container"><span tts:ruby="base">揺</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="36.720" end="37.103">ゆ</span></span></span><span begin="37.103" end="37.253">れ</span><span begin="37.253" end="37.703">た</span><span tts:ruby="container"><span tts:ruby="base">白</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="37.703" end="38.140">しろ</span></span></span><span begin="38.140" end="38.513">い</span><span tts:ruby="container"><span tts:ruby="base">風</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="38.513" end="40.088">かぜ</span></span></span><span ttm:role="x-translation">清风在阳光闪耀之处吹拂</span><span ttm:role="x-roman">hidamari ni yureta shiroi kaze</span></p><p begin="41.380" end="46.140" itunes:key="L2" ttm:agent="v1"><span begin="41.380" end="41.600">お</span><span begin="41.600" end="41.760">は</span><span begin="41.760" end="41.960">よ</span><span begin="41.960" end="42.133">う</span><span begin="42.133" end="42.233">の</span><span tts:ruby="container"><span tts:ruby="base">精</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="42.233" end="42.853">せい</span></span></span><span begin="42.853" end="43.593">が</span><span tts:ruby="container"><span tts:ruby="base">窓</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="43.593" end="44.320">まど</span></span></span><span begin="44.320" end="44.680">に</span><span tts:ruby="container"><span tts:ruby="base">降</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="44.680" end="45.000">お</span></span></span><span begin="45.000" end="45.233">り</span><span begin="45.233" end="46.140">た</span><span ttm:role="x-translation">早晨的精灵落在窗边</span><span ttm:role="x-roman">ohayou no sei ga mado ni orita</span></p><p begin="47.213" end="52.098" itunes:key="L3" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="47.213" end="47.640">なま</span></span></span><span tts:ruby="container"><span tts:ruby="base">温</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="47.640" end="48.013">ぬる</span></span></span><span begin="48.013" end="48.203">い</span><span begin="48.203" end="48.833">スー</span><span begin="48.833" end="49.340">プ</span><span tts:ruby="container"><span tts:ruby="base">飲</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="49.340" end="49.580">の</span></span></span><span begin="49.580" end="49.720">み</span><span tts:ruby="container"><span tts:ruby="base">干</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="49.720" end="49.933">ほ</span></span></span><span begin="49.933" end="50.083">し</span><span begin="50.083" end="50.240">た</span><span begin="50.240" end="50.663">ら</span> <span begin="50.663" end="50.853">ほ</span><span begin="50.853" end="52.098">ら</span><span ttm:role="x-translation">喝完了微温的汤 来吧</span><span ttm:role="x-roman">namanurui suupu nomihoshitara hora</span></p><p begin="52.973" end="56.940" itunes:key="L4" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">新</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="52.973" end="53.423">あたら</span></span></span><span begin="53.423" end="53.590">し</span><span begin="53.590" end="53.783">い</span><span begin="53.783" end="54.023">シャ</span><span begin="54.023" end="54.393">ツ</span><span tts:ruby="container"><span tts:ruby="base">着</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="54.393" end="54.603">き</span></span></span><span begin="54.603" end="54.920">て</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="54.920" end="55.133">で</span></span></span><span tts:ruby="container"><span tts:ruby="base">掛</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="55.133" end="55.313">か</span></span></span><span begin="55.313" end="55.480">け</span><span begin="55.480" end="56.130">よ</span><span begin="56.130" end="56.940">う</span><span ttm:role="x-translation">穿著新的衬杉出发吧</span><span ttm:role="x-roman">atarashii shatsu kite dekakeyou</span></p><p begin="57.673" end="1:03.280" itunes:key="L5" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">転</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="57.673" end="58.393">ころ</span></span></span><span begin="58.393" end="58.743">が</span><span begin="58.743" end="59.120">る</span><span tts:ruby="container"><span tts:ruby="base">坂</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="59.120" end="59.860">さか</span></span></span><span tts:ruby="container"><span tts:ruby="base">道</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="59.860" end="1:00.370">みち</span></span></span><span begin="1:00.370" end="1:01.080">に</span><span tts:ruby="container"><span tts:ruby="base">不</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:01.080" end="1:01.333">ふ</span></span></span><span tts:ruby="container"><span tts:ruby="base">安</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:01.333" end="1:02.043">あん</span></span></span><span tts:ruby="container"><span tts:ruby="base">抱</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:02.043" end="1:02.243">だ</span></span></span><span begin="1:02.243" end="1:02.743">い</span><span begin="1:02.743" end="1:03.280">て</span><span ttm:role="x-translation">抱持著不安 走在崎岖不平的坡道上</span><span ttm:role="x-roman">korogaru sakamichi ni fuan daite</span></p><p begin="1:03.423" end="1:06.400" itunes:key="L6" ttm:agent="v1"><span begin="1:03.423" end="1:03.823">しゃ</span><span begin="1:03.823" end="1:04.180">が</span><span begin="1:04.180" end="1:04.533">み</span><span tts:ruby="container"><span tts:ruby="base">込</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:04.533" end="1:04.900">こ</span></span></span><span begin="1:04.900" end="1:05.183">む</span><span tts:ruby="container"><span tts:ruby="base">背</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:05.183" end="1:05.463">せ</span></span></span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:05.463" end="1:05.980">なか</span></span></span><span begin="1:05.980" end="1:06.400">を</span><span ttm:role="x-translation">鹎鸟们的叫声</span><span ttm:role="x-roman">shagamikomu senaka wo</span></p><p begin="1:06.703" end="1:14.308" itunes:key="L7" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">鵯</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:06.703" end="1:07.963">ひよどり</span></span></span><span begin="1:07.963" end="1:08.153">の</span><span tts:ruby="container"><span tts:ruby="base">声</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:08.153" end="1:09.223">こえ</span></span></span><span begin="1:09.223" end="1:09.423">が</span><span tts:ruby="container"><span tts:ruby="base">撫</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:09.423" end="1:09.783">な</span></span></span><span begin="1:09.783" end="1:10.163">で</span><span begin="1:10.163" end="1:10.343">て</span><span begin="1:10.343" end="1:14.308">く</span><span ttm:role="x-translation">拂过蹲伏的背脊</span><span ttm:role="x-roman">hiyodori no koe ga nadeteku</span></p><p begin="1:15.003" end="1:21.080" itunes:key="L8" ttm:agent="v1"><span begin="1:15.003" end="1:15.193">こ</span><span begin="1:15.193" end="1:15.733">こ</span><span begin="1:15.733" end="1:16.133">か</span><span begin="1:16.133" end="1:16.493">ら</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:16.493" end="1:16.820">み</span></span></span><span begin="1:16.820" end="1:17.233">え</span><span begin="1:17.233" end="1:17.513">る</span><span tts:ruby="container"><span tts:ruby="base">明</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:17.513" end="1:17.823">あす</span></span></span><span begin="1:17.823" end="1:18.080">日</span><span begin="1:18.080" end="1:18.453">を</span><span tts:ruby="container"><span tts:ruby="base">追</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:18.453" end="1:18.640">お</span></span></span><span begin="1:18.640" end="1:18.993">い</span><span begin="1:18.993" end="1:19.363">か</span><span begin="1:19.363" end="1:19.543">け</span><span begin="1:19.543" end="1:19.900">て</span><span begin="1:19.900" end="1:20.283">い</span><span begin="1:20.283" end="1:20.500">た</span><span begin="1:20.500" end="1:21.080">い</span><span ttm:role="x-translation">想要去追赶从这里看得到的明天</span><span ttm:role="x-roman">koko kara mieru asu wo oikakete itai</span></p><p begin="1:21.313" end="1:26.300" itunes:key="L9" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">小</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:21.313" end="1:21.663">ちい</span></span></span><span begin="1:21.663" end="1:21.900">さ</span><span begin="1:21.900" end="1:22.083">く</span><span begin="1:22.083" end="1:22.423">たっ</span><span begin="1:22.423" end="1:22.780">て</span><span tts:ruby="container"><span tts:ruby="base">汚</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:22.780" end="1:23.160">よご</span></span></span><span begin="1:23.160" end="1:23.333">れ</span><span begin="1:23.333" end="1:23.523">て</span><span begin="1:23.523" end="1:23.893">たっ</span><span begin="1:23.893" end="1:24.220">て</span><span tts:ruby="container"><span tts:ruby="base">他</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:24.220" end="1:24.780">ほか</span></span></span><span begin="1:24.780" end="1:24.953">に</span><span begin="1:24.953" end="1:25.513">は</span><span begin="1:25.513" end="1:25.700">な</span><span begin="1:25.700" end="1:26.300">い</span><span ttm:role="x-translation">纵使渺小 纵使丢脸 已别无所求</span><span ttm:role="x-roman">chiisaku tatte yogorete tatte hoka ni wa nai</span></p><p begin="1:26.583" end="1:32.600" itunes:key="L10" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">遠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:26.583" end="1:27.303">とお</span></span></span><span begin="1:27.303" end="1:27.633">く</span><span tts:ruby="container"><span tts:ruby="base">広</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:27.633" end="1:28.393">ひろ</span></span></span><span begin="1:28.393" end="1:28.753">が</span><span begin="1:28.753" end="1:29.103">る</span><span tts:ruby="container"><span tts:ruby="base">丘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:29.103" end="1:29.680">おか</span></span></span><span begin="1:29.680" end="1:30.033">に</span><span tts:ruby="container"><span tts:ruby="base">登</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:30.033" end="1:30.583">のぼ</span></span></span><span begin="1:30.583" end="1:30.893">り</span><span begin="1:30.893" end="1:31.143">つ</span><span begin="1:31.143" end="1:31.473">め</span><span begin="1:31.473" end="1:31.843">た</span><span tts:ruby="container"><span tts:ruby="base">時</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:31.843" end="1:32.600">とき</span></span></span><span ttm:role="x-translation">当我们登上那延展到远方的山丘时</span><span ttm:role="x-roman">tooku hirogaru oka ni noboritsumeta toki</span></p><p begin="1:32.923" end="1:44.440" itunes:key="L11" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">何</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:32.923" end="1:33.293">なに</span></span></span><span begin="1:33.293" end="1:33.483">よ</span><span begin="1:33.483" end="1:33.643">り</span><span begin="1:33.643" end="1:34.363">も</span><span tts:ruby="container"><span tts:ruby="base">輝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:34.363" end="1:34.740">かがや</span></span></span><span begin="1:34.740" end="1:35.103">い</span><span begin="1:35.103" end="1:35.803">て</span><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:35.803" end="1:36.353">ぼく</span></span></span><span tts:ruby="container"><span tts:ruby="base">等</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:36.353" end="1:36.520">ら</span></span></span><span begin="1:36.520" end="1:37.073">を</span><span tts:ruby="container"><span tts:ruby="base">照</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:37.073" end="1:37.473">て</span></span></span><span begin="1:37.473" end="1:37.723">ら</span><span begin="1:37.723" end="1:38.153">し</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:38.153" end="1:38.323">だ</span></span></span><span begin="1:38.323" end="1:38.683">す</span><span begin="1:38.683" end="1:38.880">か</span><span begin="1:38.880" end="1:44.440">ら</span><span ttm:role="x-translation">胜过一切的闪亮光芒将照耀我们</span><span ttm:role="x-roman">nani yori mo kagayaite bokura wo terashidasu kara</span></p><p begin="2:02.393" end="2:07.008" itunes:key="L12" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">雨</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:02.393" end="2:02.780">あま</span></span></span><span tts:ruby="container"><span tts:ruby="base">粒</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:02.780" end="2:03.293">つぶ</span></span></span><span begin="2:03.293" end="2:03.460">に</span><span tts:ruby="container"><span tts:ruby="base">濡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:03.460" end="2:03.813">ぬ</span></span></span><span begin="2:03.813" end="2:04.013">れ</span><span begin="2:04.013" end="2:04.513">て</span><span tts:ruby="container"><span tts:ruby="base">傾</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:04.513" end="2:04.870">かし</span></span></span><span begin="2:04.870" end="2:05.163">ぐ</span><span tts:ruby="container"><span tts:ruby="base">花</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:05.163" end="2:07.008">はな</span></span></span><span ttm:role="x-translation">被雨滴打湿而歪斜的花</span><span ttm:role="x-roman">amatsubu ni nurete kashigu hana</span></p><p begin="2:08.153" end="2:13.020" itunes:key="L13" ttm:agent="v1"><span begin="2:08.153" end="2:08.360">ま</span><span begin="2:08.360" end="2:08.520">る</span><span begin="2:08.520" end="2:08.700">で</span><span begin="2:08.700" end="2:08.893">あ</span><span begin="2:08.893" end="2:09.073">の</span><span tts:ruby="container"><span tts:ruby="base">時</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:09.073" end="2:09.603">とき</span></span></span><span begin="2:09.603" end="2:10.303">の</span><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:10.303" end="2:11.040">きみ</span></span></span><span begin="2:11.040" end="2:11.360">の</span><span begin="2:11.360" end="2:11.740">よ</span><span begin="2:11.740" end="2:11.953">う</span><span begin="2:11.953" end="2:13.020">で</span><span ttm:role="x-translation">就像那个时候的你一样</span><span ttm:role="x-roman">marude ano toki no kimi no you de</span></p><p begin="2:13.943" end="2:19.078" itunes:key="L14" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">虹</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:13.943" end="2:14.313">にじ</span></span></span><span tts:ruby="container"><span tts:ruby="base">色</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:14.313" end="2:14.840">いろ</span></span></span><span begin="2:14.840" end="2:15.013">の</span><span tts:ruby="container"><span tts:ruby="base">傘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:15.013" end="2:15.560">かさ</span></span></span><span begin="2:15.560" end="2:16.013">を</span><span tts:ruby="container"><span tts:ruby="base">差</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:16.013" end="2:16.243">さ</span></span></span><span begin="2:16.243" end="2:16.463">し</span><span tts:ruby="container"><span tts:ruby="base">掛</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:16.463" end="2:16.823">か</span></span></span><span begin="2:16.823" end="2:17.023">け</span><span begin="2:17.023" end="2:17.393">て</span><span begin="2:17.393" end="2:17.563">み</span><span begin="2:17.563" end="2:19.078">た</span><span ttm:role="x-translation">试著撑起七彩颜色的伞</span><span ttm:role="x-roman">nijiiro no kasa wo sashikakete mita</span></p><p begin="2:19.723" end="2:23.430" itunes:key="L15" ttm:agent="v1"><span begin="2:19.723" end="2:19.903">ま</span><span begin="2:19.903" end="2:20.083">た</span><span tts:ruby="container"><span tts:ruby="base">笑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:20.083" end="2:20.273">え</span></span></span><span tts:ruby="container"><span tts:ruby="base">顔</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:20.273" end="2:20.510">がお</span></span></span><span begin="2:20.510" end="2:20.800">を</span><span tts:ruby="container"><span tts:ruby="base">取</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:20.800" end="2:21.180">と</span></span></span><span begin="2:21.180" end="2:21.373">り</span><span tts:ruby="container"><span tts:ruby="base">戻</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:21.373" end="2:21.823">もど</span></span></span><span begin="2:21.823" end="2:22.073">す</span><span begin="2:22.073" end="2:22.240">と</span><span begin="2:22.240" end="2:22.490">い</span><span begin="2:22.490" end="2:22.793">い</span><span begin="2:22.793" end="2:23.430">な</span><span ttm:role="x-translation">若是能取回笑容就好了</span><span ttm:role="x-roman">mata egao wo torimodosu to ii na</span></p><p begin="2:24.463" end="2:30.000" itunes:key="L16" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">長</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:24.463" end="2:25.103">なが</span></span></span><span tts:ruby="container"><span tts:ruby="base">過</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:25.103" end="2:25.523">す</span></span></span><span begin="2:25.523" end="2:25.883">ぎ</span><span begin="2:25.883" end="2:26.183">る</span><span tts:ruby="container"><span tts:ruby="base">坂</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:26.183" end="2:26.893">さか</span></span></span><span tts:ruby="container"><span tts:ruby="base">道</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:26.893" end="2:27.793">みち</span></span></span> <span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:27.793" end="2:28.380">そら</span></span></span><span begin="2:28.380" end="2:28.763">は</span><span tts:ruby="container"><span tts:ruby="base">遥</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:28.763" end="2:29.473">はる</span></span></span><span begin="2:29.473" end="2:30.000">か</span><span ttm:role="x-translation">在漫长的坡道上 天空很遥远</span><span ttm:role="x-roman">nagasugiru sakamichi sora wa haruka</span></p><p begin="2:30.193" end="2:41.160" itunes:key="L17" ttm:agent="v1"><span begin="2:30.193" end="2:30.580">す</span><span begin="2:30.580" end="2:30.973">り</span><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:30.973" end="2:31.323">か</span></span></span><span begin="2:31.323" end="2:31.640">わ</span><span begin="2:31.640" end="2:31.993">る</span><span tts:ruby="container"><span tts:ruby="base">景</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:31.993" end="2:32.250">け</span></span></span><span tts:ruby="container"><span tts:ruby="base">色</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:32.250" end="2:32.720">しき</span></span></span><span begin="2:32.720" end="2:33.453">に</span><span tts:ruby="container"><span tts:ruby="base">行</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:33.453" end="2:33.813">ゆ</span></span></span><span begin="2:33.813" end="2:34.193">き</span><span tts:ruby="container"><span tts:ruby="base">先</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:34.193" end="2:34.693">さき</span></span></span><span begin="2:34.693" end="2:34.953">も</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:34.953" end="2:35.530">み</span></span></span><span tts:ruby="container"><span tts:ruby="base">失</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:35.530" end="2:36.543">うしな</span></span></span><span begin="2:36.543" end="2:36.883">う</span><span begin="2:36.883" end="2:37.103">け</span><span begin="2:37.103" end="2:41.160">ど</span><span ttm:role="x-translation">虽然在瞬息万变的景色中也会迷失目标</span><span ttm:role="x-roman">surikawaru keshiki ni yukisaki mo miushinau kedo</span></p><p begin="2:41.753" end="2:47.840" itunes:key="L18" ttm:agent="v1"><span begin="2:41.753" end="2:41.943">こ</span><span begin="2:41.943" end="2:42.483">こ</span><span begin="2:42.483" end="2:42.873">か</span><span begin="2:42.873" end="2:43.243">ら</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:43.243" end="2:43.560">み</span></span></span><span begin="2:43.560" end="2:43.940">え</span><span begin="2:43.940" end="2:44.300">る</span><span tts:ruby="container"><span tts:ruby="base">明</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:44.300" end="2:44.573">あす</span></span></span><span begin="2:44.573" end="2:44.820">日</span><span begin="2:44.820" end="2:45.160">に</span><span begin="2:45.160" end="2:45.740">エー</span><span begin="2:45.740" end="2:46.080">ル</span><span begin="2:46.080" end="2:46.303">を</span><span tts:ruby="container"><span tts:ruby="base">贈</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:46.303" end="2:47.033">おく</span></span></span><span begin="2:47.033" end="2:47.370">ろ</span><span begin="2:47.370" end="2:47.840">う</span><span ttm:role="x-translation">对著从这里看得见的明天呼喊吧</span><span ttm:role="x-roman">koko kara mieru asu ni eeru wo okurou</span></p><p begin="2:48.113" end="2:53.260" itunes:key="L19" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">切</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:48.113" end="2:48.473">せつ</span></span></span><span begin="2:48.473" end="2:48.643">な</span><span begin="2:48.643" end="2:48.833">さ</span><span begin="2:48.833" end="2:49.173">だっ</span><span begin="2:49.173" end="2:49.543">て</span><span tts:ruby="container"><span tts:ruby="base">淋</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:49.543" end="2:49.843">さび</span></span></span><span begin="2:49.843" end="2:50.060">し</span><span begin="2:50.060" end="2:50.253">さ</span><span begin="2:50.253" end="2:50.623">だっ</span><span begin="2:50.623" end="2:50.980">て</span><span tts:ruby="container"><span tts:ruby="base">胸</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:50.980" end="2:51.533">むね</span></span></span><span begin="2:51.533" end="2:51.663">の</span><span tts:ruby="container"><span tts:ruby="base">波</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:51.663" end="2:52.153">は</span></span></span><span tts:ruby="container"><span tts:ruby="base">動</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:52.153" end="2:53.260">どう</span></span></span><span ttm:role="x-translation">纵使难受 纵使寂寞 这是胸口的鼓动</span><span ttm:role="x-roman">setsunasa datte sabishisa datte mune no hadou</span></p><p begin="2:53.333" end="2:59.400" itunes:key="L20" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">降</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:53.333" end="2:53.540">ふ</span></span></span><span begin="2:53.540" end="2:54.093">り</span><span tts:ruby="container"><span tts:ruby="base">止</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:54.093" end="2:54.453">や</span></span></span><span begin="2:54.453" end="2:54.783">ま</span><span begin="2:54.783" end="2:55.140">な</span><span begin="2:55.140" end="2:55.503">い</span><span tts:ruby="container"><span tts:ruby="base">雨</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:55.503" end="2:56.223">あめ</span></span></span><span begin="2:56.223" end="2:56.433">な</span><span begin="2:56.433" end="2:56.783">ど</span><span begin="2:56.783" end="2:56.943">こ</span><span begin="2:56.943" end="2:57.320">こ</span><span begin="2:57.320" end="2:57.673">に</span><span begin="2:57.673" end="2:57.883">は</span><span begin="2:57.883" end="2:58.220">な</span><span begin="2:58.220" end="2:58.583">い</span><span begin="2:58.583" end="2:58.800">か</span><span begin="2:58.800" end="2:59.400">ら</span><span ttm:role="x-translation">这里没有下不停的雨</span><span ttm:role="x-roman">furiyamanai ame nado koko ni wa nai kara</span></p><p begin="2:59.713" end="3:11.380" itunes:key="L21" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:59.713" end="3:00.060">ぼく</span></span></span><span begin="3:00.060" end="3:00.203">に</span><span begin="3:00.203" end="3:00.403">だ</span><span begin="3:00.403" end="3:01.123">け</span><span tts:ruby="container"><span tts:ruby="base">頷</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:01.123" end="3:01.620">うなず</span></span></span><span begin="3:01.620" end="3:01.853">い</span><span begin="3:01.853" end="3:02.483">て</span> <span begin="3:02.483" end="3:02.733">そ</span><span begin="3:02.733" end="3:03.093">の</span><span tts:ruby="container"><span tts:ruby="base">涙</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:03.093" end="3:04.183">なみだ</span></span></span><span begin="3:04.183" end="3:04.520">も</span><span begin="3:04.520" end="3:04.803">う</span><span tts:ruby="container"><span tts:ruby="base">拭</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:04.803" end="3:05.113">ふ</span></span></span><span begin="3:05.113" end="3:05.433">き</span><span begin="3:05.433" end="3:05.640">な</span><span begin="3:05.640" end="3:11.380">よ</span><span ttm:role="x-translation">你只对我点点头 把眼泪擦乾吧</span><span ttm:role="x-roman">boku ni dake unazuite sono namida mou fuki na yo</span></p><p begin="3:28.083" end="3:31.180" itunes:key="L22" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">振</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:28.083" end="3:28.380">ふ</span></span></span><span begin="3:28.380" end="3:28.753">り</span><span tts:ruby="container"><span tts:ruby="base">返</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:28.753" end="3:29.483">かえ</span></span></span><span begin="3:29.483" end="3:29.723">る</span><span tts:ruby="container"><span tts:ruby="base">坂</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:29.723" end="3:30.583">さか</span></span></span><span tts:ruby="container"><span tts:ruby="base">道</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:30.583" end="3:31.180">みち</span></span></span><span ttm:role="x-translation">回顾以往的坡道上</span><span ttm:role="x-roman">furikaeru sakamichi</span></p><p begin="3:31.463" end="3:36.760" itunes:key="L23" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">時</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:31.463" end="3:32.013">とき</span></span></span><span begin="3:32.013" end="3:32.373">に</span><span tts:ruby="container"><span tts:ruby="base">泣</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:32.373" end="3:32.560">な</span></span></span><span begin="3:32.560" end="3:33.103">い</span><span begin="3:33.103" end="3:33.823">た</span><span tts:ruby="container"><span tts:ruby="base">弱</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:33.823" end="3:34.520">よわ</span></span></span><span tts:ruby="container"><span tts:ruby="base">虫</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:34.520" end="3:35.263">むし</span></span></span><span begin="3:35.263" end="3:35.623">な</span><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:35.623" end="3:36.173">ぼく</span></span></span><span tts:ruby="container"><span tts:ruby="base">等</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:36.173" end="3:36.353">ら</span></span></span><span begin="3:36.353" end="3:36.760">の</span><span ttm:role="x-translation">懦弱而偶尔哭泣的我们</span><span ttm:role="x-roman">toki ni naita yowamushi na bokura no</span></p><p begin="3:37.063" end="3:44.720" itunes:key="L24" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">足</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:37.063" end="3:37.740">あし</span></span></span><span tts:ruby="container"><span tts:ruby="base">跡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:37.740" end="3:38.313">あと</span></span></span><span begin="3:38.313" end="3:38.503">に</span><span tts:ruby="container"><span tts:ruby="base">花</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:38.503" end="3:39.593">はな</span></span></span><span begin="3:39.593" end="3:39.783">が</span><span tts:ruby="container"><span tts:ruby="base">咲</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:39.783" end="3:40.160">さ</span></span></span><span begin="3:40.160" end="3:40.483">い</span><span begin="3:40.483" end="3:40.683">て</span><span begin="3:40.683" end="3:44.720">た</span><span ttm:role="x-translation">脚印上依然花儿盛开</span><span ttm:role="x-roman">ashiato ni hana ga saiteta</span></p><p begin="3:45.363" end="3:51.460" itunes:key="L25" ttm:agent="v1"><span begin="3:45.363" end="3:45.553">こ</span><span begin="3:45.553" end="3:46.083">こ</span><span begin="3:46.083" end="3:46.503">か</span><span begin="3:46.503" end="3:46.853">ら</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:46.853" end="3:47.180">み</span></span></span><span begin="3:47.180" end="3:47.560">え</span><span begin="3:47.560" end="3:47.863">る</span><span tts:ruby="container"><span tts:ruby="base">明</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:47.863" end="3:48.193">あす</span></span></span><span begin="3:48.193" end="3:48.463">日</span><span begin="3:48.463" end="3:48.813">の</span><span tts:ruby="container"><span tts:ruby="base">絵</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:48.813" end="3:49.130">え</span></span></span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:49.130" end="3:49.713">にっ</span></span></span><span tts:ruby="container"><span tts:ruby="base">記</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:49.713" end="3:49.893">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">描</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:49.893" end="3:50.643">えが</span></span></span><span begin="3:50.643" end="3:51.040">こ</span><span begin="3:51.040" end="3:51.460">う</span><span ttm:role="x-translation">去描绘从这里看得到、明天的绘画日记吧</span><span ttm:role="x-roman">koko kara mieru asu no enikki egakou</span></p><p begin="3:51.723" end="3:56.860" itunes:key="L26" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">平</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:51.723" end="3:52.093">へい</span></span></span><span tts:ruby="container"><span tts:ruby="base">凡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:52.093" end="3:52.453">ぼん</span></span></span><span begin="3:52.453" end="3:52.793">だっ</span><span begin="3:52.793" end="3:53.140">て</span><span tts:ruby="container"><span tts:ruby="base">歪</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:53.140" end="3:53.540">ゆが</span></span></span><span begin="3:53.540" end="3:53.713">ん</span><span begin="3:53.713" end="3:53.903">で</span><span begin="3:53.903" end="3:54.253">たっ</span><span begin="3:54.253" end="3:54.623">て</span> <span begin="3:54.623" end="3:54.800">そ</span><span begin="3:54.800" end="3:55.143">れ</span><span begin="3:55.143" end="3:55.340">が</span><span tts:ruby="container"><span tts:ruby="base">証</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:55.340" end="3:56.003">あか</span></span></span><span begin="3:56.003" end="3:56.860">し</span><span ttm:role="x-translation">纵使平凡 纵使歪曲 那是个证明</span><span ttm:role="x-roman">heibon datte yugande tatte sore ga akashi</span></p><p begin="3:56.953" end="4:03.000" itunes:key="L27" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">何</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:56.953" end="3:57.673">なに</span></span></span><span tts:ruby="container"><span tts:ruby="base">気</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:57.673" end="3:58.033">げ</span></span></span><span begin="3:58.033" end="3:58.380">な</span><span begin="3:58.380" end="3:58.733">い</span><span tts:ruby="container"><span tts:ruby="base">顔</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:58.733" end="3:59.480">かお</span></span></span><span begin="3:59.480" end="3:59.773">を</span><span begin="3:59.773" end="4:00.033">し</span><span begin="4:00.033" end="4:00.483">た</span><span tts:ruby="container"><span tts:ruby="base">朝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:00.483" end="4:00.920">あさ</span></span></span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:00.920" end="4:01.280">ひ</span></span></span><span begin="4:01.280" end="4:01.473">に</span><span tts:ruby="container"><span tts:ruby="base">会</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:01.473" end="4:01.820">あ</span></span></span><span begin="4:01.820" end="4:02.213">え</span><span begin="4:02.213" end="4:02.420">た</span><span begin="4:02.420" end="4:03.000">ら</span><span ttm:role="x-translation">如果能若无其事地迎接早晨的太阳</span><span ttm:role="x-roman">nanigenai kao wo shita asahi ni aetara</span></p><p begin="4:03.293" end="4:15.040" itunes:key="L28" ttm:agent="v1"><span begin="4:03.293" end="4:03.493">そ</span><span begin="4:03.493" end="4:03.643">よ</span><span tts:ruby="container"><span tts:ruby="base">風</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:03.643" end="4:04.023">かぜ</span></span></span><span begin="4:04.023" end="4:04.743">の</span><span tts:ruby="container"><span tts:ruby="base">真</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:04.743" end="4:04.920">ま</span></span></span><span tts:ruby="container"><span tts:ruby="base">似</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:04.920" end="4:05.060">ね</span></span></span><span begin="4:05.060" end="4:05.223">を</span><span begin="4:05.223" end="4:05.453">し</span><span begin="4:05.453" end="4:06.173">て</span> <span begin="4:06.173" end="4:06.353">こ</span><span begin="4:06.353" end="4:06.733">の</span><span tts:ruby="container"><span tts:ruby="base">道</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:06.733" end="4:07.423">みち</span></span></span><span tts:ruby="container"><span tts:ruby="base">歩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:07.423" end="4:08.180">ある</span></span></span><span begin="4:08.180" end="4:08.513">い</span><span begin="4:08.513" end="4:08.683">て</span><span begin="4:08.683" end="4:09.053">ゆ</span><span begin="4:09.053" end="4:10.100">こ</span><span begin="4:10.100" end="4:15.040">う</span><span ttm:role="x-translation">就模仿著微风 在这条路上继续走下去吧</span><span ttm:role="x-roman">soyokaze no mane wo shite kono michi aruite yukou</span></p></div></body></tt>