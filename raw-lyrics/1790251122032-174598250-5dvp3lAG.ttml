<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="奔赴"/><amll:meta key="artists" value="Chris Brocato"/><amll:meta key="artists" value="JULAIAH ZHUKOVA"/><amll:meta key="artists" value="Julaiah Zhukova"/><amll:meta key="artists" value="Monster Siren Records"/><amll:meta key="artists" value="塞壬唱片-MSR"/><amll:meta key="album" value="人们, 我们 (Original Soundtrack) - EP"/><amll:meta key="album" value="人们，我们OST"/><amll:meta key="album" value="人們, 我們 (Original Soundtrack)"/><amll:meta key="album" value="人們, 我們 (Original Soundtrack) - EP"/><amll:meta key="isrc" value="TWU712614527"/><amll:meta key="ncmMusicId" value="3368026168"/><amll:meta key="qqMusicId" value="002YBL382fDh9U"/><amll:meta key="qqMusicId" value="655121000"/><amll:meta key="spotifyId" value="5qsBksXVKrPCgHnhd4LH7a"/><amll:meta key="appleMusicId" value="6776195382"/><amll:meta key="ttmlAuthorGithub" value="174598250"/><amll:meta key="ttmlAuthorGithubLogin" value="ASyunagi"/></metadata></head><body dur="1:25.270"><div begin="2.000" end="1:25.270"><p begin="2.000" end="4.640" itunes:key="L1" ttm:agent="v1"><span begin="2.000" end="2.220">Как</span> <span begin="2.370" end="2.870">пре</span><span begin="2.870" end="2.970">ж</span><span begin="2.970" end="3.320">де</span> <span begin="3.320" end="3.450">сей</span><span begin="3.550" end="4.400">ча</span><span begin="4.400" end="4.640">с</span><span ttm:role="x-translation" xml:lang="zh-Hans">如今仍如往昔</span><span ttm:role="x-translation" xml:lang="zh-Hant">如今仍如往昔</span><span ttm:role="x-translation" xml:lang="en">Now as before</span><span ttm:role="x-translation" xml:lang="ja">今も かつてと同じように</span><span ttm:role="x-translation" xml:lang="ko">예전처럼 지금도</span><span ttm:role="x-translation" xml:lang="fr">Comme autrefois à présent</span><span ttm:role="x-translation" xml:lang="es">Como antes ahora</span><span ttm:role="x-translation" xml:lang="de">Wie einst so auch jetzt</span><span ttm:role="x-translation" xml:lang="pt">Como antes agora</span><span ttm:role="x-roman">Kak prezhde seychas</span></p><p begin="6.780" end="9.320" itunes:key="L2" ttm:agent="v1"><span begin="6.780" end="7.180">Зем</span><span begin="7.180" end="7.670">ля</span> <span begin="7.670" end="7.810">вз</span><span begin="7.810" end="7.990">ды</span><span begin="7.990" end="8.280">хает</span> <span begin="8.390" end="9.070">не</span><span begin="9.070" end="9.190">ж</span><span begin="9.190" end="9.320">но</span><span ttm:role="x-translation" xml:lang="zh-Hans">大地轻柔地叹息</span><span ttm:role="x-translation" xml:lang="zh-Hant">大地輕柔地嘆息</span><span ttm:role="x-translation" xml:lang="en">The earth sighs softly</span><span ttm:role="x-translation" xml:lang="ja">大地は静かに息をつく</span><span ttm:role="x-translation" xml:lang="ko">대지는 부드럽게 숨을 내쉬고</span><span ttm:role="x-translation" xml:lang="fr">La terre soupire doucement</span><span ttm:role="x-translation" xml:lang="es">La tierra suspira suavemente</span><span ttm:role="x-translation" xml:lang="de">Die Erde seufzt sanft</span><span ttm:role="x-translation" xml:lang="pt">A terra suspira suavemente</span><span ttm:role="x-roman">Zemlya vzdykhayet nezhno</span></p><p begin="10.780" end="17.790" itunes:key="L3" ttm:agent="v1"><span begin="10.780" end="11.770">Лу</span><span begin="11.970" end="12.740">чи</span> <span begin="13.580" end="14.410">е</span><span begin="14.410" end="15.000">ё</span> <span begin="15.550" end="16.530">на</span><span begin="16.530" end="16.730">с</span> <span begin="16.730" end="17.560">грею</span><span begin="17.750" end="17.790">т</span><span ttm:role="x-translation" xml:lang="zh-Hans">她的光芒温暖着我们</span><span ttm:role="x-translation" xml:lang="zh-Hant">她的光芒溫暖著我們</span><span ttm:role="x-translation" xml:lang="en">Her rays keep us warm</span><span ttm:role="x-translation" xml:lang="ja">その光が私たちを暖める</span><span ttm:role="x-translation" xml:lang="ko">그 빛줄기는 우리를 따스하게 감싸</span><span ttm:role="x-translation" xml:lang="fr">Ses rayons nous réchauffent</span><span ttm:role="x-translation" xml:lang="es">Sus rayos nos dan calor</span><span ttm:role="x-translation" xml:lang="de">Ihre Strahlen wärmen uns</span><span ttm:role="x-translation" xml:lang="pt">Seus raios nos aquecem</span><span ttm:role="x-roman">Luchi yeyo nas greyut</span></p><p begin="18.360" end="25.050" itunes:key="L4" ttm:agent="v1"><span begin="18.360" end="18.760">Мы</span> <span begin="18.760" end="19.090">и</span><span begin="19.200" end="19.890">дём</span> <span begin="20.410" end="21.350">на</span> <span begin="21.350" end="21.560">з</span><span begin="21.560" end="22.460">ов</span> <span begin="23.240" end="24.000">е</span><span begin="24.000" end="25.050">ё</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们循着她的召唤前行</span><span ttm:role="x-translation" xml:lang="zh-Hant">我們循著她的召喚前行</span><span ttm:role="x-translation" xml:lang="en">We march at her call</span><span ttm:role="x-translation" xml:lang="ja">私たちはその呼び声へと歩んでゆく</span><span ttm:role="x-translation" xml:lang="ko">우리는 그 부름을 따라 나아가</span><span ttm:role="x-translation" xml:lang="fr">Nous marchons à son appel</span><span ttm:role="x-translation" xml:lang="es">Caminamos siguiendo su llamada</span><span ttm:role="x-translation" xml:lang="de">Wir folgen ihrem Ruf</span><span ttm:role="x-translation" xml:lang="pt">Seguimos ao chamado dela</span><span ttm:role="x-roman">My idyom na zov yeyo</span></p><p begin="26.410" end="30.460" itunes:key="L5" ttm:agent="v1"><span begin="26.410" end="26.590">От</span><span begin="26.820" end="27.450">вет</span> <span begin="28.790" end="29.000">гром</span><span begin="29.000" end="29.120">че</span> <span begin="29.210" end="29.720">го</span><span begin="29.720" end="29.830">ло</span><span begin="29.940" end="30.460">сов</span><span ttm:role="x-translation" xml:lang="zh-Hans">回应盖过了所有声音</span><span ttm:role="x-translation" xml:lang="zh-Hant">回應蓋過了所有聲音</span><span ttm:role="x-translation" xml:lang="en">The answer rings louder than voices</span><span ttm:role="x-translation" xml:lang="ja">答えはあらゆる声より高く響く</span><span ttm:role="x-translation" xml:lang="ko">대답은 목소리보다 더 크게 울리고</span><span ttm:role="x-translation" xml:lang="fr">La réponse résonne plus fort que les voix</span><span ttm:role="x-translation" xml:lang="es">La respuesta resuena más fuerte que las voces</span><span ttm:role="x-translation" xml:lang="de">Die Antwort ist lauter als Stimmen</span><span ttm:role="x-translation" xml:lang="pt">A resposta é mais alta que as vozes</span><span ttm:role="x-roman">Otvet gromche golosov</span></p><p begin="31.960" end="37.090" itunes:key="L6" ttm:agent="v1"><span begin="31.960" end="32.180">Со</span><span begin="32.410" end="33.020">мне</span><span begin="33.020" end="33.260">ний</span> <span begin="33.260" end="33.850">не</span><span begin="33.850" end="33.900">т</span> <span begin="34.290" end="34.400">в</span> <span begin="34.400" end="34.520">том,</span> <span begin="34.520" end="34.780">что</span> <span begin="34.780" end="35.620">и</span><span begin="35.620" end="35.900">с</span><span begin="36.000" end="36.190">ти</span><span begin="36.190" end="36.320">на</span> <span begin="36.410" end="36.840">е</span><span begin="37.010" end="37.090">сть</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们从未怀疑 真理确然存在</span><span ttm:role="x-translation" xml:lang="zh-Hant">我們從未懷疑 真理確然存在</span><span ttm:role="x-translation" xml:lang="en">There is no doubt that truth exists</span><span ttm:role="x-translation" xml:lang="ja">真実があることに もう疑いはない</span><span ttm:role="x-translation" xml:lang="ko">진실이 존재한다는 데에는 의심이 없어</span><span ttm:role="x-translation" xml:lang="fr">Nul doute que la vérité existe</span><span ttm:role="x-translation" xml:lang="es">No hay duda de que la verdad existe</span><span ttm:role="x-translation" xml:lang="de">Kein Zweifel daran dass es Wahrheit gibt</span><span ttm:role="x-translation" xml:lang="pt">Não há dúvida de que a verdade existe</span><span ttm:role="x-roman">Somneniy net v tom, shto istina yest&apos;</span></p><p begin="37.600" end="47.550" itunes:key="L7" ttm:agent="v1"><span begin="37.600" end="37.820">И</span> <span begin="37.950" end="38.580">е</span><span begin="38.580" end="38.820">с</span><span begin="38.820" end="39.470">ли</span> <span begin="39.610" end="40.570">бы</span> <span begin="41.590" end="41.770">толь</span><span begin="41.770" end="41.880">ко</span> <span begin="41.880" end="42.020">з</span><span begin="42.020" end="42.810">на</span><span begin="42.810" end="43.570">ли мы</span> <span begin="44.590" end="44.690">в</span><span begin="44.690" end="44.800">с</span><span begin="44.800" end="45.040">ё</span> <span begin="45.040" end="45.210">с</span><span begin="45.210" end="45.710">на</span><span begin="45.970" end="46.530">ча</span><span begin="47.160" end="47.550">ла</span><span ttm:role="x-translation" xml:lang="zh-Hans">倘若从一开始 我们便知晓这一切</span><span ttm:role="x-translation" xml:lang="zh-Hant">倘若從一開始 我們便知曉這一切</span><span ttm:role="x-translation" xml:lang="en">And if only we had known everything from the start</span><span ttm:role="x-translation" xml:lang="ja">もし初めからすべてを知っていたなら</span><span ttm:role="x-translation" xml:lang="ko">처음부터 모든 것을 알 수만 있었다면</span><span ttm:role="x-translation" xml:lang="fr">Et si seulement nous avions tout su dès le début</span><span ttm:role="x-translation" xml:lang="es">Y si tan solo lo hubiéramos sabido todo desde el principio</span><span ttm:role="x-translation" xml:lang="de">Und hätten wir doch nur von Anfang an alles gewusst</span><span ttm:role="x-translation" xml:lang="pt">E se ao menos soubéssemos tudo desde o começo</span><span ttm:role="x-roman">I yesli by tol&apos;ko znali my vsyo snachala</span></p><p begin="47.620" end="53.560" itunes:key="L8" ttm:agent="v1"><span begin="47.620" end="48.280">Иным</span> <span begin="48.820" end="49.000">бы</span> <span begin="49.000" end="49.220">с</span><span begin="49.220" end="49.740">та</span><span begin="49.740" end="49.960">ло</span> <span begin="50.800" end="51.240">на</span><span begin="51.240" end="51.530">ше</span> <span begin="52.400" end="52.680">бу</span><span begin="52.680" end="52.780">ду</span><span begin="52.870" end="53.080">ще</span><span begin="53.080" end="53.560">е</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们的未来 或许便会截然不同</span><span ttm:role="x-translation" xml:lang="zh-Hant">我們的未來 或許便會截然不同</span><span ttm:role="x-translation" xml:lang="en">Our future would have been different</span><span ttm:role="x-translation" xml:lang="ja">私たちの未来は違うものになっていただろう</span><span ttm:role="x-translation" xml:lang="ko">우리의 미래는 달라졌을 텐데</span><span ttm:role="x-translation" xml:lang="fr">Notre avenir aurait été tout autre</span><span ttm:role="x-translation" xml:lang="es">Nuestro futuro habría sido distinto</span><span ttm:role="x-translation" xml:lang="de">Unsere Zukunft wäre eine andere geworden</span><span ttm:role="x-translation" xml:lang="pt">Diferente teria sido o nosso futuro</span><span ttm:role="x-roman">Inym by stalo nashe budushcheye</span></p><p begin="58.360" end="1:01.180" itunes:key="L9" ttm:agent="v1"><span begin="58.360" end="58.570">Ка</span><span begin="58.570" end="58.610">к</span> <span begin="58.780" end="59.490">пре</span><span begin="59.490" end="59.590">ж</span><span begin="59.590" end="59.770">де</span> <span begin="59.770" end="59.880">сей</span><span begin="59.990" end="1:00.940">ча</span><span begin="1:00.940" end="1:01.180">с</span><span ttm:role="x-translation" xml:lang="zh-Hans">如今仍如往昔</span><span ttm:role="x-translation" xml:lang="zh-Hant">如今仍如往昔</span><span ttm:role="x-translation" xml:lang="en">Now as before</span><span ttm:role="x-translation" xml:lang="ja">今も かつてと同じように</span><span ttm:role="x-translation" xml:lang="ko">예전처럼 지금도</span><span ttm:role="x-translation" xml:lang="fr">Comme autrefois à présent</span><span ttm:role="x-translation" xml:lang="es">Como antes ahora</span><span ttm:role="x-translation" xml:lang="de">Wie einst so auch jetzt</span><span ttm:role="x-translation" xml:lang="pt">Como antes agora</span><span ttm:role="x-roman">Kak prezhde seychas</span></p><p begin="1:04.760" end="1:10.570" itunes:key="L10" ttm:agent="v1"><span begin="1:04.760" end="1:05.160">Зем</span><span begin="1:05.160" end="1:05.220">л</span><span begin="1:05.220" end="1:05.850">я</span> <span begin="1:05.850" end="1:05.980">в</span><span begin="1:05.980" end="1:06.240">ды</span><span begin="1:06.390" end="1:07.600">ха</span><span begin="1:08.010" end="1:08.310">ет</span> <span begin="1:08.310" end="1:08.380">в</span><span begin="1:08.380" end="1:08.490">з</span><span begin="1:08.490" end="1:09.640">ры</span><span begin="1:09.990" end="1:10.570">вы</span><span ttm:role="x-translation" xml:lang="zh-Hans">大地吸入了爆炸的轰鸣</span><span ttm:role="x-translation" xml:lang="zh-Hant">大地吸入了爆炸的轟鳴</span><span ttm:role="x-translation" xml:lang="en">The earth breathes in explosions</span><span ttm:role="x-translation" xml:lang="ja">大地は爆炎を吸い込んでいる</span><span ttm:role="x-translation" xml:lang="ko">대지는 폭발을 들이마시고</span><span ttm:role="x-translation" xml:lang="fr">La terre respire les explosions</span><span ttm:role="x-translation" xml:lang="es">La tierra respira las explosiones</span><span ttm:role="x-translation" xml:lang="de">Die Erde atmet Explosionen ein</span><span ttm:role="x-translation" xml:lang="pt">A terra respira as explosões</span><span ttm:role="x-roman">Zemlya vdykhayet vzryvy</span></p><p begin="1:11.120" end="1:13.570" itunes:key="L11" ttm:agent="v1"><span begin="1:11.120" end="1:11.220">С</span><span begin="1:11.220" end="1:11.370">ерд</span><span begin="1:11.570" end="1:12.170">ца</span> <span begin="1:12.170" end="1:12.280">на</span><span begin="1:12.380" end="1:12.570">ши</span> <span begin="1:12.570" end="1:12.770">го</span><span begin="1:12.770" end="1:13.390">ря</span><span begin="1:13.530" end="1:13.570">т</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们的心正在燃烧</span><span ttm:role="x-translation" xml:lang="zh-Hant">我們的心正在燃燒</span><span ttm:role="x-translation" xml:lang="en">Our hearts are burning</span><span ttm:role="x-translation" xml:lang="ja">私たちの心は燃えている</span><span ttm:role="x-translation" xml:lang="ko">우리의 심장은 불타올라</span><span ttm:role="x-translation" xml:lang="fr">Nos cœurs brûlent</span><span ttm:role="x-translation" xml:lang="es">Nuestros corazones arden</span><span ttm:role="x-translation" xml:lang="de">Unsere Herzen stehen in Flammen</span><span ttm:role="x-translation" xml:lang="pt">Nossos corações ardem</span><span ttm:role="x-roman">Serdtsa nashi goryat</span></p><p begin="1:14.360" end="1:20.000" itunes:key="L12" ttm:agent="v1"><span begin="1:14.360" end="1:14.680">Зов</span> <span begin="1:14.800" end="1:15.200">би</span><span begin="1:15.300" end="1:15.340">т</span><span begin="1:15.340" end="1:15.560">вы</span> <span begin="1:15.560" end="1:15.760">раз</span><span begin="1:15.760" end="1:15.880">жи</span><span begin="1:16.000" end="1:16.790">га</span><span begin="1:16.790" end="1:17.130">е</span><span begin="1:17.130" end="1:17.200">т</span> <span begin="1:17.940" end="1:18.460">кровь</span> <span begin="1:18.460" end="1:18.570">в</span> <span begin="1:18.570" end="1:18.760">на</span><span begin="1:18.760" end="1:18.900">ших</span> <span begin="1:19.010" end="1:19.180">те</span><span begin="1:19.180" end="1:20.000">лах</span><span ttm:role="x-translation" xml:lang="zh-Hans">战斗的召唤 令热血在我们体内燃烧</span><span ttm:role="x-translation" xml:lang="zh-Hant">戰鬥的召喚 令熱血在我們體內燃燒</span><span ttm:role="x-translation" xml:lang="en">The call of battle sets the blood in our bodies ablaze</span><span ttm:role="x-translation" xml:lang="ja">戦いの呼び声が この身を巡る血を燃え上がらせる</span><span ttm:role="x-translation" xml:lang="ko">전투의 부름이 우리 몸속 피를 끓어오르게 해</span><span ttm:role="x-translation" xml:lang="fr">L’appel du combat embrase le sang dans nos corps</span><span ttm:role="x-translation" xml:lang="es">La llamada de la batalla enciende la sangre en nuestros cuerpos</span><span ttm:role="x-translation" xml:lang="de">Der Ruf der Schlacht lässt das Blut in unseren Körpern entflammen</span><span ttm:role="x-translation" xml:lang="pt">O chamado da batalha incendeia o sangue em nossos corpos</span><span ttm:role="x-roman">Zov bitvy razzhigayet krov&apos; v nashikh telakh</span></p><p begin="1:20.800" end="1:21.970" itunes:key="L13" ttm:agent="v1"><span begin="1:20.800" end="1:21.230">По</span><span begin="1:21.230" end="1:21.970">ра</span><span ttm:role="x-translation" xml:lang="zh-Hans">时机已到</span><span ttm:role="x-translation" xml:lang="zh-Hant">時機已到</span><span ttm:role="x-translation" xml:lang="en">It is time</span><span ttm:role="x-translation" xml:lang="ja">時は来た</span><span ttm:role="x-translation" xml:lang="ko">때가 왔어</span><span ttm:role="x-translation" xml:lang="fr">L’heure est venue</span><span ttm:role="x-translation" xml:lang="es">Es la hora</span><span ttm:role="x-translation" xml:lang="de">Es ist Zeit</span><span ttm:role="x-translation" xml:lang="pt">É hora</span><span ttm:role="x-roman">Pora</span></p><p begin="1:22.410" end="1:23.800" itunes:key="L14" ttm:agent="v1"><span begin="1:22.410" end="1:22.840">По</span><span begin="1:22.840" end="1:23.800">ра</span><span ttm:role="x-translation" xml:lang="zh-Hans">时机已到</span><span ttm:role="x-translation" xml:lang="zh-Hant">時機已到</span><span ttm:role="x-translation" xml:lang="en">It is time</span><span ttm:role="x-translation" xml:lang="ja">時は来た</span><span ttm:role="x-translation" xml:lang="ko">때가 왔어</span><span ttm:role="x-translation" xml:lang="fr">L’heure est venue</span><span ttm:role="x-translation" xml:lang="es">Es la hora</span><span ttm:role="x-translation" xml:lang="de">Es ist Zeit</span><span ttm:role="x-translation" xml:lang="pt">É hora</span><span ttm:role="x-roman">Pora</span></p><p begin="1:23.980" end="1:25.270" itunes:key="L15" ttm:agent="v1"><span begin="1:23.980" end="1:24.430">По</span><span begin="1:24.430" end="1:25.270">ра</span><span ttm:role="x-translation" xml:lang="zh-Hans">时机已到</span><span ttm:role="x-translation" xml:lang="zh-Hant">時機已到\</span><span ttm:role="x-translation" xml:lang="en">It is time</span><span ttm:role="x-translation" xml:lang="ja">時は来た</span><span ttm:role="x-translation" xml:lang="ko">때가 왔어</span><span ttm:role="x-translation" xml:lang="fr">L’heure est venue</span><span ttm:role="x-translation" xml:lang="es">Es la hora</span><span ttm:role="x-translation" xml:lang="de">Es ist Zeit</span><span ttm:role="x-translation" xml:lang="pt">É hora</span><span ttm:role="x-roman">Pora</span></p></div></body></tt>