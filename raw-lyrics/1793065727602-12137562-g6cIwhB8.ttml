<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="空に免じて (feat. 初音ミク)"/><amll:meta key="artists" value="傘村トータ"/><amll:meta key="artists" value="初音ミク"/><amll:meta key="album" value="初音ミク「マジカルミライ 2026」OFFICIAL ALBUM"/><amll:meta key="isrc" value="JP92Q2600917"/><amll:meta key="spotifyId" value="1LdgGAdSWRjt05cPosfyRP"/><amll:meta key="appleMusicId" value="6785412074"/><amll:meta key="qqMusicId" value="003hqlqF1yrLUY"/><amll:meta key="ncmMusicId" value="3394786406"/><amll:meta key="ttmlAuthorGithubLogin" value="Mrs4s"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>傘村トータ</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="4:15.268"><div begin="28.728" end="4:15.268"><p begin="28.728" end="30.456" itunes:key="L1" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">「頑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="28.728" end="29.133">がん</span></span></span><span tts:ruby="container"><span tts:ruby="base">張</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="29.133" end="29.343">ば</span></span></span><span begin="29.343" end="29.723">れ」</span> <span begin="29.723" end="29.933">で</span><span begin="29.933" end="30.456">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">既不是“加油”</span><span ttm:role="x-roman">ganbare demo</span></p><p begin="30.703" end="32.989" itunes:key="L2" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">「大</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="30.703" end="31.113">だい</span></span></span><span tts:ruby="container"><span tts:ruby="base">丈</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="31.113" end="31.533">じょう</span></span></span><span tts:ruby="container"><span tts:ruby="base">夫」</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="31.533" end="31.713">ぶ</span></span></span> <span begin="31.713" end="32.093">で</span><span begin="32.093" end="32.293">も</span><span begin="32.293" end="32.640">な</span><span begin="32.640" end="32.989">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">也不是“没关系”</span><span ttm:role="x-roman">daijoubu demo nai</span></p><p begin="34.825" end="39.230" itunes:key="L3" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">「君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="34.825" end="35.473">きみ</span></span></span><span begin="35.473" end="35.683">な</span><span begin="35.683" end="36.040">ら</span><span begin="37.008" end="37.215">で</span><span begin="37.215" end="37.443">き</span><span begin="37.443" end="37.813">る」</span> <span begin="37.813" end="38.023">で</span><span begin="38.023" end="38.623">も</span><span begin="38.623" end="38.930">な</span><span begin="38.930" end="39.230">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">更不是“你一定可以”</span><span ttm:role="x-roman">kimi nara dekiru demo nai</span></p><p begin="41.373" end="45.819" itunes:key="L4" ttm:agent="v1"><span begin="41.373" end="41.593">あ</span><span begin="41.593" end="41.723">の</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="41.723" end="41.973">ひ</span></span></span><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="41.973" end="42.553">ぼく</span></span></span><span begin="42.553" end="43.144">が</span><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="43.345" end="43.543">い</span></span></span><span begin="43.543" end="43.743">わ</span><span begin="43.743" end="44.133">れ</span><span begin="44.133" end="44.323">た</span><span begin="44.323" end="44.923">かっ</span><span begin="44.923" end="45.819">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">那一天我真正渴望听到的</span><span ttm:role="x-roman">ano hi boku ga iwaretakatta</span></p><p begin="47.462" end="52.015" itunes:key="L5" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="47.462" end="48.083">こと</span></span></span><span tts:ruby="container"><span tts:ruby="base">葉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="48.083" end="48.273">ば</span></span></span><span begin="48.273" end="48.615">を</span><span begin="48.791" end="49.653">ずっ</span><span begin="49.653" end="49.943">と</span><span tts:ruby="container"><span tts:ruby="base">探</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="49.943" end="50.573">さが</span></span></span><span begin="50.573" end="51.043">し</span><span begin="51.043" end="51.253">て</span><span begin="51.253" end="52.015">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">那句话语 我始终在寻觅</span><span ttm:role="x-roman">kotoba o zutto sagashiteru</span></p><p begin="53.809" end="55.670" itunes:key="L6" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">雨</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="53.809" end="54.223">あめ</span></span></span><span begin="54.223" end="54.413">に</span><span begin="54.413" end="54.623">も</span><span tts:ruby="container"><span tts:ruby="base">負</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="54.623" end="54.983">ま</span></span></span><span begin="54.983" end="55.193">け</span><span begin="55.193" end="55.670">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">既输给了雨</span><span ttm:role="x-roman">ame ni mo makete</span></p><p begin="55.965" end="58.627" itunes:key="L7" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">風</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="55.965" end="56.403">かぜ</span></span></span><span begin="56.403" end="56.773">に</span><span begin="56.773" end="56.973">も</span><span tts:ruby="container"><span tts:ruby="base">負</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="56.973" end="57.343">ま</span></span></span><span begin="57.343" end="57.573">け</span><span begin="57.573" end="58.627">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">也输给了风</span><span ttm:role="x-roman">kaze ni mo makete</span></p><p begin="1:00.085" end="1:04.522" itunes:key="L8" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">丈</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:00.085" end="1:00.713">じょう</span></span></span><span tts:ruby="container"><span tts:ruby="base">夫</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:00.713" end="1:00.933">ぶ</span></span></span><span begin="1:00.933" end="1:01.387">な</span><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:02.280" end="1:03.083">こころ</span></span></span><span begin="1:03.083" end="1:03.293">も</span><span tts:ruby="container"><span tts:ruby="base">無</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:03.293" end="1:03.673">な</span></span></span><span begin="1:03.673" end="1:03.883">い</span><span begin="1:03.883" end="1:04.522">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">更没有一颗坚韧的心</span><span ttm:role="x-roman">joubu na kokoro mo nai ga</span></p><p begin="1:06.584" end="1:11.048" itunes:key="L9" ttm:agent="v1"><span begin="1:06.584" end="1:06.833">ふ</span><span begin="1:06.833" end="1:07.063">と</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:07.063" end="1:07.283">み</span></span></span><span tts:ruby="container"><span tts:ruby="base">上</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:07.283" end="1:07.643">あ</span></span></span><span begin="1:07.643" end="1:07.853">げ</span><span begin="1:07.853" end="1:08.341">た</span><span tts:ruby="container"><span tts:ruby="base">曇</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:08.590" end="1:09.423">くも</span></span></span><span begin="1:09.423" end="1:09.583">り</span><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:09.583" end="1:10.223">ぞら</span></span></span><span begin="1:10.223" end="1:11.048">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">可不经意间仰望的那片阴空</span><span ttm:role="x-roman">futo miageta kumorizora ga</span></p><p begin="1:12.752" end="1:17.104" itunes:key="L10" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">優</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:12.752" end="1:13.243">やさ</span></span></span><span begin="1:13.243" end="1:13.513">し</span><span begin="1:13.513" end="1:13.966">く</span><span tts:ruby="container"><span tts:ruby="base">笑っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:14.523" end="1:15.733">わら</span></span></span><span begin="1:15.733" end="1:15.933">て</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:15.933" end="1:16.343">み</span></span></span><span begin="1:16.343" end="1:16.533">え</span><span begin="1:16.533" end="1:17.104">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">看起来却正温柔地微笑着</span><span ttm:role="x-roman">yasashiku waratte mieta</span></p><p begin="1:17.879" end="1:20.936" itunes:key="L11" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:17.879" end="1:18.053">い</span></span></span><span begin="1:18.053" end="1:18.283">き</span><span begin="1:18.283" end="1:18.476">る</span><span tts:ruby="container"><span tts:ruby="base">意</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:18.476" end="1:18.883">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">味</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:18.883" end="1:19.083">み</span></span></span><span begin="1:19.083" end="1:19.663">な</span><span begin="1:19.663" end="1:20.064">ん</span><span begin="1:20.064" end="1:20.936">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">所谓活着的意义</span><span ttm:role="x-roman">ikiru imi nante</span></p><p begin="1:21.216" end="1:24.119" itunes:key="L12" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">理</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:21.216" end="1:21.613">り</span></span></span><span tts:ruby="container"><span tts:ruby="base">由</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:21.613" end="1:22.243">ゆう</span></span></span><span begin="1:22.243" end="1:22.825">な</span><span begin="1:22.825" end="1:23.253">ん</span><span begin="1:23.253" end="1:24.119">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">所谓的理由</span><span ttm:role="x-roman">riyuu nante</span></p><p begin="1:24.387" end="1:31.604" itunes:key="L13" ttm:agent="v1"><span begin="1:24.387" end="1:24.803">わ</span><span begin="1:24.803" end="1:25.203">か</span><span begin="1:25.203" end="1:25.593">ら</span><span begin="1:25.593" end="1:25.953">な</span><span begin="1:25.953" end="1:26.173">く</span><span begin="1:26.173" end="1:26.686">て</span><span tts:ruby="container"><span tts:ruby="base">当</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:26.770" end="1:27.163">あ</span></span></span><span begin="1:27.163" end="1:27.563">た</span><span begin="1:27.563" end="1:27.953">り</span><span tts:ruby="container"><span tts:ruby="base">前</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:27.953" end="1:30.723">まえ</span></span></span><span begin="1:30.723" end="1:30.923">だ</span><span begin="1:30.923" end="1:31.604">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">不明白也是理所当然的啊</span><span ttm:role="x-roman">wakaranakute atarimae da yo</span></p><p begin="1:33.351" end="1:39.579" itunes:key="L14" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:33.351" end="1:34.303">そら</span></span></span><span begin="1:34.303" end="1:34.673">に</span><span tts:ruby="container"><span tts:ruby="base">免</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:34.673" end="1:35.383">めん</span></span></span><span begin="1:35.383" end="1:35.843">じ</span><span begin="1:35.843" end="1:36.421">て</span><span tts:ruby="container"><span tts:ruby="base">今日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:36.621" end="1:37.413">きょう</span></span></span><span begin="1:37.413" end="1:37.813">は</span><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:37.813" end="1:37.993">い</span></span></span><span begin="1:37.993" end="1:38.598">き</span><span begin="1:38.598" end="1:38.993">よ</span><span begin="1:38.993" end="1:39.579">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">看在天空的份上 今天就活下去吧</span><span ttm:role="x-roman">sora ni menjite kyou wa ikiyou</span></p><p begin="1:39.672" end="1:46.020" itunes:key="L15" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:39.672" end="1:40.613">そら</span></span></span><span begin="1:40.613" end="1:40.993">に</span><span tts:ruby="container"><span tts:ruby="base">免</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:40.993" end="1:41.713">めん</span></span></span><span begin="1:41.713" end="1:42.163">じ</span><span begin="1:42.163" end="1:42.727">て</span><span tts:ruby="container"><span tts:ruby="base">今日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:42.944" end="1:43.723">きょう</span></span></span><span begin="1:43.723" end="1:44.123">は</span><span tts:ruby="container"><span tts:ruby="base">帰</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:44.123" end="1:44.933">かえ</span></span></span><span begin="1:44.933" end="1:45.353">ろ</span><span begin="1:45.353" end="1:46.020">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">看在天空的份上 今天就回家去吧</span><span ttm:role="x-roman">sora ni menjite kyou wa kaerou</span></p><p begin="1:46.023" end="1:52.115" itunes:key="L16" ttm:agent="v1"><span begin="1:46.023" end="1:46.513">ひ</span><span begin="1:46.513" end="1:46.903">び</span><span tts:ruby="container"><span tts:ruby="base">割</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:46.903" end="1:47.313">わ</span></span></span><span begin="1:47.313" end="1:47.508">れ</span><span begin="1:47.508" end="1:48.063">た</span><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:48.063" end="1:49.603">こころ</span></span></span> <span tts:ruby="container"><span tts:ruby="base">繋</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:49.603" end="1:50.473">つな</span></span></span><span begin="1:50.473" end="1:50.663">ぎ</span><span tts:ruby="container"><span tts:ruby="base">止</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:50.663" end="1:51.263">と</span></span></span><span begin="1:51.263" end="1:51.653">め</span><span begin="1:51.653" end="1:52.115">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">将满是裂痕的心紧紧维系</span><span ttm:role="x-roman">hibiwareta kokoro tsunagitomeru</span></p><p begin="1:52.305" end="1:59.280" itunes:key="L17" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:52.305" end="1:53.193">そら</span></span></span><span begin="1:53.193" end="1:53.623">に</span><span tts:ruby="container"><span tts:ruby="base">免</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:53.623" end="1:54.333">めん</span></span></span><span begin="1:54.333" end="1:54.753">じ</span><span begin="1:54.753" end="1:55.583">て</span><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:55.583" end="1:56.343">ぼく</span></span></span><span begin="1:56.343" end="1:56.783">を</span><span tts:ruby="container"><span tts:ruby="base">許</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:56.783" end="1:57.403">ゆる</span></span></span><span begin="1:57.403" end="1:57.987">そ</span><span begin="1:57.987" end="1:59.280">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">看在天空的份上 原谅我自己吧</span><span ttm:role="x-roman">sora ni menjite boku o yurusou</span></p><p begin="2:00.208" end="2:04.952" itunes:key="L18" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">信</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:00.208" end="2:00.673">しん</span></span></span><span begin="2:00.673" end="2:00.923">じ</span><span begin="2:00.923" end="2:01.303">る</span><span begin="2:01.303" end="2:01.513">か</span><span begin="2:01.513" end="2:02.046">ら</span><span tts:ruby="container"><span tts:ruby="base">裏</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:02.295" end="2:03.083">うら</span></span></span><span tts:ruby="container"><span tts:ruby="base">切</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:03.083" end="2:03.303">ぎ</span></span></span><span begin="2:03.303" end="2:03.703">ら</span><span begin="2:03.703" end="2:03.883">れ</span><span begin="2:03.883" end="2:04.952">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">正因为相信 才会遭遇背叛</span><span ttm:role="x-roman">shinjiru kara uragirareru</span></p><p begin="2:06.403" end="2:10.803" itunes:key="L19" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">期</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:06.403" end="2:06.622">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">待</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:06.622" end="2:06.973">たい</span></span></span><span begin="2:06.973" end="2:07.263">す</span><span begin="2:07.263" end="2:07.650">る</span><span begin="2:08.598" end="2:09.023">か</span><span begin="2:09.023" end="2:09.383">ら</span><span tts:ruby="container"><span tts:ruby="base">傷</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:09.383" end="2:09.923">きず</span></span></span><span begin="2:09.923" end="2:10.163">つ</span><span begin="2:10.163" end="2:10.803">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">正因为期待 才会受到伤害</span><span ttm:role="x-roman">kitai suru kara kizutsuku</span></p><p begin="2:12.943" end="2:17.033" itunes:key="L20" ttm:agent="v1"><span begin="2:12.943" end="2:13.143">わ</span><span begin="2:13.143" end="2:13.523">かっ</span><span begin="2:13.523" end="2:13.943">て</span><span begin="2:13.943" end="2:14.143">て</span><span begin="2:14.143" end="2:14.741">も</span> <span begin="2:14.904" end="2:15.353">や</span><span begin="2:15.353" end="2:15.713">め</span><span begin="2:15.713" end="2:15.933">ら</span><span begin="2:15.933" end="2:16.313">れ</span><span begin="2:16.313" end="2:16.607">な</span><span begin="2:16.607" end="2:17.033">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">哪怕心里明白 却依然无法停止</span><span ttm:role="x-roman">wakattete mo yamerarenai</span></p><p begin="2:19.273" end="2:23.738" itunes:key="L21" ttm:agent="v1"><span begin="2:19.273" end="2:19.666">どっ</span><span begin="2:19.667" end="2:19.893">か</span><span begin="2:19.893" end="2:20.345">で</span><span tts:ruby="container"><span tts:ruby="base">愛</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:20.843" end="2:21.543">あい</span></span></span><span begin="2:21.543" end="2:22.033">し</span><span begin="2:22.033" end="2:22.253">て</span><span begin="2:22.253" end="2:22.653">る</span><span begin="2:22.653" end="2:22.863">か</span><span begin="2:22.863" end="2:23.738">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">只因在心底某处 依然深爱着啊</span><span ttm:role="x-roman">dokka de aishiteru kara</span></p><p begin="2:24.404" end="2:30.201" itunes:key="L22" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">痛</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:24.404" end="2:25.193">いた</span></span></span><span begin="2:25.193" end="2:25.491">み</span><span begin="2:25.491" end="2:25.843">を</span><span tts:ruby="container"><span tts:ruby="base">知</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:25.843" end="2:26.393">し</span></span></span><span begin="2:26.393" end="2:27.156">る</span><span tts:ruby="container"><span tts:ruby="base">者</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:27.553" end="2:28.343">もの</span></span></span><span begin="2:28.343" end="2:28.553">で</span><span begin="2:28.553" end="2:29.133">な</span><span begin="2:29.133" end="2:29.543">い</span><span begin="2:29.543" end="2:30.201">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">若非亲身尝过痛楚的人</span><span ttm:role="x-roman">itami o shiru mono de nai to</span></p><p begin="2:30.541" end="2:37.965" itunes:key="L23" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">泣</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:30.541" end="2:30.693">な</span></span></span><span begin="2:30.693" end="2:30.913">き</span><span tts:ruby="container"><span tts:ruby="base">声</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:30.913" end="2:31.503">ごえ</span></span></span><span begin="2:31.503" end="2:31.773">の</span><span tts:ruby="container"><span tts:ruby="base">周</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:31.773" end="2:32.453">しゅう</span></span></span><span tts:ruby="container"><span tts:ruby="base">波</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:32.453" end="2:32.933">は</span></span></span><span tts:ruby="container"><span tts:ruby="base">数</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:32.933" end="2:33.863">すう</span></span></span><span begin="2:33.863" end="2:34.133">は</span><span tts:ruby="container"><span tts:ruby="base">拾</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:34.133" end="2:36.633">ひろ</span></span></span><span begin="2:36.633" end="2:37.033">え</span><span begin="2:37.033" end="2:37.213">な</span><span begin="2:37.213" end="2:37.965">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">便无法捕捉那哭泣声的频率</span><span ttm:role="x-roman">nakigoe no shuuhasuu wa hiroenai</span></p><p begin="2:39.603" end="2:45.983" itunes:key="L24" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:39.603" end="2:40.460">そら</span></span></span><span begin="2:40.460" end="2:41.003">に</span><span tts:ruby="container"><span tts:ruby="base">免</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:41.003" end="2:41.713">めん</span></span></span><span begin="2:41.713" end="2:42.173">じ</span><span begin="2:42.173" end="2:42.943">て</span><span tts:ruby="container"><span tts:ruby="base">今日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:42.943" end="2:43.733">きょう</span></span></span><span begin="2:43.733" end="2:44.133">は</span><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:44.133" end="2:44.303">い</span></span></span><span begin="2:44.303" end="2:44.933">き</span><span begin="2:44.933" end="2:45.337">よ</span><span begin="2:45.337" end="2:45.983">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">看在天空的份上 今天就活下去吧</span><span ttm:role="x-roman">sora ni menjite kyou wa ikiyou</span></p><p begin="2:45.983" end="2:52.323" itunes:key="L25" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:45.983" end="2:46.883">そら</span></span></span><span begin="2:46.883" end="2:47.303">に</span><span tts:ruby="container"><span tts:ruby="base">免</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:47.303" end="2:48.023">めん</span></span></span><span begin="2:48.023" end="2:48.473">じ</span><span begin="2:48.473" end="2:49.263">て</span><span tts:ruby="container"><span tts:ruby="base">今日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:49.263" end="2:50.073">きょう</span></span></span><span begin="2:50.073" end="2:50.273">は</span><span begin="2:50.273" end="2:50.653">しゃ</span><span begin="2:50.653" end="2:51.263">が</span><span begin="2:51.263" end="2:51.613">も</span><span begin="2:51.613" end="2:52.323">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">看在天空的份上 今天就蹲下歇息吧</span><span ttm:role="x-roman">sora ni menjite kyou wa shagamou</span></p><p begin="2:52.323" end="2:58.613" itunes:key="L26" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">震</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:52.323" end="2:53.203">ふる</span></span></span><span begin="2:53.203" end="2:53.613">え</span><span begin="2:53.613" end="2:53.813">て</span><span begin="2:53.813" end="2:54.383">る</span><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:54.383" end="2:56.270">こころ</span></span></span> <span begin="2:56.270" end="2:56.773">そ</span><span begin="2:56.773" end="2:57.003">ば</span><span begin="2:57.003" end="2:57.585">に</span><span begin="2:57.585" end="2:57.963">い</span><span begin="2:57.963" end="2:58.613">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">陪伴在这颗颤抖不已的心身旁</span><span ttm:role="x-roman">furueteru kokoro soba ni ite</span></p><p begin="2:58.613" end="3:05.818" itunes:key="L27" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:58.613" end="2:59.573">そら</span></span></span><span begin="2:59.573" end="2:59.923">に</span><span tts:ruby="container"><span tts:ruby="base">免</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:59.923" end="3:00.653">めん</span></span></span><span begin="3:00.653" end="3:01.153">じ</span><span begin="3:01.153" end="3:01.893">て</span><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:01.893" end="3:02.711">ぼく</span></span></span><span begin="3:02.711" end="3:03.093">を</span><span tts:ruby="container"><span tts:ruby="base">許</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:03.093" end="3:03.753">ゆる</span></span></span><span begin="3:03.753" end="3:04.308">そ</span><span begin="3:04.308" end="3:05.818">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">看在天空的份上 原谅我自己吧</span><span ttm:role="x-roman">sora ni menjite boku o yurusou</span></p><p begin="3:18.003" end="3:24.000" itunes:key="L28" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:18.003" end="3:19.113">ひかり</span></span></span><span tts:ruby="container"><span tts:ruby="base">降</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:19.113" end="3:19.653">ふ</span></span></span><span begin="3:19.653" end="3:19.873">り</span><span begin="3:19.873" end="3:20.173">そ</span><span begin="3:20.173" end="3:20.663">そ</span><span begin="3:20.663" end="3:21.183">ぐ</span><span tts:ruby="container"><span tts:ruby="base">人</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:21.183" end="3:21.533">じん</span></span></span><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:21.533" end="3:21.983">せい</span></span></span><span begin="3:21.983" end="3:22.433">じゃ</span><span begin="3:22.433" end="3:22.623">な</span><span begin="3:22.623" end="3:23.063">い</span><span begin="3:23.063" end="3:24.000">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">这并非一路洒满阳光的人生</span><span ttm:role="x-roman">hikari furisosogu jinsei ja nai yo</span></p><p begin="3:24.403" end="3:30.200" itunes:key="L29" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">涙</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:24.403" end="3:25.573">なみだ</span></span></span><span begin="3:25.573" end="3:25.983">に</span><span begin="3:25.983" end="3:26.373">ま</span><span begin="3:26.373" end="3:26.583">み</span><span begin="3:26.583" end="3:26.963">れ</span><span begin="3:26.963" end="3:27.553">た</span><span tts:ruby="container"><span tts:ruby="base">過</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:27.553" end="3:27.943">か</span></span></span><span tts:ruby="container"><span tts:ruby="base">去</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:27.943" end="3:28.350">こ</span></span></span><span begin="3:28.350" end="3:28.743">も</span><span begin="3:28.743" end="3:28.943">あ</span><span begin="3:28.943" end="3:29.373">る</span><span begin="3:29.373" end="3:30.200">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">也曾有过被泪水浸湿的过往</span><span ttm:role="x-roman">namida ni mamireta kako mo aru yo</span></p><p begin="3:30.513" end="3:33.873" itunes:key="L30" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:30.513" end="3:30.683">い</span></span></span><span begin="3:30.683" end="3:30.925">き</span><span begin="3:30.925" end="3:31.217">る</span><span tts:ruby="container"><span tts:ruby="base">意</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:31.217" end="3:31.513">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">味</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:31.513" end="3:31.703">み</span></span></span><span begin="3:31.703" end="3:32.293">な</span><span begin="3:32.293" end="3:32.683">ん</span><span begin="3:32.683" end="3:33.873">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">所谓活着的意义</span><span ttm:role="x-roman">ikiru imi nante</span></p><p begin="3:33.873" end="3:36.590" itunes:key="L31" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">理</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:33.873" end="3:34.273">り</span></span></span><span tts:ruby="container"><span tts:ruby="base">由</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:34.273" end="3:34.873">ゆう</span></span></span><span begin="3:34.873" end="3:35.453">な</span><span begin="3:35.453" end="3:35.853">ん</span><span begin="3:35.853" end="3:36.590">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">所谓的理由</span><span ttm:role="x-roman">riyuu nante</span></p><p begin="3:37.023" end="3:44.424" itunes:key="L32" ttm:agent="v1"><span begin="3:37.023" end="3:37.403">わ</span><span begin="3:37.403" end="3:37.823">か</span><span begin="3:37.823" end="3:38.233">ら</span><span begin="3:38.233" end="3:38.603">な</span><span begin="3:38.603" end="3:38.833">く</span><span begin="3:38.833" end="3:39.403">て</span><span tts:ruby="container"><span tts:ruby="base">当</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:39.403" end="3:39.793">あ</span></span></span><span begin="3:39.793" end="3:40.203">た</span><span begin="3:40.203" end="3:40.583">り</span><span tts:ruby="container"><span tts:ruby="base">前</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:40.583" end="3:43.343">まえ</span></span></span><span begin="3:43.343" end="3:43.543">だ</span><span begin="3:43.543" end="3:44.424">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">不明白也是理所当然的啊</span><span ttm:role="x-roman">wakaranakute atarimae da yo</span></p><p begin="3:49.043" end="3:55.483" itunes:key="L33" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:49.043" end="3:50.083">そら</span></span></span><span begin="3:50.083" end="3:50.473">に</span><span tts:ruby="container"><span tts:ruby="base">免</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:50.473" end="3:51.183">めん</span></span></span><span begin="3:51.183" end="3:51.673">じ</span><span begin="3:51.673" end="3:52.423">て</span><span tts:ruby="container"><span tts:ruby="base">今日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:52.423" end="3:53.173">きょう</span></span></span><span begin="3:53.173" end="3:53.593">は</span><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:53.593" end="3:53.773">い</span></span></span><span begin="3:53.773" end="3:54.403">き</span><span begin="3:54.403" end="3:54.773">よ</span><span begin="3:54.773" end="3:55.483">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">看在天空的份上 今天就活下去吧</span><span ttm:role="x-roman">sora ni menjite kyou wa ikiyou</span></p><p begin="3:55.483" end="4:01.803" itunes:key="L34" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:55.483" end="3:56.383">そら</span></span></span><span begin="3:56.383" end="3:56.793">に</span><span tts:ruby="container"><span tts:ruby="base">免</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:56.793" end="3:57.503">めん</span></span></span><span begin="3:57.503" end="3:57.953">じ</span><span begin="3:57.953" end="3:58.743">て</span><span tts:ruby="container"><span tts:ruby="base">今日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:58.743" end="3:59.458">きょう</span></span></span><span begin="3:59.458" end="3:59.903">は</span><span tts:ruby="container"><span tts:ruby="base">帰</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:59.903" end="4:00.753">かえ</span></span></span><span begin="4:00.753" end="4:01.133">ろ</span><span begin="4:01.133" end="4:01.803">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">看在天空的份上 今天就回家去吧</span><span ttm:role="x-roman">sora ni menjite kyou wa kaerou</span></p><p begin="4:01.803" end="4:08.103" itunes:key="L35" ttm:agent="v1"><span begin="4:01.803" end="4:02.313">ひ</span><span begin="4:02.313" end="4:02.723">び</span><span tts:ruby="container"><span tts:ruby="base">割</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:02.723" end="4:03.113">わ</span></span></span><span begin="4:03.113" end="4:03.303">れ</span><span begin="4:03.303" end="4:03.853">た</span><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:03.853" end="4:05.453">こころ</span></span></span> <span tts:ruby="container"><span tts:ruby="base">繋</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:05.453" end="4:06.223">つな</span></span></span><span begin="4:06.223" end="4:06.433">ぎ</span><span tts:ruby="container"><span tts:ruby="base">止</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:06.433" end="4:07.023">と</span></span></span><span begin="4:07.023" end="4:07.445">め</span><span begin="4:07.445" end="4:08.103">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">将满是裂痕的心紧紧维系</span><span ttm:role="x-roman">hibiwareta kokoro tsunagitomeru</span></p><p begin="4:08.103" end="4:15.268" itunes:key="L36" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:08.103" end="4:09.003">そら</span></span></span><span begin="4:09.003" end="4:09.403">に</span><span tts:ruby="container"><span tts:ruby="base">免</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:09.403" end="4:10.123">めん</span></span></span><span begin="4:10.123" end="4:10.593">じ</span><span begin="4:10.593" end="4:11.373">て</span><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:11.373" end="4:12.223">ぼく</span></span></span><span begin="4:12.223" end="4:12.553">を</span><span tts:ruby="container"><span tts:ruby="base">許</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:12.553" end="4:13.183">ゆる</span></span></span><span begin="4:13.183" end="4:13.726">そ</span><span begin="4:13.726" end="4:15.268">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">看在天空的份上 原谅我自己吧</span><span ttm:role="x-roman">sora ni menjite boku o yurusou</span></p></div></body></tt>