4.442">i</span><span begin="3:34.442" end="3:34.742">ki</span><span begin="3:34.742" end="3:34.862">tu</span><span begin="3:34.862" end="3:35.102">pa</span><span begin="3:35.102" end="3:35.316">su</span><span begin="3:35.316" end="3:35.562">wa</span><span begin="3:35.562" end="3:35.680">o</span><span begin="3:35.680" end="3:35.984">mo</span><span begin="3:35.984" end="3:36.156">chi</span><span begin="3:36.156" end="3:36.362">de</span><span begin="3:36.362" end="3:36.567">su</span><span begin="3:36.567" end="3:37.266">ka</span></text></transliteration></transliterations><songwriters><songwriter>Matthew Tishler</songwriter><songwriter>Daniel J Plante</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:43.552"><div begin="4.065" end="3:43.552"><p begin="4.065" end="6.941" itunes:key="L1" ttm:agent="v1"><span begin="4.065" end="4.469">1</span><span begin="4.877" end="5.333">2</span> <span begin="5.673" end="5.950">1</span><span begin="6.075" end="6.563">2</span><span begin="6.610" end="6.941">3</span></p><p begin="7.789" end="10.920" itunes:key="L2" ttm:agent="v1"><span begin="7.789" end="8.086">強</span><span begin="8.086" end="8.251">者</span><span begin="8.251" end="8.524">に</span><span begin="8.524" end="8.681">媚</span><span begin="8.681" end="8.933">び</span><span begin="8.933" end="9.075">へ</span><span begin="9.145" end="9.398">つ</span><span begin="9.410" end="9.559">ら</span><span begin="9.559" end="9.995">う</span><span begin="9.995" end="10.457">僕</span><span begin="10.457" end="10.920">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">对着强者卑躬屈膝的我</span></p><p begin="11.132" end="14.329" itunes:key="L3" ttm:agent="v1"><span begin="11.132" end="11.457">醒</span><span begin="11.457" end="11.713">め</span><span begin="11.713" end="11.909">た</span><span begin="11.909" end="12.055">視</span><span begin="12.055" end="12.598">線</span><span begin="12.618" end="12.834">が</span><span begin="12.834" end="12.992">突</span><span begin="12.992" end="13.178">き</span><span begin="13.178" end="13.368">刺</span><span begin="13.368" end="13.891">さ</span><span begin="13.891" end="14.329">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">却被冷漠的视线刺痛</span></p><p begin="14.571" end="17.792" itunes:key="L4" ttm:agent="v1"><span begin="14.571" end="14.963">背</span><span begin="14.963" end="15.355">中</span><span begin="15.356" end="15.522">に</span><span begin="15.522" end="15.765">汗</span><span begin="15.765" end="15.996">が</span><span begin="16.027" end="16.269">つ</span><span begin="16.481" end="16.810">た</span><span begin="16.866" end="17.141">って</span><span begin="17.141" end="17.260">ゆ</span><span begin="17.260" end="17.792">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">背后流出一身冷汗</span></p><p begin="18.057" end="21.324" itunes:key="L5" ttm:agent="v1"><span begin="18.057" end="18.628">Some</span><span begin="18.628" end="18.872">one</span> <span begin="18.872" end="19.480">said</span><span begin="19.795" end="20.153">「I</span> <span begin="20.153" end="20.586">hate</span> <span begin="20.736" end="21.324">you」</span><span ttm:role="x-translation" xml:lang="zh-Hans">有人说 我恨你</span></p><p begin="21.561" end="27.987" itunes:key="L6" ttm:agent="v2"><span begin="21.561" end="21.857">あ</span><span begin="21.857" end="21.999">の</span><span begin="21.999" end="22.291">コ</span><span begin="22.291" end="22.405">の</span><span begin="22.405" end="23.088">甘</span><span begin="23.088" end="23.328">った</span><span begin="23.330" end="23.532">る</span><span begin="23.532" end="23.686">い</span><span begin="23.686" end="24.043">声</span><span begin="24.185" end="24.668">を</span><span begin="25.053" end="25.309">か</span><span begin="25.322" end="25.393">わ</span><span begin="25.620" end="25.620">い</span><span begin="25.620" end="25.883">い</span><span begin="25.883" end="26.175">と</span><span begin="26.185" end="26.343">褒</span><span begin="26.343" end="26.613">め</span><span begin="26.613" end="26.972">称</span><span begin="26.972" end="27.197">え</span><span begin="27.197" end="27.443">て</span><span begin="27.443" end="27.599">み</span><span begin="27.599" end="27.987">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">言不由衷地称赞说那个女孩嗲嗲的声音很可爱</span></p><p begin="28.345" end="31.508" itunes:key="L7" ttm:agent="v2"><span begin="28.345" end="28.919">笑</span><span begin="28.919" end="29.138">い</span><span begin="29.139" end="29.575">方</span><span begin="29.605" end="29.718">が</span><span begin="29.719" end="29.974">死</span><span begin="29.974" end="30.139">ぬ</span><span begin="30.232" end="30.616">程</span><span begin="30.616" end="31.132">嫌</span><span begin="31.132" end="31.508">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">其实她谈笑地方式让人厌恶的要死</span></p><p begin="31.834" end="34.872" itunes:key="L8" ttm:agent="v2"><span begin="31.834" end="32.341">Some</span><span begin="32.341" end="32.634">one</span> <span begin="32.634" end="33.205">said</span><span begin="33.603" end="33.939">「I</span> <span begin="33.939" end="34.408">hate</span> <span begin="34.440" end="34.872">you」</span><span ttm:role="x-translation" xml:lang="zh-Hans">有人说 我恨你</span></p><p begin="35.171" end="41.783" itunes:key="L9" ttm:agent="v1"><span begin="35.171" end="35.789">素</span><span begin="35.789" end="36.602">直</span><span begin="36.602" end="37.109">に</span><span begin="37.110" end="37.469">生</span><span begin="37.469" end="37.884">き</span><span begin="37.884" end="38.407">る</span><span begin="38.784" end="39.942">美</span><span begin="40.004" end="40.381">し</span><span begin="40.381" end="40.751">さ</span><span begin="40.751" end="41.783">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">坦诚生活明明就很美丽</span></p><p begin="42.257" end="52.159" itunes:key="L10" ttm:agent="v1"><span begin="42.257" end="43.032">黒</span><span begin="43.047" end="43.400">く</span><span begin="43.400" end="43.988">塗</span><span begin="43.988" end="44.324">ら</span><span begin="44.356" end="44.782">な</span><span begin="44.789" end="46.437">きゃ</span><span begin="47.206" end="47.578">生</span><span begin="47.642" end="47.762">き</span><span begin="47.762" end="48.200">ら</span><span begin="48.200" end="48.396">れ</span><span begin="48.396" end="48.754">な</span><span begin="48.754" end="52.159">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">为什么要把它涂的一团糟呢？</span><span ttm:role="x-bg" begin="47.206" end="52.159"><span begin="47.206" end="47.578">(生</span><span begin="47.642" end="47.762">き</span><span begin="47.762" end="48.200">ら</span><span begin="48.200" end="48.396">れ</span><span begin="48.396" end="48.754">な</span><span begin="48.754" end="52.159">い)</span></span></p><p begin="55.886" end="59.245" itunes:key="L11" ttm:agent="v1"><span begin="55.886" end="56.184">ア</span><span begin="56.184" end="56.326">イ</span><span begin="56.326" end="56.630">ツ</span><span begin="56.630" end="56.762">の</span><span begin="56.762" end="57.362">幸</span><span begin="57.390" end="57.608">せ</span><span begin="57.608" end="58.234">喜</span><span begin="58.264" end="58.358">べ</span><span begin="58.358" end="58.667">ま</span><span begin="58.667" end="58.863">す</span><span begin="58.863" end="59.245">か?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你会为那家伙的幸福感到高兴吗？</span></p><p begin="59.353" end="1:02.735" itunes:key="L12" ttm:agent="v2"><span begin="59.353" end="59.599">あ</span><span begin="59.599" end="59.733">の</span><span begin="59.733" end="1:00.025">コ</span><span begin="1:00.025" end="1:00.179">の</span><span begin="1:00.179" end="1:00.425">も</span><span begin="1:00.425" end="1:00.583">の</span><span begin="1:00.611" end="1:00.798">欲</span><span begin="1:00.798" end="1:01.015">し</span><span begin="1:01.018" end="1:01.449">が</span><span begin="1:01.449" end="1:01.705">って</span><span begin="1:01.705" end="1:01.860">ま</span><span begin="1:01.860" end="1:02.180">せ</span><span begin="1:02.180" end="1:02.304">ん</span><span begin="1:02.304" end="1:02.735">か?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你会想把那个女孩的东西占为己有吗？</span></p><p begin="1:02.769" end="1:06.155" itunes:key="L13" ttm:agent="v1"><span begin="1:02.769" end="1:02.905">果</span><span begin="1:02.905" end="1:03.121">た</span><span begin="1:03.121" end="1:03.424">し</span><span begin="1:03.424" end="1:03.558">て</span><span begin="1:03.558" end="1:03.826">自</span><span begin="1:03.826" end="1:04.003">分</span><span begin="1:04.028" end="1:04.446">は</span><span begin="1:04.478" end="1:04.851">特</span><span begin="1:04.851" end="1:05.294">別</span><span begin="1:05.294" end="1:05.528">で</span><span begin="1:05.528" end="1:05.727">す</span><span begin="1:05.727" end="1:06.155">か?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你会觉得自己是世界上特别的存在吗？</span></p><p begin="1:06.366" end="1:09.217" itunes:key="L14" ttm:agent="v1"><span begin="1:06.565" end="1:07.001">It&apos;s</span> <span begin="1:07.030" end="1:07.503">me</span> <span begin="1:07.764" end="1:07.847">why</span> <span begin="1:07.847" end="1:08.124">don&apos;t</span> <span begin="1:08.124" end="1:08.270">you</span> <span begin="1:08.270" end="1:08.717">kill</span> <span begin="1:08.717" end="1:09.217">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">这就是我 为什么你不杀了我</span></p><p begin="1:09.609" end="1:12.969" itunes:key="L15" ttm:agent="v1"><span begin="1:09.609" end="1:09.771">グ</span><span begin="1:09.771" end="1:10.014">ロ</span><span begin="1:10.014" end="1:10.240">テ</span><span begin="1:10.240" end="1:10.507">ス</span><span begin="1:10.507" end="1:10.731">ク</span><span begin="1:10.731" end="1:10.869">な</span><span begin="1:10.869" end="1:11.308">僕</span><span begin="1:11.308" end="1:11.597">を</span><span begin="1:11.597" end="1:11.933">愛</span><span begin="1:11.933" end="1:12.117">せ</span><span begin="1:12.117" end="1:12.391">ま</span><span begin="1:12.391" end="1:12.575">す</span><span begin="1:12.575" end="1:12.969">か?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你会爱上怪诞的我吗？</span></p><p begin="1:13.082" end="1:16.335" itunes:key="L16" ttm:agent="v1"><span begin="1:13.082" end="1:13.430">本</span><span begin="1:13.460" end="1:13.625">当</span><span begin="1:13.625" end="1:13.871">は</span><span begin="1:13.871" end="1:14.151">泣</span><span begin="1:14.151" end="1:14.349">き</span><span begin="1:14.349" end="1:14.547">た</span><span begin="1:14.547" end="1:14.818">い</span><span begin="1:14.818" end="1:14.939">ん</span><span begin="1:14.943" end="1:14.977">じ</span><span begin="1:14.977" end="1:15.096">ゃ</span><span begin="1:15.096" end="1:15.391">な</span><span begin="1:15.391" end="1:15.601">い</span><span begin="1:15.601" end="1:15.829">で</span><span begin="1:15.829" end="1:15.997">す</span><span begin="1:15.997" end="1:16.335">か?</span><span ttm:role="x-translation" xml:lang="zh-Hans">其实你很想哭对吧？</span></p><p begin="1:16.509" end="1:19.928" itunes:key="L17" ttm:agent="v1"><span begin="1:16.509" end="1:16.878">今</span><span begin="1:16.878" end="1:17.133">を</span><span begin="1:17.133" end="1:17.279">生</span><span begin="1:17.279" end="1:17.575">き</span><span begin="1:17.575" end="1:17.690">る</span><span begin="1:17.690" end="1:17.925">パ</span><span begin="1:17.925" end="1:18.167">ス</span><span begin="1:18.167" end="1:18.434">は</span><span begin="1:18.434" end="1:18.593">お</span><span begin="1:18.593" end="1:18.849">持</span><span begin="1:18.849" end="1:19.005">ち</span><span begin="1:19.005" end="1:19.251">で</span><span begin="1:19.251" end="1:19.444">す</span><span begin="1:19.444" end="1:19.928">か?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你是那种活在当下的人吗？</span></p><p begin="1:20.340" end="1:22.988" itunes:key="L18" ttm:agent="v1"><span begin="1:20.360" end="1:20.745">It&apos;s</span> <span begin="1:20.745" end="1:21.201">me</span> <span begin="1:21.450" end="1:21.572">why</span> <span begin="1:21.572" end="1:21.800">don&apos;t</span> <span begin="1:21.800" end="1:21.988">you</span> <span begin="1:21.988" end="1:22.432">kill</span> <span begin="1:22.464" end="1:22.988">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">这就是我 为什么你不杀了我</span></p><p begin="1:23.796" end="1:26.294" itunes:key="L19" ttm:agent="v1"><span begin="1:23.796" end="1:24.055">It&apos;s</span> <span begin="1:24.206" end="1:24.633">me</span> <span begin="1:24.831" end="1:24.978">why</span> <span begin="1:24.978" end="1:25.261">don&apos;t</span> <span begin="1:25.285" end="1:25.392">you</span> <span begin="1:25.424" end="1:25.846">kill</span> <span begin="1:25.908" end="1:26.294">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">这就是我 为什么你不杀了我</span></p><p begin="1:26.339" end="1:29.609" itunes:key="L20" ttm:agent="v1"><span begin="1:26.339" end="1:26.676">1</span> <span begin="1:27.211" end="1:27.617">2</span> <span begin="1:28.050" end="1:28.430">1</span> <span begin="1:28.483" end="1:28.823">2</span> <span begin="1:28.905" end="1:29.609">3</span></p><p begin="1:30.039" end="1:33.241" itunes:key="L21" ttm:agent="v1"><span begin="1:30.039" end="1:30.409">「す」</span><span begin="1:30.409" end="1:30.587">の</span><span begin="1:30.587" end="1:31.027">一</span><span begin="1:31.027" end="1:31.270">文</span><span begin="1:31.270" end="1:31.510">字</span><span begin="1:31.510" end="1:31.897">入</span><span begin="1:31.897" end="1:32.246">力</span><span begin="1:32.246" end="1:32.567">す</span><span begin="1:32.567" end="1:32.715">れ</span><span begin="1:32.715" end="1:33.241">ば</span><span ttm:role="x-translation" xml:lang="zh-Hans">只要输入一个「su」字</span><span ttm:role="x-bg" begin="1:31.897" end="1:33.241"><span begin="1:31.897" end="1:32.246">(力</span><span begin="1:32.246" end="1:32.567">す</span><span begin="1:32.567" end="1:32.715">れ</span><span begin="1:32.715" end="1:33.241">ば)</span></span></p><p begin="1:33.484" end="1:36.598" itunes:key="L22" ttm:agent="v1"><span begin="1:33.484" end="1:33.750">「す</span><span begin="1:33.750" end="1:33.943">い</span><span begin="1:33.943" end="1:34.174">ま</span><span begin="1:34.174" end="1:34.420">せ</span><span begin="1:34.464" end="1:34.657">ん」</span><span begin="1:34.687" end="1:34.835">と</span><span begin="1:34.835" end="1:35.037">予</span><span begin="1:35.037" end="1:35.493">測</span><span begin="1:35.493" end="1:35.964">変</span><span begin="1:35.964" end="1:36.598">換</span><span ttm:role="x-translation" xml:lang="zh-Hans">就会预测「すいません」（suimasen对不起）&lt;スキ(suki)是喜爱)&gt;</span><span ttm:role="x-bg" begin="1:35.493" end="1:36.598"><span begin="1:35.493" end="1:35.964">(変</span><span begin="1:35.964" end="1:36.598">換)</span></span></p><p begin="1:36.957" end="1:40.211" itunes:key="L23" ttm:agent="v1"><span begin="1:36.957" end="1:37.606">心</span><span begin="1:37.636" end="1:37.746">な</span><span begin="1:37.746" end="1:38.120">い</span><span begin="1:38.120" end="1:38.464">指</span><span begin="1:38.464" end="1:38.966">先</span><span begin="1:38.966" end="1:39.131">の</span><span begin="1:39.131" end="1:39.600">謝</span><span begin="1:39.600" end="1:40.211">罪</span><span ttm:role="x-translation" xml:lang="zh-Hans">假情假意地用手指来道歉</span><span ttm:role="x-bg" begin="1:38.825" end="1:40.211"><span begin="1:38.825" end="1:38.966">(先</span><span begin="1:38.966" end="1:39.131">の</span><span begin="1:39.131" end="1:39.600">謝</span><span begin="1:39.600" end="1:40.211">罪)</span></span></p><p begin="1:40.371" end="1:43.506" itunes:key="L24" ttm:agent="v1"><span begin="1:40.371" end="1:40.921">Some</span><span begin="1:40.921" end="1:41.187">one</span> <span begin="1:41.187" end="1:41.711">said</span><span begin="1:42.104" end="1:42.532">「I</span> <span begin="1:42.532" end="1:42.978">hate</span> <span begin="1:43.072" end="1:43.506">you」</span><span ttm:role="x-translation" xml:lang="zh-Hans">有人说 我恨你</span></p><p begin="1:43.758" end="1:46.826" itunes:key="L25" ttm:agent="v2"><span begin="1:43.758" end="1:44.563">空</span><span begin="1:44.563" end="1:44.744">が</span><span begin="1:44.744" end="1:45.022">青</span><span begin="1:45.022" end="1:45.106">く</span><span begin="1:45.106" end="1:45.496">澄</span><span begin="1:45.496" end="1:45.632">み</span><span begin="1:45.632" end="1:45.998">渡</span><span begin="1:45.998" end="1:46.264">る</span><span begin="1:46.264" end="1:46.460">ほ</span><span begin="1:46.460" end="1:46.826">ど</span><span ttm:role="x-translation" xml:lang="zh-Hans">天空越是晴空万里</span><span ttm:role="x-bg" begin="1:45.632" end="1:46.826"><span begin="1:45.632" end="1:45.998">(渡</span><span begin="1:45.998" end="1:46.264">る</span><span begin="1:46.264" end="1:46.460">ほ</span><span begin="1:46.460" end="1:46.826">ど)</span></span></p><p begin="1:47.307" end="1:50.318" itunes:key="L26" ttm:agent="v2"><span begin="1:47.307" end="1:47.765">風</span><span begin="1:47.765" end="1:48.003">が</span><span begin="1:48.003" end="1:48.402">優</span><span begin="1:48.402" end="1:48.626">し</span><span begin="1:48.626" end="1:48.907">く</span><span begin="1:48.907" end="1:49.405">流</span><span begin="1:49.405" end="1:49.445">れ</span><span begin="1:49.445" end="1:49.741">る</span><span begin="1:49.741" end="1:49.932">ほ</span><span begin="1:49.932" end="1:50.318">ど</span><span ttm:role="x-translation" xml:lang="zh-Hans">微风越是温柔流动</span><span ttm:role="x-bg" begin="1:48.907" end="1:50.318"><span begin="1:48.907" end="1:49.405">(流</span><span begin="1:49.405" end="1:49.445">れ</span><span begin="1:49.445" end="1:49.741">る</span><span begin="1:49.741" end="1:49.932">ほ</span><span begin="1:49.932" end="1:50.318">ど)</span></span></p><p begin="1:50.773" end="1:53.772" itunes:key="L27" ttm:agent="v2"><span begin="1:50.773" end="1:51.417">私</span><span begin="1:51.443" end="1:51.566">の</span><span begin="1:51.593" end="1:51.847">た</span><span begin="1:51.847" end="1:52.079">め</span><span begin="1:52.079" end="1:52.457">息</span><span begin="1:52.457" end="1:52.710">が</span><span begin="1:52.710" end="1:52.836">浮</span><span begin="1:52.836" end="1:53.170">き</span><span begin="1:53.170" end="1:53.354">彫</span><span begin="1:53.354" end="1:53.772">り</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的叹息就越是沉重不已</span><span ttm:role="x-bg" begin="1:52.457" end="1:53.772"><span begin="1:52.457" end="1:52.710">(が</span><span begin="1:52.710" end="1:52.836">浮</span><span begin="1:52.836" end="1:53.170">き</span><span begin="1:53.170" end="1:53.354">彫</span><span begin="1:53.354" end="1:53.772">り)</span></span></p><p begin="1:54.078" end="1:57.184" itunes:key="L28" ttm:agent="v2"><span begin="1:54.078" end="1:54.540">Some</span><span begin="1:54.540" end="1:54.916">one</span> <span begin="1:54.916" end="1:55.465">said</span><span begin="1:55.933" end="1:56.178">「I</span> <span begin="1:56.178" end="1:56.680">hate</span> <span begin="1:56.680" end="1:57.184">you」</span><span ttm:role="x-translation" xml:lang="zh-Hans">有人说 我恨你</span></p><p begin="1:57.482" end="2:04.077" itunes:key="L29" ttm:agent="v1"><span begin="1:57.482" end="1:58.102">素</span><span begin="1:58.102" end="1:58.891">直</span><span begin="1:58.891" end="1:59.367">に</span><span begin="1:59.367" end="1:59.849">生</span><span begin="1:59.849" end="2:00.189">き</span><span begin="2:00.189" end="2:00.672">る</span><span begin="2:01.124" end="2:01.494">あ</span><span begin="2:01.494" end="2:01.894">な</span><span begin="2:01.894" end="2:02.258">た</span><span begin="2:02.258" end="2:02.752">は</span><span begin="2:02.752" end="2:03.057">言</span><span begin="2:03.057" end="2:04.077">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">虽然说着想要坦诚生活</span></p><p begin="2:04.401" end="2:14.298" itunes:key="L30" ttm:agent="v1"><span begin="2:04.401" end="2:04.889">そ</span><span begin="2:04.889" end="2:05.360">の</span><span begin="2:05.360" end="2:05.783">目</span><span begin="2:05.783" end="2:06.225">の</span><span begin="2:06.225" end="2:07.097">奥</span><span begin="2:07.097" end="2:08.789">に</span><span begin="2:09.557" end="2:10.495">光</span><span begin="2:10.495" end="2:10.744">が</span><span begin="2:10.744" end="2:13.934">無</span><span begin="2:13.934" end="2:14.298">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">但是你的眼睛里没有坦诚的光</span><span ttm:role="x-bg" begin="2:09.557" end="2:14.298"><span begin="2:09.557" end="2:10.495">(光</span><span begin="2:10.495" end="2:10.744">が</span><span begin="2:10.744" end="2:13.934">無</span><span begin="2:13.934" end="2:14.298">い)</span></span></p><p begin="2:18.034" end="2:21.556" itunes:key="L31" ttm:agent="v1"><span begin="2:18.034" end="2:18.453">ア</span><span begin="2:18.453" end="2:18.579">イ</span><span begin="2:18.579" end="2:18.825">ツ</span><span begin="2:18.825" end="2:18.953">の</span><span begin="2:18.953" end="2:19.175">不</span><span begin="2:19.353" end="2:19.503">幸</span><span begin="2:19.503" end="2:20.157">せ</span><span begin="2:20.157" end="2:20.293">は</span><span begin="2:20.293" end="2:20.491">好</span><span begin="2:20.491" end="2:20.749">き</span><span begin="2:20.749" end="2:20.963">で</span><span begin="2:20.963" end="2:21.152">す</span><span begin="2:21.152" end="2:21.556">か?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你很开心那个家伙不幸吗？</span></p><p begin="2:21.606" end="2:25.036" itunes:key="L32" ttm:agent="v2"><span begin="2:21.606" end="2:21.885">あ</span><span begin="2:21.885" end="2:21.983">の</span><span begin="2:22.055" end="2:22.318">コ</span><span begin="2:22.318" end="2:22.478">と</span><span begin="2:22.515" end="2:22.858">本</span><span begin="2:22.858" end="2:23.186">音</span><span begin="2:23.186" end="2:23.306">で</span><span begin="2:23.306" end="2:23.730">喋</span><span begin="2:23.730" end="2:24.016">れ</span><span begin="2:24.016" end="2:24.198">て</span><span begin="2:24.198" end="2:24.398">ま</span><span begin="2:24.398" end="2:24.538">す</span><span begin="2:24.606" end="2:25.036">か?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你跟那个女孩说真心话吗？</span></p><p begin="2:25.056" end="2:28.499" itunes:key="L33" ttm:agent="v1"><span begin="2:25.056" end="2:25.702">心</span><span begin="2:25.754" end="2:25.932">で</span><span begin="2:25.932" end="2:26.086">あ</span><span begin="2:26.086" end="2:26.280">