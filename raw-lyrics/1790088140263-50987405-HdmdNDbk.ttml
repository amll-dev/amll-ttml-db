<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ru"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="冰湖的凯旋礼 Triumph on the Ice"/><amll:meta key="musicName" value="冰湖的凯旋礼"/><amll:meta key="musicName" value="冰湖的凱旋禮"/><amll:meta key="musicName" value="氷上の凱旋"/><amll:meta key="musicName" value="Triumph on the Ice"/><amll:meta key="artists" value="HOYO-MiX"/><amll:meta key="album" value="原神-悯宥慈怜之垠 Where Mercy Endures"/><amll:meta key="isrc" value="FRX762649494"/><amll:meta key="isrc" value="FRX762649133"/><amll:meta key="isrc" value="FRX762652060"/><amll:meta key="isrc" value="FRX762648926"/><amll:meta key="isrc" value="FRX762649031"/><amll:meta key="qqMusicId" value="002PL0sr1Vins4"/><amll:meta key="qqMusicId" value="724680943"/><amll:meta key="ncmMusicId" value="3437733165"/><amll:meta key="appleMusicId" value="6810718786"/><amll:meta key="appleMusicId" value="6810718806"/><amll:meta key="appleMusicId" value="6810706895"/><amll:meta key="appleMusicId" value="6810721096"/><amll:meta key="appleMusicId" value="6810721048"/><amll:meta key="spotifyId" value="2DrJULWlGwnbejZiOrEnJg"/><amll:meta key="spotifyId" value="0ruaulpL10K9dBtZgo9RI1"/><amll:meta key="spotifyId" value="3OTfrayYaF1XPKP6r6wrck"/><amll:meta key="spotifyId" value="2Y4PQVDUuIB2LQ2w7OhraJ"/><amll:meta key="ttmlAuthorGithub" value="50987405"/><amll:meta key="ttmlAuthorGithubLogin" value="ITManCHINA"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><transliterations><transliteration xml:lang="ru-Latn"><text for="L1"><span begin="1:43.885" end="1:44.207">My`</span><span begin="1:44.207" end="1:44.597">Ot</span><span begin="1:44.597" end="1:44.985">chiz</span><span begin="1:44.985" end="1:45.407">nu</span><span begin="1:45.407" end="1:45.745">ot</span><span begin="1:45.745" end="1:46.149">sto</span><span begin="1:46.149" end="1:46.435">im</span><span begin="1:46.599" end="1:46.771">i</span><span begin="1:46.771" end="1:46.967">vos</span><span begin="1:46.967" end="1:47.417">sla</span><span begin="1:47.417" end="1:47.597">vim</span><span begin="1:47.597" end="1:47.821">seb</span><span begin="1:47.821" end="1:48.175">ya</span><span begin="1:48.175" end="1:48.565">v ve</span><span begin="1:48.565" end="1:50.042">kax</span></text><text for="L2"><span begin="3:43.873" end="3:44.013">Vi</span><span begin="3:44.217" end="3:44.378">vat</span><span begin="3:44.624" end="3:44.768">Ana</span><span begin="3:44.938" end="3:45.173">sta</span><span begin="3:45.404" end="3:46.107">siya</span></text></transliteration></transliterations><songwriters><songwriter>项柳</songwriter><songwriter>項柳</songwriter><songwriter>Hsiang Liu</songwriter><songwriter>Alina Lobanova</songwriter><songwriter>李洋</songwriter><songwriter>Yang Lee</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:46.107"><div begin="1:43.885" end="3:46.107"><p begin="1:43.885" end="1:50.042" itunes:key="L1" ttm:agent="v1"><span begin="1:43.885" end="1:44.207">Мы</span> <span begin="1:44.207" end="1:44.597">От</span><span begin="1:44.597" end="1:44.985">чиз</span><span begin="1:44.985" end="1:45.407">ну</span> <span begin="1:45.407" end="1:45.745">от</span><span begin="1:45.745" end="1:46.149">сто</span><span begin="1:46.149" end="1:46.435">им</span> <span begin="1:46.599" end="1:46.771">и</span> <span begin="1:46.771" end="1:46.967">вос</span><span begin="1:46.967" end="1:47.417">сла</span><span begin="1:47.417" end="1:47.597">вим</span> <span begin="1:47.597" end="1:47.821">себ</span><span begin="1:47.821" end="1:48.175">я</span> <span begin="1:48.175" end="1:48.565">в ве</span> <span begin="1:48.565" end="1:50.042">ках</span><span ttm:role="x-translation" xml:lang="de">Der Ruhm derjenigen, die ihre Heimat verteidigen, ist nichts, was je niedergeschrieben wird.</span><span ttm:role="x-translation" xml:lang="en">The glory of those who defend the homeland is not something written down</span><span ttm:role="x-translation" xml:lang="es">La gloria de quienes defienden su patria nunca se escribe en papel.</span><span ttm:role="x-translation" xml:lang="fr">La gloire de ceux qui défendent leur patrie ne s&apos;écrit jamais sur le papier.</span><span ttm:role="x-translation" xml:lang="id">Tiada tinta yang mampu mengabadikan seluruh kemuliaan mereka, para pembela tanah air.</span><span ttm:role="x-translation" xml:lang="it">La gloria di chi difende la patria non è mai scritta su carta.</span><span ttm:role="x-translation" xml:lang="ja">我らが祖国を守り 歴史に刻め</span><span ttm:role="x-translation" xml:lang="ko">우리는 조국을 수호하고, 역사에 이름을 남길지니</span><span ttm:role="x-translation" xml:lang="pt">A glória daqueles que defendem a pátria não é algo que se escreve</span><span ttm:role="x-translation" xml:lang="ru">Мы Отчизну отстоим и восславим себя в веках.</span><span ttm:role="x-translation" xml:lang="th">เราจะหยัดยืนพิทักษ์ปิตุภูมิ และจารึกเกียรติภูมิของพวกเราไว้ตราบนานเท่านาน</span><span ttm:role="x-translation" xml:lang="tr">Vatanımızı savunacak, adımızı çağlar boyu yaşatacağız.</span><span ttm:role="x-translation" xml:lang="vi">Chúng tôi bảo vệ quê nhà và làm rạng danh bản thân</span><span ttm:role="x-translation" xml:lang="zh-Hant">保家衛國之人的榮光從來不是寫在紙上</span><span ttm:role="x-translation" xml:lang="zh-Hans">保家卫国之人的荣光从来不是写在纸上</span></p><p begin="3:43.873" end="3:46.107" itunes:key="L2" ttm:agent="v1"><span begin="3:43.873" end="3:44.013">Ви</span><span begin="3:44.217" end="3:44.378">ват</span> <span begin="3:44.624" end="3:44.768">Ана</span><span begin="3:44.938" end="3:45.173">ста</span><span begin="3:45.404" end="3:46.107">сия</span><span ttm:role="x-translation" xml:lang="de">Ruhm sei euch, Eure Majestät Anastasya!</span><span ttm:role="x-translation" xml:lang="en">Glory be unto you, Your Majesty Anastasya</span><span ttm:role="x-translation" xml:lang="es">¡Gloria a su majestad Anastasia!</span><span ttm:role="x-translation" xml:lang="fr">Gloire à la Tsarine Anastasya !</span><span ttm:role="x-translation" xml:lang="id">Terpujilah, oh Yang Mulia Anastasya!</span><span ttm:role="x-translation" xml:lang="it">Lunga vita a Sua Maestà Anastasya!</span><span ttm:role="x-translation" xml:lang="ja">アナスターシャに栄光あれ！</span><span ttm:role="x-translation" xml:lang="ko">아나스타샤에게 영광 있으라!</span><span ttm:role="x-translation" xml:lang="pt">Glória a Vossa Majestade Anastasya</span><span ttm:role="x-translation" xml:lang="ru">Ура, Анастасия!</span><span ttm:role="x-translation" xml:lang="th">Anastasya จงเจริญ</span><span ttm:role="x-translation" xml:lang="tr">Şan olsun sana, ey yüce Çariçe Anastasia!</span><span ttm:role="x-translation" xml:lang="vi">Hoan hô, nữ hoàng Anastasya!</span><span ttm:role="x-translation" xml:lang="zh-Hant">榮耀啊，吾皇安娜絲塔夏</span><span ttm:role="x-translation" xml:lang="zh-Hans">荣耀啊，吾皇安娜丝塔夏</span></p></div></body></tt>