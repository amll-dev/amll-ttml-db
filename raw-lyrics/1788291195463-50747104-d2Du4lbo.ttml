:02.665">bi</span><span begin="4:02.665" end="4:03.078">wa</span><span begin="4:03.078" end="4:03.286">re</span><span begin="4:03.286" end="4:03.850">ta</span><span begin="4:03.850" end="4:05.364">ko ko ro</span><span begin="4:05.364" end="4:06.208">tsu na</span><span begin="4:06.208" end="4:06.390">gi</span><span begin="4:06.390" end="4:07.011">to</span><span begin="4:07.011" end="4:07.371">me</span><span begin="4:07.371" end="4:07.735">ru</span></text><text for="L32"><span begin="4:08.108" end="4:08.967">so ra</span><span begin="4:08.967" end="4:09.393">ni</span><span begin="4:09.393" end="4:10.107">me n</span><span begin="4:10.107" end="4:10.536">ji</span><span begin="4:10.536" end="4:10.906">te</span><span begin="4:11.355" end="4:12.124">bo ku</span><span begin="4:12.124" end="4:12.531">wo</span><span begin="4:12.531" end="4:13.176">yu ru</span><span begin="4:13.176" end="4:13.639">so</span><span begin="4:13.639" end="4:15.204">u</span></text></transliteration></transliterations><songwriters><songwriter>傘村トータ</songwriter><songwriter>Tota Kasamura</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="4:15.204"><div begin="28.629" end="4:15.204"><p begin="28.629" end="33.098" itunes:key="L1" ttm:agent="v1"><span begin="28.629" end="28.728">「</span><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">頑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="28.728" end="28.876">が</span><span tts:ruby="text" begin="28.876" end="29.128">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">張</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="29.128" end="29.347">ば</span></span></span><span begin="29.347" end="29.615">れ</span><span begin="29.615" end="29.709">」</span> <span begin="29.709" end="29.917">で</span><span begin="29.917" end="30.290">も</span> <span begin="30.661" end="30.711">「</span><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">大</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="30.711" end="30.936">だ</span><span tts:ruby="text" begin="30.936" end="31.104">い</span></span></span><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">丈</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="31.104" end="31.513">じょう</span></span></span><span tts:ruby="container"><span tts:ruby="base">夫</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="31.513" end="31.667">ぶ</span></span></span><span begin="31.667" end="31.712">」</span> <span begin="31.712" end="32.077">で</span><span begin="32.077" end="32.285">も</span><span begin="32.285" end="32.772">な</span><span begin="32.772" end="33.098">い</span><span ttm:role="x-translation">并不是 “要加油” 也不是 “没关系” / Neither a &quot;Keep going!&quot; nor any &quot;It&apos;s fine!&quot;</span></p><p begin="34.780" end="39.506" itunes:key="L2" ttm:agent="v1"><span begin="34.780" end="34.852">「</span><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="34.852" end="35.066">き</span><span tts:ruby="text" begin="35.066" end="35.435">み</span></span></span><span begin="35.435" end="35.670">な</span><span begin="35.670" end="36.146">ら</span><span begin="37.013" end="37.208">で</span><span begin="37.208" end="37.412">き</span><span begin="37.412" end="37.713">る</span><span begin="37.713" end="37.791">」</span> <span begin="37.791" end="38.010">で</span><span begin="38.010" end="38.597">も</span><span begin="38.597" end="38.972">な</span><span begin="38.972" end="39.506">い</span><span ttm:role="x-translation">更不是 “你一定可以做到” / Not even a single &quot;You can do it!&quot;</span></p><p begin="41.364" end="45.880" itunes:key="L3" ttm:agent="v1"><span begin="41.364" end="41.575">あ</span><span begin="41.575" end="41.714">の</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="41.714" end="41.978">ひ</span></span></span><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="41.978" end="42.330">ぼ</span><span tts:ruby="text" begin="42.330" end="42.560">く</span></span></span><span begin="42.560" end="43.019">が</span><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="43.334" end="43.538">い</span></span></span><span begin="43.538" end="43.727">わ</span><span begin="43.727" end="44.134">れ</span><span begin="44.134" end="44.318">た</span><span begin="44.318" end="44.751">か</span><span begin="44.751" end="44.900">っ</span><span begin="44.900" end="45.880">た</span><span ttm:role="x-translation">我一直都在不懈地找寻着 / I&apos;ve been searching all this time</span></p><p begin="47.465" end="51.988" itunes:key="L4" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="47.465" end="47.670">こ</span></span></span><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">葉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="47.670" end="48.069">と</span><span tts:ruby="text" begin="48.069" end="48.268">ば</span></span></span><span begin="48.268" end="48.499">を</span><span begin="48.818" end="49.148">ず</span><span begin="49.148" end="49.664">っ</span><span begin="49.664" end="49.944">と</span><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">探</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="49.944" end="50.418">さ</span><span tts:ruby="text" begin="50.418" end="50.565">が</span></span></span><span begin="50.565" end="51.010">し</span><span begin="51.010" end="51.232">て</span><span begin="51.232" end="51.988">る</span><span ttm:role="x-translation">那天想听到的那句话 / For the words I wanted to be told on that day</span></p><p begin="53.797" end="58.559" itunes:key="L5" ttm:agent="v1"><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">雨</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="53.797" end="53.986">あ</span><span tts:ruby="text" begin="53.986" end="54.221">め</span></span></span><span begin="54.221" end="54.402">に</span><span begin="54.402" end="54.604">も</span><span tts:ruby="container"><span tts:ruby="base">負</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="54.604" end="54.968">ま</span></span></span><span begin="54.968" end="55.165">け</span><span begin="55.165" end="55.548">て</span> <span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">風</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="55.944" end="56.155">か</span><span tts:ruby="text" begin="56.155" end="56.379">ぜ</span></span></span><span begin="56.379" end="56.761">に</span><span begin="56.761" end="56.956">も</span><span tts:ruby="container"><span tts:ruby="base">負</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="56.956" end="57.345">ま</span></span></span><span begin="57.345" end="57.557">け</span><span begin="57.557" end="58.559">て</span><span ttm:role="x-translation">抵不过暴雨 赢不过狂风 / I lost to the rain, I lost to the wind too</span></p><p begin="1:00.081" end="1:04.738" itunes:key="L6" ttm:agent="v1"><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">丈</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:00.081" end="1:00.685">じょう</span></span></span><span tts:ruby="container"><span tts:ruby="base">夫</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:00.685" end="1:00.903">ぶ</span></span></span><span begin="1:00.903" end="1:01.378">な</span><span tts:ruby="container" amll:empty-beat="2"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:02.268" end="1:02.456">こ</span><span tts:ruby="text" begin="1:02.456" end="1:02.685">こ</span><span tts:ruby="text" begin="1:02.685" end="1:03.072">ろ</span></span></span><span begin="1:03.072" end="1:03.276">も</span><span tts:ruby="container"><span tts:ruby="base">無</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:03.276" end="1:03.656">な</span></span></span><span begin="1:03.656" end="1:03.870">い</span><span begin="1:03.870" end="1:04.738">が</span><span ttm:role="x-translation">甚至没有坚韧的心 / I don&apos;t even have an enduring heart</span></p><p begin="1:06.538" end="1:10.988" itunes:key="L7" ttm:agent="v1"><span begin="1:06.538" end="1:06.817">ふ</span><span begin="1:06.817" end="1:07.045">と</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:07.045" end="1:07.270">み</span></span></span><span tts:ruby="container"><span tts:ruby="base">上</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:07.270" end="1:07.641">あ</span></span></span><span begin="1:07.641" end="1:07.837">げ</span><span begin="1:07.837" end="1:08.239">た</span><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">曇</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:08.584" end="1:08.906">く</span><span tts:ruby="text" begin="1:08.906" end="1:09.385">も</span></span></span><span begin="1:09.385" end="1:09.585">り</span><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:09.585" end="1:09.993">ぞ</span><span tts:ruby="text" begin="1:09.993" end="1:10.200">ら</span></span></span><span begin="1:10.200" end="1:10.988">が</span><span ttm:role="x-translation">偶然抬头望见的阴沉天空 / But suddenly, The cloudy sky I looked up at</span></p><p begin="1:12.693" end="1:17.228" itunes:key="L8" ttm:agent="v1"><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">優</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:12.693" end="1:12.896">や</span><span tts:ruby="text" begin="1:12.896" end="1:13.250">さ</span></span></span><span begin="1:13.250" end="1:13.507">し</span><span begin="1:13.507" end="1:13.848">く</span><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">笑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:14.517" end="1:14.936">わ</span><span tts:ruby="text" begin="1:14.936" end="1:15.329">ら</span></span></span><span begin="1:15.329" end="1:15.694">っ</span><span begin="1:15.694" end="1:15.916">て</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:15.916" end="1:16.312">み</span></span></span><span begin="1:16.312" end="1:16.514">え</span><span begin="1:16.514" end="1:17.228">た</span><span ttm:role="x-translation">仿佛正温柔地朝我微笑 / Seemed as if it was giving me a gentle smile</span></p><p begin="1:17.872" end="1:23.988" itunes:key="L9" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:17.872" end="1:18.043">い</span></span></span><span begin="1:18.043" end="1:18.282">き</span><span begin="1:18.282" end="1:18.479">る</span><span tts:ruby="container"><span tts:ruby="base">意</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:18.479" end="1:18.880">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">味</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:18.880" end="1:19.062">み</span></span></span><span begin="1:19.062" end="1:19.649">な</span><span begin="1:19.649" end="1:20.031">ん</span><span begin="1:20.031" end="1:20.828">て</span> <span tts:ruby="container"><span tts:ruby="base">理</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:21.176" end="1:21.593">り</span></span></span><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">由</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:21.593" end="1:21.967">ゆ</span><span tts:ruby="text" begin="1:21.967" end="1:22.224">う</span></span></span><span begin="1:22.224" end="1:22.796">な</span><span begin="1:22.796" end="1:23.224">ん</span><span begin="1:23.224" end="1:23.988">て</span><span ttm:role="x-translation">所谓活着的意义 还有理由之类的 / It&apos;s completely natural to not understand</span></p><p begin="1:24.420" end="1:31.450" itunes:key="L10" ttm:agent="v1"><span begin="1:24.420" end="1:24.799">わ</span><span begin="1:24.799" end="1:25.171">か</span><span begin="1:25.171" end="1:25.580">ら</span><span begin="1:25.580" end="1:25.927">な</span><span begin="1:25.927" end="1:26.149">く</span><span begin="1:26.149" end="1:26.746">て</span><span tts:ruby="container"><span tts:ruby="base">当</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:26.746" end="1:27.104">あ</span></span></span><span begin="1:27.104" end="1:27.547">た</span><span begin="1:27.547" end="1:27.918">り</span><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">前</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:27.918" end="1:30.352">ま</span><span tts:ruby="text" begin="1:30.352" end="1:30.704">え</span></span></span><span begin="1:30.704" end="1:30.893">だ</span><span begin="1:30.893" end="1:31.450">よ</span><span ttm:role="x-translation">搞不懂这些才是人之常情吧 / Things like &quot;the meaning of life&quot; or &quot;the reason to live&quot;</span></p><p begin="1:33.350" end="1:39.359" itunes:key="L11" ttm:agent="v1"><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:33.350" end="1:33.866">そ</span><span tts:ruby="text" begin="1:33.866" end="1:34.261">ら</span></span></span><span begin="1:34.261" end="1:34.667">に</span><span tts:ruby="container" amll:empty-beat="1"><span tts:ruby="base">免</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:34.667" end="1:34.865">め</span><span tts:ruby="text" begin="1:34.865" end="1:35.372">ん</span></span></span><span begin="1:35.372" end="1:35.817">じ</span><span begin="1:35.817" end="1:36.281">て</span><span tts:ruby="container"><span tts:ruby="base">今</span><span tts:ruby="textContainer"><span tts:ruby=