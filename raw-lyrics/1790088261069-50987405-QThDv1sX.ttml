sg"/><amll:meta key="spotifyId" value="1vK1rSRhPXkhykr5UgVjes"/><amll:meta key="appleMusicId" value="6810718177"/><amll:meta key="appleMusicId" value="6810718599"/><amll:meta key="appleMusicId" value="6810706206"/><amll:meta key="appleMusicId" value="6810720363"/><amll:meta key="appleMusicId" value="6810720491"/><amll:meta key="ttmlAuthorGithub" value="50987405"/><amll:meta key="ttmlAuthorGithubLogin" value="ITManCHINA"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>余子彦</songwriter><songwriter>餘子彥</songwriter><songwriter>Ian Yee</songwriter><songwriter>李洋</songwriter><songwriter>Yang Lee</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="1:08.351"><div begin="4.359" end="1:08.351"><p begin="4.359" end="10.485" itunes:key="L1" ttm:agent="v1"><span begin="4.359" end="4.515">Dear</span> <span begin="4.515" end="4.793">O</span><span begin="4.793" end="5.581">dette,</span> <span begin="6.225" end="6.525">come</span> <span begin="6.525" end="6.669">and</span> <span begin="6.669" end="6.975">build</span> <span begin="6.975" end="7.155">a</span> <span begin="7.155" end="7.673">snow</span><span begin="7.673" end="8.761">man</span> <span begin="8.761" end="9.015">with</span> <span begin="9.015" end="10.485">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">奥黛塔 快陪我去堆个雪人吧</span><span ttm:role="x-translation" xml:lang="ja">オデット 雪だるま作りましょ</span><span ttm:role="x-translation" xml:lang="ko">오데트 나랑 눈사람 만들자</span></p><p begin="11.703" end="17.283" itunes:key="L2" ttm:agent="v1"><span begin="11.703" end="12.431">Or</span> <span begin="12.431" end="12.649">hop</span> <span begin="12.649" end="12.851">on</span> <span begin="12.851" end="13.099">a</span> <span begin="13.099" end="13.721">train,</span> <span begin="14.125" end="14.305">roa</span><span begin="14.305" end="14.493">ming</span> <span begin="14.493" end="14.891">Snezh</span><span begin="14.891" end="15.385">na</span><span begin="15.385" end="15.843">ya</span> <span begin="15.843" end="16.039">with</span> <span begin="16.039" end="17.283">glee</span><span ttm:role="x-translation" xml:lang="zh-Hans">或是跳上火车 绕着至冬跑一圈</span><span ttm:role="x-translation" xml:lang="ja">列車に飛び乗って 雪国を一周</span><span ttm:role="x-translation" xml:lang="ko">아님 기차 타고 스네즈나야 돌자</span></p><p begin="17.703" end="21.175" itunes:key="L3" ttm:agent="v1"><span begin="17.703" end="17.965">It&apos;s</span> <span begin="17.965" end="18.183">been</span> <span begin="18.183" end="18.565">a</span><span begin="18.565" end="18.949">ges</span> <span begin="18.949" end="19.465">since</span> <span begin="19.465" end="19.909">you&apos;ve</span> <span begin="19.909" end="20.089">come</span> <span begin="20.089" end="20.569">to</span> <span begin="20.569" end="21.175">play</span><span ttm:role="x-translation" xml:lang="zh-Hans">你好久都没陪我玩</span><span ttm:role="x-translation" xml:lang="ja">お魚と歌うわ</span><span ttm:role="x-translation" xml:lang="ko">맨날 나랑 안 놀아줘서</span></p><p begin="21.396" end="26.809" itunes:key="L4" ttm:agent="v1"><span begin="21.396" end="21.573">I&apos;ve</span> <span begin="21.573" end="21.813">been</span> <span begin="21.813" end="22.189">sing</span><span begin="22.189" end="22.645">ing</span> <span begin="22.645" end="23.081">to</span> <span begin="23.081" end="23.531">the</span> <span begin="23.531" end="23.801">fish</span> <span begin="23.801" end="24.239">all</span> <span begin="24.239" end="26.809">day</span><span ttm:role="x-translation" xml:lang="zh-Hans">我只能对着鱼唱歌</span><span ttm:role="x-translation" xml:lang="ja">あなたがいないから</span><span ttm:role="x-translation" xml:lang="ko">물고기한테 노래하네</span></p><p begin="28.479" end="31.727" itunes:key="L5" ttm:agent="v1"><span begin="28.479" end="28.727">Though</span> <span begin="28.727" end="28.975">the</span> <span begin="28.975" end="29.469">stage</span> <span begin="29.469" end="29.913">is</span> <span begin="29.913" end="30.363">far</span> <span begin="30.363" end="30.595">from</span> <span begin="30.595" end="30.969">em</span><span begin="30.969" end="31.727">pty</span><span ttm:role="x-translation" xml:lang="zh-Hans">虽然舞台并不空</span><span ttm:role="x-translation" xml:lang="ja">舞台は満席でも</span><span ttm:role="x-translation" xml:lang="ko">관객이 있다 해도</span></p><p begin="32.258" end="35.468" itunes:key="L6" ttm:agent="v1"><span begin="32.258" end="32.686">You</span> <span begin="32.686" end="33.158">know</span> <span begin="33.158" end="33.586">I&apos;m</span> <span begin="33.586" end="34.028">fee</span><span begin="34.028" end="34.268">ling</span> <span begin="34.268" end="34.756">so</span> <span begin="34.756" end="34.966">a</span><span begin="34.966" end="35.468">lone</span><span ttm:role="x-translation" xml:lang="zh-Hans">但你知道我总是很孤单</span><span ttm:role="x-translation" xml:lang="ja">あたしはひとりぼっち</span><span ttm:role="x-translation" xml:lang="ko">나는 언제나 외로워</span></p><p begin="35.880" end="42.384" itunes:key="L7" ttm:agent="v1"><span begin="35.880" end="36.264">Just</span> <span begin="36.264" end="36.720">wat</span><span begin="36.720" end="37.156">ching</span> <span begin="37.156" end="37.598">as</span> <span begin="37.598" end="38.094">the</span> <span begin="38.094" end="38.670">time</span> <span begin="39.016" end="39.870">ticks</span> <span begin="39.870" end="42.384">by</span><span ttm:role="x-translation" xml:lang="zh-Hans">看时光滴答流转</span><span ttm:role="x-translation" xml:lang="ja">時計を見つめるだけ</span><span ttm:role="x-translation" xml:lang="ko">시간만 똑딱똑딱</span></p><p begin="43.114" end="49.370" itunes:key="L8" ttm:agent="v1"><span begin="43.114" end="43.496">Tick-</span><span begin="43.496" end="44.052">tock,</span> <span begin="44.988" end="45.386">tick-</span><span begin="45.386" end="45.883">tock,</span> <span begin="46.760" end="47.194">tick-</span><span begin="47.194" end="49.370">tock</span><span ttm:role="x-translation" xml:lang="zh-Hans">滴答 滴答 滴答</span><span ttm:role="x-translation" xml:lang="ja">チクタク、チクタク、チクタク</span><span ttm:role="x-translation" xml:lang="ko">똑딱 똑딱 똑딱</span></p><p begin="50.399" end="56.592" itunes:key="L9" ttm:agent="v1"><span begin="50.399" end="50.797">Tick-</span><span begin="50.797" end="51.321">tock,</span> <span begin="52.191" end="52.657">tick-</span><span begin="52.657" end="53.107">tock,</span> <span begin="54.029" end="54.449">tick-</span><span begin="54.449" end="56.592">tock</span><span ttm:role="x-translation" xml:lang="zh-Hans">滴答 滴答 滴答</span><span ttm:role="x-translation" xml:lang="ja">チクタク、チクタク、チクタク</span><span ttm:role="x-translation" xml:lang="ko">똑딱 똑딱 똑딱</span></p><p begin="58.879" end="1:08.351" itunes:key="L10" ttm:agent="v1"><span begin="58.879" end="59.029">Dear</span> <span begin="59.029" end="59.343">O</span><span begin="59.343" end="1:00.153">dette,</span> <span begin="1:00.903" end="1:01.107">come</span> <span begin="1:01.107" end="1:01.323">and</span> <span begin="1:01.323" end="1:01.511">build</span> <span begin="1:01.511" end="1:01.677">a</span> <span begin="1:01.677" end="1:02.577">snow</span><span begin="1:02.577" end="1:04.429">man</span> <span begin="1:04.961" end="1:05.471">with</span> <span begin="1:05.471" end="1:08.351">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">奥黛塔 快陪我去堆个雪人吧</span><span ttm:role="x-translation" xml:lang="ja">オデット 雪だるま作りましょ</span><span ttm:role="x-translation" xml:lang="ko">오데트 나랑 눈사람 만들자</span></p></div></body></tt>