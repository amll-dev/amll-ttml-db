:30.820">っ</span></span></span><span begin="1:30.820" end="1:31.080">た</span><span tts:ruby="container"><span tts:ruby="base">道</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:31.080" end="1:31.280">み</span><span tts:ruby="text" begin="1:31.280" end="1:31.940">ち</span></span></span><span ttm:role="x-translation">我与你两人并行于归途</span><span ttm:role="x-roman">anata to futari kaetta michi</span></p><p begin="1:32.400" end="1:41.540" itunes:key="L11" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">追</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:32.400" end="1:32.860">お</span></span></span><span begin="1:32.860" end="1:33.280">い</span><span begin="1:33.280" end="1:33.720">か</span><span begin="1:33.720" end="1:33.960">け</span><span begin="1:33.960" end="1:35.820">て</span> <span tts:ruby="container"><span tts:ruby="base">追</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:36.360" end="1:36.600">お</span></span></span><span begin="1:36.600" end="1:36.820">い</span><span begin="1:36.820" end="1:37.260">か</span><span begin="1:37.260" end="1:37.500">け</span><span begin="1:37.500" end="1:41.540">て</span><span ttm:role="x-translation">我们追逐着 我们追逐着</span><span ttm:role="x-roman">oikakete oikakete</span></p><p begin="1:42.820" end="1:50.360" itunes:key="L12" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">銀</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:42.820" end="1:42.980">ぎ</span><span tts:ruby="text" begin="1:42.980" end="1:43.260">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">色</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:43.260" end="1:43.480">い</span><span tts:ruby="text" begin="1:43.480" end="1:43.620">ろ</span></span></span><span tts:ruby="container"><span tts:ruby="base">飛</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:43.620" end="1:43.920">ひ</span></span></span><span tts:ruby="container"><span tts:ruby="base">行</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:43.920" end="1:44.550">こ</span><span tts:ruby="text" begin="1:44.550" end="1:45.180">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">船</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:45.180" end="1:45.520">せ</span><span tts:ruby="text" begin="1:45.520" end="1:46.500">ん</span></span></span> <span tts:ruby="container"><span tts:ruby="base">輝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:47.220" end="1:47.460">か</span><span tts:ruby="text" begin="1:47.460" end="1:48.700">が</span><span tts:ruby="text" begin="1:48.700" end="1:48.980">や</span></span></span><span begin="1:48.980" end="1:50.360">く</span><span ttm:role="x-translation">银色飞行船 闪耀着光芒</span><span ttm:role="x-roman">gin&apos;iro hikōsen kagayaku</span></p><p begin="1:50.960" end="1:56.160" itunes:key="L13" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">海</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:50.960" end="1:52.340">う</span><span tts:ruby="text" begin="1:52.340" end="1:52.720">み</span></span></span><span begin="1:52.720" end="1:53.140">だ</span><span begin="1:53.140" end="1:53.380">け</span><span begin="1:53.380" end="1:53.840">が</span><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:54.260" end="1:54.520">か</span></span></span><span begin="1:54.520" end="1:54.940">わ</span><span begin="1:54.940" end="1:55.180">ら</span><span begin="1:55.180" end="1:55.580">な</span><span begin="1:55.580" end="1:55.880">い</span><span begin="1:55.880" end="1:56.160">で</span><span ttm:role="x-translation">唯有那片海 依旧未变如初</span><span ttm:role="x-roman">umi dake ga kawaranaide</span></p><p begin="1:56.860" end="2:04.440" itunes:key="L14" ttm:agent="v1"><span begin="1:56.860" end="1:57.100">あ</span><span begin="1:57.100" end="1:57.360">な</span><span begin="1:57.360" end="1:57.580">た</s