<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="雨停时分 After the Rain"/><amll:meta key="musicName" value="After the Rain"/><amll:meta key="artists" value="The 1999"/><amll:meta key="artists" value="Tim Condor"/><amll:meta key="album" value="雨停时分 After the Rain"/><amll:meta key="album" value="After the Rain - Single"/><amll:meta key="album" value="After the Rain"/><amll:meta key="isrc" value="FRX452627451"/><amll:meta key="appleMusicId" value="6796211091"/><amll:meta key="spotifyId" value="1wI1KrFf0Hk38Rni7H443S"/><amll:meta key="qqMusicId" value="659363859"/><amll:meta key="qqMusicId" value="002Fq2JC1xnEyb"/><amll:meta key="ncmMusicId" value="3376104369"/><amll:meta key="ttmlAuthorGithub" value="176977142"/><amll:meta key="ttmlAuthorGithubLogin" value="zhr166"/><amll:meta key="ttmlAuthorLyricify" value="悲杏"/><amll:meta key="deliverableAudioLanguage" value="en"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Ricky Lee (BLUEPOCH)</songwriter><songwriter>April Wang(Oasis Audio)</songwriter><songwriter>李政翮</songwriter><songwriter>王唯</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="4:15.901"><div begin="16.689" end="20.627" itunes:songPart="Verse"><p begin="16.689" end="20.627" itunes:key="L1" ttm:agent="v1"><span begin="16.689" end="16.967">She</span> <span begin="16.967" end="17.289">grew</span> <span begin="17.289" end="18.388">beneath</span> <span begin="18.388" end="18.757">old</span> <span begin="18.757" end="19.424">si</span><span begin="19.424" end="19.856">lent</span> <span begin="19.856" end="20.627">orders</span><span ttm:role="x-translation" xml:lang="zh-CN">无声规则中 她悄然生根</span></p></div><div begin="20.876" end="24.780" itunes:songPart="Verse"><p begin="20.876" end="24.780" itunes:key="L2" ttm:agent="v1"><span begin="20.876" end="21.447">Between</span> <span begin="21.447" end="22.107">school</span> <span begin="22.107" end="22.656">walls</span> <span begin="22.656" end="22.868">and</span> <span begin="22.868" end="23.847">measured</span> <span begin="23.847" end="24.780">borders</span><span ttm:role="x-translation" xml:lang="zh-CN">于高墙之间 顺从地生长</span></p></div><div begin="24.894" end="28.395" itunes:songPart="Verse"><p begin="24.894" end="28.395" itunes:key="L3" ttm:agent="v1"><span begin="24.894" end="25.146">But</span> <span begin="25.146" end="25.791">every</span> <span begin="25.791" end="26.331">storm</span> <span begin="26.331" end="26.818">she</span> <span begin="26.818" end="27.363">couldn&apos;t</span> <span begin="27.363" end="27.814">out</span><span begin="27.814" end="28.395">run</span><span ttm:role="x-translation" xml:lang="zh-CN">可那些无从逃避的暴雨</span></p></div><div begin="29.574" end="32.329" itunes:songPart="Verse"><p begin="29.574" end="32.329" itunes:key="L4" ttm:agent="v1"><span begin="29.574" end="29.919">Left</span> <span begin="29.919" end="30.088">a</span> <span begin="30.088" end="30.852">shadow</span> <span begin="30.852" end="31.309">shaped</span> <span begin="31.309" end="31.833">like</span> <span begin="31.833" end="32.329">home</span><span ttm:role="x-translation" xml:lang="zh-CN">冲刷出家的影子</span></p></div><div begin="32.785" end="36.717" itunes:songPart="Verse"><p begin="32.785" end="36.717" itunes:key="L5" ttm:agent="v1"><span begin="32.785" end="33.044">She</span> <span begin="33.044" end="33.347">learned</span> <span begin="33.347" end="33.871">to</span> <span begin="33.871" end="34.404">breathe</span> <span begin="34.404" end="34.668">through</span> <span begin="34.668" end="35.619">si</span><span begin="35.619" end="35.862">rens</span> <span begin="35.862" end="36.717">calling</span><span ttm:role="x-translation" xml:lang="zh-CN">她学会在警笛声中呼吸</span></p></div><div begin="37.308" end="40.674" itunes:songPart="Verse"><p begin="37.308" end="40.674" itunes:key="L6" ttm:agent="v1"><span begin="37.308" end="37.567">To</span> <span begin="37.567" end="37.840">step</span> <span begin="37.840" end="38.401">aside</span> <span begin="38.401" end="38.913">while</span> <span begin="38.913" end="39.678">empires</span> <span begin="39.678" end="39.804">are</span> <span begin="39.804" end="40.674">falling</span><span ttm:role="x-translation" xml:lang="zh-CN">在大厦倾颓时 侧身而过</span></p></div><div begin="40.887" end="44.496" itunes:songPart="Verse"><p begin="40.887" end="44.496" itunes:key="L7" ttm:agent="v1"><span begin="40.887" end="41.595">Between</span> <span begin="41.595" end="41.904">the</span> <span begin="41.904" end="42.630">white,</span> <span begin="42.630" end="43.374">between</span> <span begin="43.374" end="43.593">the</span> <span begin="43.593" end="44.496">rules</span><span ttm:role="x-translation" xml:lang="zh-CN">在纯白与规则之间</span></p></div><div begin="44.771" end="48.947" itunes:songPart="Verse"><p begin="44.771" end="48.947" itunes:key="L8" ttm:agent="v1"><span begin="44.771" end="44.999">She</span> <span begin="44.999" end="45.359">stayed</span> <span begin="45.359" end="46.646">herself,</span> <span begin="46.784" end="47.249">she</span> <span begin="47.249" end="47.762">stayed</span> <span begin="47.762" end="48.947">true</span><span ttm:role="x-translation" xml:lang="zh-CN">她始终选择成为自己</span></p></div><div begin="49.072" end="52.476" itunes:songPart="Chorus"><p begin="49.072" end="52.476" itunes:key="L9" ttm:agent="v1"><span begin="49.072" end="49.290">What</span> <span begin="49.290" end="49.496">if</span> <span begin="49.496" end="49.829">I</span> <span begin="49.829" end="50.254">met</span> <span begin="50.254" end="50.866">you</span> <span begin="50.866" end="51.577">after</span> <span begin="51.577" end="51.763">the</span> <span begin="51.763" end="52.476">rain?</span><span ttm:role="x-translation" xml:lang="zh-CN">倘若我们在雨停时分相遇呢</span></p></div><div begin="53.022" end="56.571" itunes:songPart="Chorus"><p begin="53.022" end="56.571" itunes:key="L10" ttm:agent="v1"><span begin="53.022" end="53.296">What</span> <span begin="53.296" end="53.553">if</span> <span begin="53.553" end="53.860">the</span> <span begin="53.860" end="54.360">loss</span> <span begin="54.360" end="54.609">was</span> <span begin="54.609" end="55.374">never</span> <span begin="55.374" end="55.780">in</span> <span begin="55.780" end="56.571">vain?</span><span ttm:role="x-translation" xml:lang="zh-CN">倘若所有牺牲都并非徒然呢</span></p></div><div begin="57.043" end="1:00.549" itunes:songPart="Chorus"><p begin="57.043" end="1:00.549" itunes:key="L11" ttm:agent="v1"><span begin="57.043" end="57.340">What</span> <span begin="57.340" end="57.547">if</span> <span begin="57.547" end="57.771">the</span> <span begin="57.771" end="58.353">storm</span> <span begin="58.353" end="58.824">re</span><span begin="58.824" end="59.376">winds</span> <span begin="59.376" end="59.810">our</span> <span begin="59.810" end="1:00.549">plans?</span><span ttm:role="x-translation" xml:lang="zh-CN">倘若暴雨将命运重新倒转</span></p></div><div begin="1:00.644" end="1:04.562" itunes:songPart="Chorus"><p begin="1:00.644" end="1:04.562" itunes:key="L12" ttm:agent="v1"><span begin="1:00.644" end="1:00.845">And</span> <span begin="1:00.845" end="1:01.223">leaves</span> <span begin="1:01.223" end="1:01.730">us</span> <span begin="1:01.730" end="1:02.588">standing</span> <span begin="1:02.588" end="1:03.084">where</span> <span begin="1:03.084" end="1:03.573">we</span> <span begin="1:03.573" end="1:04.562">began?</span><span ttm:role="x-translation" xml:lang="zh-CN">让我们停驻在故事的起点</span></p></div><div begin="1:05.097" end="1:08.568" itunes:songPart="Chorus"><p begin="1:05.097" end="1:08.568" itunes:key="L13" ttm:agent="v1"><span begin="1:05.097" end="1:05.344">What</span> <span begin="1:05.344" end="1:05.538">if</span> <span begin="1:05.538" end="1:05.859">I</span> <span begin="1:05.859" end="1:06.276">met</span> <span begin="1:06.276" end="1:06.859">you</span> <span begin="1:06.859" end="1:07.540">after</span> <span begin="1:07.540" end="1:07.752">the</span> <span begin="1:07.752" end="1:08.568">rain?</span><span ttm:role="x-translation" xml:lang="zh-CN">倘若我们在雨停时分相遇呢</span></p></div><div begin="1:09.024" end="1:12.501" itunes:songPart="Chorus"><p begin="1:09.024" end="1:12.501" itunes:key="L14" ttm:agent="v1"><span begin="1:09.024" end="1:09.334">What</span> <span begin="1:09.334" end="1:09.547">if</span> <span begin="1:09.547" end="1:09.813">the</span> <span begin="1:09.813" end="1:10.344">loss</span> <span begin="1:10.344" end="1:10.785">was</span> <span begin="1:10.785" end="1:11.337">never</span> <span begin="1:11.337" end="1:11.810">in</span> <span begin="1:11.810" end="1:12.501">vain?</span><span ttm:role="x-translation" xml:lang="zh-CN">倘若所有牺牲都并非徒然呢</span></p></div><div begin="1:12.999" end="1:16.474" itunes:songPart="Chorus"><p begin="1:12.999" end="1:16.474" itunes:key="L15" ttm:agent="v1"><span begin="1:12.999" end="1:13.356">What</span> <span begin="1:13.356" end="1:13.551">if</span> <span begin="1:13.551" end="1:13.646">the</span> <span begin="1:13.646" end="1:14.549">storm</span> <span begin="1:14.549" end="1:14.822">re</span><span begin="1:14.822" end="1:15.350">winds</span> <span begin="1:15.350" end="1:15.775">our</span> <span begin="1:15.775" end="1:16.474">plans?</span><span ttm:role="x-translation" xml:lang="zh-CN">倘若暴雨将时光重新倒转</span></p></div><div begin="1:16.533" end="1:20.698" itunes:songPart="Chorus"><p begin="1:16.533" end="1:20.698" itunes:key="L16" ttm:agent="v1"><span begin="1:16.533" end="1:17.089">Slowly</span> <span begin="1:17.089" end="1:17.845">pulling</span> <span begin="1:17.845" end="1:18.346">time</span> <span begin="1:18.346" end="1:19.036">back</span> <span begin="1:19.036" end="1:19.555">toward</span> <span begin="1:19.555" end="1:19.753">the</span> <span begin="1:19.753" end="1:20.698">same?</span><span ttm:role="x-translation" xml:lang="zh-CN">牵引着一切</span></p></div><div begin="1:20.840" end="1:24.552" itunes:songPart="Chorus"><p begin="1:20.840" end="1:24.552" itunes:key="L17" ttm:agent="v1"><span begin="1:20.840" end="1:21.551">After</span> <span begin="1:21.551" end="1:21.791">the</span> <span begin="1:21.791" end="1:24.552">rain</span><span ttm:role="x-translation" xml:lang="zh-CN">回到雨停时分</span></p></div><div begin="1:31.069" end="1:34.726" itunes:songPart="Verse"><p begin="1:31.069" end="1:34.726" itunes:key="L18" ttm:agent="v1"><span begin="1:31.069" end="1:31.842">Orange</span> <span begin="1:31.842" end="1:32.632">peels</span> <span begin="1:32.632" end="1:32.851">and</span> <span begin="1:32.851" end="1:33.832">borrowed</span> <span begin="1:33.832" end="1:34.726">summers</span><span ttm:role="x-translation" xml:lang="zh-CN">借来的夏天 橘皮的苦香</span></p></div><div begin="1:35.091" end="1:38.649" itunes:songPart="Verse"><p begin="1:35.091" end="1:38.649" itunes:key="L19" ttm:agent="v1"><span begin="1:35.091" end="1:35.335">Doves</span> <span begin="1:35.335" end="1:36.406">scatter,</span> <span begin="1:36.406" end="1:36.880">white</span> <span begin="1:36.880" end="1:37.858">feathers</span> <span begin="1:37.858" end="1:38.649">flutter</span><span ttm:role="x-translation" xml:lang="zh-CN">惊散的鸽群 纷飞的白羽</span></p></div><div begin="1:38.998" end="1:42.879" itunes:songPart="Verse"><p begin="1:38.998" end="1:42.879" itunes:key="L20" ttm:agent="v1"><span begin="1:38.998" end="1:39.391">Crowds</span> <span begin="1:39.391" end="1:39.799">turn</span> <span begin="1:39.799" end="1:40.348">pale,</span> <span begin="1:40.348" end="1:40.893">the</span> <span begin="1:40.893" end="1:41.863">echoes</span> <span begin="1:41.863" end="1:42.879">fall</span><span ttm:role="x-translation" xml:lang="zh-CN">人群褪去颜色 回声渐渐消散</span></p></div><div begin="1:43.506" end="1:46.495" itunes:songPart="Verse"><p begin="1:43.506" end="1:46.495" itunes:key="L21" ttm:agent="v1"><span begin="1:43.506" end="1:44.059">Yet</span> <span begin="1:44.059" end="1:44.575">she</span> <span begin="1:44.575" end="1:45.384">remembers</span> <span begin="1:45.384" end="1:45.592">it</span> <span begin="1:45.592" end="1:46.495">all</span><span ttm:role="x-translation" xml:lang="zh-CN">她却将一切 深深铭刻心上</span></p></div><div begin="1:47.050" end="1:50.900" itunes:songPart="Verse"><p begin="1:47.050" end="1:50.900" itunes:key="L22" ttm:agent="v1"><span begin="1:47.050" end="1:47.324">High-</span><span begin="1:47.324" end="1:47.852">hung</span> <span begin="1:47.852" end="1:48.347">grapes</span> <span begin="1:48.347" end="1:48.800">like</span> <span begin="1:48.800" end="1:49.841">quiet</span> <span begin="1:49.841" end="1:50.900">questions</span><span ttm:role="x-translation" xml:lang="zh-CN">高悬的葡萄 无声地质问</span></p></div><div begin="1:51.109" end="1:54.976" itunes:songPart="Verse"><p begin="1:51.109" end="1:54.976" itunes:key="L23" ttm:agent="v1"><span begin="1:51.109" end="1:51.860">Broken</span> <span begin="1:51.860" end="1:52.880">mirrors,</span> <span begin="1:52.880" end="1:53.641">shared</span> <span begin="1:53.641" end="1:54.976">reflections</span><span ttm:role="x-translation" xml:lang="zh-CN">破碎的镜面 映照着彼此</span></p></div><div begin="1:55.111" end="1:59.008" itunes:songPart="Verse"><p begin="1:55.111" end="1:59.008" itunes:key="L24" ttm:agent="v1"><span begin="1:55.111" end="1:55.348">War-</span><span begin="1:55.348" end="1:55.847">time</span> <span begin="1:55.847" end="1:56.594">prayers,</span> <span begin="1:56.594" end="1:57.091">small</span> <span begin="1:57.091" end="1:57.794">foolish</span> <span begin="1:57.794" end="1:59.008">dreams</span><span ttm:role="x-translation" xml:lang="zh-CN">战火中的祈祷 微小而愚蠢的梦</span></p></div><div begin="1:59.233" end="2:02.788" itunes:songPart="Verse"><p begin="1:59.233" end="2:02.788" itunes:key="L25" ttm:agent="v1"><span begin="1:59.233" end="1:59.620">She</span> <span begin="1:59.620" end="1:59.867">k