0.660" itunes:key="L1" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">小</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="0.326" end="0.644">ち</span><span tts:ruby="text" begin="0.644" end="1.615">い</span></span></span><span begin="1.615" end="1.889">さ</span><span begin="1.889" end="3.068">な</span><span tts:ruby="container"><span tts:ruby="base">種</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3.068" end="3.291">た</span><span tts:ruby="text" begin="3.291" end="3.460">ね</span></span></span><span begin="3.460" end="3.659">が</span><span begin="3.659" end="4.093">そ</span><span begin="4.093" end="4.184">っ</span><span begin="4.184" end="5.550">と</span> <span tts:ruby="container"><span tts:ruby="base">小</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="7.433" end="7.787">ち</span><span tts:ruby="text" begin="7.787" end="8.745">い</span></span></span><span begin="8.745" end="9.067">さ</span><span begin="9.067" end="10.069">な</span><span tts:ruby="container"><span tts:ruby="base">町</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="10.069" end="10.328">ま</span><span tts:ruby="text" begin="10.328" end="10.599">ち</span></span></span><span begin="10.599" end="10.799">に</span><span tts:ruby="container"><span tts:ruby="base">落</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="10.799" end="11.134">お</span></span></span><span begin="11.134" end="11.276">ち</span><span begin="11.276" end="12.580">て</span><span tts:ruby="container"><span tts:ruby="base">咲</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="13.605" end="14.336">さ</span></span></span><span begin="14.336" end="14.572">い</span><span begin="14.572" end="18.134">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">小小的种子 悄然飘落 在这小小的城镇 落地开花</span><span ttm:role="x-bg" begin="18.135" end="20.660">(<span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="18.135" end="18.382">ひ</span><span tts:ruby="text" begin="18.382" end="18.637">か</span><span tts:ruby="text" begin="18.830" end="19.050">り</span></span></span><span begin="19.050" end="19.280">に</span><span tts:ruby="container"><span tts:ruby="base">吹</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="19.454" end="19.689">ふ</span></span></span><span begin="19.689" end="19.962">か</span><span begin="20.147" end="20.385">れ</span><span begin="20.385" end="20.660">て))</span><span ttm:role="x-translation" xml:lang="zh-Hans">沐浴在光芒之中</span></span></p><p begin="20.791" end="28.550" itunes:key="L2" ttm:agent="v1"><span begin="20.791" end="21.342">ゆ</span><span begin="21.342" end="21.425">っ</span><span begin="21.425" end="21.504">く</span><span begin="21.504" end="21.729">り</span><span begin="21.729" end="25.210">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">缓缓地</span><span ttm:role="x-bg" begin="25.250" end="28.550">(<span tts:ruby="container"><span tts:ruby="base">２人</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="25.250" end="25.504">ふ</span><span tts:ruby="text" begin="25.504" end="25.953">た</span><span tts:ruby="text" begin="25.953" end="26.183">り</span></span></span><span begin="26.183" end="26.590">で</span><span tts:ruby="container"><span tts:ruby="base">歩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="26.590" end="26.869">あ</span><span tts:ruby="text" begin="26.869" end="27.276">る</span></span></span><span begin="27.276" end="27.549">こ</span><span begin="27.549" end="28.550">う))</span><span ttm:role="x-translation" xml:lang="zh-Hans">两人并肩前行吧</span></span></p><p begin="29.161" end="34.690" itunes:key="L3" ttm:agent="v1"><span begin="29.161" end="29.500">き</span><span begin="29.500" end="29.740">れ</span><span begin="29.740" end="29.877">い</span><span begin="29.877" end="30.070">な</span><span begin="30.070" end="30.305">も</span><span begin="30.305" end="30.542">の</span><span begin="30.542" end="31.273">は</span><span begin="31.273" end="31.549">い</span><span begin="31.549" end="31.740">つ</span><span begin="31.740" end="31.967">か</span><span begin="31.967" end="32.183">こ</span><span begin="32.183" end="32.623">の</span><span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="32.623" end="32.872">て</span></span></span><span begin="32.872" end="33.090">こ</span><span begin="33.090" end="33.518">ぼ</span><span begin="33.518" end="33.704">れ</span><span begin="33.704" end="33.935">お</span><span begin="33.935" end="34.432">ち</span><span begin="34.432" end="34.690">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">美好的事物 终将从掌心滑落</span></p><p begin="36.236" end="41.510" itunes:key="L4" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">知</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="36.236" end="36.717">し</span></span></span><span begin="36.717" end="36.784">っ</span><span begin="36.784" end="36.953">た</span><span begin="36.953" end="37.258">そ</span><span begin="37.258" end="37.427">の</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="37.427" end="37.952">ひ</span></span></span><span begin="37.952" end="38.395">に</span><span tts:ruby="container"><span tts:ruby="base">帰</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="38.395" end="38.616">か</span><span tts:ruby="text" begin="38.616" end="38.842">え</span></span></span><span begin="38.842" end="39.076">ら</span><span begin="39.076" end="39.287">な</span><span begin="39.287" end="39.727">い</span><span tts:ruby="container"><span tts:ruby="base">旅</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="39.727" end="39.958">た</span><span tts:ruby="text" begin="39.958" end="40.169">び</span></span></span><span begin="40.169" end="40.620">に</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="40.620" end="41.061">で</span></span></span><span begin="41.061" end="41.510">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">就在明白的那天 踏上了永不回头的旅程</span></p><p begin="42.172" end="45.276" itunes:key="L5" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="42.172" end="42.300">お</span><span tts:ruby="text" begin="42.300" end="42.586">も</span></span></span><span begin="42.586" end="42.838">い</span><span begin="42.838" end="43.076">が</span><span begin="43.076" end="43.241">け</span><span begin="43.241" end="43.732">ず</span><span begin="43.732" end="43.956">こ</span><span begin="43.956" end="44.096">の</span><span tts:ruby="container"><span tts:ruby="base">町</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="44.096" end="44.364">ま</span><span tts:ruby="text" begin="44.364" end="44.606">ち</span></span></span><span begin="44.606" end="44.803">に</span><span tts:ruby="container"><span tts:ruby="base">来</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="44.803" end="45.050">き</span></span></span><span begin="45.050" end="45.276">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">偶然来到这座小镇</span></p><p begin="45.479" end="49.042" itunes:key="L6" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="45.479" end="45.703">き</span><span tts:ruby="text" begin="45.703" end="45.943">み</span></span></span><span begin="45.943" end="46.143">と</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="46.143" end="46.334">で</span></span></span><span tts:ruby="container"><span tts:ruby="base">会</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="46.334" end="46.751">あ</span></span></span><span begin="46.751" end="46.847">っ</span><span begin="46.847" end="47.272">て</span><span tts:ruby="container"><span tts:ruby="base">季節</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="47.272" end="47.381">き</span><span tts:ruby="text" begin="47.381" end="47.700">せ</span><span tts:ruby="text" begin="47.700" end="47.961">つ</span></span></span><span begin="47.961" end="48.120">が</span><span begin="48.120" end="48.370">め</span><span begin="48.370" end="48.646">ぐ</span><span begin="48.646" end="49.042">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">与你相遇 看四季流转</span></p><p begin="49.092" end="54.430" itunes:key="L7" ttm:agent="v1"><span begin="49.092" end="49.297">ま</span><span begin="49.297" end="49.418">た</span><span tts:ruby="container"><span tts:ruby="base">失</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="49.418" end="49.596">う</span><span tts:ruby="text" begin="49.596" end="49.940">し</span><span tts:ruby="text" begin="49.940" end="50.197">な</span></span></span><span begin="50.197" end="50.390">っ</span><span begin="50.390" end="50.815">て</span> <span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="50.815" end="51.064">き</span><span tts:ruby="text" begin="51.064" end="51.305">み</span></span></span><span begin="51.305" end="51.511">が</span><span tts:ruby="container"><span tts:ruby="base">残</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="51.511" end="51.726">の</span><span tts:ruby="text" begin="51.726" end="51.923">こ</span></span></span><span begin="51.923" end="52.177">し</span><span begin="52.177" end="52.598">た</span> <span begin="52.598" end="53.065">き</span><span begin="53.065" end="53.308">ら</span><span begin="53.308" end="53.496">め</span><span begin="53.496" end="54.430">き</span><span ttm:role="x-translation" xml:lang="zh-Hans">尽管再次经历失去 却寻得</span></p><p begin="55.023" end="1:00.012" itunes:key="L8" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="55.023" end="55.239">み</span></span></span><span begin="55.239" end="55.730">つ</span><span begin="55.730" end="56.167">け</span><span begin="56.167" end="56.521">た</span><span begin="56.521" end="56.642">ん</span><span begin="56.642" end="57.266">だ</span> <span tts:ruby="container"><span tts:ruby="base">守</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="57.266" end="57.968">ま</span><span tts:ruby="text" begin="57.968" end="58.618">も</span></span></span><span begin="58.618" end="58.907">ろ</span><span begin="58.907" end="1:00.012">う──</span><span ttm:role="x-translation" xml:lang="zh-Hans">你留下的光芒 决心将它守护——</span></p><p begin="1:00.371" end="1:07.958" itunes:key="L9" ttm:agent="v1"><span begin="1:00.371" end="1:00.833">Gold</span><span begin="1:00.833" end="1:02.184">en</span><span begin="1:02.184" end="1:03.504">field</span> <span tts:ruby="container"><span tts:ruby="base">駆</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:03.504" end="1:03.728">か</span></span></span><span begin="1:03.728" end="1:04.207">け</span><span tts:ruby="container"><span tts:ruby="base">抜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:04.207" end="1:04.605">ぬ</span></span></span><span begin="1:04.605" end="1:06.972">け</span><span ttm:role="x-translation" xml:lang="zh-Hans">穿越那片金色麦田</span><span ttm:role="x-bg" begin="1:04.341" end="1:07.958"><span begin="1:04.341" end="1:05.236">(か</span><span begin="1:05.236" end="1:06.177">き</span><span begin="1:06.177" end="1:07.049">わ</span><span begin="1:07.049" end="1:07.958">け)</span><span ttm:role="x-translation" xml:lang="zh-Hans">拨开丛丛麦穗</span></span></p><p begin="1:07.430" end="1:16.629" itunes:key="L10" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">遠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:07.430" end="1:07.938">と</span><span tts:ruby="text" begin="1:07.938" end="1:09.303">お</span></span></span><span begin="1:09.303" end="1:09.503">く</span><span begin="1:09.503" end="1:10.607">に</span><span tts:ruby="container"><span tts:ruby="base">影</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:10.607" end="1:10.859">か</span><span tts:ruby="text" begin="1:10.859" end="1:11.067">げ</span></span></span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:11.067" end="1:11.245">み</span></span></span><span begin="1:11.245" end="1:11.709">つ</span><span begin="1:11.709" end="1:13.170">け</span> <span tts:ruby="container"><span tts:ruby="base">呼</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:13.170" end="1:13.635">よ</span></span></span><span begin="1:13.635" end="1:13.977">び</span><span begin="1:13.977" end="1:14.391">か</span><span begin="1:14.391" end="1:14.844">け</span><span begin="1:14.844" end="1:15.209">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">望见远方你的身影 我放声呼喊</span><span ttm:role="x-bg" begin="1:14.992" end="1:16.629"><span begin="1:14.992" end="1:15.239">(さ</span><span begin="1:15.239" end="1:15.699">さ</span><span begin="1:15.699" end="1:15.938">や</span><span begin="1:15.938" end="1:16.307">か</span><span begin="1:16.307" end="1:16.629">な)</span><span ttm:role="x-translation" xml:lang="zh-Hans">琐碎的</span></span></p><p begin="1:16.570" end="1:20.482" itunes:key="L11" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">繰</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:16.570" end="1:16.866">く</span></span></span><span begin="1:16.866" end="1:17.156">り</span><span tts:ruby="container"><span tts:ruby="base">返</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:17.156" end="1:17.527">か</span><span tts:ruby="text" begin="1:17.527" end="1:17.871">え</span></span></span><span begin="1:17.871" end="1:18.406">し</span><span begin="1:18.406" end="1:18.708">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">点滴日常</span><span ttm:role="x-bg" begin="1:18.597" end="1:20.482"><span begin="1:18.597" end="1:18.771">(き</span><span begin="1:18.771" end="1:19.219">ら</span><span begin="1:19.219" end="1:19.479">め</span><span begin="1:19.479" end="1:19.932">い</span><span begin="1:19.932" end="1:20.179">て</span><span begin="1:20.179" end="1:20.482">る)</span><span ttm:role="x-translation" xml:lang="zh-Hans">闪烁着</span></span></p><p begin="1:19.635" end="1:22.204" itunes:key="L12" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:19.635" end="1:19.936">ぼ</span><span tts:ruby="text" begin="1:19.936" end="1:20.139">く</span></span></span><span begin="1:20.139" end="1:20.559">ら</span><span begin="1:20.559" end="1:21.071">つ</span><span begin="1:21.071" end="1:21.379">な</span><span begin="1:21.379" end="1:21.495">い</span><span begin="1:21.495" end="1:21.890">で</span><span begin="1:21.890" end="1:21.974">い</span><span begin="1:21.974" end="1:22.204">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">将你我紧密相连</span></p><p begin="1:22.408" end="1:35.391" itunes:key="L13" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">風</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:22.408" end="1:22.591">か</span><span tts:ruby="text" begin="1:22.591" end="1:23.089">ぜ</span></span></span><span begin="1:23.089" end="1:23.301">に</span><span tts:ruby="container"><span tts:ruby="base">揺</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:23.301" end="1:23.738">ゆ</span></span></span><span begin="1:23.738" end="1:23.978">れ</span><span begin="1:23.978" end="1:24.382">る</span><span tts:ruby="container"><span tts:ruby="base">穂</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:24.382" end="1:24.622">ほ</span></span></span><span begin="1:24.622" end="1:25.041">が</span><span begin="1:25.041" end="1:25.505">ま</span><span begin="1:25.505" end="1:25.639">ぶ</span><span begin="1:25.639" end="1:26.014">し</span><span begin="1:26.014" end="1:27.169">い</span> <span begin="1:27.491" end="1:27.721">こ</span><span begin="1:27.721" end="1:27.970">こ</span><span begin="1:27.970" end="1:28.149">に</span><span begin="1:28.149" end="1:28.635">い</span><span begin="1:28.635" end="1:29.033">る</span><span begin="1:29.033" end="1:32.819">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">风中摇曳的麦穗 何等耀眼 我就在这里啊</span><span ttm:role="x-bg" begin="1:32.821" end="1:35.391">(<span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:32.821" end="1:33.097">ひ</span><span tts:ruby="text" begin="1:33.097" end="1:33.507">か</span><span tts:ruby="text" begin="1:33.507" end="1:33.740">り</span></span></span><span begin="1:33.740" end="1:34.168">を</span><span tts:ruby="container"><span tts:ruby="base">灯</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:34.168" end="1:34.414">と</span><span tts:ruby="text" begin="1:34.414" end="1:34.704">も</span></span></span><span begin="1:34.704" end="1:35.002">し</span><span begin="1:35.002" end="1:35.391">て))</span><span ttm:role="x-translation" xml:lang="zh-Hans">点亮灯火</span></span></p><p begin="1:35.439" end="1:42.512" itunes:key="L14" ttm:agent="v1"><span begin="1:35.439" end="1:36.064">ゆ</span><span begin="1:36.064" end="1:36.114">っ</span><span begin="1:36.114" end="1:36.166">く</span><span begin="1:36.166" end="1:36.401">り</span><span begin="1:36.401" end="1:39.857">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">缓缓地</span><span ttm:role="x-bg" begin="1:39.890" end="1:42.512">(<span tts:ruby="container"><span tts:ruby="base">２人</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:39.890" end="1:40.157">ふ</span><span tts:ruby="text" begin="1:40.157" end="1:40.622">た</span><span tts:ruby="text" begin="1:40.622" end="1:40.853">り</span></span></span><span begin="1:40.853" end="1:41.267">で</span><span tts:ruby="container"><span tts:ruby="base">暮</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:41.267" end="1:41.529">く</span></span></span><span begin="1:41.529" end="1:41.865">ら</span><span begin="1:41.865" end="1:42.222">そ</span><span begin="1:42.222" end="1:42.512">う))</span><span ttm:role="x-translation" xml:lang="zh-Hans">两人一起生活吧</span></span></p><p begin="1:43.922" end="1:49.388" itunes:key="L15" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:43.922" end="1:44.184">き</span><span tts:ruby="text" begin="1:44.184" end="1:44.397">み</span></span></span><span begin="1:44.397" end="1:44.583">が</span><span tts:ruby="container"><span tts:ruby="base">残</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:44.583" end="1:44.789">の</span><span tts:ruby="text" begin="1:44.789" end="1:44.941">こ</span></span></span><span begin="1:44.941" end="1:45.269">し</span><span begin="1:45.269" end="1:45.926">た</span><span begin="1:45.926" end="1:46.160">き</span><span begin="1:46.160" end="1:46.393">ら</span><span begin="1:46.393" end="1:46.610">め</span><span begin="1:46.610" end="1:46.830">き</span><span begin="1:46.830" end="1:47.119">は</span><span tts:ruby="container"><span tts:ruby="base">大</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:47.119" end="1:47.392">お</span><span tts:ruby="text" begin="1:47.392" end="1:47.710">お</span></span></span><span begin="1:47.710" end="1:48.177">き</span><span begin="1:48.177" end="1:48.367">く</span><span tts:ruby="container"><span tts:ruby="base">育</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:48.367" end="1:48.635">そ</span><span tts:ruby="text" begin="1:48.635" end="1:49.016">だ</span></span></span><span begin="1:49.016" end="1:49.078">っ</span><span begin="1:49.078" end="1:49.388">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">你留下的那抹光芒 已茁壮成长</span></p><p begin="1:50.522" end="1:56.157" itunes:key="L16" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:50.522" end="1:50.853">ゆ</span><span tts:ruby="text" begin="1:50.853" end="1:51.088">め</span></span></span><span tts:ruby="container"><span tts:ruby="base">語</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:51.088" end="1:51.283">か</span><span tts:ruby="text" begin="1:51.283" end="1:51.664">た</span></span></span><span begin="1:51.664" end="1:51.723">っ</span><span begin="1:51.723" end="1:51.900">て</span><span tts:ruby="container"><span tts:ruby="base">髭</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:51.900" end="1:52.189">ひ</span><span tts:ruby="text" begin="1:52.189" end="1:52.396">げ</span></span></span><span begin="1:52.396" end="1:52.630">の</span><span begin="1:52.630" end="1:52.900">ば</span><span begin="1:52.900" end="1:53.067">し</span><span begin="1:53.067" end="1:53.480">て</span> <span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:53.480" end="1:53.743">き</span><span tts:ruby="text" begin="1:53.743" end="1:53.957">み</span></span></span><span begin="1:53.957" end="1:54.210">は</span><span tts:ruby="container"><span tts:ruby="base">笑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:54.210" end="1:54.611">わ</span><span tts:ruby="text" begin="1:54.611" end="1:54.866">ら</span></span></span><span begin="1:54.866" end="1:55.267">う</span><span begin="1:55.267" end="1:55.761">だ</span><span begin="1:55.761" end="1:56.027">ろ</span><span begin="1:56.027" end="1:56.157">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">畅谈着梦想 任胡须生长 你若是看到 一定会笑吧</span></p><p begin="1:56.785" end="1:59.968" itunes:key="L17" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">疲</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:56.785" end="1:57.069">つ</span><span tts:ruby="text" begin="1:57.069" end="1:57.300">か</span></span></span><span begin="1:57.300" end="1:57.480">れ</span><span tts:ruby="container"><span tts:ruby="base">果</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:57.480" end="1:57.740">は</span></span></span><span begin="1:57.740" end="1:57.958">て</span><span begin="1:57.958" end="1:58.410">て</span><span tts:ruby="container"><span tts:ruby="base">家</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:58.410" end="1:58.627">い</span><span tts:ruby="text" begin="1:58.627" end="1:58.861">え</span></span></span><span begin="1:58.861" end="1:59.038">に</span><span begin="1:59.038" end="1:59.340">つ</span><span begin="1:59.340" end="1:59.498">い</span><span begin="1:59.498" end="1:59.728">た</span><span begin="1:59.728" end="1:59.968">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">疲惫不堪地回到家</span></p><p begin="2:00.201" end="2:03.515" itunes:key="L18" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">窓</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:00.201" end="2:00.400">ま</span><span tts:ruby="text" begin="2:00.400" end="2:00.625">ど</span></span></span><span begin="2:00.625" end="2:00.864">の</span><span tts:ruby="container"><span tts:ruby="base">灯</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:00.864" end="2:01.054">あ</span><span tts:ruby="text" begin="2:01.054" end="2:01.309">か</span></span></span><span begin="2:01.309" end="2:01.516">り</span><span begin="2:01.516" end="2:01.943">に</span><span tts:ruby="container"><span tts:ruby="base">影</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:01.943" end="2:02.180">か</span><span tts:ruby="text" begin="2:02.180" end="2:02.380">げ</span></span></span><span begin="2:02.380" end="2:02.633">を</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:02.633" end="2:02.815">み</span></span></span><span begin="2:02.815" end="2:03.068">つ</span><span begin="2:03.068" end="2:03.294">け</span><span begin="2:03.294" end="2:03.515">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">在窗边的灯光里 看见了一抹身影</span></p><p begin="2:03.750" end="2:09.409" itunes:key="L19" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:03.750" end="2:03.972">ぼ</span><span tts:ruby="text" begin="2:03.972" end="2:04.168">く</span></span></span><span begin="2:04.168" end="2:04.431">は</span><span tts:ruby="container"><span tts:ruby="base">急</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:04.431" end="2:04.511">い</span><span tts:ruby="text" begin="2:04.511" end="2:04.825">そ</span></span></span><span begin="2:04.825" end="2:05.065">い</span><span begin="2:05.065" end="2:05.498">で</span><span tts:ruby="container"><span tts:ruby="base">扉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:05.498" end="2:05.720">と</span><span tts:ruby="text" begin="2:05.720" end="2:05.967">び</span><span tts:ruby="text" begin="2:05.967" end="2:06.186">ら</span></span></span><span begin="2:06.186" end="2:06.406">を</span><span tts:ruby="container"><span tts:ruby="base">開</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:06.406" end="2:06.618">あ</span></span></span><span begin="2:06.618" end="2:06.841">け</span><span begin="2:06.841" end="2:07.288">て</span><span tts:ruby="container"><span tts:ruby="base">飛</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:07.288" end="2:07.735">と</span></span></span><span begin="2:07.735" end="2:07.959">び</span><span tts:ruby="container"><span tts:ruby="base">込</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:07.959" end="2:08.196">こ</span></span></span><span begin="2:08.196" end="2:09.409">む</span><span ttm:role="x-translation" xml:lang="zh-Hans">我慌忙推开门 飞奔而入</span></p><p begin="2:09.658" end="2:17.920" itunes:key="L20" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">幻</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:09.658" end="2:09.936">ま</span><span tts:ruby="text" begin="2:09.936" end="2:10.439">ぼ</span><span tts:ruby="text" begin="2:10.439" end="2:10.690">ろ</span><span tts:ruby="text" begin="2:10.690" end="2:10.825">し</span></span></span><span begin="2:10.825" end="2:11.284">で</span><span begin="2:11.284" end="2:11.944">も</span><span begin="2:11.944" end="2:12.634">い</span><span begin="2:12.634" end="2:13.284">い</span><span begin="2:13.284" end="2:13.536">か</span><span begin="2:13.536" end="2:13.848">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">哪怕那只是幻影 也无所谓</span><span ttm:role="x-bg" begin="2:13.860" end="2:17.920">(<span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:13.860" end="2:14.147">て</span></span></span><span begin="2:14.147" end="2:14.396">を</span><span begin="2:14.396" end="2:14.610">の</span><span begin="2:14.610" end="2:14.742">ば</span><span begin="2:14.742" end="2:15.059">し</span><span begin="2:15.059" end="2:15.257">た</span><span begin="2:15.257" end="2:15.454">な</span><span begin="2:15.454" end="2:17.920">ら))</span><span ttm:role="x-translation" xml:lang="zh-Hans">只要伸出手去</span></span></p><p begin="2:15.059" end="2:22.598" itunes:key="L21" ttm:agent="v1"><span begin="2:15.059" end="2:15.565">Gold</span><span begin="2:15.565" end="2:16.843">en</span><span begin="2:16.843" end="2:18.107">field</span> <span begin="2:18.107" end="2:18.403">そ</span><span begin="2:18.403" end="2:18.860">の</span><span begin="2:18.860" end="2:19.291">ま</span><span begin="2:19.291" end="2:20.977">ま</span><span ttm:role="x-translation" xml:lang="zh-Hans">金色麦田啊 请永远如初</span><span ttm:role="x-bg" begin="2:19.291" end="2:22.598">(<span tts:ruby="container"><span tts:ruby="base">静</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:19.291" end="2:19.857">し</span><span tts:ruby="text" begin="2:19.857" end="2:20.827">ず</span></span></span><span begin="2:20.827" end="2:21.722">か</span><span begin="2:21.722" end="2:22.598">に))</span><span ttm:role="x-translation" xml:lang="zh-Hans">静静守望</span></span></p><p begin="2:22.157" end="2:31.524" itunes:key="L22" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:22.157" end="2:22.601">こ</span><span tts:ruby="text" begin="2:22.601" end="2:23.918">こ</span><span tts:ruby="text" begin="2:23.918" end="2:24.198">ろ</span></span></span><span begin="2:24.198" end="2:25.247">の</span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:25.247" end="2:25.493">な</span><span tts:ruby="text" begin="2:25.493" end="2:25.732">か</span></span></span><span begin="2:25.732" end="2:26.003">に</span><span begin="2:26.003" end="2:26.414">あ</span><span begin="2:26.414" end="2:27.782">る</span><span tts:ruby="container"><span tts:ruby="base">輝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:27.925" end="2:28.297">か</span><span tts:ruby="text" begin="2:28.297" end="2:28.549">が</span><span tts:ruby="text" begin="2:28.549" end="2:29.049">や</span></span></span><span begin="2:29.049" end="2:29.501">き</span><span begin="2:29.501" end="2:29.689">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">存于心底的光芒</span><span ttm:role="x-bg" begin="2:29.689" end="2:31.524"><span begin="2:29.689" end="2:29.999">(き</span><span begin="2:29.999" end="2:30.361">ら</span><span begin="2:30.361" end="2:30.660">め</span><span begin="2:30.660" end="2:30.973">い</span><span begin="2:30.973" end="2:31.224">て</span><span begin="2:31.224" end="2:31.524">る)</span><span ttm:role="x-translation" xml:lang="zh-Hans">闪烁着</span></span></p><p begin="2:31.280" end="2:35.190" itunes:key="L23" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">鳥</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:31.280" end="2:31.527">と</span><span tts:ruby="text" begin="2:31.527" end="2:31.835">り</span></span></span><span begin="2:31.835" end="2:32.180">に</span><span begin="2:32.180" end="2:33.005">な</span><span begin="2:33.005" end="2:33.088">っ</span><span begin="2:33.088" end="2:33.510">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">化作了飞鸟</span><span ttm:role="x-bg" begin="2:33.312" end="2:35.190"><span begin="2:33.312" end="2:33.557">(ま</span><span begin="2:33.557" end="2:33.950">わ</span><span begin="2:33.950" end="2:34.212">り</span><span begin="2:34.212" end="2:34.630">な</span><span begin="2:34.630" end="2:34.875">が</span><span begin="2:34.875" end="2:35.190">ら)</span><span ttm:role="x-translation" xml:lang="zh-Hans">盘旋着</span></span></p><p begin="2:34.380" end="2:36.857" itunes:key="L24" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:34.380" end="2:34.619">き</span><span tts:ruby="text" begin="2:34.619" end="2:34.814">み</span></span></span><span begin="2:34.814" end="2:35.191">を</span><span begin="2:35.191" end="2:35.731">さ</span><span begin="2:35.731" end="2:36.049">が</span><span begin="2:36.049" end="2:36.598">し</span><span begin="2:36.598" end="2:36.857">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">前去寻找你的踪迹</span></p><p begin="2:36.937" end="2:51.331" itunes:key="L25" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">世界</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:36.937" end="2:37.273">せ</span><span tts:ruby="text" begin="2:37.273" end="2:37.727">か</span><span tts:ruby="text" begin="2:37.727" end="2:38.013">い</span></span></span><span begin="2:38.013" end="2:38.373">の</span><span tts:ruby="container"><span tts:ruby="base">果</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:38.373" end="2:38.629">は</span></span></span><span begin="2:38.629" end="2:39.058">て</span><span begin="2:39.058" end="2:39.304">ま</span><span begin="2:39.304" end="2:39.716">で</span><span tts:ruby="container"><span tts:ruby="base">飛</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:39.716" end="2:40.184">と</span></span></span><span begin="2:40.184" end="2:40.384">ん</span><span begin="2:40.384" end="2:42.146">で</span> <span tts:ruby="container"><span tts:ruby="base">会</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:42.146" end="2:42.366">あ</span></span></span><span begin="2:42.366" end="2:42.658">い</span><span begin="2:42.658" end="2:42.873">に</span><span tts:ruby="container"><span tts:ruby="base">行</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:42.873" end="2:43.280">い</span></span></span><span begin="2:43.280" end="2:43.773">く</span><span begin="2:43.773" end="2:47.005">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">哪怕飞至世界尽头 也定要与你相见</span><span ttm:role="x-bg" begin="2:47.565" end="2:51.331">(<span tts:ruby="container"><span tts:ruby="base">小</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:47.565" end="2:47.685">ち</span><span tts:ruby="text" begin="2:47.685" end="2:47.878">い</span></span></span><span begin="2:47.878" end="2:48.414">さ</span><span begin="2:48.414" end="2:48.614">な</span><span tts:ruby="container"><span tts:ruby="base">家</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:48.614" end="2:48.960">い</span><span tts:ruby="text" begin="2:48.960" end="2:49.318">え</span></span></span><span begin="2:49.318" end="2:49.591">の</span><span begin="2:49.591" end="2:49.935">テ</span><span begin="2:49.935" end="2:50.467">ー</span><span begin="2:50.467" end="2:50.640">ブ</span><span begin="2:50.640" end="2:50.947">ル</span><span begin="2:50.947" end="2:51.331">に))</span><span ttm:role="x-translation" xml:lang="zh-Hans">在那张小家的餐桌上</span></span></p><p begin="2:51.625" end="3:01.990" itunes:key="L26" ttm:agent="v1"><span begin="2:51.625" end="2:51.794">い</span><span begin="2:51.794" end="2:51.868">っ</span><span begin="2:51.868" end="2:52.452">しょ</span><span begin="2:52.452" end="2:52.538">に</span><span tts:ruby="container"><span tts:ruby="base">描</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:52.538" end="2:52.642">え</span><span tts:ruby="text" begin="2:52.642" end="2:52.979">が</span></span></span><span begin="2:52.979" end="2:53.292">い</span><span begin="2:53.292" end="2:53.625">た</span> <span begin="2:53.625" end="2:54.497">gold</span><span begin="2:54.497" end="2:54.952">en</span><span begin="2:54.952" end="2:57.945">field</span> <span begin="2:57.945" end="2:58.818">い</span><span begin="2:58.818" end="2:58.953">つ</span><span begin="2:58.953" end="2:59.613">ま</span><span begin="2:59.613" end="2:59.938">で</span><span begin="2:59.938" end="3:01.990">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们一起画下的金色麦田 永远都在那里</span></p><p begin="3:04.519" end="3:17.778" itunes:key="L27" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:04.519" end="3:04.837">よ</span><span tts:ruby="text" begin="3:04.837" end="3:05.047">る</span></span></span><span begin="3:05.047" end="3:05.278">に</span><span begin="3:05.278" end="3:05.623">な</span><span begin="3:05.623" end="3:05.713">っ</span><span begin="3:05.713" end="3:07.036">て</span> <span tts:ruby="container"><span tts:ruby="base">星</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:11.704" end="3:11.876">ほ</span><span tts:ruby="text" begin="3:11.876" end="3:12.193">し</span></span></span><span begin="3:12.193" end="3:12.393">に</span><span begin="3:12.393" end="3:12.680">な</span><span begin="3:12.680" end="3:12.849">っ</span><span begin="3:12.849" end="3:14.195">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">随后夜幕降临 天边繁星闪烁</span><span ttm:role="x-bg" begin="3:14.587" end="3:17.778">(<span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:14.587" end="3:14.833">て</span></span></span><span begin="3:14.833" end="3:14.991">を</span><span begin="3:14.991" end="3:15.245">つ</span><span begin="3:15.245" end="3:15.544">な</span><span begin="3:15.544" end="3:15.724">い</span><span begin="3:15.724" end="3:15.860">で、</span><span begin="3:15.860" end="3:16.276">さ</span><span begin="3:16.276" end="3:17.778">あ))</span><span ttm:role="x-translation" xml:lang="zh-Hans">来 牵起手吧</span></span></p><p begin="3:15.730" end="3:23.182" itunes:key="L28" ttm:agent="v1"><span begin="3:15.730" end="3:16.187">Gold</span><span begin="3:16.187" end="3:17.527">en</span><span begin="3:17.527" end="3:18.850">field</span> <span tts:ruby="container"><span tts:ruby="base">駆</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:18.850" end="3:19.079">か</span></span></span><span begin="3:19.079" end="3:19.524">け</span><span tts:ruby="container"><span tts:ruby="base">抜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:19.524" end="3:19.934">ぬ</span></span></span><span begin="3:19.934" end="3:21.633">け</span><span ttm:role="x-translation" xml:lang="zh-Hans">穿越那片金色麦田</span><span ttm:role="x-bg" begin="3:19.526" end="3:23.182"><span begin="3:19.526" end="3:20.625">(か</span><span begin="3:20.625" end="3:21.385">き</span><span begin="3:21.385" end="3:22.446">わ</span><span begin="3:22.446" end="3:23.182">け)</span><span ttm:role="x-translation" xml:lang="zh-Hans">拨开丛丛麦穗</span></span></p><p begin="3:22.844" end="3:32.207" itunes:key="L29" ttm:agent="v1"><span begin="3:22.844" end="3:23.256">こ</span><span begin="3:23.256" end="3:24.397">の</span><span tts:ruby="container"><span tts:ruby="base">町</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:24.397" end="3:24.557">ま</span><span tts:ruby="text" begin="3:24.557" end="3:24.831">ち</span></span></span><span begin="3:24.831" end="3:25.947">で</span><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:25.947" end="3:26.182">い</span></span></span><span begin="3:26.182" end="3:26.402">き</span><span begin="3:26.402" end="3:26.638">て</span><span begin="3:26.638" end="3:27.059">い</span><span begin="3:27.059" end="3:27.352">こ</span><span begin="3:27.352" end="3:28.586">う</span> <span tts:ruby="container"><span tts:ruby="base">微笑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:28.586" end="3:28.916">ほ</span><span tts:ruby="text" begin="3:28.916" end="3:29.323">ほ</span><span tts:ruby="text" begin="3:29.323" end="3:29.757">え</span></span></span><span begin="3:29.757" end="3:30.187">ん</span><span begin="3:30.187" end="3:30.541">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">就在这座小镇 微笑着生活下去吧</span><span ttm:role="x-bg" begin="3:30.331" end="3:32.207"><span begin="3:30.331" end="3:30.557">((さ</span><span begin="3:30.557" end="3:31.042">さ</span><span begin="3:31.042" end="3:31.287">や</span><span begin="3:31.287" end="3:31.753">か</span><span begin="3:31.753" end="3:31.912">な</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:31.912" end="3:32.207">ひ</span></span></span>)<span ttm:role="x-translation" xml:lang="zh-Hans">微不足道的每天</span></span></p><p begin="3:31.912" end="3:35.873" itunes:key="L30" ttm:agent="v1"><span begin="3:31.912" end="3:32.207">き</span><span begin="3:32.207" end="3:32.518">ら</span><span begin="3:32.518" end="3:32.881">め</span><span begin="3:32.881" end="3:33.296">い</span><span begin="3:33.296" end="3:33.766">て</span><span begin="3:33.766" end="3:34.185">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">闪耀着</span><span ttm:role="x-bg" begin="3:33.875" end="3:35.873"><span begin="3:33.875" end="3:34.202">(ゆ</span><span begin="3:34.202" end="3:34.637">れ</span><span begin="3:34.637" end="3:35.270">な</span><span begin="3:35.270" end="3:35.521">が</span><span begin="3:35.521" end="3:35.873">ら)</span><span ttm:role="x-translation" xml:lang="zh-Hans">摇曳着</span></span></p><p begin="3:35.002" end="3:37.544" itunes:key="L31" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:35.002" end="3:35.271">ぼ</span><span tts:ruby="text" begin="3:35.271" end="3:35.517">く</span></span></span><span begin="3:35.517" end="3:35.889">ら</span><span begin="3:35.889" end="3:36.387">つ</span><span begin="3:36.387" end="3:36.736">な</span><span begin="3:36.736" end="3:36.858">い</span><span begin="3:36.858" end="3:37.308">で</span><span begin="3:37.308" end="3:37.544">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">将你我紧密相连</span></p><p begin="3:37.716" end="3:50.730" itunes:key="L32" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">長</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:37.716" end="3:37.960">な</span><span tts:ruby="text" begin="3:37.960" end="3:38.377">が</span></span></span><span begin="3:38.377" end="3:38.435">い</span><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:38.435" end="3:38.635">ゆ</span><span tts:ruby="text" begin="3:38.635" end="3:39.056">め</span></span></span><span begin="3:39.056" end="3:39.301">が</span><span begin="3:39.301" end="3:39.791">や</span><span begin="3:39.791" end="3:39.946">っ</span><span begin="3:39.946" end="3:40.398">と</span><span tts:ruby="container"><span tts:ruby="base">終</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:40.398" end="3:40.797">お</span></span></span><span begin="3:40.797" end="3:41.069">わ</span><span begin="3:41.069" end="3:42.764">る</span> <span begin="3:42.764" end="3:43.084">そ</span><span begin="3:43.084" end="3:43.304">ば</span><span begin="3:43.304" end="3:43.537">に</span><span begin="3:43.537" end="3:43.959">い</span><span begin="3:43.959" end="3:44.411">る</span><span begin="3:44.411" end="3:47.331">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">漫长的梦境 终于走到了尽头 我就在你身旁</span><span ttm:role="x-bg" begin="3:48.125" end="3:50.730">(<span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:48.125" end="3:48.374">ひ</span><span tts:ruby="text" begin="3:48.374" end="3:48.862">か</span><span tts:ruby="text" begin="3:48.862" end="3:49.117">り</span></span></span><span begin="3:49.117" end="3:49.552">に</span><span tts:ruby="container"><span tts:ruby="base">吹</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:49.552" end="3:49.712">ふ</span></span></span><span begin="3:49.712" end="3:50.143">か</span><span begin="3:50.143" end="3:50.450">れ</span><span begin="3:50.450" end="3:50.730">て))</span><span ttm:role="x-translation" xml:lang="zh-Hans">沐浴在光芒之中</span></span></p><p begin="3:50.796" end="3:59.199" itunes:key="L33" ttm:agent="v1"><span begin="3:50.796" end="3:51.449">ゆ</span><span begin="3:51.449" end="3:51.522">っ</span><span begin="3:51.522" end="3:51.648">く</span><span begin="3:51.648" end="3:51.745">り</span><span begin="3:51.745" end="3:55.243">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">缓缓地</span><span ttm:role="x-bg" begin="3:55.254" end="3:59.199">(<span tts:ruby="container"><span tts:ruby="base">２人</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:55.254" end="3:55.503">ふ</span><span tts:ruby="text" begin="3:55.503" end="3:55.936">た</span><span tts:ruby="text" begin="3:55.936" end="3:56.175">り</span></span></span><span begin="3:56.175" end="3:56.612">で</span><span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:56.612" end="3:56.834">て</span></span></span><span begin="3:56.834" end="3:57.276">を</span><span begin="3:57.276" end="3:57.526">と</span><span begin="3:57.526" end="3:57.961">り</span><span tts:ruby="container"><span tts:ruby="base">歩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:57.961" end="3:58.201">あ</span><span tts:ruby="text" begin="3:58.201" end="3:58.623">る</span></span></span><span begin="3:58.623" end="3:58.867">こ</span><span begin="3:58.867" end="3:59.199">う))</span><span ttm:role="x-translation" xml:lang="zh-Hans">两人携手 继续前行吧</span></span></p></div></body></tt>