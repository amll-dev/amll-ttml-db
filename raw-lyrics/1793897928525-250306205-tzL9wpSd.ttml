32.807" end="01:33.218">加</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:33.218" end="01:33.763">上</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:34.076" end="01:34.348">不</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:34.348" end="01:34.789">死</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:34.789" end="01:34.989">的</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:34.989" end="01:35.507">心</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:35.507" end="01:36.771">痛</span></text><text for="L25"><span xmlns="http://www.w3.org/ns/ttml" begin="02:47.292" end="02:47.482">這</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:47.482" end="02:47.712">次</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:47.712" end="02:47.902">季</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:47.902" end="02:48.212">候</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:48.212" end="02:50.521">風</span> <span xmlns="http://www.w3.org/ns/ttml" begin="02:50.521" end="02:51.002">吹</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:51.002" end="02:51.202">得</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:51.202" end="02:51.382">格</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:51.382" end="02:51.711">外</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:51.711" end="02:52.708">兇</span></text><text for="L26"><span xmlns="http://www.w3.org/ns/ttml" begin="02:54.292" end="02:54.472">彷</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:54.472" end="02:54.682">佛</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:54.682" end="02:54.872">世</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:54.872" end="02:55.112">上</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:55.112" end="02:55.652">一</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:55.652" end="02:56.102">切</span> <span xmlns="http://www.w3.org/ns/ttml" begin="02:56.642" end="02:56.882">已</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:56.882" end="02:57.292">經</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:57.292" end="02:57.542">消</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:57.542" end="02:57.982">失</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:57.982" end="02:58.383">所</span><span xmlns="http://www.w3.org/ns/ttml" begin="02:58.383" end="03:00.451">蹤</span></text><text for="L27"><span xmlns="http://www.w3.org/ns/ttml" begin="03:01.242" end="03:01.482">你</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:01.482" end="03:01.661">似</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:01.661" end="03:01.912">季</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:01.912" end="03:02.154">候</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:02.154" end="03:04.522">風</span> <span xmlns="http://www.w3.org/ns/ttml" begin="03:04.522" end="03:04.982">抵</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:04.982" end="03:05.162">擋</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:05.162" end="03:05.352">計</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:05.352" end="03:05.632">劃</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:05.632" end="03:06.042">全</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:06.042" end="03:06.472">也</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:06.472" end="03:06.902">無</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:06.902" end="03:07.762">用</span></text><text for="L28"><span xmlns="http://www.w3.org/ns/ttml" begin="03:08.216" end="03:08.442">然</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:08.442" end="03:08.642">後</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:08.642" end="03:08.814">是</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:08.814" end="03:09.062">場</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:09.062" end="03:10.370">空</span> <span xmlns="http://www.w3.org/ns/ttml" begin="03:10.370" end="03:10.763">加</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:10.763" end="03:11.262">上</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:11.672" end="03:11.999">不</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:11.999" end="03:12.304">死</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:12.304" end="03:12.561">的</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:12.561" end="03:13.149">心</span><span xmlns="http://www.w3.org/ns/ttml" begin="03:13.149" end="03:14.404">痛</span></text></translation><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">空气中暗涌着某种悸动</text><text for="L2">那一刻我就明白 愿焚尽世界只为温暖你</text><text for="L3">可我的生活 容不得我在此停留</text><text for="L4">所以就算往后不再联络</text><text for="L5">至少我们的灵魂依然相通</text><text for="L6">唯有上帝 才能将你我分开</text><text for="L7">你在我的肌肤上 留下了印记</text><text for="L8">就在那一夜 你将我紧拥入怀</text><text for="L9">可清晨一到 我们便形同陌路</text><text for="L10">但只要你想 随时都能打给我</text><text for="L11">我就留在香港</text><text for="L16">还记得我们初遇的时刻</text><text for="L17">明明才刚认识 彼此间的张力却从未消散</text><text for="L18">如今你正安睡在我的枕边</text><text for="L19">还没来得及开始 却已悄然走向终局</text><text for="L20">可我知道 上帝终会将你我拆散</text><text for="L21">每当感觉如此美妙 结局总沦为一曲悲歌</text><text for="L22">我早已习惯 承受所有的变幻</text><text for="L23">所以若是哪天 你改变了心意</text><text for="L24">我依然在香港等你</text></translation><translation xml:lang="zh-Hant" type="subtitle"><text for="L1">空氣中暗湧著某種悸動</text><text for="L2">那一刻我就明白 願焚盡世界只為溫暖你</text><text for="L3">可我的生活 容不得我在此停留</text><text for="L4">所以就算往後不再聯絡</text><text for="L5">至少我們的靈魂依然相通</text><text for="L6">唯有上帝 才能將你我分開</text><text for="L7">你在我的肌膚上 留下了印記</text><text for="L8">就在那一夜 你將我緊擁入懷</text><text for="L9">可清晨一到 我們便形同陌路</text><text for="L10">但只要你想 隨時都能打給我</text><text for="L11">我就留在香港</text><text for="L16">還記得我們初遇的時刻</text><text for="L17">明明才剛認識 彼此間的張力卻從未消散</text><text for="L18">如今你正安睡在我的枕邊</text><text for="L19">還沒來得及開始 卻已悄然走向終局</text><text for="L20">可我知道 上帝終會將你我拆散</text><text for="L21">每當感覺如此美妙 結局總淪為一曲悲歌</text><text for="L22">我早已習慣 承受所有的變幻</text><text for="L23">所以若是哪天 你改變了心意</text><text for="L24">我依然在香港等你</text></translation></translations><transliterations><transliteration automaticallyCreated="true" xml:lang="zh-Latn-jyutping"><text for="L12"><span xmlns="http://www.w3.org/ns/ttml" begin="01:09.710" end="01:09.898">ze5</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:09.898" end="01:10.141">ci3</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:10.141" end="01:10.369">gwai3</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:10.369" end="01:10.572">hau6</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:10.572" end="01:12.932">fung1</span> <span xmlns="http://www.w3.org/ns/ttml" begin="01:12.932" end="01:13.409">ceoi1</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:13.409" end="01:13.590">dak1</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:13.590" end="01:13.800">gaak3</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:13.800" end="01:14.046">ngoi6</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:14.046" end="01:15.029">hung1</span></text><text for="L13"><span xmlns="http://www.w3.org/ns/ttml" begin="01:16.662" end="01:16.867">fong2</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:16.867" end="01:17.050">fat6</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:17.050" end="01:17.263">sai3</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:17.263" end="01:17.536">soeng6</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:17.536" end="01:18.010">jat1</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:18.010" end="01:18.491">cai3</span> <span xmlns="http://www.w3.org/ns/ttml" begin="01:19.113" end="01:19.296">ji5</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:19.296" end="01:19.649">ging1</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:19.649" end="01:19.905">siu1</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:19.905" end="01:20.345">sat1</span><span xmlns="http://www.w3.org/ns/ttml" begin="01:20.445" end="01:20.743">so2</span><span xmlns="http://www.w3.org/ns