.940" end="5:09.160">の</span><span tts:ruby="text" begin="5:09.160" end="5:09.420">く</span><span tts:ruby="text" begin="5:09.420" end="5:09.680">に</span></span></span><span begin="5:09.680" end="5:09.880">は</span><span begin="5:09.880" end="5:10.380">こ</span><span begin="5:10.380" end="5:10.640">れ</span><span begin="5:10.640" end="5:10.880">に</span><span begin="5:10.880" end="5:11.093">あ</span><span begin="5:11.093" end="5:12.113">り</span><span ttm:role="x-translation">幻想乡尽在于此</span><span ttm:role="x-roman">maboroshi no kuni wa kore ni ari</span></p><p begin="5:11.093" end="5:12.113" itunes:key="L74" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">華</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:11.093" end="5:11.373">は</span><span tts:ruby="text" begin="5:11.373" end="5:11.603">な</span></span></span><span tts:ruby="container"><span tts:ruby="base">咲</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:11.603" end="5:11.860">さ</span><span tts:ruby="text" begin="5:11.860" end="5:12.113">く</span></span></span><span ttm:role="x-translation">花开似锦</span><span ttm:role="x-roman">hana saku</span></p><p begin="5:12.160" end="5:15.480" itunes:key="L75" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">望</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:12.160" end="5:12.533">の</span><span tts:ruby="text" begin="5:12.533" end="5:12.820">ぞ</span></span></span><span begin="5:12.820" end="5:13.060">み</span><span tts:ruby="container"><span tts:ruby="base">望</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:13.060" end="5:13.260">の</span><span tts:ruby="text" begin="5:13.260" end="5:13.520">ぞ</span></span></span><span begin="5:13.520" end="5:13.760">ま</span><span begin="5:13.760" end="5:14.260">れ</span><span begin="5:14.260" end="5:14.480">て</span><span begin="5:14.480" end="5:14.733">こ</span><span begin="5:14.733" end="5:14.960">こ</span><span begin="5:14.960" end="5:15.480">に</span><span ttm:role="x-translation">遂人愿己愿，绽放于此</span><span ttm:role="x-roman">nozomi nozomarete koko ni</span></p><p begin="5:15.680" end="5:19.120" itunes:key="L76" ttm:agent="v1"><span begin="5:15.680" end="5:15.960">め</span><span begin="5:15.960" end="5:16.400">で</span><span begin="5:16.400" end="5:16.640">た</span><span begin="5:16.640" end="5:16.920">き</span><span begin="5:16.920" end="5:17.180">も</span><span begin="5:17.180" end="5:17.400">の</span><span begin="5:17.400" end="5:17.620">は</span><span begin="5:17.620" end="5:18.100">こ</span><span begin="5:18.100" end="5:18.360">れ</span><span begin="5:18.360" end="5:18.600">に</span><span begin="5:18.600" end="5:18.840">あ</span><span begin="5:18.840" end="5:19.120">り</span><span ttm:role="x-translation">如画般的景致就在这里</span><span ttm:role="x-roman">medetaki mono wa kore ni ari</span></p><p begin="5:19.300" end="5:22.980" itunes:key="L77" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:19.300" end="5:19.583">ゆ</span><span tts:ruby="text" begin="5:19.583" end="5:19.833">め</span></span></span><span begin="5:19.833" end="5:20.260">と</span><span tts:ruby="container"><span tts:ruby="base">現</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:20.260" end="5:20.500">う</span><span tts:ruby="text" begin="5:20.500" end="5:20.760">つ</span><span tts:ruby="text" begin="5:20.760" end="5:21.260">つ</span></span></span><span begin="5:21.260" end="5:21.500">と</span><span tts:ruby="container"><span tts:ruby="base">交</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:21.500" end="5:22.000">ま</span><span tts:ruby="text" begin="5:22.000" end="5:22.220">じ</span></span></span><span begin="5:22.220" end="5:22.480">え</span><span begin="5:22.480" end="5:22.720">て</span><span begin="5:22.720" end="5:22.980">は</span><span ttm:role="x-translation">梦与现交错之际</span><span ttm:role="x-roman">yume to utsutsu to majiete wa</span></p><p begin="5:23.160" end="5:31.870" itunes:key="L78" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">幻想郷</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:23.160" end="5:23.440">ま</span><span tts:ruby="text" begin="5:23.440" end="5:23.700">ぼ</span><span tts:ruby="text" begin="5:23.700" end="5:24.100">ろ</span><span tts:ruby="text" begin="5:24.100" end="5:24.680">し</span><span tts:ruby="text" begin="5:24.680" end="5:24.900">の</span><span tts:ruby="text" begin="5:24.900" end="5:25.160">く</span><span tts:ruby="text" begin="5:25.160" end="5:25.400">に</span></span></span><span begin="5:25.400" end="5:26.140">に</span><span tts:ruby="container"><span tts:ruby="base">遊</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="5:26.560" end="5:26.800">あ</span><span tts:ruby="text" begin="5:26.800" end="5:27.080">そ</span></span></span><span begin="5:27.080" end="5:27.320">ぶ</span><span begin="5:27.320" end="5:27.540">が</span><span begin="5:27.540" end="5:29.520">い</span><span begin="5:29.520" end="5:31.870">い</span><span ttm:role="x-translation">只消畅玩于幻想乡</span><span ttm:role="x-roman">maboroshi no kuni ni asobu ga ii</span></p></div></body></tt>