.300" end="4:18.480">ら</span><span begin="4:18.480" end="4:18.660">れ</span><span begin="4:18.660" end="4:18.840">れ</span><span begin="4:18.840" end="4:19.320">ば</span><span tts:ruby="container"><span tts:ruby="base">救</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:19.320" end="4:19.480">す</span><span tts:ruby="text" begin="4:19.480" end="4:19.700">く</span></span></span><span begin="4:19.700" end="4:19.860">わ</span><span begin="4:19.860" end="4:20.040">れ</span><span begin="4:20.040" end="4:20.200">る</span><span begin="4:20.200" end="4:20.540">か</span><span begin="4:20.540" end="4:20.880">ら</span><span ttm:role="x-translation">因为你置身彼处我就能获得救赎</span><span ttm:role="x-roman">anata ga soko ni irarereba sukuwareru kara</span></p><p begin="4:21.200" end="4:22.240" itunes:key="L53" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">訊</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:21.200" end="4:21.440">き</span></span></span><span begin="4:21.440" end="4:21.560">か</span><span begin="4:21.560" end="4:21.800">な</span><span begin="4:21.800" end="4:21.920">い</span><span begin="4:21.920" end="4:22.240">で</span><span ttm:role="x-translation">请不要自责</span><span ttm:role="x-roman">kikanai de</span></p><p begin="4:22.240" end="4:26.220" itunes:key="L54" ttm:agent="v1"><span begin="4:22.240" end="4:22.440">あ</span><span begin="4:22.440" end="4:22.600">な</span><span begin="4:22.600" end="4:22.760">た</span><span begin="4:22.760" end="4:22.900">が</span><span begin="4:22.900" end="4:23.100">そ</span><span begin="4:23.100" end="4:23.300">こ</span><span begin="4:23.300" end="4:23.540">に</span><span begin="4:23.540" end="4:23.780">い</span><span begin="4:23.780" end="4:23.960">ら</span><span begin="4:23.960" end="4:24.120">れ</span><span begin="4:24.140" end="4:24.280">れ</span><span begin="4:24.280" end="4:24.420">ば</span><span begin="4:24.420" end="4:24.640">そ</span><span begin="4:24.640" end="4:24.960">れ</span><span begin="4:24.960" end="4:25