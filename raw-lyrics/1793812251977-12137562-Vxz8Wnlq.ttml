0" end="57.740">の</span><span tts:ruby="container"><span tts:ruby="base">元</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="57.740" end="58.320">も</span><span tts:ruby="text" begin="58.320" end="58.620">と</span></span></span><span begin="58.620" end="59.240">へ</span> <span tts:ruby="container"><span tts:ruby="base">還</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="59.500" end="1:00.060">か</span><span tts:ruby="text" begin="1:00.060" end="1:00.400">え</span></span></span><span begin="1:00.400" end="1:01.020">る</span><span begin="1:01.020" end="1:01.343">で</span><span begin="1:01.343" end="1:01.870">しょ</span><span begin="1:01.870" end="1:02.590">う</span><span ttm:role="x-translation">我定会回到你身边吧</span><span ttm:role="x-roman">anata no moto e kaeru deshō</span></p><p begin="1:03.353" end="1:10.420" itunes:key="L9" ttm:agent="v1"><span begin="1:03.353" end="1:03.700">う</span><span begin="1:03.700" end="1:04.020">ね</span><span begin="1:04.020" end="1:04.580">り</span><span begin="1:04.580" end="1:04.840">を</span><span tts:ruby="container"><span tts:ruby="base">裂</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:04.840" end="1:05.540">さ</span></span></span><span begin="1:05.540" end="1:05.760">い</span><span begin="1:05.760" end="1:06.680">て</span> <span tts:ruby="container"><span tts:ruby="base">闇</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:06.960" end="1:07.320">や</span><span tts:ruby="text" begin="1:07.320" end="1:07.580">み</span></span></span><span begin="1:07.580" end="1:08.220">を</span><span begin="1:08.220" end="1:08.500">ほ</span><span begin="1:08.500" end="1:08.990">ど</span><span begin="1:08.990" end="1:09.423">い</span><span begin="1:09.423" end="1:10.420">て</span><span ttm:role="x-translation">撕碎海浪 劈开黑暗</span><span ttm:role="x-roman">uneri o saite yami o hodoite</span></p><p begin="1:11.060" end="1:17.660" itunes:key="L10" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:11.060" end="1:11.440">ゆ</span><span tts:ruby="text" begin="1:11.440" end="1:11.740">め</span></span></span><span begin="1:11.740" end="1:12.040">の</span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:12.040" end="1:12.620">な</span><span tts:ruby="text" begin="1:12.620" end="1:12.940">か</span></span></span><span begin="1:12.940" end="1:13.560">は</span><span tts:ruby="container"><span tts:ruby="base">濁</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:13.560" end="1:13.840">に</span><span tts:ruby="text" begin="1:13.840" end="1:14.760">ご</span></span></span><span begin="1:14.760" end="1:15.460">ら</span><span begin="1:15.460" end="1:17.660">ず</span><span ttm:role="x-translation">梦境之中依旧澄澈不染</span><span ttm:role="x-roman">yume no naka wa nigorazu</span></p><p begin="1:19.200" end="1:25.600" itunes:key="L11" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">碧</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:19.200" end="1:19.620">あ</span><span tts:ruby="text" begin="1:19.620" end="1:19.950">お</span></span></span><span begin="1:19.950" end="1:20.183">く</span><span tts:ruby="container"><span tts:ruby="base">続</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:20.183" end="1:20.420">つ</span><span tts:ruby="text" begin="1:20.420" end="1:20.700">づ</span></span></span><span begin="1:20.700" end="1:21.020">く</span><span tts:ruby="container"><span tts:ruby="base">道</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:21.020" end="1:21.200">み</span><span tts:ruby="text" begin="1:21.200" end="1:22.800">ち</span></span></span><span begin="1:22.800" end="1:25.600">を</span><span ttm:role="x-translation">延续向那碧蓝连绵的道路</span><span ttm:role="x-roman">aoku tsuzuku michi o</span></p><p begin="1:36.740" end="1:43.300" itunes:key="L12" ttm:agent="v1"><span tts:ruby="container"><sp