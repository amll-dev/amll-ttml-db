<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="無間嫉妬劇場『666』"/><amll:meta key="artists" value="あやぽんず*"/><amll:meta key="artists" value="あよ"/><amll:meta key="album" value="ネタミニティ"/><amll:meta key="ncmMusicId" value="1306498257"/><amll:meta key="qqMusicId" value="000cB3xV3NIrGX"/><amll:meta key="appleMusicId" value="1437769867"/><amll:meta key="spotifyId" value="7aRZV9axsW32NIsewNXHZf"/><amll:meta key="ttmlAuthorGithubLogin" value="Mrs4s"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>kaztora</songwriter><songwriter>waoru</songwriter><songwriter>夜好ころろ</songwriter><songwriter>Hedonist</songwriter><songwriter>Zen</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="4:32.670"><div begin="27.993" end="4:32.670"><p begin="27.993" end="35.110" itunes:key="L1" ttm:agent="v1"><span begin="27.993" end="28.290">奈</span><span begin="28.290" end="28.500">落</span><span begin="28.500" end="28.750">の</span><span begin="28.750" end="29.213">底</span><span begin="29.213" end="29.623">で</span> <span begin="29.623" end="30.033">幕</span><span begin="30.033" end="30.310">が</span><span begin="30.310" end="30.523">上</span><span begin="30.523" end="30.843">がっ</span><span begin="30.843" end="31.200">た</span> <span begin="31.200" end="31.653">絶</span><span begin="31.653" end="32.263">望</span><span begin="32.263" end="32.883">的</span><span begin="32.883" end="33.263">な</span><span begin="33.263" end="34.123">喜</span><span begin="34.123" end="35.110">劇</span><span ttm:role="x-translation" xml:lang="zh-Hans">无间地狱之底 绝望的喜剧 拉开了帷幕</span><span ttm:role="x-roman">na ra ku no so ko de ma ku ga a ga tta ze tsu bo u te ki na ki ge ki</span></p><p begin="35.463" end="37.850" itunes:key="L2" ttm:agent="v1"><span begin="35.463" end="35.703">こ</span><span begin="35.703" end="36.103">の</span><span begin="36.103" end="36.320">場</span><span begin="36.320" end="36.473">を</span><span begin="36.473" end="36.933">借</span><span begin="36.933" end="37.323">り</span><span begin="37.323" end="37.850">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">就借此地</span><span ttm:role="x-roman">ko no ba wo ka ri te</span></p><p begin="38.023" end="41.470" itunes:key="L3" ttm:agent="v1"><span begin="38.023" end="38.333">お</span><span begin="38.333" end="38.850">話</span><span begin="38.850" end="39.353">し</span><span begin="39.353" end="39.693">を</span><span begin="39.693" end="40.220">致</span><span begin="40.220" end="40.563">し</span><span begin="40.563" end="40.650">ま</span><span begin="40.650" end="40.983">しょ</span><span begin="40.983" end="41.173">う</span><span begin="41.173" end="41.470">か</span><span ttm:role="x-translation" xml:lang="zh-Hans">来讲讲故事吧…</span><span ttm:role="x-roman">o ha na shi wo i ta shi ma sho u ka</span></p><p begin="41.563" end="44.683" itunes:key="L4" ttm:agent="v2"><span begin="41.563" end="41.973">第</span><span begin="41.973" end="42.593">一</span><span begin="42.593" end="42.983">幕</span><span begin="42.983" end="43.260">『閑</span><span begin="43.260" end="43.813">静</span><span begin="43.813" end="44.003">な</span><span begin="44.013" end="44.360">日</span><span begin="44.360" end="44.683">常』</span><span ttm:role="x-translation" xml:lang="zh-Hans">☆第一幕『清静的日常』☆</span><span ttm:role="x-roman">da i i chi ma ku『ka n se i na ni chi jo u』</span></p><p begin="44.813" end="48.110" itunes:key="L5" ttm:agent="v2"><span begin="44.813" end="45.030">キャ</span><span begin="45.030" end="45.223">ス</span><span begin="45.223" end="45.433">ト</span><span begin="45.433" end="45.823">は</span><span begin="45.823" end="46.043">有</span><span begin="46.043" end="46.223">り</span><span begin="46.223" end="46.663">触</span><span begin="46.663" end="47.033">れ</span><span begin="47.033" end="47.243">た</span><span begin="47.243" end="47.453">モ</span><span begin="47.453" end="47.653">ブ</span><span begin="47.653" end="48.110">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">出演者是随处可见的路人</span><span ttm:role="x-roman">kya su to wa a ri fu re ta mo bu de</span></p><p begin="48.463" end="54.123" itunes:key="L6" ttm:agent="v1"><span begin="48.463" end="48.633">不</span><span begin="48.633" end="48.840">器</span><span begin="48.840" end="49.283">用</span><span begin="49.283" end="49.533">な</span><span begin="49.533" end="49.913">日</span><span begin="49.913" end="50.480">陰</span><span begin="50.480" end="51.123">者</span><span begin="51.123" end="51.283">に</span> <span begin="51.283" end="52.113">役</span><span begin="52.113" end="52.420">目</span><span begin="52.420" end="52.933">は</span><span begin="52.933" end="53.370">な</span><span begin="53.370" end="54.123">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">但笨拙的湮没于世的人没有上场的资格</span><span ttm:role="x-roman">bu ki yo u na hi ka ge mo no ni ya ku me wa na i</span></p><p begin="54.553" end="1:00.500" itunes:key="L7" ttm:agent="v1"><span begin="54.553" end="56.183">枯</span><span begin="56.183" end="57.743">れ</span><span begin="57.743" end="58.603">果</span><span begin="58.603" end="59.423">て</span><span begin="59.423" end="1:00.500">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">只能像花一样</span><span ttm:role="x-roman">ka re ha te ta</span></p><p begin="1:00.603" end="1:10.840" itunes:key="L8" ttm:agent="v2"><span begin="1:00.603" end="1:01.843">華</span><span begin="1:01.843" end="1:02.623">は</span><span begin="1:02.623" end="1:03.410">落</span><span begin="1:03.410" end="1:04.273">ち</span><span begin="1:04.273" end="1:10.840">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">枯萎凋零而终结</span><span ttm:role="x-roman">ha na wa o chi te</span></p><p begin="1:12.103" end="1:15.250" itunes:key="L9" ttm:agent="v1"><span begin="1:12.103" end="1:13.340">嗚</span><span begin="1:13.340" end="1:15.250">呼</span><span ttm:role="x-translation" xml:lang="zh-Hans">啊啊</span><span ttm:role="x-roman">a a</span></p><p begin="1:14.423" end="1:19.913" itunes:key="L10" ttm:agent="v2"><span begin="1:14.423" end="1:14.991">誰</span><span begin="1:14.991" end="1:15.163">よ</span><span begin="1:15.163" end="1:15.330">り</span><span begin="1:15.330" end="1:15.523">も</span><span begin="1:15.523" end="1:15.643">努</span><span begin="1:15.643" end="1:15.940">力</span><span begin="1:15.940" end="1:16.090">を</span><span begin="1:16.090" end="1:16.390">し</span><span begin="1:16.390" end="1:16.690">て</span><span begin="1:16.690" end="1:16.850">い</span><span begin="1:16.850" end="1:17.080">る</span> <span begin="1:17.283" end="1:17.750">誰</span><span begin="1:17.750" end="1:17.970">よ</span><span begin="1:17.970" end="1:18.190">り</span><span begin="1:18.190" end="1:18.510">も</span><span begin="1:18.510" end="1:18.710">普</span><span begin="1:18.710" end="1:18.940">通</span><span begin="1:18.940" end="1:19.100">を</span><span begin="1:19.100" end="1:19.400">調</span><span begin="1:19.400" end="1:19.540">べ</span><span begin="1:19.540" end="1:19.913">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明比谁都更加努力 比谁都认真钻研何为普通</span><span ttm:role="x-roman">da re yo ri mo do ryo ku wo shi te i ru da re yo ri mo fu tsu u wo shi ra be ta</span></p><p begin="1:15.523" end="1:24.900" itunes:key="L11" ttm:agent="v1"><span begin="1:15.523" end="1:16.213">ど</span><span begin="1:16.213" end="1:16.830">う</span><span begin="1:16.830" end="1:18.353">し</span><span begin="1:18.353" end="1:19.300">て</span> <span begin="1:19.300" end="1:19.553">う</span><span begin="1:19.553" end="1:19.790">ま</span><span begin="1:19.790" end="1:20.770">く</span><span begin="1:20.770" end="1:20.970">で</span><span begin="1:20.970" end="1:21.163">き</span><span begin="1:21.163" end="1:21.520">な</span><span begin="1:21.520" end="1:21.873">い</span><span begin="1:21.873" end="1:22.243">ん</span><span begin="1:22.243" end="1:22.573">だ</span><span begin="1:22.573" end="1:23.540">ろ</span><span begin="1:23.540" end="1:24.900">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">为什么 无法好好的做到啊</span><span ttm:role="x-roman">do u shi te u ma ku de ki na i n da ro u</span></p><p begin="1:20.080" end="1:25.560" itunes:key="L12" ttm:agent="v2"><span begin="1:20.080" end="1:20.451">そ</span><span begin="1:20.451" end="1:21.160">れ</span><span begin="1:21.160" end="1:21.873">で</span><span begin="1:21.873" end="1:22.573">も</span> <span begin="1:22.881" end="1:23.461">誰</span><span begin="1:23.461" end="1:23.670">よ</span><span begin="1:23.670" end="1:23.930">り</span><span begin="1:23.930" end="1:24.140">も</span><span begin="1:24.140" end="1:24.320">普</span><span begin="1:24.320" end="1:24.570">通</span><span begin="1:24.570" end="1:24.711">を</span><span begin="1:24.711" end="1:24.940">で</span><span begin="1:24.940" end="1:25.073">き</span><span begin="1:25.073" end="1:25.233">な</span><span begin="1:25.233" end="1:25.560">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">即使如此 也不能变得与普通人一样</span><span ttm:role="x-roman">so re de mo da re yo ri mo fu tsu u wo de ki na i</span></p><p begin="1:25.751" end="1:31.051" itunes:key="L13" ttm:agent="v2"><span begin="1:25.751" end="1:25.921">普</span><span begin="1:25.921" end="1:26.301">通</span><span begin="1:26.301" end="1:26.711">に</span><span begin="1:26.711" end="1:26.910">み</span><span begin="1:26.910" end="1:27.181">ん</span><span begin="1:27.181" end="1:27.310">な</span><span begin="1:27.310" end="1:27.431">と</span><span begin="1:27.431" end="1:27.811">話</span><span begin="1:27.811" end="1:28.091">し</span><span begin="1:28.091" end="1:28.410">て</span> <span begin="1:28.571" end="1:28.850">普</span><span begin="1:28.850" end="1:29.131">通</span><span begin="1:29.131" end="1:29.481">に</span><span begin="1:29.481" end="1:29.760">生</span><span begin="1:29.760" end="1:29.971">き</span><span begin="1:29.971" end="1:30.171">て</span><span begin="1:30.171" end="1:30.331">み</span><span begin="1:30.331" end="1:30.530">た</span><span begin="1:30.530" end="1:30.730">い</span><span begin="1:30.730" end="1:30.881">の</span><span begin="1:30.881" end="1:31.051">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">只是想普通的和大家聊天 只是想普通的活着</span><span ttm:role="x-roman">fu tsu u ni mi n na to ha na shi te fu tsu u ni i ki te mi ta i no ni</span></p><p begin="1:25.401" end="1:36.701" itunes:key="L14" ttm:agent="v1"><span begin="1:25.401" end="1:26.770">ど</span><span begin="1:26.770" end="1:27.390">う</span><span begin="1:27.390" end="1:28.221">し</span><span begin="1:28.221" end="1:30.450">て</span> <span begin="1:30.703" end="1:31.881">心</span><span begin="1:32.171" end="1:32.820">蝕</span><span begin="1:32.820" end="1:33.191">ま</span><span begin="1:33.191" end="1:33.591">れ</span><span begin="1:33.591" end="1:33.851">て</span><span begin="1:33.851" end="1:36.701">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">为什么 心灵逐渐被腐蚀</span><span ttm:role="x-roman">do u shi te ko ko ro mu shi ba ma re te ku</span></p><p begin="1:31.051" end="1:36.701" itunes:key="L15" ttm:agent="v2"><span begin="1:31.051" end="1:31.751">変</span><span begin="1:31.751" end="1:32.461">わ</span><span begin="1:32.461" end="1:33.161">ら</span><span begin="1:33.161" end="1:33.490">な</span><span begin="1:33.490" end="1:33.871">い</span> <span begin="1:34.221" end="1:34.441">こ</span><span begin="1:34.441" end="1:34.761">れ</span><span begin="1:34.761" end="1:35.131">は</span><span begin="1:35.131" end="1:35.451">本</span><span begin="1:35.451" end="1:35.621">当</span><span begin="1:35.621" end="1:35.801">に</span><span begin="1:35.801" end="1:36.701">私？</span><span ttm:role="x-translation" xml:lang="zh-Hans">却无法改变 这真的是我吗？</span><span ttm:role="x-roman">ka wa ra na i ko re wa ho n to u ni wa ta shi?</span></p><p begin="1:52.101" end="1:54.761" itunes:key="L16" ttm:agent="v2"><span begin="1:52.101" end="1:52.241">ぎ</span><span begin="1:52.241" end="1:52.421">こ</span><span begin="1:52.421" end="1:52.621">ち</span><span begin="1:52.621" end="1:52.790">な</span><span begin="1:52.790" end="1:52.981">く</span><span begin="1:52.981" end="1:53.220">笑</span><span begin="1:53.220" end="1:53.501">う</span> <span begin="1:53.501" end="1:53.671">不</span><span begin="1:53.671" end="1:53.861">慣</span><span begin="1:53.861" end="1:54.021">れ</span><span begin="1:54.021" end="1:54.131">な</span><span begin="1:54.131" end="1:54.541">演</span><span begin="1:54.541" end="1:54.761">技</span><span ttm:role="x-translation" xml:lang="zh-Hans">尴尬的笑容 生疏的演技</span><span ttm:role="x-roman">gi ko chi na ku wa ra u fu na re na e n gi</span></p><p begin="1:54.911" end="1:58.291" itunes:key="L17" ttm:agent="v2"><span begin="1:54.911" end="1:55.030">「も</span><span begin="1:55.030" end="1:55.141">う</span><span begin="1:55.141" end="1:55.630">少</span><span begin="1:55.630" end="1:55.830">し</span><span begin="1:55.830" end="1:55.991">自</span><span begin="1:55.991" end="1:56.331">然</span><span begin="1:56.331" end="1:56.561">に</span><span begin="1:56.561" end="1:57.021">し</span><span begin="1:57.021" end="1:57.361">た</span><span begin="1:57.361" end="1:58.291">ら？」</span><span ttm:role="x-translation" xml:lang="zh-Hans">「再自然一点怎么样？」</span><span ttm:role="x-roman">「mo u su ko shi shi ze n ni shi ta ra?」</span></p><p begin="1:58.601" end="2:00.830" itunes:key="L18" ttm:agent="v1"><span begin="1:58.601" end="1:59.161">第</span><span begin="1:59.161" end="1:59.331">二</span><span begin="1:59.331" end="1:59.851">幕</span><span begin="1:59.851" end="2:00.111">『覚</span><span begin="2:00.111" end="2:00.830">醒』</span><span ttm:role="x-translation" xml:lang="zh-Hans">☆第二幕『觉醒』☆</span><span ttm:role="x-roman">da i ni ma ku『ka ku se i』</span></p><p begin="2:01.321" end="2:03.863" itunes:key="L19" ttm:agent="v1"><span begin="2:01.321" end="2:01.520">「何</span><span begin="2:01.520" end="2:01.631">も</span><span begin="2:01.631" end="2:01.780">知</span><span begin="2:01.780" end="2:01.891">ら</span><span begin="2:01.891" end="2:01.970">な</span><span begin="2:01.970" end="2:02.081">い</span><span begin="2:02.081" end="2:02.361">で」</span><span begin="2:02.601" end="2:02.971">ふ</span><span begin="2:02.971" end="2:03.193">ざ</span><span begin="2:03.193" end="2:03.390">け</span><span begin="2:03.390" end="2:03.573">る</span><span begin="2:03.573" end="2:03.863">な</span><span ttm:role="x-translation" xml:lang="zh-Hans">「我什么都不知道」别开玩笑了</span><span ttm:role="x-roman">「na ni mo shi ra na i de」fu za ke ru na</span></p><p begin="2:03.863" end="2:06.760" itunes:key="L20" ttm:agent="v1"><span begin="2:03.863" end="2:04.120">聞</span><span begin="2:04.120" end="2:04.273">い</span><span begin="2:04.273" end="2:04.453">て</span><span begin="2:04.453" end="2:04.803">も</span><span begin="2:04.803" end="2:04.990">な</span><span begin="2:04.990" end="2:05.123">い</span> <span begin="2:05.123" end="2:05.493">傲</span><span begin="2:05.493" end="2:05.863">慢</span><span begin="2:05.863" end="2:06.050">な</span><span begin="2:06.050" end="2:06.210">ア</span><span begin="2:06.210" end="2:06.383">ド</span><span begin="2:06.383" end="2:06.490">バ</span><span begin="2:06.490" end="2:06.583">イ</span><span begin="2:06.583" end="2:06.760">ス</span><span ttm:role="x-translation" xml:lang="zh-Hans">傲慢的建议有什么听的必要吗</span><span ttm:role="x-roman">ki i te mo na i go u ma n na a do ba i su</span></p><p begin="2:06.760" end="2:09.443" itunes:key="L21" ttm:agent="v1"><span begin="2:06.760" end="2:07.093">そ</span><span begin="2:07.093" end="2:07.273">れ</span><span begin="2:07.273" end="2:07.573">は</span><span begin="2:07.573" end="2:07.893">健</span><span begin="2:07.893" end="2:08.233">常</span><span begin="2:08.233" end="2:08.683">者</span><span begin="2:08.683" end="2:08.850">の</span><span begin="2:08.850" end="2:09.030">理</span><span begin="2:09.030" end="2:09.443">屈</span><span ttm:role="x-translation" xml:lang="zh-Hans">那只是一般人的借口</span><span ttm:role="x-roman">so re wa ke n jo u sha no ri ku tsu</span></p><p begin="2:09.901" end="2:12.130" itunes:key="L22" ttm:agent="v2"><span begin="2:09.901" end="2:10.461">心</span><span begin="2:10.461" end="2:10.711">が</span><span begin="2:10.711" end="2:11.300">沈</span><span begin="2:11.300" end="2:11.501">ん</span><span begin="2:11.501" end="2:11.691">で</span><span begin="2:11.691" end="2:12.130">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">心灵不断堕落</span><span ttm:role="x-roman">ko ko ro ga shi zu n de ku</span></p><p begin="2:12.213" end="2:13.273" itunes:key="L23" ttm:agent="v1"><span begin="2:12.213" end="2:12.733">貴</span><span begin="2:12.733" end="2:12.903">方</span><span begin="2:12.903" end="2:13.273">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">你。</span><span ttm:role="x-roman">a na ta ga</span></p><p begin="2:13.273" end="2:14.760" itunes:key="L24" ttm:agent="v2"><span begin="2:13.273" end="2:13.400">い</span><span begin="2:13.400" end="2:13.613">え</span><span begin="2:13.613" end="2:14.333">皆</span><span begin="2:14.333" end="2:14.760">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">不，是大家</span><span ttm:role="x-roman">i e mi na ga</span></p><p begin="2:15.023" end="2:15.950" itunes:key="L25" ttm:agent="v1"><span begin="2:15.023" end="2:15.180">何</span><span begin="2:15.180" end="2:15.363">も</span><span begin="2:15.363" end="2:15.573">か</span><span begin="2:15.573" end="2:15.733">も</span><span begin="2:15.733" end="2:15.950">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">一切的一切</span><span ttm:role="x-roman">na ni mo ka mo ga</span></p><p begin="2:15.820" end="2:16.633" itunes:key="L26" ttm:agent="v2"><span begin="2:15.820" end="2:16.263">全</span><span begin="2:16.263" end="2:16.443">て</span><span begin="2:16.443" end="2:16.633">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">所有的</span><span ttm:role="x-roman">su be te ga</span></p><p begin="2:16.633" end="2:20.130" itunes:key="L27" ttm:agent="v1"><span begin="2:16.633" end="2:17.183">眩</span><span begin="2:17.183" end="2:18.650">し</span><span begin="2:18.650" end="2:20.130">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">都太过耀眼</span><span ttm:role="x-roman">ma bu shi i</span></p><p begin="2:22.141" end="2:29.030" itunes:key="L28" ttm:agent="v1"><span begin="2:22.141" end="2:22.751">妬</span><span begin="2:22.751" end="2:24.021">ま</span><span begin="2:24.021" end="2:24.500">し</span><span begin="2:24.500" end="2:25.131">い</span> <span begin="2:25.361" end="2:25.660">こ</span><span begin="2:25.660" end="2:26.141">の</span><span begin="2:26.141" end="2:26.971">世</span><span begin="2:26.971" end="2:28.401">界</span><span begin="2:28.401" end="2:29.030">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">好嫉妒啊 这个世界</span><span ttm:role="x-roman">ne ta ma shi i ko no se ka i ga</span></p><p begin="2:24.500" end="2:29.781" itunes:key="L29" ttm:agent="v2"><span begin="2:24.500" end="2:25.041">偽っ</span><span begin="2:25.041" end="2:25.391">て</span><span begin="2:25.391" end="2:25.990">周</span><span begin="2:25.990" end="2:26.231">り</span><span begin="2:26.231" end="2:26.370">に</span><span begin="2:26.370" end="2:26.530">合</span><span begin="2:26.530" end="2:26.680">わ</span><span begin="2:26.680" end="2:26.821">せ</span><span begin="2:26.821" end="2:27.120">て</span> <span begin="2:27.291" end="2:27.921">造っ</span><span begin="2:27.921" end="2:28.221">て</span><span begin="2:28.221" end="2:28.521">無</span><span begin="2:28.521" end="2:28.730">理</span><span begin="2:28.730" end="2:28.921">を</span><span begin="2:28.921" end="2:29.100">す</span><span begin="2:29.100" end="2:29.271">る</span><span begin="2:29.271" end="2:29.430">よ</span><span begin="2:29.430" end="2:29.590">り</span><span begin="2:29.590" end="2:29.781">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">虚伪地（笑着）迎合着周围所作出的 （虚假的笑容）与其勉强自己</span><span ttm:role="x-roman">i tsu wa tte ma wa ri ni a wa se te tsu ku tte mu ri wo su ru yo ri mo</span></p><p begin="2:29.204" end="2:35.080" itunes:key="L30" ttm:agent="v1"><span begin="2:29.204" end="2:29.781">全</span><span begin="2:29.781" end="2:30.421">部</span> <span begin="2:30.861" end="2:31.241">呪</span><span begin="2:31.241" end="2:31.540">い</span><span begin="2:31.540" end="2:31.901">尽</span><span begin="2:31.901" end="2:32.160">く</span><span begin="2:32.160" end="2:32.611">す</span><span begin="2:32.611" end="2:35.080">わ</span><span ttm:role="x-translation" xml:lang="zh-Hans">不如诅咒所有吞噬一切</span><span ttm:role="x-roman">ze n bu no ro i tsu ku su wa</span></p><p begin="2:29.781" end="2:35.721" itunes:key="L31" ttm:agent="v2"><span begin="2:29.781" end="2:30.631">な</span><span begin="2:30.631" end="2:31.251">ん</span><span begin="2:31.251" end="2:31.901">だ</span><span begin="2:31.901" end="2:32.831">か</span> <span begin="2:32.831" end="2:33.211">自</span><span begin="2:33.211" end="2:33.491">然</span><span begin="2:33.491" end="2:33.850">に</span><span begin="2:33.850" end="2:34.400">笑</span><span begin="2:34.400" end="2:34.590">え</span><span begin="2:34.590" end="2:34.780">る</span><span begin="2:34.780" end="2:34.961">気</span><span begin="2:34.961" end="2:35.151">が</span><span begin="2:35.151" end="2:35.251">す</span><span begin="2:35.251" end="2:35.721">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">不知为何 这样想的话就可以很自然的笑出来了</span><span ttm:role="x-roman">na n da ka shi ze n ni wa ra e ru ki ga su ru</span></p><p begin="2:35.451" end="2:40.321" itunes:key="L32" ttm:agent="v1"><span begin="2:35.451" end="2:36.821">見</span><span begin="2:36.821" end="2:37.531">つ</span><span begin="2:37.531" end="2:38.251">け</span><span begin="2:38.251" end="2:40.321">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">找到了</span><span ttm:role="x-roman">mi tsu ke ta</span></p><p begin="2:35.721" end="2:41.081" itunes:key="L33" ttm:agent="v2"><span begin="2:35.721" end="2:36.080">妬</span><span begin="2:36.080" end="2:36.311">ん</span><span begin="2:36.311" end="2:36.641">で</span><span begin="2:36.641" end="2:37.381">心</span><span begin="2:37.381" end="2:37.541">を</span><span begin="2:37.541" end="2:37.910">汚</span><span begin="2:37.910" end="2:38.101">し</span><span begin="2:38.101" end="2:38.330">て</span> <span begin="2:38.611" end="2:38.960">恨</span><span begin="2:38.960" end="2:39.151">ん</span><span begin="2:39.151" end="2:39.491">で</span><span begin="2:39.491" end="2:40.150">心</span><span begin="2:40.150" end="2:40.321">を</span><span begin="2:40.321" end="2:40.660">壊</span><span begin="2:40.660" end="2:40.911">し</span><span begin="2:40.911" end="2:41.081">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">嫉妒的感情彻底污染了这颗心 憎恨的感情破坏了心中最后一道防线</span><span ttm:role="x-roman">ne ta n de ko ko ro wo yo go shi te u ra n de ko ko ro wo ko wa shi te</span></p><p begin="2:40.671" end="2:46.301" itunes:key="L34" ttm:agent="v1"><span begin="2:40.671" end="2:41.081">一</span><span begin="2:41.081" end="2:41.801">番</span> <span begin="2:42.151" end="2:42.530">得</span><span begin="2:42.530" end="2:42.861">意</span><span begin="2:42.861" end="2:43.181">な</span><span begin="2:43.181" end="2:43.510">コ</span><span begin="2:43.510" end="2:43.901">ト</span><span begin="2:43.901" end="2:46.301">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">我最满意的作品</span><span ttm:role="x-roman">i chi ba n to ku i na ko to wo</span></p><p begin="2:41.081" end="2:51.231" itunes:key="L35" ttm:agent="v2"><span begin="2:41.081" end="2:41.801">変</span><span begin="2:41.801" end="2:42.501">わ</span><span begin="2:42.501" end="2:43.211">れ</span><span begin="2:43.211" end="2:43.900">た</span> <span begin="2:44.251" end="2:44.441">こ</span><span begin="2:44.441" end="2:44.771">れ</span><span begin="2:44.771" end="2:45.131">が</span><span begin="2:45.131" end="2:45.450">本</span><span begin="2:45.450" end="2:45.681">当</span><span begin="2:45.681" end="2:45.861">の</span><span begin="2:45.861" end="2:51.231">私</span><span ttm:role="x-translation" xml:lang="zh-Hans">终于改变了 这就是真正的…我</span><span ttm:role="x-roman">ka wa re ta ko re ga ho n to u no wa ta shi</span></p><p begin="2:59.801" end="3:03.771" itunes:key="L36" ttm:agent="v1"><span begin="2:59.801" end="3:00.871">純</span><span begin="3:00.871" end="3:01.791">白</span><span begin="3:01.791" end="3:02.121">の</span><span begin="3:02.121" end="3:02.491">ド</span><span begin="3:02.491" end="3:02.791">レ</span><span begin="3:02.791" end="3:03.120">ス</span><span begin="3:03.120" end="3:03.771">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">纯白的礼服上</span><span ttm:role="x-roman">ju n pa ku no do re su ni</span></p><p begin="3:03.771" end="3:07.651" itunes:key="L37" ttm:agent="v2"><span begin="3:03.771" end="3:04.111">綺</span><span begin="3:04.111" end="3:04.761">羅</span><span begin="3:04.761" end="3:04.881">び</span><span begin="3:04.881" end="3:05.061">や</span><span begin="3:05.061" end="3:05.701">か</span><span begin="3:05.701" end="3:05.991">な</span><span begin="3:05.991" end="3:06.221">ア</span><span begin="3:06.221" end="3:06.461">ク</span><span begin="3:06.461" end="3:06.761">セ</span><span begin="3:06.761" end="3:06.961">サ</span><span begin="3:06.961" end="3:07.651">リー</span><span ttm:role="x-translation" xml:lang="zh-Hans">用绚烂夺目的装饰物</span><span ttm:role="x-roman">ki ra bi ya ka na a ku se sa rii</span></p><p begin="3:07.800" end="3:11.720" itunes:key="L38" ttm:agent="v1"><span begin="3:07.800" end="3:08.771">ちょっ</span><span begin="3:08.771" end="3:09.101">び</span><span begin="3:09.101" end="3:09.391">り</span> <span begin="3:09.391" end="3:09.571">着</span><span begin="3:09.571" end="3:10.391">飾っ</span><span begin="3:10.391" end="3:10.711">た</span><span begin="3:10.711" end="3:11.720">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">稍微装饰一下的话</span><span ttm:role="x-roman">cho bbi ri ki ka za tta ra</span></p><p begin="3:11.780" end="3:17.020" itunes:key="L39" ttm:agent="v1"><span begin="3:11.780" end="3:12.211">最</span><span begin="3:12.211" end="3:12.531">後</span><span begin="3:12.531" end="3:12.913">の</span><span begin="3:12.913" end="3:13.803">幕</span><span begin="3:13.803" end="3:14.530">開</span><span begin="3:14.530" end="3:17.020">け</span><span ttm:role="x-translation" xml:lang="zh-Hans">☆最终幕开演☆</span><span ttm:role="x-roman">sa i go no ma ku a ke</span></p><p begin="3:17.293" end="3:22.621" itunes:key="L40" ttm:agent="v2"><span begin="3:17.293" end="3:18.813">嫉</span><span begin="3:18.813" end="3:20.231">妬</span> <span begin="3:20.231" end="3:21.671">恨</span><span begin="3:21.671" end="3:22.621">み</span><span ttm:role="x-translation" xml:lang="zh-Hans">嫉妒、憎恨</span><span ttm:role="x-roman">shi tto u ra mi</span></p><p begin="3:22.621" end="3:30.431" itunes:key="L41" ttm:agent="v1"><span begin="3:22.621" end="3:23.751">曝</span><span begin="3:23.751" end="3:24.481">け</span><span begin="3:24.481" end="3:25.081">出</span><span begin="3:25.081" end="3:25.881">し</span><span begin="3:25.881" end="3:30.431">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">全部倾泻而出</span><span ttm:role="x-roman">sa ra ke da shi te</span></p><p begin="3:34.931" end="3:38.641" itunes:key="L42" ttm:agent="v1"><span begin="3:34.931" end="3:37.311">嗚</span><span begin="3:37.311" end="3:38.641">呼</span><span ttm:role="x-translation" xml:lang="zh-Hans">啊啊</span><span ttm:role="x-roman">a a</span></p><p begin="3:37.780" end="3:43.241" itunes:key="L43" ttm:agent="v2"><span begin="3:37.780" end="3:38.280">誰</span><span begin="3:38.280" end="3:38.430">よ</span><span begin="3:38.430" end="3:38.700">り</span><span begin="3:38.700" end="3:39.000">嫉</span><span begin="3:39.000" end="3:39.300">妬</span><span begin="3:39.300" end="3:39.460">に</span><span begin="3:39.460" end="3:39.751">塗</span><span begin="3:39.751" end="3:39.950">れ</span><span begin="3:39.950" end="3:40.181">て</span><span begin="3:40.181" end="3:40.631">る</span> <span begin="3:40.631" end="3:41.091">誰</span><span begin="3:41.091" end="3:41.340">よ</span><span begin="3:41.340" end="3:41.541">り</span><span begin="3:41.541" end="3:42.100">僻</span><span begin="3:42.100" end="3:42.330">み</span><span begin="3:42.330" end="3:42.561">に</span><span begin="3:42.561" end="3:42.761">満</span><span begin="3:42.761" end="3:42.941">ち</span><span begin="3:42.941" end="3:43.051">て</span><span begin="3:43.051" end="3:43.241">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">比谁都要嫉妒 比谁都充满偏见</span><span ttm:role="x-roman">da re yo ri shi tto ni ma mi re te ru da re yo ri hi ga mi ni mi chi te ru</span></p><p begin="3:38.901" end="3:48.241" itunes:key="L44" ttm:agent="v1"><span begin="3:38.901" end="3:39.561">ど</span><span begin="3:39.561" end="3:40.181">う</span><span begin="3:40.181" end="3:41.741">し</span><span begin="3:41.741" end="3:42.761">て</span> <span begin="3:42.761" end="3:42.941">う</span><span begin="3:42.941" end="3:43.141">ま</span><span begin="3:43.141" end="3:43.881">く</span><span begin="3:44.351" end="3:44.461">で</span><span begin="3:44.461" end="3:44.541">き</span><span begin="3:44.541" end="3:44.951">ちゃ</span><span begin="3:44.951" end="3:45.281">う</span><span begin="3:45.281" end="3:45.591">ん</span><span begin="3:45.591" end="3:45.941">だ</span><span begin="3:45.941" end="3:46.821">ろ</span><span begin="3:46.821" end="3:48.241">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">为什么 这不是能做得很好嘛</span><span ttm:role="x-roman">do u shi te u ma ku de ki cha u n da ro u</span></p><p begin="3:43.241" end="3:48.951" itunes:key="L45" ttm:agent="v2"><span begin="3:43.241" end="3:43.831">そ</span><span begin="3:43.831" end="3:44.541">れ</span><span begin="3:44.541" end="3:45.231">で</span><span begin="3:45.231" end="3:46.201">も</span> <span begin="3:46.201" end="3:46.821">誰</span><span begin="3:46.821" end="3:47.000">よ</span><span begin="3:47.000" end="3:47.191">り</span><span begin="3:47.191" end="3:47.561">自</span><span begin="3:47.561" end="3:47.860">然</span><span begin="3:47.860" end="3:48.110">に</span><span begin="3:48.110" end="3:48.390">笑</span><span begin="3:48.390" end="3:48.581">え</span><span begin="3:48.581" end="3:48.951">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">即使如此 却依然笑的比谁都自然</span><span ttm:role="x-roman">so re de mo da re yo ri shi ze n ni wa ra e ru</span></p><p begin="3:48.950" end="3:54.551" itunes:key="L46" ttm:agent="v2"><span begin="3:48.950" end="3:49.291">妬</span><span begin="3:49.291" end="3:49.631">ん</span><span begin="3:49.631" end="3:50.001">で</span><span begin="3:50.001" end="3:50.701">心</span><span begin="3:50.701" end="3:50.871">を</span><span begin="3:50.871" end="3:51.401">保っ</span><span begin="3:51.401" end="3:51.700">て</span> <span begin="3:52.051" end="3:52.290">恨</span><span begin="3:52.290" end="3:52.471">ん</span><span begin="3:52.471" end="3:52.811">で</span><span begin="3:52.811" end="3:53.371">心</span><span begin="3:53.371" end="3:53.560">を</span><span begin="3:53.560" end="3:53.871">満</span><span begin="3:53.871" end="3:54.090">た</span><span begin="3:54.090" end="3:54.221">し</span><span begin="3:54.221" end="3:54.551">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">满怀着嫉妒心 漫溢而出的憎恨感</span><span ttm:role="x-roman">ne ta n de ko ko ro wo ta mo tte u ra n de ko ko ro wo mi ta shi te</span></p><p begin="3:48.781" end="3:59.691" itunes:key="L47" ttm:agent="v1"><span begin="3:48.781" end="3:49.990">ど</span><span begin="3:49.990" end="3:50.791">う</span><span begin="3:50.791" end="3:51.591">し</span><span begin="3:51.591" end="3:53.991">て</span> <span begin="3:53.991" end="3:55.441">心</span> <span begin="3:55.441" end="3:55.581">晴</span><span begin="3:55.581" end="3:55.821">れ</span><span begin="3:55.821" end="3:56.881">渡っ</span><span begin="3:56.881" end="3:57.211">て</span><span begin="3:57.211" end="3:59.691">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">为什么 心中如此愉悦</span><span ttm:role="x-roman">do u shi te ko ko ro ha re wa ta tte ku</span></p><p begin="3:54.550" end="4:01.680" itunes:key="L48" ttm:agent="v2"><span begin="3:54.550" end="3:55.121">変</span><span begin="3:55.121" end="3:55.831">わ</span><span begin="3:55.831" end="3:56.521">れ</span><span begin="3:56.521" end="3:57.571">た</span> <span begin="3:57.571" end="3:57.731">こ</span><span begin="3:57.731" end="3:58.091">れ</span><span begin="3:58.091" end="3:58.461">が</span><span begin="3:58.461" end="3:58.821">本</span><span begin="3:58.821" end="3:59.191">当</span><span begin="3:59.191" end="3:59.351">の</span><span begin="3:59.351" end="4:01.680">私</span><span ttm:role="x-translation" xml:lang="zh-Hans">终于改变了 这就是真正的我</span><span ttm:role="x-roman">ka wa re ta ko re ga ho n to u no wa ta shi</span></p><p begin="4:00.101" end="4:05.060" itunes:key="L49" ttm:agent="v1"><span begin="4:00.101" end="4:01.491">こ</span><span begin="4:01.491" end="4:02.031">の</span><span begin="4:02.031" end="4:02.881">世</span><span begin="4:02.881" end="4:04.301">界</span><span begin="4:04.301" end="4:05.060">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">将此世的</span><span ttm:role="x-roman">ko no se ka i wo</span></p><p begin="4:03.540" end="4:07.171" itunes:key="L50" ttm:agent="v2"><span begin="4:03.540" end="4:04.301">ど</span><span begin="4:04.301" end="4:04.921">う</span><span begin="4:04.921" end="4:05.701">し</span><span begin="4:05.701" end="4:07.171">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">为什么</span><span ttm:role="x-roman">do u shi te</span></p><p begin="4:05.071" end="4:10.850" itunes:key="L51" ttm:agent="v1"><span begin="4:05.071" end="4:05.701">凡</span><span begin="4:05.701" end="4:06.361">て</span> <span begin="4:06.741" end="4:07.171">呪</span><span begin="4:07.171" end="4:07.471">い</span><span begin="4:07.471" end="4:07.811">尽</span><span begin="4:07.811" end="4:08.110">く</span><span begin="4:08.110" end="4:08.511">し</span><span begin="4:08.511" end="4:10.850">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">一切 诅咒并吞噬殆尽</span><span ttm:role="x-roman">su be te no ro i tsu ku shi te</span></p><p begin="4:07.811" end="4:11.371" itunes:key="L52" ttm:agent="v2"><span begin="4:07.811" end="4:08.531">満</span><span begin="4:08.531" end="4:09.281">た</span><span begin="4:09.281" end="4:09.981">さ</span><span begin="4:09.981" end="4:10.440">れ</span><span begin="4:10.440" end="4:11.371">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">心底涌起的这份满足感</span><span ttm:role="x-roman">mi ta sa re ru</span></p><p begin="4:11.590" end="4:14.370" itunes:key="L53" ttm:agent="v2"><span begin="4:11.590" end="4:11.910">自</span><span begin="4:11.910" end="4:12.210">然</span><span begin="4:12.210" end="4:12.601">に</span><span begin="4:12.601" end="4:13.080">笑</span><span begin="4:13.080" end="4:13.360">え</span><span begin="4:13.360" end="4:13.530">て</span><span begin="4:13.530" end="4:13.710">い</span><span begin="4:13.710" end="4:13.870">る</span><span begin="4:13.870" end="4:14.070">も</span><span begin="4:14.070" end="4:14.370">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">不知为何 只要这样自然地笑着的话</span><span ttm:role="x-roman">shi ze n ni wa ra e te i ru mo no</span></p><p begin="4:11.361" end="4:16.181" itunes:key="L54" ttm:agent="v1"><span begin="4:11.361" end="4:12.781">見</span><span begin="4:12.781" end="4:13.441">つ</span><span begin="4:13.441" end="4:14.161">け</span><span begin="4:14.161" end="4:16.181">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">找到了</span><span ttm:role="x-roman">mi tsu ke ta</span></p><p begin="4:14.541" end="4:19.821" itunes:key="L55" ttm:agent="v2"><span begin="4:14.541" end="4:14.840">み</span><span begin="4:14.840" end="4:15.071">ん</span><span begin="4:15.071" end="4:15.410">な</span><span begin="4:15.410" end="4:15.720">褒</span><span begin="4:15.720" end="4:15.941">め</span><span begin="4:15.941" end="4:16.121">て</span><span begin="4:16.121" end="4:16.321">く</span><span begin="4:16.321" end="4:16.490">れ</span><span begin="4:16.490" end="4:16.661">る</span><span begin="4:16.661" end="4:17.001">わ</span> <span begin="4:17.001" end="4:17.971">な</span><span begin="4:17.971" end="4:18.421">ん</span><span begin="4:18.421" end="4:19.171">だ</span><span begin="4:19.171" end="4:19.821">か</span><span ttm:role="x-translation" xml:lang="zh-Hans">大家都会夸奖我</span><span ttm:role="x-roman">mi n na ho me te ku re ru wa na n da ka</span></p><p begin="4:16.781" end="4:22.301" itunes:key="L56" ttm:agent="v1"><span begin="4:16.781" end="4:17.011">一</span><span begin="4:17.011" end="4:17.961">番</span> <span begin="4:17.961" end="4:18.630">幸</span><span begin="4:18.630" end="4:19.111">せ</span><span begin="4:19.111" end="4:19.470">な</span><span begin="4:19.470" end="4:19.811">こ</span><span begin="4:19.811" end="4:22.301">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">最令我幸福的事</span><span ttm:role="x-roman">i chi ba n shi a wa se na ko to</span></p><p begin="4:20.171" end="4:22.721" itunes:key="L57" ttm:agent="v2"><span begin="4:20.171" end="4:20.361">こ</span><span begin="4:20.361" end="4:20.691">れっ</span><span begin="4:20.691" end="4:21.051">て</span> <span begin="4:21.051" end="4:21.591">とっ</span><span begin="4:21.591" end="4:21.771">て</span><span begin="4:21.771" end="4:21.931">も</span><span begin="4:21.931" end="4:22.301">幸</span><span begin="4:22.301" end="4:22.721">福</span><span ttm:role="x-translation" xml:lang="zh-Hans">这样是多么幸福啊</span></p><p begin="4:22.971" end="4:25.451" itunes:key="L58" ttm:agent="v1"><span begin="4:22.971" end="4:23.341">誰</span><span begin="4:23.341" end="4:23.521">し</span><span begin="4:23.521" end="4:23.841">も</span><span begin="4:23.841" end="4:24.551">抱</span><span begin="4:24.551" end="4:24.741">え</span><span begin="4:24.741" end="4:24.910">込</span><span begin="4:24.910" end="4:25.081">ん</span><span begin="4:25.081" end="4:25.240">で</span><span begin="4:25.240" end="4:25.451">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">无尽空虚的嫉妒</span><span ttm:role="x-roman">da re shi mo ka ka e ko n de ru</span></p><p begin="4:25.451" end="4:32.670" itunes:key="L59" ttm:agent="v1"><span begin="4:25.451" end="4:26.491">空</span><span begin="4:26.491" end="4:26.881">虚</span><span begin="4:26.881" end="4:27.251">な</span> <span begin="4:27.251" end="4:32.670">無間嫉妬</span><span ttm:role="x-translation" xml:lang="zh-Hans">笼络在世人的心间…挥之不去</span><span ttm:role="x-roman">ku u kyo na ne ta mi ni te i</span><span ttm:role="x-bg" begin="4:27.251" end="4:32.670"><span begin="4:27.251" end="4:27.571">(ネ</span><span begin="4:27.571" end="4:27.931">タ</span><span begin="4:27.931" end="4:28.291">ミ</span><span begin="4:28.291" end="4:28.821">ニ</span><span begin="4:28.821" end="4:32.670">ティ)</span><span ttm:role="x-translation" xml:lang="zh-Hans">无尽空虚的嫉妒</span><span ttm:role="x-roman">ne ta mi ni te i</span></span></p></div></body></tt>