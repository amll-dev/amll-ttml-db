ruby="container"><span tts:ruby="base">不</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:07.940" end="1:08.220">ふ</span></span></span><span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:08.220" end="1:08.580">し</span></span></span><span tts:ruby="container"><span tts:ruby="base">議</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:08.580" end="1:08.760">ぎ</span></span></span><span begin="1:08.760" end="1:09.060">な</span><span tts:ruby="container"><span tts:ruby="base">事</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:09.060" end="1:09.400">こ</span><span tts:ruby="text" begin="1:09.400" end="1:09.900">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">起</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:10.000" end="1:10.220">お</span></span></span><span begin="1:10.220" end="1:10.380">こ</span><span begin="1:10.380" end="1:10.540">る</span><span begin="1:10.540" end="1:10.740">か</span><span begin="1:10.740" end="1:12.820">ら</span><span ttm:role="x-translation">无论何时 都会有不可思议的事发生</span><span ttm:role="x-roman">itsu datte fushigi na koto okoru kara</span></p><p begin="1:13.213" end="1:17.540" itunes:key="L10" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:13.213" end="1:13.720">そ</span><span tts:ruby="text" begin="1:13.720" end="1:13.880">ら</span></span></span><span begin="1:13.880" end="1:14.200">に</span><span tts:ruby="container"><span tts:ruby="base">浮</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:14.200" end="1:14.360">う</span></span></span><span begin="1:14.360" end="1:14.520">か</span><span begin="1:14.520" end="1:14.680">ぶ</span><span tts:ruby="container"><span tts:ruby="base">星</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:14.680" end="1:15.243">ほ</span><span tts:ruby="text" begin="1:15.243" end="1:15.960">し</span></span></span><span begin="1:15.960" end="1:17.540">を</span><span ttm:role="x-translation">将浮游于夜空的繁星</span><span ttm:role="x-roman">sora ni ukabu hoshi o</span></p><p begin="1:17.860" end="1:23.380" itunes:key="L11" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">瞳</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:17.860" end="1:18.220">ひ</span><span tts:ruby="text" begin="1:18.220" end="1:18.540">と</span><span tts:ruby="text" begin="1:18.540" end="1:19.040">み</span></span></span><span begin="1:19.040" end="1:19.500">に</span><span tts:ruby="container"><span tts:ruby="base">落</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:19.500" end="1:19.820">お</span></span></span><span begin="1:19.820" end="1:20.120">と</span><span begin="1:20.120" end="1:20.440">し</span><span tts:ruby="container"><span tts:ruby="base">込</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:20.440" end="1:20.780">こ</span></span></span><span begin="1:20.780" end="1:21.100">ん</span><span begin="1:21.100" end="1:22.000">で</span> <span tts:ruby="container"><span tts:ruby="base">閉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:22.200" end="1:22.400">と</span></span></span><span begin="1:22.400" end="1:22.540">じ</span><span tts:ruby="container"><span tts:ruby="base">込</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:22.540" end="1:22.720">こ</span></span></span><span begin="1:22.720" end="1:22.860">め</span><span begin="1:22.860" end="1:23.380">た</span><span ttm:role="x-translation">映入眼眸深处 悄然封存</span><span ttm:role="x-roman">hitomi ni otoshikonde tojikometa</span></p><p begin="1:23.660" end="1:27.840" itunes:key="L12" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">朝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:23.660" end="1:23.940">あ</span><span tts:ruby="text" begin="1:23.940" end="1:24.180">さ</span></span></span><span begin="1:24.180" end="1:24.480">に</span><span begin="1:24.480" end="1:24.660">な</span><span begin="1:24.660" end="1:24.820">れ</span><span begin="1:24.820" end="1:24.960">ば</span><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:24.960" end="1:25.580">き</span></span></span><span begin="1:25.580" end="1:26.220">え</span><span begin="1:26.220" end="1:27.840">る</span><span ttm:role="x-translation">一到清晨便会消散</span><span ttm:role="x-roman">asa ni nareba kieru</span></p><p begin="1:28.140" end="1:33.280" itunes:key="L13" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">独</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:28.140" end="1:28.500">ひ</span><span tts:ruby="text" begin="1:28.500" end="1:28.800">と</span></span></span><span begin="1:28.800" end="1:29.123">り</span><span tts:ruby="container"><span tts:ruby="base">占</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:29.123" end="1:29.303">じ</span></span></span><span begin="1:29.303" end="1:29.460">め</span><span begin="1:29.460" end="1:29.600">し</span><span begin="1:29.600" end="1:29.840">た</span> <span begin="1:29.920" end="1:30.220">お</span><span tts:ruby="container"><span tts:ruby="base">休</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:30.220" end="1:30.380">や</span><span tts:ruby="text" begin="1:30.380" end="1:30.760">す</span></span></span><span begin="1:30.760" end="1:31.080">み</span><span begin="1:31.080" end="1:31.380">の</span><span tts:ruby="container"><span tts:ruby="base">魔</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:31.380" end="1:31.860">ま</span></span></span><span tts:ruby="container"><span tts:ruby="base">法</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:31.860" end="1:32.020">ほ</span><span tts:ruby="text" begin="1:32.020" end="1:33.280">う</span></span></span><span ttm:role="x-translation">一人独享的 晚安的魔法</span><span ttm:role="x-roman">hitorijime shita oyasumi no mahō</span></p><p begin="1:33.560" end="1:35.840" itunes:key="L14" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:33.560" end="1:33.920">ゆ</span><span tts:ruby="text" begin="1:33.920" end="1:34.100">め</span></span></span><span begin="1:34.100" end="1:34.260">の</span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:34.260" end="1:34.420">な</span><span tts:ruby="text" begin="1:34.420" end="1:34.740">か</span></span></span><span begin="1:34.740" end="1:34.900">だ</span><span begin="1:34.900" end="1:35.060">け</span><span begin="1:35.060" end="1:35.840">は</span><span ttm:role="x-translation">唯有在梦境之中</span><span ttm:role="x-roman">yume no naka dake wa</span></p><p begin="1:36.180" end="1:40.420" itunes:key="L15" ttm:agent="v1"><span begin="1:36.180" end="1:36.380">ど</span><span begin="1:36.380" end="1:36.500">ん</span><span begin="1:36.500" end="1:36.820">な</span><span begin="1:36.820" end="1:37.000">こ</span><span begin="1:37.000" end="1:37.300">と</span><span begin="1:37.300" end="1:37.640">で</span><span begin="1:37.640" end="1:37.780">も</span><span tts:ruby="container"><span tts:ruby="base">叶</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:37.780" end="1:38.100">か</span><span tts:ruby="text" begin="1:38.100" end="1:38.440">な</span></span></span><span begin="1:38.440" end="1:38.740">う</span><span begin="1:38.740" end="1:39.160">か</span><span begin="1:39.160" end="1:40.420">ら</span><span ttm:role="x-translation">无论什么愿望都能实现</span><span ttm:role="x-roman">donna koto demo kanau kara</span></p><p begin="1:49.640" end="1:52.020" itunes:key="L16" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">濡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:49.640" end="1:49.960">ぬ</span><span tts:ruby="text" begin="1:49.960" end="1:50.320">れ</span></span></span><span tts:ruby="container"><span tts:ruby="base">羽</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:50.320" end="1:50.640">ば</span></span></span><span tts:ruby="container"><span tts:ruby="base">色</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:50.640" end="1:50.960">い</span><span tts:ruby="text" begin="1:50.960" end="1:51.180">ろ</span></span></span><span begin="1:51.180" end="1:51.400">を</span><span begin="1:51.400" end="1:51.760">し</span><span begin="1:51.760" end="1:52.020">た</span><span ttm:role="x-translation">那染作鸦羽之色的</span><span ttm:role="x-roman">nurebairo o shita</span></p><p begin="1:52.200" end="1:55.060" itunes:key="L17" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">景</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:52.200" end="1:52.400">け</span></span></span><span tts:ruby="container"><span tts:ruby="base">色</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:52.400" end="1:52.520">し</span><span tts:ruby="text" begin="1:52.520" end="1:52.860">き</span></span></span><span begin="1:52.860" end="1:53.160">を</span><span tts:ruby="container"><span tts:ruby="base">探</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:53.160" end="1:53.500">さ</span><span tts:ruby="text" begin="1:53.500" end="1:53.660">が</span></span></span><span begin="1:53.660" end="1:54.000">す</span><span begin="1:54.000" end="1:54.320">た</span><span begin="1:54.320" end="1:55.060">め</span><span ttm:role="x-translation">风景 为了将它寻觅</span><span ttm:role="x-roman">keshiki o sagasu tame</span></p><p begin="1:55.260" end="1:59.480" itunes:key="L18" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:55.260" end="1:55.440">こ</span><span tts:ruby="text" begin="1:55.443" end="1:55.783">こ</span><span tts:ruby="text" begin="1:55.783" end="1:56.100">ろ</span></span></span><span begin="1:56.100" end="1:56.240">の</span><span tts:ruby="container"><span tts:ruby="base">鍵</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:56.240" end="1:56.580">か</span><span tts:ruby="text" begin="1:56.580" end="1:56.860">ぎ</span></span></span><span begin="1:56.860" end="1:57.980">を</span><span tts:ruby="container"><span tts:ruby="base">取</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:58.160" end="1:58.360">と</span></span></span><span begin="1:58.360" end="1:58.500">り</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:58.500" end="1:58.620">だ</span></span></span><span begin="1:58.620" end="1:58.820">し</span><span begin="1:58.820" end="1:59.480">た</span><span ttm:role="x-translation">我取出了心门的钥匙</span><span ttm:role="x-roman">kokoro no kagi o toridashita</span></p><p begin="1:59.920" end="2:04.240" itunes:key="L19" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:59.920" end="2:00.140">か</span></span></span><span begin="2:00.140" end="2:00.440">わっ</span><span begin="2:00.440" end="2:00.580">た</span><span begin="2:00.580" end="2:00.740">の</span><span begin="2:00.740" end="2:01.200">は</span><span tts:ruby="container"><span tts:ruby="base">自</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:01.340" end="2:01.560">じ</span></span></span><span tts:ruby="container"><span tts:ruby="base">分</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:01.560" end="2:01.660">ぶ</span><span tts:ruby="text" begin="2:01.660" end="2:02.140">ん</span></span></span><span begin="2:02.140" end="2:02.500">じゃ</span><span tts:ruby="container"><span tts:ruby="base">無</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:02.500" end="2:02.640">な</span></span></span><span begin="2:02.640" end="2:02.920">く</span><span tts:ruby="container"><span tts:ruby="base">世</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:02.920" end="2:03.140">せ</span></span></span><span tts:ruby="container"><span tts:ruby="base">界</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:03.140" end="2:03.300">か</span><span tts:ruby="text" begin="2:03.300" end="2:03.620">い</span></span></span><span begin="2:03.620" end="2:03.840">な</span><span begin="2:03.840" end="2:03.960">ん</span><span begin="2:03.960" end="2:04.240">だ</span><span ttm:role="x-translation">改变的并非自己 而是这个世界</span><span ttm:role="x-roman">kawatta no wa jibun ja naku sekai nanda</span></p><p begin="2:04.380" end="2:09.540" itunes:key="L20" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">後</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:04.380" end="2:04.580">あ</span><span tts:ruby="text" begin="2:04.580" end="2:04.900">と</span></span></span><span begin="2:04.900" end="2:05.060">は</span><span begin="2:05.060" end="2:05.243">だ</span><span begin="2:05.243" end="2:05.520">た</span><span tts:ruby="container"><span tts:ruby="base">追</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:05.520" end="2:05.700">お</span></span></span><span begin="2:05.700" end="2:05.840">い</span><span begin="2:05.840" end="2:06.180">つ</span><span begin="2:06.180" end="2:06.340">く</span><span begin="2:06.340" end="2:06.520">た</span><span begin="2:06.520" end="2:06.940">め</span> <span tts:ruby="container"><span tts:ruby="base">歩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:07.120" end="2:07.340">あ</span><span tts:ruby="text" begin="2:07.340" end="2:07.740">る</span></span></span><span begin="2:07.740" end="2:08.280">い</span><span begin="2:08.280" end="2:08.420">て</span><span begin="2:08.420" end="2:09.540">く</span><span ttm:role="x-translation">接下来只为追上它的脚步 迈步前行</span><span ttm:role="x-roman">ato wa data oitsuku tame aruiteku</span></p><p begin="2:09.800" end="2:19.860" itunes:key="L21" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">「世</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:09.800" end="2:10.480">せ</span></span></span><span tts:ruby="container"><span tts:ruby="base">界</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:10.480" end="2:10.763">か</span><span tts:ruby="text" begin="2:10.763" end="2:10.980">い</span></span></span><span begin="2:10.980" end="2:11.580">を</span><span tts:ruby="container"><span tts:ruby="base">覆</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:11.720" end="2:12.410">お</span><span tts:ruby="text" begin="2:12.410" end="2:13.100">お</span></span></span><span begin="2:13.100" end="2:13.720">う</span><span tts:ruby="container"><span tts:ruby="base">夜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:13.720" end="2:14.360">よ</span><span tts:ruby="text" begin="2:14.360" end="2:14.680">る</span></span></span><span begin="2:14.680" end="2:14.980">は</span><span tts:ruby="container"><span tts:ruby="base">怖</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:14.980" end="2:15.640">こ</span><span tts:ruby="text" begin="2:15.640" end="2:15.980">わ</span></span></span><span begin="2:15.980" end="2:16.120">く</span><span begin="2:16.120" end="2:16.620">は</span><span tts:ruby="container"><span tts:ruby="base">無</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:16.900" end="2:17.560">な</span></span></span><span begin="2:17.560" end="2:18.200">い</span><span begin="2:18.200" end="2:18.860">か</span><span begin="2:18.860" end="2:19.860">ら」</span><span ttm:role="x-translation">“笼罩世界的黑夜并不可怕”</span><span ttm:role="x-roman">sekai o ōu yoru wa kowaku wa nai kara</span></p><p begin="2:19.993" end="2:29.840" itunes:key="L22" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">最</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:19.993" end="2:20.740">さ</span><span tts:ruby="text" begin="2:20.740" end="2:21.080">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">初</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:21.080" end="2:21.260">しょ</span></span></span><span begin="2:21.260" end="2:22.060">に</span><span tts:ruby="container"><span tts:ruby="base">教</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:22.060" end="2:22.660">お</span><span tts:ruby="text" begin="2:22.660" end="2:23.300">そ</span></span></span><span begin="2:23.300" end="2:24.640">わっ</span><span begin="2:24.640" end="2:25.000">た</span> <span begin="2:25.240" end="2:25.900">あ</span><span begin="2:25.900" end="2:26.540">い</span><span begin="2:26.540" end="2:27.200">こ</span><span begin="2:27.200" end="2:27.820">と</span><span begin="2:27.820" end="2:29.840">ば</span><span ttm:role="x-translation">这是最初学会的 秘密暗语</span><span ttm:role="x-roman">saisho ni osowatta aikotoba</span></p><p begin="2:30.060" end="2:34.520" itunes:key="L23" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">瞳</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:30.060" end="2:30.400">ひ</span><span tts:ruby="text" begin="2:30.400" end="2:30.720">と</span><span tts:ruby="text" begin="2:30.720" end="2:30.880">み</span></span></span><span begin="2:30.880" end="2:31.220">に</span><span tts:ruby="container"><span tts:ruby="base">写</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:31.220" end="2:31.360">う</span><span tts:ruby="text" begin="2:31.360" end="2:31.540">つ</span></span></span><span begin="2:31.540" end="2:31.680">る</span><span tts:ruby="container"><span tts:ruby="base">星</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:31.680" end="2:32.300">ほ</span><span tts:ruby="text" begin="2:32.300" end="2:32.980">し</span></span></span><span begin="2:32.980" end="2:34.520">で</span><span ttm:role="x-translation">用映在眼眸里的繁星</span><span ttm:role="x-roman">hitomi ni utsuru hoshi de</span></p><p begin="2:34.840" end="2:38.960" itunes:key="L24" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">星</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:34.840" end="2:35.240">せ</span><span tts:ruby="text" begin="2:35.240" end="2:35.520">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">座</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:35.520" end="2:36.000">ざ</span></span></span><span begin="2:36.000" end="2:36.500">を</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:36.500" end="2:36.780">み</span></span></span><span begin="2:36.780" end="2:37.120">つ</span><span begin="2:37.120" end="2:37.460">け</span><span begin="2:37.460" end="2:37.760">ま</span><span begin="2:37.760" end="2:38.120">しょ</span><span begin="2:38.120" end="2:38.960">う</span><span ttm:role="x-translation">来寻找星座吧</span><span ttm:role="x-roman">seiza o mitsukemashō</span></p><p begin="2:39.220" end="2:40.380" itunes:key="L25" ttm:agent="v1"><span begin="2:39.220" end="2:39.420">こ</span><span begin="2:39.420" end="2:39.560">れ</span><span begin="2:39.560" end="2:39.720">か</span><span begin="2:39.720" end="2:39.860">ら</span><span begin="2:39.860" end="2:40.380">も</span><span ttm:role="x-translation">从今往后亦是如此</span><span ttm:role="x-roman">korekara mo</span></p><p begin="2:40.640" end="2:44.860" itunes:key="L26" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:40.640" end="2:41.000">よ</span><span tts:ruby="text" begin="2:41.000" end="2:41.160">る</span></span></span><span begin="2:41.160" end="2:41.500">に</span><span tts:ruby="container"><span tts:ruby="base">映</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:41.500" end="2:41.660">は</span></span></span><span begin="2:41.660" end="2:41.820">え</span><span begin="2:41.820" end="2:41.960">る</span><span tts:ruby="container"><span tts:ruby="base">月</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:41.960" end="2:42.580">つ</span><span tts:ruby="text" begin="2:42.580" end="2:43.240">き</span></span></span><span begin="2:43.240" end="2:44.860">が</span><span ttm:role="x-translation">夜色中皎洁的明月</span><span ttm:role="x-roman">yoru ni haeru tsuki ga</span></p><p begin="2:45.100" end="2:46.960" itunes:key="L27" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">全</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:45.100" end="2:45.480">す</span><span tts:ruby="text" begin="2:45.480" end="2:45.800">べ</span></span></span><span begin="2:45.800" end="2:46.140">て</span><span begin="2:46.140" end="2:46.280">を</span><span tts:ruby="container"><span tts:ruby="base">照</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:46.280" end="2:46.440">て</span></span></span><span begin="2:46.440" end="2:46.560">ら</span><span begin="2:46.560" end="2:46.960">し</span><span ttm:role="x-translation">将万物尽数照亮</span><span ttm:role="x-roman">subete o terashi</span></p><p begin="2:46.960" end="2:51.060" itunes:key="L28" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:46.960" end="2:47.240">み</span></span></span><span begin="2:47.240" end="2:47.400">え</span><span begin="2:47.400" end="2:47.620">な</span><span begin="2:47.620" end="2:47.740">く</span><span begin="2:47.740" end="2:48.060">な</span><span begin="2:48.060" end="2:48.340">る</span><span begin="2:48.340" end="2:48.840">ま</span><span begin="2:48.840" end="2:51.060">で</span><span ttm:role="x-translation">直到再也看不见为止</span><span ttm:role="x-roman">mienaku naru made</span></p><p begin="3:16.540" end="3:21.400" itunes:key="L29" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:16.540" end="3:17.260">ゆ</span><span tts:ruby="text" begin="3:17.260" end="3:17.900">め</span></span></span><span begin="3:17.900" end="3:18.680">が</span><span tts:ruby="container"><span tts:ruby="base">覚</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:18.680" end="3:18.880">さ</span></span></span><span begin="3:18.880" end="3:19.040">め</span><span begin="3:19.040" end="3:19.140">た</span><span tts:ruby="container"><span tts:ruby="base">世</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:19.140" end="3:19.500">せ</span></span></span><span tts:ruby="container"><span tts:ruby="base">界</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:19.500" end="3:19.680">か</span><span tts:ruby="text" begin="3:19.680" end="3:19.980">い</span></span></span><span begin="3:19.980" end="3:20.320">で</span><span begin="3:20.320" end="3:21.400">は</span><span ttm:role="x-translation">在大梦初醒的世界里</span><span ttm:role="x-roman">yume ga sameta sekai de wa</span></p><p begin="3:21.760" end="3:26.560" itunes:key="L30" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">色</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:21.760" end="3:22.400">い</span><span tts:ruby="text" begin="3:22.400" end="3:23.060">ろ</span></span></span><span begin="3:23.060" end="3:23.783">も</span><span tts:ruby="container"><span tts:ruby="base">褪</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:23.783" end="3:24.000">さ</span></span></span><span begin="3:24.000" end="3:24.160">め</span><span begin="3:24.160" end="3:24.280">て</span><span begin="3:24.280" end="3:24.640">し</span><span begin="3:24.640" end="3:24.873">ま</span><span begin="3:24.873" end="3:25.100">う</span><span begin="3:25.100" end="3:25.440">け</span><span begin="3:25.440" end="3:26.560">ど</span><span ttm:role="x-translation">纵使色彩也会渐渐褪去</span><span ttm:role="x-roman">iro mo samete shimau kedo</span></p><p begin="3:26.860" end="3:30.140" itunes:key="L31" ttm:agent="v1"><span begin="3:26.860" end="3:27.500">あ</span><span begin="3:27.500" end="3:28.120">の</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:28.120" end="3:28.740">ひ</span></span></span> <span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:28.940" end="3:29.120">お</span><span tts:ruby="text" begin="3:29.120" end="3:29.280">も</span></span></span><span begin="3:29.280" end="3:29.420">い</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:29.420" end="3:29.700">だ</span></span></span><span begin="3:29.700" end="3:29.920">し</span><span begin="3:29.920" end="3:30.140">た</span><span ttm:role="x-translation">那一天回想起来的</span><span ttm:role="x-roman">ano hi omoidashita</span></p><p begin="3:30.260" end="3:34.240" itunes:key="L32" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">不</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:30.260" end="3:30.480">ふ</span></span></span><span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:30.480" end="3:31.063">し</span></span></span><span tts:ruby="container"><span tts:ruby="base">議</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:31.063" end="3:31.360">ぎ</span></span></span><span begin="3:31.360" end="3:31.680">の</span><span tts:ruby="container"><span tts:ruby="base">国</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:31.680" end="3:32.020">く</span><span tts:ruby="text" begin="3:32.020" end="3:32.520">に</span></span></span><span begin="3:32.520" end="3:32.940">の</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:32.940" end="3:33.300">ひ</span></span></span><span tts:ruby="container"><span tts:ruby="base">々</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:33.300" end="3:34.240">び</span></span></span><span ttm:role="x-translation">不可思议之国的岁月</span><span ttm:role="x-roman">fushigi no kuni no hibi</span></p><p begin="3:34.560" end="3:47.100" itunes:key="L33" ttm:agent="v1"><span begin="3:34.560" end="3:35.540">あ</span><span begin="3:35.540" end="3:35.680">の</span><span tts:ruby="container"><span tts:ruby="base">気</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:35.680" end="3:35.880">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">持</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:35.880" end="3:36.500">も</span></span></span><span begin="3:36.500" end="3:37.140">ち</span><span begin="3:37.140" end="3:39.360">を</span><span tts:ruby="container"><span tts:ruby="base">忘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:39.700" end="3:40.880">わ</span><span tts:ruby="text" begin="3:40.880" end="3:42.220">す</span></span></span><span begin="3:42.220" end="3:44.500">れ</span><span begin="3:44.500" end="3:44.740">な</span><span begin="3:44.740" end="3:47.100">い</span><span ttm:role="x-translation">那份心情我永远不会忘记</span><span ttm:role="x-roman">ano kimochi o wasurenai</span></p><p begin="3:47.400" end="3:51.560" itunes:key="L34" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">音</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:47.400" end="3:47.740">お</span><span tts:ruby="text" begin="3:47.740" end="3:47.900">と</span></span></span><span begin="3:47.900" end="3:48.200">が</span><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:48.200" end="3:48.400">き</span></span></span><span begin="3:48.400" end="3:48.560">え</span><span begin="3:48.560" end="3:48.680">た</span><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:48.680" end="3:49.320">そ</span><span tts:ruby="text" begin="3:49.320" end="3:49.940">ら</span></span></span><span begin="3:49.940" end="3:51.560">に</span><span ttm:role="x-translation">在声音消逝的夜空里</span><span 