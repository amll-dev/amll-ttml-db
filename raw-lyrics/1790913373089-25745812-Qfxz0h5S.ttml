pan></p><p begin="29.339" end="35.860" itunes:key="L3" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="29.339" end="29.529">ゆ</span><span tts:ruby="text" begin="29.529" end="29.795">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">立</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="29.795" end="30.533">だ</span><span tts:ruby="text" begin="30.533" end="31.490">ち</span></span></span><span begin="31.490" end="32.462">の</span><span tts:ruby="container"><span tts:ruby="base">雨</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="32.850" end="33.332">あ</span><span tts:ruby="text" begin="33.332" end="33.775">め</span></span></span><span tts:ruby="container"><span tts:ruby="base">上</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="33.775" end="34.195">あ</span></span></span><span begin="34.195" end="34.700">が</span><span begin="34.700" end="35.140">り</span><span begin="35.140" end="35.860">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">在这傍晚阵雨之后</span></p><p begin="35.860" end="42.315" itunes:key="L4" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">気</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="35.860" end="36.390">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">付</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="36.390" end="36.810">づ</span></span></span><span begin="36.810" end="37.375">く</span><span tts:ruby="container"><span tts:ruby="base">夏</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="38.175" end="38.583">な</span><span tts:ruby="text" begin="38.583" end="39.055">つ</span></span></span><span begin="39.055" end="39.600">の</span><span tts:ruby="container"><span tts:ruby="base">匂</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="39.600" end="40.053">に</span><span tts:ruby="text" begin="40.053" end="40.495">お</span></span></span><span begin="40.495" end="42.315">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">悄然察觉夏日的气息</span></p><p begin="44.380" end="50.990" itunes:key="L5" ttm:agent="v1"><span begin="44.380" end="44.980">ひ</span><span begin="44.980" end="45.487">し</span><span begin="45.487" end="45.890">め</span><span begin="45.890" end="46.790">く</span><span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="47.265" end="47.649">ひ</span><span tts:ruby="text" begin="47.649" end="48.125">か</span><span tts:ruby="text" begin="48.125" end="48.550">り</span></span></span><span begin="48.550" end="49.015">が</span><span tts:ruby="container"><span tts:ruby="base">照</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="49.015" end="49.515">て</span></span></span><span begin="49.515" end="50.240">ら</span><span begin="50.240" end="50.990">す</span><span ttm:role="x-translation" xml:lang="zh-Hans">云后的霞光涌向大地</span></p><p begin="51.245" end="58.245" itunes:key="L6" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">想</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="51.245" end="52.206">お</span><span tts:ruby="text" begin="52.206" end="52.630">も</span></span></span><span begin="52.630" end="53.050">い</span><span begin="53.050" end="53.810">に</span><span tts:ruby="container"><span tts:ruby="base">耳</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="53.963" end="54.401">み</span><span tts:ruby="text" begin="54.401" end="54.875">み</span></span></span><span begin="54.875" end="55.650">を</span><span tts:ruby="container"><span tts:ruby="base">澄</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="55.650" end="56.210">す</span></span></span><span begin="56.210" end="56.490">ま</span><span begin="56.490" end="57.590">せ</span><span begin="57.590" end="58.245">ば</span><span ttm:role="x-translation" xml:lang="zh-Hans">侧耳倾听着心中思绪</span></p><p begin="58.375" end="1:07.300" itunes:key="L7" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">聴</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="58.375" end="59.300">き</span></span></span><span begin="59.300" end="59.750">こ</span><span begin="59.750" end="1:00.095">え</span><span begin="1:00.097" end="1:01.007">し</span><span tts:ruby="container"><span tts:ruby="base">友</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:01.007" end="1:01.463">と</span><span tts:ruby="text" begin="1:01.463" end="1:01.910">も</span></span></span><span begin="1:01.910" end="1:03.798">の</span><span tts:ruby="container"><span tts:ruby="base">面</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:04.140" end="1:04.693">お</span><span tts:ruby="text" begin="1:04.693" end="1:05.040">も</span></span></span><span tts:ruby="container"><span tts:ruby="base">影</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:05.040" end="1:05.535">か</span><span tts:ruby="text" begin="1:05.535" end="1:07.300">げ</span></span></span><span ttm:role="x-translation" xml:lang="zh-Hans">友人面容在耳边响起</span></p><p begin="1:07.702" end="1:15.380" itunes:key="L8" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夏</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:07.702" end="1:08.188">な</span><span tts:ruby="text" begin="1:08.188" end="1:08.660">つ</span></span></span><span tts:ruby="container"><span tts:ruby="base">夕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:08.660" end="1:09.243">ゆ</span><span tts:ruby="text" begin="1:09.243" end="1:10.590">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:10.590" end="1:11.003">ぞ</span><span tts:ruby="text" begin="1:11.003" end="1:12.348">ら</span></span></span><span tts:ruby="container"><span tts:ruby="base">薫</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:12.348" end="1:12.572">か</span><span tts:ruby="text" begin="1:12.572" end="1:12.812">お</span></span></span><span begin="1:12.812" end="1:14.090">り</span><span tts:ruby="container"><span tts:ruby="base">立</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:14.090" end="1:14.530">た</span></span></span><span begin="1:14.530" end="1:15.380">つ</span><span ttm:role="x-translation" xml:lang="zh-Hans">夏日夕空 泛起馨香记忆</span></p><p begin="1:15.380" end="1:22.185" itunes:key="L9" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">鮮</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:15.380" end="1:15.838">あ</span><span tts:ruby="text" begin="1:15.838" end="1:16.267">ざ</span></span></span><span begin="1:16.267" end="1:17.248">や</span><span begin="1:17.603" end="1:18.108">か</span><span begin="1:18.108" end="1:18.580">な</span><span tts:ruby="container"><span tts:ruby="base">過</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:18.877" end="1:19.398">す</span></span></span><span begin="1:19.398" end="1:19.758">ぎ</span><span tts:ruby="container"><span tts:ruby="base">去</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:19.758" end="1:20.233">さ</span></span></span><span begin="1:20.233" end="1:20.575">り</span><span begin="1:20.575" end="1:21.005">し</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:21.005" end="1:21.587">ひ</span></span></span><span tts:ruby="container"><span tts:ruby="base">々</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:21.587" end="1:22.185">び</span></span></span><span ttm:role="x-translation" xml:lang="zh-Hans">过往时光 依然那么鲜明</span></p><p begin="1:22.520" end="1:29.350" itunes:key="L10" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:22.520" end="1:23.007">こ</span><span tts:ruby="text" begin="1:23.007" end="1:23.465">こ</span><span tts:ruby="text" begin="1:23.465" end="1:24.800">ろ</span></span></span><span begin="1:24.800" end="1:25.050">の</span><span begin="1:25.050" end="1:25.281">ま</span><span begin="1:25.281" end="1:26.200">ま</span><span tts:ruby="container"><span tts:ruby="base">笑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:26.657" end="1:27.072">わ</span><span tts:ruby="text" begin="1:27.072" end="1:27.530">ら</span></span></span><span begin="1:27.530" end="1:28.010">い</span><span begin="1:28.010" end="1:28.605">あ</span><span begin="1:28.605" end="1:28.830">っ</span><span begin="1:28.830" end="1:29.350">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">真心相对 众人欢笑之景</span></p><p begin="1:29.755" end="1:35.157" itunes:key="L11" ttm:agent="v1"><span begin="1:29.755" end="1:30.140">あ</span><span begin="1:30.140" end="1:30.630">の</span><span tts:ruby="container"><span tts:ruby="base">夏</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:30.630" end="1:31.368">な</span><span tts:ruby="text" begin="1:31.368" end="1:31.955">つ</span></span></span><span begin="1:31.955" end="1:32.370">の</span><span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:32.370" end="1:32.842">お</span><span tts:ruby="text" begin="1:32.842" end="1:33.300">も</span></span></span><span begin="1:33.300" end="1:33.745">い</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:33.745" end="1:34.180">で</span></span></span><span begin="1:34.180" end="1:35.157">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">原来是 那场夏天的回忆</span></p><p begin="1:41.365" end="1:47.710" itunes:key="L12" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">色</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:41.365" end="1:42.330">い</span><span tts:ruby="text" begin="1:42.330" end="1:43.120">ろ</span></span></span><span begin="1:43.120" end="1:44.255">づ</span><span begin="1:44.520" end="1:44.970">く</span><span tts:ruby="container"><span tts:ruby="base">鬼灯</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:44.970" end="1:45.490">ほ</span><span tts:ruby="text" begin="1:45.490" end="1:45.860">お</span><span tts:ruby="text" begin="1:45.860" end="1:46.265">ず</span><span tts:ruby="text" begin="1:46.265" end="1:46.790">き</span></span></span><span begin="1:46.790" end="1:47.710">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">灯笼草丛果色渐红</span></p><p begin="1:48.560" end="1:55.250" itunes:key="L13" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">賑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:48.560" end="1:49.444">に</span><span tts:ruby="text" begin="1:49.444" end="1:50.350">ぎ</span></span></span><span begin="1:50.351" end="1:51.231">わ</span><span begin="1:51.738" end="1:52.035">い</span><span begin="1:52.035" end="1:52.540">し</span><span tts:ruby="container"><span tts:ruby="base">夏</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:52.540" end="1:52.950">な</span><span tts:ruby="text" begin="1:52.950" end="1:53.505">つ</span></span></span><span tts:ruby="container"><span tts:ruby="base">祭</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:53.505" end="1:53.856">な</span><span tts:ruby="text" begin="1:53.856" end="1:54.870">つ</span></span></span><span begin="1:54.870" end="1:55.250">り</span><span ttm:role="x-translation" xml:lang="zh-Hans">仿佛那场热闹的夏祭</span></p><p begin="1:55.250" end="2:01.600" itunes:key="L14" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">鳴</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:55.250" end="1:55.500">な</span></span></span><span begin="1:55.500" end="1:55.670">り</span><span tts:ruby="container"><span tts:ruby="base">響</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:55.670" end="1:56.635">ひ</span><span tts:ruby="text" begin="1:56.635" end="1:57.470">び</span></span></span><span begin="1:57.470" end="1:58.455">く</span><span tts:ruby="container"><span tts:ruby="base">風</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:58.750" end="1:59.330">す</span></span></span><span tts:ruby="container"><span tts:ruby="base">鈴</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:59.330" end="2:00.185">ず</span></span></span><span begin="2:00.185" end="2:00.640">の</span><span tts:ruby="container"><span tts:ruby="base">音</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:00.640" end="2:01.090">ね</span></span></span><span begin="2:01.090" end="2:01.600">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">檐下风铃清悦响动</span></p><p begin="2:01.960" end="2:08.495" itunes:key="L15" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">胸</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:01.960" end="2:02.335">む</span><span tts:ruby="text" begin="2:02.335" end="2:02.840">ね</span></span></span><span begin="2:02.840" end="2:03.811">の</span><span tts:ruby="container"><span tts:ruby="base">奥</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:04.240" end="2:04.660">お</span><span tts:ruby="text" begin="2:04.660" end="2:05.160">く</span></span></span><span begin="2:05.160" end="2:05.545">が</span><span tts:ruby="container"><span tts:ruby="base">揺</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:05.545" end="2:06.025">ゆ</span></span></span><span begin="2:06.025" end="2:06.460">れ</span><span begin="2:06.460" end="2:08.495">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">让我的心也一同摇曳</span></p><p begin="2:10.350" end="2:17.219" itunes:key="L16" ttm:agent="v1"><span begin="2:10.350" end="2:10.940">さ</span><span begin="2:10.940" end="2:11.390">ざ</span><span begin="2:11.390" end="2:11.810">め</span><span begin="2:11.810" end="2:12.790">く</span><span tts:ruby="container"><span tts:ruby="base">蜩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:13.200" end="2:13.648">ひ</span><span tts:ruby="text" begin="2:13.648" end="2:14.055">ぐ</span><span tts:ruby="text" begin="2:14.055" end="2:14.373">ら</span><span tts:ruby="text" begin="2:14.373" end="2:14.988">し</span></span></span><span begin="2:14.988" end="2:15.415">が</span><span tts:ruby="container"><span tts:ruby="base">鳴</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:15.415" end="2:16.310">な</span></span></span><span begin="2:16.310" end="2:17.219">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">夜蝉已早早开始喧闹</span></p><p begin="2:17.170" end="2:24.253" itunes:key="L17" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">木</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:17.170" end="2:18.145">こ</span></span></span><span tts:ruby="container"><span tts:ruby="base">立</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:18.145" end="2:18.496">だ</span><span tts:ruby="text" begin="2:18.496" end="2:19.020">ち</span></span></span><span begin="2:19.020" end="2:19.510">を</span><span tts:ruby="container"><span tts:ruby="base">一人</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:19.906" end="2:20.326">ひ</span><span tts:ruby="text" begin="2:20.326" end="2:20.801">と</span><span tts:ruby="text" begin="2:20.801" end="2:21.705">り</span></span></span><span tts:ruby="container"><span tts:ruby="base">歩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:21.705" end="2:22.149">あ</span><span tts:ruby="text" begin="2:22.149" end="2:22.530">る</span></span></span><span begin="2:22.530" end="2:23.490">け</span><span begin="2:23.490" end="2:24.253">ば</span><span ttm:role="x-translation" xml:lang="zh-Hans">独自漫步于林间小道</span></p><p begin="2:24.320" end="2:33.580" itunes:key="L18" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">蘇</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:24.320" end="2:25.281">よ</span><span tts:ruby="text" begin="2:25.281" end="2:25.725">み</span><span tts:ruby="text" begin="2:25.725" end="2:26.186">が</span><span tts:ruby="text" begin="2:26.186" end="2:26.876">え</span></span></span><span begin="2:26.876" end="2:27.456">し</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:27.456" end="2:27.960">ひ</span></span></span><span begin="2:27.960" end="2:29.721">の</span><span tts:ruby="container"><span tts:ruby="base">面</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:30.250" end="2:30.636">お</span><span tts:ruby="text" begin="2:30.636" end="2:31.010">も</span></span></span><span tts:ruby="container"><span tts:ruby="base">影</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:31.010" end="2:31.511">か</span><span tts:ruby="text" begin="2:31.511" end="2:33.580">げ</span></span></span><span ttm:role="x-translation" xml:lang="zh-Hans">往日情景在心中苏醒</span></p><p begin="2:33.580" end="2:38.270" itunes:key="L19" ttm:agent="v1"><span begin="2:33.580" end="2:34.245">そ</span><span begin="2:34.245" end="2:34.710">っ</span><span begin="2:34.710" end="2:35.120">と</span><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:35.120" end="2:36.480">ぼ</span><span tts:ruby="text" begin="2:36.480" end="2:36.912">く</span></span></span><span begin="2:36.912" end="2:38.270">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">仿佛在我耳边</span></p><p begin="2:38.270" end="2:44.965" itunes:key="L20" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">耳</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:38.270" end="2:38.506">み</span><span tts:ruby="text" begin="2:38.506" end="2:38.710">み</span></span></span><span tts:ruby="container"><span tts:ruby="base">元</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:38.710" end="2:40.048">も</span><span tts:ruby="text" begin="2:40.048" end="2:40.495">と</span></span></span><span begin="2:40.495" end="2:41.041">で</span><span begin="2:41.350" end="2:41.735">さ</span><span begin="2:41.735" end="2:42.260">さ</span><span begin="2:42.260" end="2:43.455">や</span><span begin="2:43.455" end="2:44.065">い</span><span begin="2:44.065" end="2:44.965">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">对我轻声细语</span></p><p begin="2:44.965" end="2:48.160" itunes:key="L21" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">懐</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:44.965" end="2:45.331">な</span><span tts:ruby="text" begin="2:45.331" end="2:45.800">つ</span></span></span><span begin="2:45.800" end="2:46.100">か</span><span begin="2:46.100" end="2:46.686">し</span><span begin="2:46.686" end="2:46.999">い</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:46.999" end="2:47.650">ひ</span></span></span><span tts:ruby="container"><span tts:ruby="base">々</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:47.650" end="2:48.160">び</span></span></span><span ttm:role="x-translation" xml:lang="zh-Hans">原来是 令人怀念的往昔</span></p><p begin="2:48.540" end="2:55.350" itunes:key="L22" ttm:agent="v1"><span begin="2:48.540" end="2:49.035">あ</span><span begin="2:49.035" end="2:49.465">の</span><span tts:ruby="container"><span tts:ruby="base">頃</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:49.465" end="2:50.837">こ</span><span tts:ruby="text" begin="2:50.837" end="2:51.319">ろ</span></span></span><span begin="2:51.319" end="2:52.162">の</span><span begin="2:52.591" end="2:53.040">ま</span><span begin="2:53.040" end="2:53.495">ま</span><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:53.495" end="2:53.966">か</span></span></span><span begin="2:53.966" end="2:54.386">わ</span><span begin="2:54.386" end="2:54.745">ら</span><span begin="2:54.745" end="2:55.350">ず</span><span ttm:role="x-translation" xml:lang="zh-Hans">依旧留存着 昨日的模样</span></p><p begin="2:55.705" end="3:02.051" itunes:key="L23" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">今</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:55.705" end="2:56.216">い</span><span tts:ruby="text" begin="2:56.216" end="2:56.661">ま</span></span></span><span begin="2:56.661" end="2:57.296">も</span><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:57.451" end="2:57.881">こ</span><span tts:ruby="text" begin="2:57.881" end="2:58.401">こ</span><span tts:ruby="text" begin="2:58.401" end="2:58.838">ろ</span></span></span><span begin="2:58.838" end="2:59.321">の</span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:59.321" end="2:59.751">な</span><span tts:ruby="text" begin="2:59.751" end="3:00.210">か</span></span></span><span begin="3:00.210" end="3:02.051">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">依旧埋藏在 今日的心底</span></p><p begin="3:17.925" end="3:24.500" itunes:key="L24" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">人</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:17.925" end="3:18.576">ひ</span><span tts:ruby="text" begin="3:18.576" end="3:19.026">と</span></span></span><span begin="3:19.026" end="3:19.338">と</span><span begin="3:19.338" end="3:19.937">し</span><span begin="3:19.937" end="3:21.331">て</span><span tts:ruby="container"><span tts:ruby="base">守</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:21.331" end="3:21.561">ま</span><span tts:ruby="text" begin="3:21.561" end="3:21.806">も</span></span></span><span begin="3:21.806" end="3:23.091">る</span><span begin="3:23.091" end="3:23.461">も</span><span begin="3:23.461" end="3:24.500">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">人生在世 无志不成</span></p><p begin="3:25.090" end="3:31.595" itunes:key="L25" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">人</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:25.090" end="3:25.745">ひ</span><span tts:ruby="text" begin="3:25.745" end="3:26.174">と</span></span></span><span begin="3:26.174" end="3:26.459">と</span><span begin="3:26.459" end="3:27.091">し</span><span begin="3:27.091" end="3:28.449">て</span><span tts:ruby="container"><span tts:ruby="base">学</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:28.449" end="3:28.690">ま</span><span tts:ruby="text" begin="3:28.690" end="3:28.919">な</span></span></span><span begin="3:28.919" end="3:30.171">ぶ</span><span begin="3:30.171" end="3:30.665">こ</span><span begin="3:30.665" end="3:31.595">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">人生在世 无学不行</span></p><p begin="3:31.595" end="3:36.945" itunes:key="L26" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">亡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:31.595" end="3:32.005">な</span></span></span><span begin="3:32.005" end="3:32.340">き</span><span tts:ruby="container"><span tts:ruby="base">祖</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:32.340" end="3:34.225">そ</span></span></span><span tts:ruby="container"><span tts:ruby="base">父</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:34.225" end="3:34.690">ふ</span></span></span><span begin="3:34.690" end="3:35.030">が</span><span tts:ruby="container"><span tts:ruby="base">紡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:35.030" end="3:35.575">つ</span><span tts:ruby="text" begin="3:35.575" end="3:36.010">む</span></span></span><span begin="3:36.010" end="3:36.945">ぐ</span><span ttm:role="x-translation" xml:lang="zh-Hans">祖父去世前教导的话语</span></p><p begin="3:37.740" end="3:48.248" itunes:key="L27" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">大</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:37.740" end="3:38.288">た</span><span tts:ruby="text" begin="3:38.288" end="3:38.602">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">切</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:38.602" end="3:39.097">せ</span><span tts:ruby="text" begin="3:39.097" end="3:39.598">つ</span></span></span><span begin="3:39.598" end="3:40.932">な</span><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:40.932" end="3:41.186">こ</span><span tts:ruby="text" begin="3:41.186" end="3:41.463">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">葉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:41.463" end="3:41.886">ば</span></span></span><span begin="3:41.886" end="3:42.288">は</span><span begin="3:42.288" end="3:42.786">こ</span><span begin="3:42.786" end="3:43.197">の</span><span tts:ruby="container"><span tts:ruby="base">胸</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:43.197" end="3:44.577">む</span><span tts:ruby="text" begin="3:44.577" end="3:45.006">ね</span></span></span><span begin="3:45.006" end="3:48.248">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">如今依旧珍藏在我胸中</span></p><p begin="3:48.970" end="3:56.485" itunes:key="L28" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夏</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:48.970" end="3:49.389">な</span><span tts:ruby="text" begin="3:49.389" end="3:49.829">つ</span></span></span><span tts:ruby="container"><span tts:ruby="base">夕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:49.829" end="3:50.309">ゆ</span><span tts:ruby="text" begin="3:50.309" end="3:51.749">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:51.749" end="3:52.149">ぞ</span><span tts:ruby="text" begin="3:52.149" end="3:53.501">ら</span></span></span><span tts:ruby="container"><span tts:ruby="base">薫</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:53.501" end="3:53.659">か</span><span tts:ruby="text" begin="3:53.659" end="3:53.909">お</span></span></span><span begin="3:53.909" end="3:55.246">り</span><span tts:ruby="container"><span tts:ruby="base">立</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:55.246" end="3:55.674">た</span></span></span><span begin="3:55.674" end="3:56.485">つ</span><span ttm:role="x-translation" xml:lang="zh-Hans">夏日夕空 泛起馨香记忆</span></p><p begin="3:56.645" end="4:03.311" itunes:key="L29" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">鮮</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:56.645" end="3:57.036">あ</span><span tts:ruby="text" begin="3:57.036" end="3:57.500">ざ</span></span></span><span begin="3:57.500" end="3:58.425">や</span><span begin="3:58.746" end="3:59.186">か</span><span begin="3:59.186" end="3:59.776">な</span><span tts:ruby="container"><span tts:ruby="base">過</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:00.021" end="4:00.599">す</span></span></span><span begin="4:00.599" end="4:01.011">ぎ</span><span tts:ruby="container"><span tts:ruby="base">去</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:01.011" end="4:01.514">さ</span></span></span><span begin="4:01.514" end="4:01.904">り</span><span begin="4:01.904" end="4:02.286">し</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:02.286" end="4:02.875">ひ</span></span></span><span tts:ruby="container"><span tts:ruby="base">々</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:02.875" end="4:03.311">び</span></span></span><span ttm:role="x-translation" xml:lang="zh-Hans">过往时光 依然那么鲜明</span></p><p begin="4:03.760" end="4:10.760" itunes:key="L30" ttm:agent="v1"><span begin="4:03.760" end="4:04.205">あ</span><span begin="4:04.205" end="4:04.590">の</span><span tts:ruby="container"><span tts:ruby="base">頃</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:04.590" end="4:06.052">こ</span><span tts:ruby="text" begin="4:06.052" end="4:06.611">ろ</span></span></span><span begin="4:06.611" end="4:07.396">の</span><span begin="4:07.780" end="4:08.265">ま</span><span begin="4:08.265" end="4:08.710">ま</span><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:08.710" end="4:09.212">か</span></span></span><span begin="4:09.212" end="4:09.666">わ</span><span begin="4:09.666" end="4:10.055">ら</span><span begin="4:10.055" end="4:10.760">ぬ</span><span ttm:role="x-translation" xml:lang="zh-Hans">依旧留存着 昨日的模样</span></p><p begin="4:10.760" end="4:17.487" itunes:key="L31" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">染</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:10.760" end="4:11.411">し</span></span></span><span begin="4:11.411" end="4:11.858">み</span><span tts:ruby="container"><span tts:ruby="base">渡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:11.858" end="4:12.691">わ</span><span tts:ruby="text" begin="4:12.691" end="4:13.161">た</span></span></span><span begin="4:13.161" end="4:13.596">る</span><span tts:ruby="container"><span tts:ruby="base">温</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:13.596" end="4:14.003">ぬ</span><span tts:ruby="text" begin="4:14.003" end="4:14.483">く</span></span></span><span begin="4:14.483" end="4:14.891">も</span><span begin="4:14.891" end="4:15.352">り</span><span begin="4:15.352" end="4:17.487">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">依旧温暖着 正如同往昔</span></p><p begin="4:18.055" end="4:26.283" itunes:key="L32" ttm:agent="v1"><span begin="4:18.055" end="4:18.539">あ</span><span begin="4:18.539" end="4:18.974">の</span><span tts:ruby="container"><span tts:ruby="base">夏</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:18.974" end="4:19.814">な</span><span tts:ruby="text" begin="4:19.814" end="4:20.283">つ</span></span></span><span begin="4:20.283" end="4:20.789">の</span><span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:20.789" end="4:21.282">お</span><span tts:ruby="text" begin="4:21.282" end="4:21.714">も</span></span></span><span begin="4:21.714" end="4:22.162">い</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="4:22.162" end="4:22.625">で</span></span></span><span begin="4:22.625" end="4:26.283">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">原来是 那场夏天的回忆</span></p></div></body></tt>