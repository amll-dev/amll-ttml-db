<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttx="urn:ttml:extensions:shared-ruby:1"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="daze"/><amll:meta key="artists" value="じん"/><amll:meta key="artists" value="MARiA"/><amll:meta key="album" value="daze / days"/><amll:meta key="ncmMusicId" value="28613320"/><amll:meta key="qqMusicId" value="233032206"/><amll:meta key="spotifyId" value="2GtsEc1UhATRZ6937ahAmN"/><amll:meta key="appleMusicId" value="1538288592"/><amll:meta key="ttmlAuthorGithubLogin" value="Mrs4s"/><amll:meta key="ttmlAuthorGithub" value="12137562"/><amll:meta key="ttmlAuthorGithubLogin" value="Mrs4s"/></metadata></head><body dur="03:55.493"><div begin="00:16.380" end="03:34.640"><p begin="00:16.380" end="00:18.060" ttm:agent="v1" itunes:key="L1"><span begin="00:16.380" end="00:16.600" ttx:rubyGroup="1" ttx:rubyText="concrete" ttx:rubyTimes="00:16.380,00:17.140">コ</span><span begin="00:16.600" end="00:16.700" ttx:rubyGroup="1">ン</span><span begin="00:16.700" end="00:16.820" ttx:rubyGroup="1">ク</span><span begin="00:16.820" end="00:16.980" ttx:rubyGroup="1">リー</span><span begin="00:16.980" end="00:17.140" ttx:rubyGroup="1">ト</span><span begin="00:17.140" end="00:17.280">が</span><span tts:ruby="container"><span tts:ruby="base">揺</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:17.280" end="00:17.420">ゆ</span></span></span><span begin="00:17.420" end="00:17.600">ら</span><span begin="00:17.600" end="00:17.720">い</span><span begin="00:17.720" end="00:18.060">だ</span><span ttm:role="x-translation">阳炎缭绕的水泥</span><span ttm:role="x-roman">konkurīto ga yuraida</span></p><p begin="00:18.060" end="00:20.860" ttm:agent="v1" itunes:key="L2"><span tts:ruby="container"><span tts:ruby="base">霞</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:18.060" end="00:18.120">か</span><span tts:ruby="text" begin="00:18.120" end="00:18.360">す</span></span></span><span begin="00:18.360" end="00:18.620">み</span><span tts:ruby="container"><span tts:ruby="base">燻</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:18.620" end="00:18.740">く</span><span tts:ruby="text" begin="00:18.740" end="00:18.960">す</span></span></span><span begin="00:18.960" end="00:19.240">む、</span><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:19.240" end="00:19.400">き</span><span tts:ruby="text" begin="00:19.400" end="00:19.540">み</span></span></span><span begin="00:19.540" end="00:19.800">の</span><span tts:ruby="container"><span tts:ruby="base">望</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:19.800" end="00:20.020">み</span></span></span><span begin="00:20.020" end="00:20.100">て</span><span begin="00:20.100" end="00:20.180">い</span><span begin="00:20.180" end="00:20.320">る</span><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:20.320" end="00:20.500">ゆ</span><span tts:ruby="text" begin="00:20.500" end="00:20.860">め</span></span></span><span ttm:role="x-translation">朦胧着 黯淡着 正如你所做的梦</span><span ttm:role="x-roman">kasumi kusumu kimi no mite iru yume</span></p><p begin="00:21.200" end="00:22.800" ttm:agent="v1" itunes:key="L3"><span begin="00:21.200" end="00:21.440" ttx:rubyGroup="1" ttx:rubyText="template" ttx:rubyTimes="00:21.200,00:21.980">テ</span><span begin="00:21.440" end="00:21.520" ttx:rubyGroup="1">ン</span><span begin="00:21.520" end="00:21.600" ttx:rubyGroup="1">プ</span><span begin="00:21.600" end="00:21.820" ttx:rubyGroup="1">レー</span><span begin="00:21.820" end="00:21.980" ttx:rubyGroup="1">ト</span><span begin="00:21.980" end="00:22.140">を</span><span begin="00:22.140" end="00:22.300">な</span><span begin="00:22.300" end="00:22.580">ぞっ</span><span begin="00:22.580" end="00:22.800">た</span><span ttm:role="x-translation">按部就班的过着</span><span ttm:role="x-roman">tenpurēto o nazotta</span></p><p begin="00:22.800" end="00:24.780" ttm:agent="v1" itunes:key="L4"><span tts:ruby="container"><span tts:ruby="base">知</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:22.800" end="00:23.060">し</span></span></span><span begin="00:23.060" end="00:23.160">ら</span><span begin="00:23.160" end="00:23.380">な</span><span begin="00:23.380" end="00:23.520">い</span><span begin="00:23.520" end="00:23.660">ま</span><span begin="00:23.660" end="00:23.880">ま</span><span begin="00:23.880" end="00:24.060">の</span> <span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:24.060" end="00:24.220">に</span><span tts:ruby="text" begin="00:24.220" end="00:24.340">ち</span></span></span><span tts:ruby="container"><span tts:ruby="base">常</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:24.340" end="00:24.440">じょ</span><span tts:ruby="text" begin="00:24.440" end="00:24.780">う</span></span></span><span ttm:role="x-translation">仍旧一无所知的日常</span><span ttm:role="x-roman">shiranai mama no nichijō</span></p><p begin="00:26.060" end="00:28.360" ttm:agent="v1" itunes:key="L5"><span begin="00:26.060" end="00:26.260" ttx:rubyGroup="1" ttx:rubyText="high" ttx:rubyTimes="00:26.060,00:26.380">ハ</span><span begin="00:26.260" end="00:26.380" ttx:rubyGroup="1">イ</span><span begin="00:26.380" end="00:26.640" ttx:rubyGroup="2" ttx:rubyText="tempo" ttx:rubyTimes="00:26.380,00:26.860">テ</span><span begin="00:26.640" end="00:26.700" ttx:rubyGroup="2">ン</span><span begin="00:26.700" end="00:26.860" ttx:rubyGroup="2">ポ</span><span begin="00:26.860" end="00:26.980">な</span><span begin="00:26.980" end="00:27.120" ttx:rubyGroup="3" ttx:rubyText="attendance" ttx:rubyTimes="00:26.980,00:27.800">ア</span><span begin="00:27.120" end="00:27.260" ttx:rubyGroup="3">テ</span><span begin="00:27.260" end="00:27.440" ttx:rubyGroup="3">ン</span><span begin="00:27.440" end="00:27.580" ttx:rubyGroup="3">ダ</span><span begin="00:27.580" end="00:27.660" ttx:rubyGroup="3">ン</span><span begin="00:27.660" end="00:27.800" ttx:rubyGroup="3">ス</span> <span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:27.800" end="00:27.920">き</span></span></span><span begin="00:27.920" end="00:28.060">え</span><span begin="00:28.060" end="00:28.220">な</span><span begin="00:28.220" end="00:28.360">い</span><span ttm:role="x-translation">来去匆匆的节奏</span><span ttm:role="x-roman">hai tenpo na atendansu kienai</span></p><p begin="00:28.360" end="00:30.420" ttm:agent="v1" itunes:key="L6"><span tts:ruby="container"><span tts:ruby="base">足</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:28.360" end="00:28.520">た</span></span></span><span begin="00:28.520" end="00:28.680">り</span><span begin="00:28.680" end="00:28.820">な</span><span begin="00:28.820" end="00:28.960">い</span> <span tts:ruby="container"><span tts:ruby="base">落</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:28.960" end="00:29.160">お</span></span></span><span begin="00:29.160" end="00:29.260">ち</span><span tts:ruby="container"><span tts:ruby="base">込</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:29.260" end="00:29.420">こ</span></span></span><span begin="00:29.420" end="00:29.580">ん</span><span begin="00:29.580" end="00:29.720">だ</span><span tts:ruby="container"><span tts:ruby="base">未</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:29.720" end="00:29.880">み</span></span></span><span tts:ruby="container"><span tts:ruby="base">来</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:29.880" end="00:30.220">ら</span><span tts:ruby="text" begin="00:30.220" end="00:30.420">い</span></span></span><span ttm:role="x-translation">抹不去 来不及 令人失落的未来</span><span ttm:role="x-roman">tarinai ochikonda mirai</span></p><p begin="00:30.813" end="00:33.200" ttm:agent="v1" itunes:key="L7"><span tts:ruby="container"><span tts:ruby="base">最</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:30.813" end="00:31.080">さ</span><span tts:ruby="text" begin="00:31.080" end="00:31.173">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">終</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:31.173" end="00:31.380">しゅ</span><span tts:ruby="text" begin="00:31.380" end="00:31.520">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">話</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:31.520" end="00:31.680">わ</span></span></span><span begin="00:31.680" end="00:31.820">が</span><span tts:ruby="container"><span tts:ruby="base">来</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:31.820" end="00:31.960">き</span></span></span><span begin="00:31.960" end="00:32.280">たっ</span><span begin="00:32.280" end="00:32.540">て</span> <span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:32.540" end="00:32.740">い</span></span></span><span begin="00:32.740" end="00:32.880">え</span><span begin="00:32.880" end="00:33.060">な</span><span begin="00:33.060" end="00:33.200">い</span><span ttm:role="x-translation">即使最终话已经到来</span><span ttm:role="x-roman">saishūwa ga kitatte ienai</span></p><p begin="00:33.200" end="00:34.800" ttm:agent="v1" itunes:key="L8"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:33.200" end="00:33.400">き</span><span tts:ruby="text" begin="00:33.400" end="00:33.500">み</span></span></span><span begin="00:33.500" end="00:33.800">は</span><span tts:ruby="container"><span tts:ruby="base">泣</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:33.800" end="00:33.960">な</span></span></span><span begin="00:33.960" end="00:34.100">き</span><span begin="00:34.100" end="00:34.500">そ</span><span begin="00:34.500" end="00:34.800">う</span><span ttm:role="x-translation">有苦难言的你也泫然欲泣</span><span ttm:role="x-roman">kimi wa nakisō</span></p><p begin="00:35.100" end="00:37.300" ttm:agent="v1" itunes:key="L9"><span begin="00:35.100" end="00:35.340">ほ</span><span begin="00:35.340" end="00:35.480">ら、</span><span tts:ruby="container"><span tts:ruby="base">目</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:35.480" end="00:35.640">め</span></span></span><span begin="00:35.640" end="00:35.780">を</span><span tts:ruby="container"><span tts:ruby="base">閉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:35.780" end="00:35.920">と</span></span></span><span begin="00:35.920" end="00:36.080">じ</span><span begin="00:36.080" end="00:36.340">て</span> <span tts:ruby="container"><span tts:ruby="base">迷</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:36.520" end="00:36.740">ま</span><span tts:ruby="text" begin="00:36.740" end="00:36.840">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">子</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:36.840" end="00:36.960">ご</span></span></span><span begin="00:36.960" end="00:37.140">な</span><span begin="00:37.140" end="00:37.300">ら</span><span ttm:role="x-translation">来闭上双眼 反正我们同病相怜</span><span ttm:role="x-roman">hora me o tojite maigo nara</span></p><p begin="00:37.300" end="00:39.760" ttm:agent="v1" itunes:key="L10"><span tts:ruby="container"><span tts:ruby="base">一</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:37.300" end="00:37.480">い</span><span tts:ruby="text" begin="00:37.480" end="00:37.560">っ</span></span></span><span tts:ruby="container"><span tts:ruby="base">緒</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:37.560" end="00:37.880">しょ</span></span></span> <span tts:ruby="container"><span tts:ruby="base">帰</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:37.880" end="00:38.140">か</span><span tts:ruby="text" begin="00:38.140" end="00:38.180">え</span></span></span><span begin="00:38.180" end="00:38.380">り</span><span tts:ruby="container"><span tts:ruby="base">道</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:38.380" end="00:38.520">み</span><span tts:ruby="text" begin="00:38.520" end="00:38.660">ち</span></span></span><span begin="00:38.660" end="00:38.920">も</span><span begin="00:38.920" end="00:39.120">な</span><span begin="00:39.120" end="00:39.240">い</span><span begin="00:39.240" end="00:39.400">で</span><span begin="00:39.400" end="00:39.580">しょ</span><span begin="00:39.580" end="00:39.760">う？</span><span ttm:role="x-translation">都已迷失了回家的路</span><span ttm:role="x-roman">issho kaerimichi mo nai deshō</span></p><p begin="00:39.980" end="00:44.440" ttm:agent="v1" itunes:key="L11"><span tts:ruby="container"><span tts:ruby="base">継</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:39.980" end="00:40.160">つ</span></span></span><span begin="00:40.160" end="00:40.320">ぎ</span><span tts:ruby="container"><span tts:ruby="base">接</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:40.320" end="00:40.500">は</span></span></span><span begin="00:40.500" end="00:40.640">い</span><span begin="00:40.640" end="00:40.760">で</span><span begin="00:40.760" end="00:41.100">た</span> <span tts:ruby="container"><span tts:ruby="base">秘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:41.220" end="00:41.400">ひ</span></span></span><span tts:ruby="container"><span tts:ruby="base">密</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:41.400" end="00:41.800">み</span><span tts:ruby="text" begin="00:41.800" end="00:41.980">つ</span></span></span><span begin="00:41.980" end="00:42.440">に</span><span tts:ruby="container"><span tts:ruby="base">願</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:42.440" end="00:42.600">ね</span><span tts:ruby="text" begin="00:42.600" end="00:42.820">が</span></span></span><span begin="00:42.820" end="00:43.040">う</span> <span tts:ruby="container"><span tts:ruby="base">未</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:43.040" end="00:43.220">み</span></span></span><span tts:ruby="container"><span tts:ruby="base">来</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:43.220" end="00:43.500">ら</span><span tts:ruby="text" begin="00:43.500" end="00:43.680">い</span></span></span><span begin="00:43.680" end="00:43.820">は</span><span tts:ruby="container"><span tts:ruby="base">平</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:43.820" end="00:44.000">へ</span><span tts:ruby="text" begin="00:44.000" end="00:44.120">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">凡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:44.120" end="00:44.420">ぼ</span><span tts:ruby="text" begin="00:44.420" end="00:44.440">ん</span></span></span><span ttm:role="x-translation">千疮百孔的秘密中 期盼的是平凡的未来</span><span ttm:role="x-roman">tsugih aideta himitsu ni negau mirai wa heibon</span></p><p begin="00:44.760" end="00:47.600" ttm:agent="v1" itunes:key="L12"><span begin="00:44.760" end="00:45.140">さぁ、</span><span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:45.140" end="00:45.320">て</span></span></span><span begin="00:45.320" end="00:45.460">を</span><span tts:ruby="container"><span tts:ruby="base">鳴</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:45.460" end="00:45.640">な</span></span></span><span begin="00:45.640" end="00:45.720">ら</span><span begin="00:45.720" end="00:46.240">せ</span> <span begin="00:46.240" end="00:46.660">０</span><span begin="00:46.660" end="00:46.880">で</span><span tts:ruby="container"><span tts:ruby="base">廻っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:46.880" end="00:46.960">ま</span><span tts:ruby="text" begin="00:46.960" end="00:47.160">わ</span><span tts:ruby="text" begin="00:47.160" end="00:47.240">っ</span></span></span><span begin="00:47.240" end="00:47.600">た</span><span ttm:role="x-translation">来拍响双手 将徘徊零点的误解</span><span ttm:role="x-roman">sā te o narase zero de mawatta</span></p><p begin="00:47.600" end="00:50.440" ttm:agent="v1" itunes:key="L13"><span tts:ruby="container"><span tts:ruby="base">勘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:47.600" end="00:47.780">か</span><span tts:ruby="text" begin="00:47.780" end="00:47.900">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">違</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:47.900" end="00:48.060">ち</span><span tts:ruby="text" begin="00:48.060" end="00:48.260">が</span></span></span><span begin="00:48.260" end="00:48.360">い</span><span begin="00:48.360" end="00:48.660">を</span><span begin="00:48.660" end="00:48.840" ttx:rubyGroup="1" ttx:rubyText="きょ|う" ttx:rubyTimes="00:48.660,00:48.840 00:48.840,00:49.040">今</span><span begin="00:48.840" end="00:49.040" ttx:rubyGroup="1">日</span><span begin="00:49.040" end="00:49.400">も</span><span tts:ruby="container"><span tts:ruby="base">集</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:49.400" end="00:49.600">あ</span><span tts:ruby="text" begin="00:49.600" end="00:49.880">つ</span></span></span><span begin="00:49.880" end="00:50.000">め</span><span begin="00:50.000" end="00:50.440">て</span><span ttm:role="x-translation">今天也尽力收集</span><span ttm:role="x-roman">kanchigai o kyō mo atsumete</span></p><p begin="00:50.600" end="00:54.553" ttm:agent="v1" itunes:key="L14"><span tts:ruby="container"><span tts:ruby="base">始</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:50.600" end="00:50.780">は</span><span tts:ruby="text" begin="00:50.780" end="00:50.940">じ</span></span></span><span begin="00:50.940" end="00:51.060">め</span><span begin="00:51.060" end="00:51.300">よ</span><span begin="00:51.300" end="00:51.520">う</span> <span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:51.680" end="00:51.840">き</span><span tts:ruby="text" begin="00:51.840" end="00:51.980">み</span></span></span><span begin="00:51.980" end="00:52.140">も</span><span begin="00:52.140" end="00:52.300">ま</span><span begin="00:52.300" end="00:53.360">た</span> <span tts:ruby="container"><span tts:ruby="base">無</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:53.640" end="00:53.780">む</span></span></span><span tts:ruby="container"><span tts:ruby="base">我</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:53.780" end="00:53.940">が</span></span></span><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:53.940" end="00:54.080">む</span></span></span><span tts:ruby="container"><span tts:ruby="base">中？</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:54.080" end="00:54.320">ちゅ</span><span tts:ruby="text" begin="00:54.320" end="00:54.553">う</span></span></span><span ttm:role="x-translation">那就开始吧 你可愿再次忘情投入</span><span ttm:role="x-roman">hajimeyō kimi mo mata mugamuchū</span></p><p begin="00:54.540" end="00:56.972" ttm:agent="v1" itunes:key="L15"><span tts:ruby="container"><span tts:ruby="base">届</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:55.300" end="00:55.480">と</span><span tts:ruby="text" begin="00:55.480" end="00:55.620">ど</span></span></span><span begin="00:55.620" end="00:55.780">く</span><span begin="00:55.780" end="00:55.940">ま</span><span begin="00:55.940" end="00:56.040">で</span><span tts:ruby="container"><span tts:ruby="base">叫</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:56.040" end="00:56.220">さ</span><span tts:ruby="text" begin="00:56.220" end="00:56.420">け</span></span></span><span begin="00:56.420" end="00:56.540">ん</span><span begin="00:56.540" end="00:56.972">で</span><span ttm:role="x-bg" begin="00:54.540" end="00:55.180"><span begin="00:54.540" end="00:54.800">Let’s</span> <span begin="00:54.800" end="00:55.180">「play」</span><span ttm:role="x-translation">一起走入游戏</span></span><span ttm:role="x-translation">嘶喊直到听见</span><span ttm:role="x-roman">todoku made sakende</span></p><p begin="00:56.980" end="00:59.360" ttm:agent="v1" itunes:key="L16"><span tts:ruby="container"><span tts:ruby="base">叶</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:57.720" end="00:57.880">か</span><span tts:ruby="text" begin="00:57.880" end="00:58.080">な</span></span></span><span begin="00:58.080" end="00:58.220">う</span><span begin="00:58.220" end="00:58.360">ま</span><span begin="00:58.360" end="00:58.480">で</span><span begin="00:58.480" end="00:58.660" ttx:rubyGroup="1" ttx:rubyText="あ|が" ttx:rubyTimes="00:58.480,00:58.660 00:58.660,00:58.820">足</span><span begin="00:58.660" end="00:58.820" ttx:rubyGroup="1">掻</span><span begin="00:58.820" end="00:58.940">い</span><span begin="00:58.940" end="00:59.360">て</span><span ttm:role="x-bg" begin="00:56.980" end="00:57.600"><span begin="00:56.980" end="00:57.360">Let’s</span> <span begin="00:57.360" end="00:57.600">「save」</span><span ttm:role="x-translation">一起存档重来</span></span><span ttm:role="x-translation">挣扎直到实现</span><span ttm:role="x-roman">kanau made agaite</span></p><p begin="00:59.360" end="01:04.080" ttm:agent="v1" itunes:key="L17"><span begin="00:59.360" end="00:59.560">そ</span><span begin="00:59.560" end="00:59.700">の</span><span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:59.700" end="01:00.000">て</span></span></span><span begin="01:00.000" end="01:00.160">を</span><span tts:ruby="container"><span tts:ruby="base">掴</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:00.160" end="01:00.460">つ</span><span tts:ruby="text" begin="01:00.460" end="01:00.780">か</span></span></span><span begin="01:00.780" end="01:01.080">む</span><span begin="01:01.080" end="01:01.360">ま</span><span begin="01:01.360" end="01:01.680">で</span> <span begin="01:01.840" end="01:02.000">こ</span><span begin="01:02.000" end="01:02.170">の</span><span tts:ruby="container"><span tts:ruby="base">温</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:02.170" end="01:02.340">お</span><span tts:ruby="text" begin="01:02.340" end="01:02.460">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">度</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:02.460" end="01:02.580">ど</span></span></span><span begin="01:02.580" end="01:02.920">は</span><span tts:ruby="container"><span tts:ruby="base">忘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:02.920" end="01:03.120">わ</span><span tts:ruby="text" begin="01:03.120" end="01:03.500">す</span></span></span><span begin="01:03.500" end="01:03.780">れ</span><span begin="01:03.780" end="01:03.893">な</span><span begin="01:03.893" end="01:04.080">い</span><span ttm:role="x-translation">在抓紧你的手之前 决不忘却这份温暖</span><span ttm:role="x-roman">sono te o tsukamu made kono ondo wa wasurenai</span></p><p begin="01:04.340" end="01:06.600" ttm:agent="v1" itunes:key="L18"><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:04.980" end="01:05.160">こ</span><span tts:ruby="text" begin="01:05.160" end="01:05.340">こ</span><span tts:ruby="text" begin="01:05.340" end="01:05.480">ろ</span></span></span><span begin="01:05.480" end="01:05.620">を</span><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:05.620" end="01:05.740">け</span></span></span><span begin="01:05.740" end="01:05.940">さ</span><span begin="01:05.940" end="01:06.080">な</span><span begin="01:06.080" end="01:06.220">い</span><span begin="01:06.220" end="01:06.600">で</span><span ttm:role="x-bg" begin="01:04.340" end="01:04.860"><span begin="01:04.340" end="01:04.600">Let’s</span> <span begin="01:04.600" end="01:04.860">「daze」</span><span ttm:role="x-translation">一起直面眩乱</span></span><span ttm:role="x-translation">不要按捺本心</span><span ttm:role="x-roman">kokoro o kesanaide</span></p><p begin="01:06.701" end="01:09.020" ttm:agent="v1" itunes:key="L19"><span begin="01:07.420" end="01:07.760" ttx:rubyGroup="1" ttx:rubyText="ひ|と|り" ttx:rubyTimes="01:07.420,01:07.600 01:07.600,01:07.760 01:07.760,01:07.900">一</span><span begin="01:07.760" end="01:07.900" ttx:rubyGroup="1">人</span><span begin="01:07.900" end="01:08.040">で</span><span tts:ruby="container"><span tts:ruby="base">泣</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:08.040" end="01:08.200">な</span></span></span><span begin="01:08.200" end="01:08.360">か</span><span begin="01:08.360" end="01:08.520">な</span><span begin="01:08.520" end="01:08.660">い</span><span begin="01:08.660" end="01:09.020">で</span><span ttm:role="x-bg" begin="01:06.701" end="01:07.320"><span begin="01:06.701" end="01:07.060">Let’s</span> <span begin="01:07.060" end="01:07.320">「change」</span><span ttm:role="x-translation">一起改变命运</span></span><span ttm:role="x-translation">不要独自哭泣</span><span ttm:role="x-roman">hitori de nakanaide</span></p><p begin="01:09.100" end="01:11.340" ttm:agent="v1" itunes:key="L20"><span tts:ruby="container"><span tts:ruby="base">「孤</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:09.100" end="01:09.260">こ</span></span></span><span tts:ruby="container"><span tts:ruby="base">独」</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:09.260" end="01:09.400">ど</span><span tts:ruby="text" begin="01:09.400" end="01:09.720">く</span></span></span><span begin="01:09.720" end="01:09.900">な</span><span begin="01:09.900" end="01:10.100">ら</span> <span tts:ruby="container"><span tts:ruby="base">塗</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:10.320" end="01:10.440">ぬ</span></span></span><span begin="01:10.440" end="01:10.640">り</span><span tts:ruby="container"><span tts:ruby="base">替</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:10.640" end="01:10.820">か</span></span></span><span begin="01:10.820" end="01:10.980">え</span><span begin="01:10.980" end="01:11.100">れ</span><span begin="01:11.100" end="01:11.340">る</span><span ttm:role="x-translation">若只是孤独 一定能够改写</span><span ttm:role="x-roman">kodoku nara nurikaereru</span></p><p begin="01:11.380" end="01:14.540" ttm:agent="v1" itunes:key="L21"><span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:11.380" end="01:11.540">お</span><span tts:ruby="text" begin="01:11.540" end="01:11.680">も</span></span></span><span begin="01:11.680" end="01:11.840">い</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:11.840" end="01:12.000">だ</span></span></span><span begin="01:12.000" end="01:12.140">し</span><span begin="01:12.140" end="01:12.300">て</span><span begin="01:12.300" end="01:12.640">よ</span> <span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:12.640" end="01:12.780">い</span></span></span><span begin="01:12.780" end="01:12.920">い</span><span begin="01:12.920" end="01:13.260">た</span><span begin="01:13.260" end="01:13.540">かっ</span><span begin="01:13.540" end="01:13.820">た</span><span begin="01:13.820" end="01:14.000">こ</span><span begin="01:14.000" end="01:14.540">と</span><span ttm:role="x-translation">请你快回想起 曾经想说的话语</span><span ttm:role="x-roman">omoidashite yo iitakatta koto</span></p><p begin="01:24.240" end="01:25.920" ttm:agent="v1" itunes:key="L22"><span begin="01:24.240" end="01:24.440" ttx:rubyGroup="1" ttx:rubyText="encore" ttx:rubyTimes="01:24.240,01:25.000">ア</span><span begin="01:24.440" end="01:24.560" ttx:rubyGroup="1">ン</span><span begin="01:24.560" end="01:24.860" ttx:rubyGroup="1">コー</span><span begin="01:24.860" end="01:25.000" ttx:rubyGroup="1">ル</span><span begin="01:25.000" end="01:25.140">が</span><span tts:ruby="container"><span tts:ruby="base">響</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:25.140" end="01:25.320">ひ</span><span tts:ruby="text" begin="01:25.320" end="01:25.460">び</span></span></span><span begin="01:25.460" end="01:25.600">い</span><span begin="01:25.600" end="01:25.920">た</span><span ttm:role="x-translation">再来一次的呼声</span><span ttm:role="x-roman">ankōru ga hibiita</span></p><p begin="01:25.920" end="01:28.660" ttm:agent="v1" itunes:key="L23"><span tts:ruby="container"><span tts:ruby="base">巡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:25.920" end="01:26.060">め</span><span tts:ruby="text" begin="01:26.060" end="01:26.220">ぐ</span></span></span><span begin="01:26.220" end="01:26.520">り</span><span tts:ruby="container"><span tts:ruby="base">廻</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:26.520" end="01:26.680">め</span><span tts:ruby="text" begin="01:26.680" end="01:26.840">ぐ</span></span></span><span begin="01:26.840" end="01:27.120">る、</span><span tts:ruby="container"><span tts:ruby="base">街</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:27.120" end="01:27.280">ま</span><span tts:ruby="text" begin="01:27.280" end="01:27.460">ち</span></span></span><span begin="01:27.460" end="01:27.740">の</span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:27.740" end="01:27.880">な</span><span tts:ruby="text" begin="01:27.880" end="01:28.060">か</span></span></span><span begin="01:28.060" end="01:28.180">を</span><span tts:ruby="container"><span tts:ruby="base">往</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:28.180" end="01:28.340">ゆ</span></span></span><span begin="01:28.340" end="01:28.660">け</span><span ttm:role="x-translation">在回荡 在萦绕 在街头横冲直撞</span><span ttm:role="x-roman">meguri meguru machi no naka o yuke</span></p><p begin="01:28.980" end="01:30.760" ttm:agent="v1" itunes:key="L24"><span begin="01:28.980" end="01:29.120" ttx:rubyGroup="1" ttx:rubyText="standard" ttx:rubyTimes="01:28.980,01:29.870">ス</span><span begin="01:29.120" end="01:29.280" ttx:rubyGroup="1">タ</span><span begin="01:29.280" end="01:29.400" ttx:rubyGroup="1">ン</span><span begin="01:29.400" end="01:29.720" ttx:rubyGroup="1">ダー</span><span begin="01:29.720" end="01:29.870" ttx:rubyGroup="1">ド</span><span begin="01:29.870" end="01:30.020">を</span><span tts:ruby="container"><span tts:ruby="base">壊</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:30.020" end="01:30.180">こ</span><span tts:ruby="text" begin="01:30.180" end="01:30.340">わ</span></span></span><span begin="01:30.340" end="01:30.480">し</span><span begin="01:30.480" end="01:30.760">て</span><span ttm:role="x-translation">打破标准的队形</span><span ttm:role="x-roman">sutandādo o kowashite</span></p><p begin="01:30.760" end="01:32.700" ttm:agent="v1" itunes:key="L25"><span tts:ruby="container"><span tts:ruby="base">汗</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:30.760" end="01:30.870">あ</span><span tts:ruby="text" begin="01:30.870" end="01:31.020">せ</span></span></span><span begin="01:31.020" end="01:31.220">ば</span><span begin="01:31.220" end="01:31.380">ん</span><span begin="01:31.380" end="01:31.520">だ</span><span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:31.520" end="01:31.700">て</span></span></span><span begin="01:31.700" end="01:31.960">を</span> <span tts:ruby="container"><span tts:ruby="base">繋</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:31.960" end="01:32.120">つ</span><span tts:ruby="text" begin="01:32.120" end="01:32.300">な</span></span></span><span begin="01:32.300" end="01:32.520">ご</span><span begin="01:32.520" end="01:32.700">う</span><span ttm:role="x-translation">握起彼此汗津津的手</span><span ttm:role="x-roman">asebanda te o tsunagō</span></p><p begin="01:33.940" end="01:36.200" ttm:agent="v1" itunes:key="L26"><span begin="01:33.940" end="01:34.080" ttx:rubyGroup="1" ttx:rubyText="breakout" ttx:rubyTimes="01:33.940,01:34.720">ブ</span><span begin="01:34.080" end="01:34.160" ttx:rubyGroup="1">レ</span><span begin="01:34.160" end="01:34.240" ttx:rubyGroup="1">イ</span><span begin="01:34.240" end="01:34.300" ttx:rubyGroup="1">ク</span><span begin="01:34.300" end="01:34.500" ttx:rubyGroup="1">ア</span><span begin="01:34.500" end="01:34.571" ttx:rubyGroup="1">ウ</span><span begin="01:34.571" end="01:34.720" ttx:rubyGroup="1">ト</span><span begin="01:34.720" end="01:34.800">と</span><span begin="01:34.800" end="01:35.040" ttx:rubyGroup="2" ttx:rubyText="stand" ttx:rubyTimes="01:34.800,01:35.320">ス</span><span begin="01:35.040" end="01:35.160" ttx:rubyGroup="2">タ</span><span begin="01:35.160" end="01:35.260" ttx:rubyGroup="2">ン</span><span begin="01:35.260" end="01:35.320" ttx:rubyGroup="2">ド</span><span begin="01:35.320" end="01:35.480" ttx:rubyGroup="3" ttx:rubyText="up" ttx:rubyTimes="01:35.320,01:35.640">アッ</span><span begin="01:35.480" end="01:35.640" ttx:rubyGroup="3">プ</span> <span tts:ruby="container"><span tts:ruby="base">寝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:35.640" end="01:35.760">ね</span></span></span><span begin="01:35.760" end="01:35.920">れ</span><span begin="01:35.920" end="01:36.120">な</span><span begin="01:36.120" end="01:36.200">い</span><span ttm:role="x-translation">奋力起身地爆发</span><span ttm:role="x-roman">bureikuauto to sutando appu nerenai</span></p><p begin="01:36.200" end="01:38.320" ttm:agent="v1" itunes:key="L27"><span tts:ruby="container"><span tts:ruby="base">止</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:36.200" end="01:36.360">や</span></span></span><span begin="01:36.360" end="01:36.540">め</span><span begin="01:36.540" end="01:36.700">な</span><span begin="01:36.700" end="01:36.840">い</span><span tts:ruby="container"><span tts:ruby="base">逆</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:36.840" end="01:36.960">ぎゃ</span><span tts:ruby="text" begin="01:36.960" end="01:37.080">く</span></span></span><span tts:ruby="container"><span tts:ruby="base">襲</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:37.080" end="01:37.160">しゅ</span><span tts:ruby="text" begin="01:37.160" end="01:37.440">う</span></span></span><span begin="01:37.440" end="01:37.600">の</span><span tts:ruby="container"><span tts:ruby="base">気</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:37.600" end="01:37.760">け</span></span></span><span tts:ruby="container"><span tts:ruby="base">配</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:37.760" end="01:38.120">は</span><span tts:ruby="text" begin="01:38.120" end="01:38.320">い</span></span></span><span ttm:role="x-translation">睡不着 停不下 满怀逆袭的冲动</span><span ttm:role="x-roman">yamenai gyakushū no kehai</span></p><p begin="01:38.713" end="01:40.440" ttm:agent="v1" itunes:key="L28"><span tts:ruby="container"><span tts:ruby="base">最</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:38.713" end="01:38.940">さ</span><span tts:ruby="text" begin="01:38.940" end="01:39.100">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">終</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:39.100" end="01:39.250">しゅ</span><span tts:ruby="text" begin="01:39.250" end="01:39.400">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:39.400" end="01:39.560">び</span></span></span><span begin="01:39.560" end="01:39.720">が</span><span tts:ruby="container"><span tts:ruby="base">来</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:39.720" end="01:39.860">き</span></span></span><span begin="01:39.860" end="01:40.180">たっ</span><span begin="01:40.180" end="01:40.440">て</span><span ttm:role="x-translation">即使最终日已经到来</span><span ttm:role="x-roman">saishūbi ga kitatte</span></p><p begin="01:40.440" end="01:42.720" ttm:agent="v1" itunes:key="L29"><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:40.440" end="01:40.620">き</span></span></span><span begin="01:40.620" end="01:40.780">え</span><span begin="01:40.780" end="01:40.940">な</span><span begin="01:40.940" end="01:41.080">い</span><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:41.080" end="01:41.200">こ</span><span tts:ruby="text" begin="01:41.200" end="01:41.380">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">葉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:41.380" end="01:41.620">ば</span></span></span><span tts:ruby="container"><span tts:ruby="base">探</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:41.620" end="01:41.820">さ</span><span tts:ruby="text" begin="01:41.820" end="01:41.960">が</span></span></span><span begin="01:41.960" end="01:42.280">そ</span><span begin="01:42.280" end="01:42.720">う</span><span ttm:role="x-translation">也要寻觅永不消失的话语</span><span ttm:role="x-roman">kienai kotoba sagasō</span></p><p begin="01:43.020" end="01:44.200" ttm:agent="v1" itunes:key="L30"><span begin="01:43.020" end="01:43.200">ほ</span><span begin="01:43.200" end="01:43.360">ら、</span><span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:43.360" end="01:43.520">て</span></span></span><span begin="01:43.520" end="01:43.680">を</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:43.680" end="01:43.790">だ</span></span></span><span begin="01:43.790" end="01:43.960">し</span><span begin="01:43.960" end="01:44.200">て</span><span ttm:role="x-translation">来伸出双手</span><span ttm:role="x-roman">hora te o dashite</span></p><p begin="01:44.380" end="01:45.640" ttm:agent="v1" itunes:key="L31"><span tts:ruby="container"><span tts:ruby="base">会</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:44.380" end="01:44.560">あ</span></span></span><span begin="01:44.560" end="01:44.720">え</span><span begin="01:44.720" end="01:44.860">た</span><span begin="01:44.860" end="01:45.000">の</span><span begin="01:45.000" end="01:45.180">は</span><span begin="01:45.180" end="01:45.480">きっ</span><span begin="01:45.480" end="01:45.640">と</span><span ttm:role="x-translation">想必我们在此相遇</span><span ttm:role="x-roman">aeta no wa kitto</span></p><p begin="01:45.640" end="01:47.620" ttm:agent="v1" itunes:key="L32"><span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:45.640" end="01:45.720">お</span><span tts:ruby="text" begin="01:45.720" end="01:45.940">も</span></span></span><span begin="01:45.940" end="01:46.080">い</span><span tts:ruby="container"><span tts:ruby="base">違</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:46.080" end="01:46.240">ち</span><span tts:ruby="text" begin="01:46.240" end="01:46.380">が</span></span></span><span begin="01:46.380" end="01:46.540">い</span><span begin="01:46.540" end="01:46.820">じゃ</span><span begin="01:46.820" end="01:46.980">な</span><span begin="01:46.980" end="01:47.140">い</span><span begin="01:47.140" end="01:47.260">で</span><span begin="01:47.260" end="01:47.440">しょ</span><span begin="01:47.440" end="01:47.620">う？</span><span ttm:role="x-translation">一定不会是出于误会？</span><span ttm:role="x-roman">omoichigai ja nai deshō</span></p><p begin="01:47.880" end="01:50.340" ttm:agent="v1" itunes:key="L33"><span tts:ruby="container"><span tts:ruby="base">影</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:47.880" end="01:48.080">か</span><span tts:ruby="text" begin="01:48.080" end="01:48.180">げ</span></span></span><span tts:ruby="container"><span tts:ruby="base">法</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:48.180" end="01:48.330">ぼ</span><span tts:ruby="text" begin="01:48.330" end="01:48.480">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">師</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:48.480" end="01:48.680">し</span></span></span><span begin="01:48.680" end="01:49.080">の</span><span tts:ruby="container"><span tts:ruby="base">随</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:49.080" end="01:49.280">ま</span><span tts:ruby="text" begin="01:49.280" end="01:49.720">に</span><span tts:ruby="text" begin="01:49.720" end="01:49.900">ま</span></span></span><span begin="01:49.900" end="01:50.340">に</span><span ttm:role="x-translation">任凭身影摇摇晃晃</span><span ttm:role="x-roman">kagebōshi no manima ni</span></p><p begin="01:50.340" end="01:52.340" ttm:agent="v1" itunes:key="L34"><span tts:ruby="container"><span tts:ruby="base">憂</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:50.340" end="01:50.520">う</span><span tts:ruby="text" begin="01:50.520" end="01:50.690">れ</span></span></span><span begin="01:50.690" end="01:50.860">う</span><span tts:ruby="container"><span tts:ruby="base">世</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:50.860" end="01:51.060">せ</span></span></span><span tts:ruby="container"><span tts:ruby="base">界</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:51.060" end="01:51.380">か</span><span tts:ruby="text" begin="01:51.380" end="01:51.540">い</span></span></span><span begin="01:51.540" end="01:51.700">は</span><span tts:ruby="container"><span tts:ruby="base">残</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:51.700" end="01:51.800">ざ</span><span tts:ruby="text" begin="01:51.800" end="01:52.000">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">像</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:52.000" end="01:52.240">ぞ</span><span tts:ruby="text" begin="01:52.240" end="01:52.340">う</span></span></span><span ttm:role="x-translation">忧虑的世界只是残像</span><span ttm:role="x-roman">ureu sekai wa zanzō</span></p><p begin="01:52.720" end="01:54.880" ttm:agent="v1" itunes:key="L35"><span begin="01:52.720" end="01:52.920">も</span><span begin="01:52.920" end="01:53.040">う</span><span tts:ruby="container"><span tts:ruby="base">「悔</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:53.040" end="01:53.180">く</span><span tts:ruby="text" begin="01:53.180" end="01:53.300">や</span></span></span><span begin="01:53.300" end="01:53.480">し</span><span begin="01:53.480" end="01:53.640">さ」</span><span begin="01:53.640" end="01:53.920">も</span><span tts:ruby="container"><span tts:ruby="base">「弱</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:54.060" end="01:54.380">よ</span><span tts:ruby="text" begin="01:54.380" end="01:54.520">わ</span></span></span><span begin="01:54.520" end="01:54.720">さ」</span><span begin="01:54.720" end="01:54.880">も</span><span ttm:role="x-translation">无论悔恨还是软弱</span><span ttm:role="x-roman">mō kuyashisa mo yowasa mo</span></p><p begin="01:54.880" end="01:58.240" ttm:agent="v1" itunes:key="L36"><span begin="01:54.880" end="01:55.080">いっ</span><span begin="01:55.080" end="01:55.300">そ</span><span begin="01:55.300" end="01:55.460" ttx:rubyGroup="1" ttx:rubyText="い|く|じ" ttx:rubyTimes="01:55.300,01:55.460 01:55.460,01:55.780 01:55.780,01:55.920">「意</span><span begin="01:55.460" end="01:55.780" ttx:rubyGroup="1">気</span><span begin="01:55.780" end="01:55.920" ttx:rubyGroup="1">地</span><span begin="01:55.920" end="01:56.120">な</span><span begin="01:56.120" end="01:56.240">し」</span><span begin="01:56.240" end="01:56.500">も</span><span tts:ruby="container"><span tts:ruby="base">全</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:56.500" end="01:56.840">ぜ</span><span tts:ruby="text" begin="01:56.840" end="01:56.980">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">部</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:56.980" end="01:57.360">ぶ</span></span></span><span tts:ruby="container"><span tts:ruby="base">含</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:57.360" end="01:57.380">ふ</span><span tts:ruby="text" begin="01:57.380" end="01:57.760">く</span></span></span><span begin="01:57.760" end="01:57.900">め</span><span begin="01:57.900" end="01:58.240">て</span><span ttm:role="x-translation">就连毫无志气也全都包容</span><span ttm:role="x-roman">isso ikujinashi mo zenbu fukumete</span></p><p begin="01:58.460" end="02:02.240" ttm:agent="v1" itunes:key="L37"><span tts:ruby="container"><span tts:ruby="base">飛</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:58.460" end="01:58.680">と</span></span></span><span begin="01:58.680" end="01:58.780">び</span><span tts:ruby="container"><span tts:ruby="base">込</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:58.780" end="01:58.960">こ</span></span></span><span begin="01:58.960" end="01:59.120">も</span><span begin="01:59.120" end="01:59.360">う</span> <span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:59.540" end="01:59.740">き</span><span tts:ruby="text" begin="01:59.740" end="01:59.880">み</span></span></span><span begin="01:59.880" end="02:00.000">も</span><span begin="02:00.000" end="02:00.180">ま</span><span begin="02:00.180" end="02:01.220">た</span> <span tts:ruby="container"><span tts:ruby="base">無</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:01.540" end="02:01.687">む</span></span></span><span tts:ruby="container"><span tts:ruby="base">我</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:01.687" end="02:01.780">が</span></span></span><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:01.780" end="02:01.943">む</span></span></span><span tts:ruby="container"><span tts:ruby="base">中？</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:01.943" end="02:02.180">ちゅ</span><span tts:ruby="text" begin="02:02.180" end="02:02.240">う</span></span></span><span ttm:role="x-translation">投身其中吧 你可愿再次忘情投入？</span><span ttm:role="x-roman">tobikomō kimi mo mata mugamuchū</span></p><p begin="02:02.440" end="02:04.770" ttm:agent="v1" itunes:key="L38"><span tts:ruby="container"><span tts:ruby="base">伸</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:03.160" end="02:03.340">の</span></span></span><span begin="02:03.340" end="02:03.480">ば</span><span begin="02:03.480" end="02:03.640">す</span><span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:03.640" end="02:03.820">て</span></span></span><span begin="02:03.820" end="02:03.920">が</span><span tts:ruby="container"><span tts:ruby="base">揺</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:03.920" end="02:04.120">ゆ</span></span></span><span begin="02:04.120" end="02:04.300">ら</span><span begin="02:04.300" end="02:04.400">い</span><span begin="02:04.400" end="02:04.770">で</span><span ttm:role="x-bg" begin="02:02.440" end="02:03.000"><span begin="02:02.440" end="02:02.820">Let’s</span> <span begin="02:02.820" end="02:03.000">「play」</span><span ttm:role="x-translation">一起走入游戏</span></span><span ttm:role="x-translation">伸出的手在抖</span><span ttm:role="x-roman">nobasu te ga yuraide</span></p><p begin="02:04.900" end="02:07.200" ttm:agent="v1" itunes:key="L39"><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:05.600" end="02:05.771">こ</span><span tts:ruby="text" begin="02:05.771" end="02:05.940">こ</span><span tts:ruby="text" begin="02:05.940" end="02:06.070">ろ</span></span></span><span begin="02:06.070" end="02:06.200">を</span><span begin="02:06.200" end="02:06.400">す</span><span begin="02:06.400" end="02:06.560">り</span><span tts:ruby="container"><span tts:ruby="base">減っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:06.560" end="02:06.640">へ</span><span tts:ruby="text" begin="02:06.640" end="02:06.820">っ</span></span></span><span begin="02:06.820" end="02:07.200">て</span><span ttm:role="x-bg" begin="02:04.900" end="02:05.460"><span begin="02:04.900" end="02:05.300">Let’s</span> <span begin="02:05.300" end="02:05.460">「save」</span><span ttm:role="x-translation">一起存档重来</span></span><span ttm:role="x-translation">心也已经憔悴</span><span ttm:role="x-roman">kokoro o surihette</span></p><p begin="02:07.260" end="02:09.500" ttm:agent="v1" itunes:key="L40"><span begin="02:07.260" end="02:07.460">ま</span><span begin="02:07.460" end="02:07.580">る</span><span begin="02:07.580" end="02:07.860">で</span><span tts:ruby="container"><span tts:ruby="base">希</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:07.860" end="02:08.060">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">望</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:08.060" end="02:08.200">ぼ</span><span tts:ruby="text" begin="02:08.200" end="02:08.360">う</span></span></span><span begin="02:08.360" end="02:08.640">が</span><span tts:ruby="container"><span tts:ruby="base">無</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:08.640" end="02:08.883">な</span></span></span><span begin="02:08.883" end="02:09.000">く</span><span begin="02:09.000" end="02:09.260">たっ</span><span begin="02:09.260" end="02:09.500">て</span><span ttm:role="x-translation">就连希望都已渺茫</span><span ttm:role="x-roman">marude kibō ga nakutatte</span></p><p begin="02:09.680" end="02:12.142" ttm:agent="v1" itunes:key="L41"><span begin="02:09.680" end="02:09.860">そ</span><span begin="02:09.860" end="02:10.000">の</span><span tts:ruby="container"><span tts:ruby="base">温</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:10.000" end="02:10.200">お</span><span tts:ruby="text" begin="02:10.200" end="02:10.340">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">度</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:10.340" end="02:10.480">ど</span></span></span><span begin="02:10.480" end="02:10.780">は</span><span tts:ruby="container"><span tts:ruby="base">忘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:10.780" end="02:11.000">わ</span><span tts:ruby="text" begin="02:11.000" end="02:11.360">す</span></span></span><span begin="02:11.360" end="02:11.660">れ</span><span begin="02:11.660" end="02:11.900">な</span><span begin="02:11.900" end="02:12.142">い</span><span ttm:role="x-translation">却还不忘你的温暖</span><span ttm:role="x-roman">sono ondo wa wasurenai</span></p><p begin="02:12.142" end="02:14.573" ttm:agent="v1" itunes:key="L42"><span tts:ruby="container"><span tts:ruby="base">街</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:12.860" end="02:13.040">ま</span><span tts:ruby="text" begin="02:13.040" end="02:13.200">ち</span></span></span><span tts:ruby="container"><span tts:ruby="base">風</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:13.200" end="02:13.320">か</span><span tts:ruby="text" begin="02:13.320" end="02:13.500">ぜ</span></span></span><span begin="02:13.500" end="02:13.640">が</span><span tts:ruby="container"><span tts:ruby="base">唸っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:13.640" end="02:13.820">う</span><span tts:ruby="text" begin="02:13.820" end="02:14.020">な</span><span tts:ruby="text" begin="02:14.020" end="02:14.100">っ</span></span></span><span begin="02:14.100" end="02:14.573">て</span><span ttm:role="x-bg" begin="02:12.142" end="02:12.700"><span begin="02:12.142" end="02:12.460">Let’s</span> <span begin="02:12.460" end="02:12.700">「daze」</span><span ttm:role="x-translation">一起直面眩乱</span></span><span ttm:role="x-translation">即使狂风肆虐</span><span ttm:role="x-roman">machikaze ga unatte</span></p><p begin="02:14.580" end="02:16.900" ttm:agent="v1" itunes:key="L43"><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:15.300" end="02:15.480">こ</span><span tts:ruby="text" begin="02:15.480" end="02:15.640">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">葉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:15.640" end="02:15.780">ば</span></span></span><span begin="02:15.780" end="02:15.920">が</span><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:15.920" end="02:16.060">き</span></span></span><span begin="02:16.060" end="02:16.220">え</span><span begin="02:16.220" end="02:16.540">たっ</span><span begin="02:16.540" end="02:16.900">て</span><span ttm:role="x-bg" begin="02:14.580" end="02:15.240"><span begin="02:14.580" end="02:14.840">Let’s</span> <span begin="02:14.840" end="02:15.240">「change」</span><span ttm:role="x-translation">一起改变命运</span></span><span ttm:role="x-translation">即使无言以对</span><span ttm:role="x-roman">kotoba ga kietatte</span></p><p begin="02:16.920" end="02:19.240" ttm:agent="v1" itunes:key="L44"><span tts:ruby="container"><span tts:ruby="base">気</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:16.920" end="02:17.120">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">持</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:17.120" end="02:17.280">も</span></span></span><span begin="02:17.280" end="02:17.600">ち</span><span begin="02:17.600" end="02:17.760">な</span><span begin="02:17.760" end="02:17.980">ら</span> <span begin="02:18.180" end="02:18.360" ttx:rubyGroup="1" ttx:rubyText="こ|こ" ttx:rubyTimes="02:18.180,02:18.360 02:18.360,02:18.500">此</span><span begin="02:18.360" end="02:18.500" ttx:rubyGroup="1">処</span><span begin="02:18.500" end="02:18.800">に</span><span begin="02:18.800" end="02:18.980">あ</span><span begin="02:18.980" end="02:19.240">る</span><span ttm:role="x-translation">你要的真心就在这个地方</span><span ttm:role="x-roman">kimochi nara koko ni aru</span></p><p begin="02:19.240" end="02:22.360" ttm:agent="v1" itunes:key="L45"><span begin="02:19.240" end="02:19.560">ずっ</span><span begin="02:19.560" end="02:19.720">と</span><span tts:ruby="container"><span tts:ruby="base">前</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:19.720" end="02:19.920">ま</span><span tts:ruby="text" begin="02:19.920" end="02:19.980">え</span></span></span><span begin="02:19.980" end="02:20.200">か</span><span begin="02:20.200" end="02:20.480">ら</span> <span tts:ruby="container"><span tts:ruby="base">気</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:20.480" end="02:20.740">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">付</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:20.740" end="02:20.960">づ</span></span></span><span begin="02:20.960" end="02:21.380">い</span><span begin="02:21.380" end="02:21.600">た</span><span begin="02:21.600" end="02:21.720">ん</span><span begin="02:21.720" end="02:21.840">だ</span><span begin="02:21.840" end="02:22.360">よ</span><span ttm:role="x-translation">很久很久以前我就早已经察觉</span><span ttm:role="x-roman">zutto mae kara kizuita n da yo</span></p><p begin="02:31.320" end="02:34.080" ttm:agent="v1" itunes:key="L46"><span tts:ruby="container"><span tts:ruby="base">赤</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:31.320" end="02:31.520">あ</span><span tts:ruby="text" begin="02:31.520" end="02:31.680">か</span></span></span><span begin="02:31.680" end="02:31.840">い</span><span tts:ruby="container"><span tts:ruby="base">目</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:31.840" end="02:32.120">め</span></span></span><span tts:ruby="container"><span tts:ruby="base">擦っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:32.280" end="02:32.400">こ</span><span tts:ruby="text" begin="02:32.400" end="02:32.740">す</span><span tts:ruby="text" begin="02:32.740" end="02:32.920">っ</span></span></span><span begin="02:32.920" end="02:33.020">た</span><span begin="02:33.020" end="02:33.200">あ</span><span begin="02:33.200" end="02:33.360">の</span><span tts:ruby="container"><span tts:ruby="base">子</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:33.360" end="02:33.480">こ</span></span></span><span begin="02:33.480" end="02:33.640">へ</span><span begin="02:33.640" end="02:34.080">と</span><span ttm:role="x-translation">向着那个哭红了眼的孩子</span><span ttm:role="x-roman">akai me kosutta ano ko e to</span></p><p begin="02:34.080" end="02:36.340" ttm:agent="v1" itunes:key="L47"><span tts:ruby="container"><span tts:ruby="base">青</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:34.080" end="02:34.220">あ</span><span tts:ruby="text" begin="02:34.220" end="02:34.520">お</span></span></span><span begin="02:34.520" end="02:34.700">い</span><span tts:ruby="container"><span tts:ruby="base">青</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:34.700" end="02:34.820">あ</span><span tts:ruby="text" begin="02:34.820" end="02:35.060">お</span></span></span><span begin="02:35.060" end="02:35.300">い</span><span tts:ruby="container"><span tts:ruby="base">夏</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:35.300" end="02:35.460">な</span><span tts:ruby="text" begin="02:35.460" end="02:35.620">つ</span></span></span><span begin="02:35.620" end="02:35.760">を</span><span tts:ruby="container"><span tts:ruby="base">超</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:35.760" end="02:35.900">こ</span></span></span><span begin="02:35.900" end="02:36.100">え</span><span begin="02:36.100" end="02:36.340">て</span><span ttm:role="x-translation">飞越这个天空湛蓝的夏天</span><span ttm:role="x-roman">aoi aoi natsu o koete</span></p><p begin="02:36.520" end="02:40.060" ttm:agent="v1" itunes:key="L48"><span tts:ruby="container"><span tts:ruby="base">届</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:36.520" end="02:36.680">と</span><span tts:ruby="text" begin="02:36.680" end="02:36.960">ど</span></span></span><span begin="02:36.960" end="02:37.140">く</span><span begin="02:37.140" end="02:37.280">の</span><span begin="02:37.280" end="02:37.600">が</span> <span begin="02:37.740" end="02:37.940">こ</span><span begin="02:37.940" end="02:38.340">の</span><span tts:ruby="container"><span tts:ruby="base">声</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:38.340" end="02:38.560">こ</span><span tts:ruby="text" begin="02:38.560" end="02:38.960">え</span></span></span><span begin="02:38.960" end="02:39.120">な</span><span begin="02:39.120" end="02:40.060">ら</span><span ttm:role="x-translation">如果我的呼唤能够抵达</span><span ttm:role="x-roman">todoku no ga kono koe nara</span></p><p begin="02:41.040" end="02:43.740" ttm:agent="v1" itunes:key="L49"><span begin="02:41.040" end="02:41.220">「さ</span><span begin="02:41.220" end="02:41.380">よ</span><span begin="02:41.380" end="02:41.540">な</span><span begin="02:41.540" end="02:41.840">ら」</span> <span tts:ruby="container"><span tts:ruby="base">唱</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:41.960" end="02:42.140">と</span><span tts:ruby="text" begin="02:42.140" end="02:42.420">な</span></span></span><span begin="02:42.420" end="02:42.620">え</span><span begin="02:42.620" end="02:42.740">た</span><span tts:ruby="container"><span tts:ruby="base">夕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:42.740" end="02:42.900">ゆ</span><span tts:ruby="text" begin="02:42.900" end="02:43.060">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">暮</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:43.060" end="02:43.170">ぐ</span></span></span><span begin="02:43.170" end="02:43.340">れ</span><span begin="02:43.340" end="02:43.740">も</span><span ttm:role="x-translation">就连高喊再见的黄昏</span><span ttm:role="x-roman">sayonara tonaeta yūgure mo</span></p><p begin="02:43.780" end="02:45.760" ttm:agent="v1" itunes:key="L50"><span begin="02:43.780" end="02:43.960">ま</span><span begin="02:43.960" end="02:44.260">た</span><span begin="02:44.260" end="02:44.600" ttx:rubyGroup="1" ttx:rubyText="き|の|う" ttx:rubyTimes="02:44.260,02:44.420 02:44.420,02:44.600 02:44.600,02:44.720">昨</span><span begin="02:44.600" end="02:44.720" ttx:rubyGroup="1">日</span><span begin="02:44.720" end="02:45.000">に</span><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:45.000" end="02:45.180">か</span></span></span><span begin="02:45.180" end="02:45.360">え</span><span begin="02:45.360" end="02:45.480">れ</span><span begin="02:45.480" end="02:45.760">る</span><span ttm:role="x-translation">也能再次变回昨天</span><span ttm:role="x-roman">mata kinō ni kaereru</span></p><p begin="02:46.040" end="02:50.260" ttm:agent="v1" itunes:key="L51"><span begin="02:46.040" end="02:46.220">こ</span><span begin="02:46.220" end="02:46.360">の</span><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:46.360" end="02:46.680">ゆ</span><span tts:ruby="text" begin="02:46.680" end="02:46.840">め</span></span></span><span begin="02:46.840" end="02:47.100">を</span><span tts:ruby="container"><span tts:ruby="base">抜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:47.280" end="02:47.440">ぬ</span></span></span><span begin="02:47.440" end="02:47.600">け</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:47.600" end="02:47.840">だ</span></span></span><span begin="02:47.840" end="02:48.060">せ</span><span begin="02:48.060" end="02:48.340">る</span> <span begin="02:48.340" end="02:48.660">きっ</span><span begin="02:48.660" end="02:50.260">と</span><span ttm:role="x-translation">我们一定能逃出这场梦魇</span><span ttm:role="x-roman">kono yume o nukedaseru kitto</span></p><p begin="02:52.120" end="02:54.380" ttm:agent="v1" itunes:key="L52"><span tts:ruby="container"><span tts:ruby="base">待っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:52.120" end="02:52.320">ま</span><span tts:ruby="text" begin="02:52.320" end="02:52.440">っ</span></span></span><span begin="02:52.440" end="02:52.740">て</span> <span begin="02:52.900" end="02:53.220" ttx:rubyGroup="1" ttx:rubyText="ひ|と|り" ttx:rubyTimes="02:52.900,02:53.060 02:53.060,02:53.220 02:53.220,02:53.360">一</span><span begin="02:53.220" end="02:53.360" ttx:rubyGroup="1">人</span><span begin="02:53.360" end="02:53.520">な</span><span begin="02:53.520" end="02:53.660">ら</span><span tts:ruby="container"><span tts:ruby="base">応</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:53.660" end="02:53.800">こ</span><span tts:ruby="text" begin="02:53.800" end="02:53.940">た</span></span></span><span begin="02:53.940" end="02:54.140">え</span><span begin="02:54.140" end="02:54.380">て</span><span ttm:role="x-translation">等等 若是孤独就回答我吧</span><span ttm:role="x-roman">matte hitori nara kotaete</span></p><p begin="02:54.540" end="02:56.880" ttm:agent="v1" itunes:key="L53"><span begin="02:54.540" end="02:54.747" ttx:rubyGroup="1" ttx:rubyText="きょ|う" ttx:rubyTimes="02:54.540,02:54.747 02:54.747,02:54.953">今</span><span begin="02:54.747" end="02:54.953" ttx:rubyGroup="1">日</span><span begin="02:54.953" end="02:55.160">を</span> <span tts:ruby="container"><span tts:ruby="base">嘆</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:55.280" end="02:55.480">な</span><span tts:ruby="text" begin="02:55.480" end="02:55.660">げ</span></span></span><span begin="02:55.660" end="02:55.780">い</span><span begin="02:55.780" end="02:55.940">た</span><span begin="02:55.940" end="02:56.060">り</span><span begin="02:56.060" end="02:56.240">し</span><span begin="02:56.240" end="02:56.420">な</span><span begin="02:56.420" end="02:56.540">い</span><span begin="02:56.540" end="02:56.880">で</span><span ttm:role="x-translation">别再沉浸于对今天的哀叹</span><span ttm:role="x-roman">kyō o nageitari shinaide</span></p><p begin="02:56.960" end="03:01.720" ttm:agent="v1" itunes:key="L54"><span tts:ruby="container"><span tts:ruby="base">寂</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:56.960" end="02:57.160">さ</span><span tts:ruby="text" begin="02:57.160" end="02:57.260">み</span></span></span><span begin="02:57.260" end="02:57.600">し</span><span begin="02:57.600" end="02:57.780">さ</span><span begin="02:57.780" end="02:58.060">も</span> <span tts:ruby="container"><span tts:ruby="base">涙</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:58.060" end="02:58.400">な</span><span tts:ruby="text" begin="02:58.400" end="02:58.660">み</span><span tts:ruby="text" begin="02:58.660" end="02:58.960">だ</span></span></span><span begin="02:58.960" end="02:59.280">も</span> <span tts:ruby="container"><span tts:ruby="base">分</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:59.400" end="02:59.560">わ</span></span></span><span begin="02:59.560" end="02:59.720">け</span><span tts:ruby="container"><span tts:ruby="base">合</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:59.720" end="02:59.880">あ</span></span></span><span begin="02:59.880" end="03:00.020">う</span><span begin="03:00.020" end="03:00.180">か</span><span begin="03:00.180" end="03:00.480">ら</span> <span tts:ruby="container"><span tts:ruby="base">一</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:00.480" end="03:00.940">い</span><span tts:ruby="text" begin="03:00.940" end="03:01.040">っ</span></span></span><span tts:ruby="container"><span tts:ruby="base">緒</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:01.040" end="03:01.340">しょ</span></span></span><span begin="03:01.340" end="03:01.720">に</span><span ttm:role="x-translation">无论寂寞还是眼泪 我都与你一起分担</span><span ttm:role="x-roman">samishisa mo namida mo wakeau kara issho ni</span></p><p begin="03:01.800" end="03:04.180" ttm:agent="v1" itunes:key="L55"><span tts:ruby="container"><span tts:ruby="base">届</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:02.595" end="03:02.740">と</span><span tts:ruby="text" begin="03:02.740" end="03:02.880">ど</span></span></span><span begin="03:02.880" end="03:03.040">く</span><span begin="03:03.040" end="03:03.200">ま</span><span begin="03:03.200" end="03:03.320">で</span><span tts:ruby="container"><span tts:ruby="base">叫</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:03.320" end="03:03.480">さ</span><span tts:ruby="text" begin="03:03.480" end="03:03.680">け</span></span></span><span begin="03:03.680" end="03:03.820">ん</span><span begin="03:03.820" end="03:04.180">で</span><span ttm:role="x-bg" begin="03:01.800" end="03:02.520"><span begin="03:01.800" end="03:02.100">Let’s</span> <span begin="03:02.100" end="03:02.520">「play」</span><span ttm:role="x-translation">一起走入游戏</span></span><span ttm:role="x-translation">嘶喊直到听见</span><span ttm:role="x-roman">todoku made sakende</span></p><p begin="03:04.220" end="03:06.620" ttm:agent="v1" itunes:key="L56"><span tts:ruby="container"><span tts:ruby="base">叶</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:05.000" end="03:05.160">か</span><span tts:ruby="text" begin="03:05.160" end="03:05.340">な</span></span></span><span begin="03:05.340" end="03:05.480">う</span><span begin="03:05.480" end="03:05.620">ま</span><span begin="03:05.620" end="03:05.760">で</span><span begin="03:05.760" end="03:05.920" ttx:rubyGroup="1" ttx:rubyText="あ|が" ttx:rubyTimes="03:05.760,03:05.920 03:05.920,03:06.100">足</span><span begin="03:05.920" end="03:06.100" ttx:rubyGroup="1">掻</span><span begin="03:06.100" end="03:06.200">い</span><span begin="03:06.200" end="03:06.620">て</span><span ttm:role="x-bg" begin="03:04.220" end="03:04.860"><span begin="03:04.220" end="03:04.520">Let’s</span> <span begin="03:04.520" end="03:04.860">「save」</span><span ttm:role="x-translation">一起存档重来</span></span><span ttm:role="x-translation">挣扎直到实现</span><span ttm:role="x-roman">kanau made agaite</span></p><p begin="03:06.620" end="03:11.460" ttm:agent="v1" itunes:key="L57"><span begin="03:06.620" end="03:06.840">そ</span><span begin="03:06.840" end="03:06.980">の</span><span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:06.980" end="03:07.280">て</span></span></span><span begin="03:07.280" end="03:07.440">を</span><span tts:ruby="container"><span tts:ruby="base">掴</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:07.440" end="03:07.720">つ</span><span tts:ruby="text" begin="03:07.720" end="03:08.040">か</span></span></span><span begin="03:08.040" end="03:08.360">む</span><span begin="03:08.360" end="03:08.640">ま</span><span begin="03:08.640" end="03:08.940">で</span> <span begin="03:09.100" end="03:09.300">こ</span><span begin="03:09.300" end="03:09.420">の</span><span tts:ruby="container"><span tts:ruby="base">温</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:09.420" end="03:09.600">お</span><span tts:ruby="text" begin="03:09.600" end="03:09.740">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">度</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:09.740" end="03:09.860">ど</span></span></span><span begin="03:09.860" end="03:10.180">は</span><span tts:ruby="container"><span tts:ruby="base">忘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:10.180" end="03:10.420">わ</span><span tts:ruby="text" begin="03:10.420" end="03:10.780">す</span></span></span><span begin="03:10.780" end="03:11.060">れ</span><span begin="03:11.060" end="03:11.280">な</span><span begin="03:11.280" end="03:11.460">い</span><span ttm:role="x-translation">在抓紧你的手之前 决不忘却这份温暖</span><span ttm:role="x-roman">sono te o tsukamu made kono ondo wa wasurenai</span></p><p begin="03:11.520" end="03:13.959" ttm:agent="v1" itunes:key="L58"><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:12.260" end="03:12.440">こ</span><span tts:ruby="text" begin="03:12.440" end="03:12.600">こ</span><span tts:ruby="text" begin="03:12.600" end="03:12.760">ろ</span></span></span><span begin="03:12.760" end="03:12.920">を</span><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:12.920" end="03:13.030">け</span></span></span><span begin="03:13.030" end="03:13.200">さ</span><span begin="03:13.200" end="03:13.360">な</span><span begin="03:13.360" end="03:13.500">い</span><span begin="03:13.500" end="03:13.959">で</span><span ttm:role="x-bg" begin="03:11.520" end="03:12.120"><span begin="03:11.520" end="03:11.820">Let’s</span> <span begin="03:11.820" end="03:12.120">「daze」</span><span ttm:role="x-translation">一起直面眩乱</span></span><span ttm:role="x-translation">不要按捺本心</span><span ttm:role="x-roman">kokoro o kesanaide</span></p><p begin="03:13.959" end="03:16.300" ttm:agent="v1" itunes:key="L59"><span begin="03:14.700" end="03:15.020" ttx:rubyGroup="1" ttx:rubyText="ひ|と|り" ttx:rubyTimes="03:14.700,03:14.860 03:14.860,03:15.020 03:15.020,03:15.180">一</span><span begin="03:15.020" end="03:15.180" ttx:rubyGroup="1">人</span><span begin="03:15.180" end="03:15.320">で</span><span tts:ruby="container"><span tts:ruby="base">泣</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:15.320" end="03:15.480">な</span></span></span><span begin="03:15.480" end="03:15.620">か</span><span begin="03:15.620" end="03:15.780">な</span><span begin="03:15.780" end="03:15.920">い</span><span begin="03:15.920" end="03:16.300">で</span><span ttm:role="x-bg" begin="03:13.959" end="03:14.620"><span begin="03:13.959" end="03:14.200">Let’s</span> <span begin="03:14.200" end="03:14.620">「change」</span><span ttm:role="x-translation">一起改变命运</span></span><span ttm:role="x-translation">不要独自哭泣</span><span ttm:role="x-roman">hitori de nakanaide</span></p><p begin="03:16.360" end="03:18.620" ttm:agent="v1" itunes:key="L60"><span tts:ruby="container"><span tts:ruby="base">揺</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:16.360" end="03:16.540">ゆ</span></span></span><span begin="03:16.540" end="03:16.660">ら</span><span begin="03:16.660" end="03:16.880">め</span><span begin="03:16.880" end="03:16.980">き</span><span begin="03:16.980" end="03:17.120">だ</span><span begin="03:17.120" end="03:17.440">す</span> <span tts:ruby="container"><span tts:ruby="base">街</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:17.560" end="03:17.740">ま</span><span tts:ruby="text" begin="03:17.740" end="03:17.900">ち</span></span></span><span begin="03:17.900" end="03:18.180">の</span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:18.180" end="03:18.340">な</span><span tts:ruby="text" begin="03:18.340" end="03:18.620">か</span></span></span><span ttm:role="x-translation">身处摇曳在阳炎中的都市</span><span ttm:role="x-roman">yuramekidasu machi no naka</span></p><p begin="03:18.620" end="03:21.100" ttm:agent="v1" itunes:key="L61"><span tts:ruby="container"><span tts:ruby="base">挫</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:18.620" end="03:18.800">く</span><span tts:ruby="text" begin="03:18.800" end="03:18.960">じ</span></span></span><span begin="03:18.960" end="03:19.080">け</span><span begin="03:19.080" end="03:19.230">そ</span><span begin="03:19.230" end="03:19.380">う</span><span begin="03:19.380" end="03:19.580">に</span><span begin="03:19.580" end="03:19.860">なっ</span><span begin="03:19.860" end="03:20.080">て</span><span begin="03:20.080" end="03:20.180">し</span><span begin="03:20.180" end="03:20.460">まっ</span><span begin="03:20.460" end="03:20.620">て</span><span begin="03:20.620" end="03:21.100">も</span><span ttm:role="x-translation">即使你几乎倒在挫折面前</span><span ttm:role="x-roman">kujikesō ni natte shimatte mo</span></p><p begin="03:21.180" end="03:23.420" ttm:agent="v1" itunes:key="L62"><span tts:ruby="container"><span tts:ruby="base">「孤</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:21.180" end="03:21.360">こ</span></span></span><span tts:ruby="container"><span tts:ruby="base">独」</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:21.360" end="03:21.520">ど</span><span tts:ruby="text" begin="03:21.520" end="03:21.840">く</span></span></span><span begin="03:21.840" end="03:22.000">な</span><span begin="03:22.000" end="03:22.220">ら</span> <span tts:ruby="container"><span tts:ruby="base">塗</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:22.420" end="03:22.580">ぬ</span></span></span><span begin="03:22.580" end="03:22.740">り</span><span tts:ruby="container"><span tts:ruby="base">替</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:22.740" end="03:22.940">か</span></span></span><span begin="03:22.940" end="03:23.100">え</span><span begin="03:23.100" end="03:23.220">れ</span><span begin="03:23.220" end="03:23.420">る</span><span ttm:role="x-translation">若只是孤独一定能够改写</span><span ttm:role="x-roman">kodoku nara nurikaereru</span></p><p begin="03:23.480" end="03:28.741" ttm:agent="v1" itunes:key="L63"><span begin="03:23.480" end="03:23.660">「ひ</span><span begin="03:23.660" end="03:23.800">と</span><span begin="03:23.800" end="03:23.940">り</span><span begin="03:23.940" end="03:24.220">ぼっ</span><span begin="03:24.220" end="03:24.420">ち」</span><span begin="03:24.420" end="03:24.740">を</span><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:24.740" end="03:25.025">か</span></span></span><span begin="03:25.025" end="03:25.190">え</span><span begin="03:25.190" end="03:25.340">よ</span><span begin="03:25.340" end="03:25.520">と</span><span begin="03:25.520" end="03:25.640">し</span><span begin="03:25.640" end="03:25.920">た</span> <span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:25.920" end="03:26.240">き</span><span tts:ruby="text" begin="03:26.240" end="03:26.820">み</span></span></span><span begin="03:26.820" end="03:26.926">と</span><span begin="03:26.926" end="03:27.170">な</span><span begin="03:27.170" end="03:28.741">ら</span><span ttm:role="x-translation">只要和勇于改变孤单的你一起</span><span ttm:role="x-roman">hitoribotchi o kaeyō to shita kimi to nara</span></p><p begin="03:30.800" end="03:34.640" ttm:agent="v1" itunes:key="L64"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:30.800" end="03:31.080">き</span><span tts:ruby="text" begin="03:31.080" end="03:31.700">み</span></span></span><span begin="03:31.700" end="03:31.840">と</span><span begin="03:31.840" end="03:32.120">な</span><span begin="03:32.120" end="03:34.640">ら</span><span ttm:role="x-translation">和你一起的话</span><span ttm:role="x-roman">kimi to nara</span></p></div></body></tt>