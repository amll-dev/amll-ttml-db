<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="ありふれてたい"/><amll:meta key="musicName" value="只想平凡地活着"/><amll:meta key="musicName" value="只想平凡地活着 (TV动画《少女型兵器想要成为家人》片尾曲)"/><amll:meta key="artists" value="KAF"/><amll:meta key="artists" value="kaf"/><amll:meta key="artists" value="かふ"/><amll:meta key="artists" value="花譜"/><amll:meta key="artists" value="花谱"/><amll:meta key="album" value="Transcendent Love"/><amll:meta key="album" value="深愛"/><amll:meta key="album" value="深爱"/><amll:meta key="isrc" value="JPY392503583"/><amll:meta key="ncmMusicId" value="3383669235"/><amll:meta key="qqMusicId" value="001KHopB0deGeb"/><amll:meta key="qqMusicId" value="667146772"/><amll:meta key="spotifyId" value="1NfyXHF9LBicXXYnNBH2oB"/><amll:meta key="appleMusicId" value="6764277995"/><amll:meta key="ttmlAuthorGithub" value="174598250"/><amll:meta key="ttmlAuthorGithubLogin" value="ASyunagi"/></metadata></head><body dur="2:43.450"><div begin="0.850" end="2:43.450"><p begin="0.850" end="4.010" itunes:key="L1" ttm:agent="v1"><span begin="0.850" end="1.160">Run</span> <span begin="1.160" end="1.550">of</span> <span begin="1.550" end="1.730">the</span> <span begin="1.730" end="2.030">mi</span><span begin="2.030" end="2.330">ll</span> <span begin="3.390" end="3.720">ah</span> <span begin="3.720" end="4.010">ah</span><span ttm:role="x-translation" xml:lang="zh-Hans">平凡无奇 啊 啊</span><span ttm:role="x-translation" xml:lang="zh-Hant">平凡無奇 啊 啊</span><span ttm:role="x-translation" xml:lang="ja">ありふれた日々 ああ ああ</span><span ttm:role="x-translation" xml:lang="ko">그저 평범해 아 아</span><span ttm:role="x-translation" xml:lang="fr">Rien d&apos;extraordinaire ah ah</span><span ttm:role="x-translation" xml:lang="es">Cosas de cada día ah ah</span><span ttm:role="x-translation" xml:lang="de">Ganz gewöhnlich ah ah</span><span ttm:role="x-translation" xml:lang="pt">Coisas tão comuns ah ah</span><span ttm:role="x-translation" xml:lang="ru">Всё так обычно а а</span><span ttm:role="x-translation" xml:lang="ar">أشياء عادية آه آه</span><span ttm:role="x-translation" xml:lang="it">Cose di tutti i giorni ah ah</span></p><p begin="5.390" end="6.950" itunes:key="L2" ttm:agent="v1"><span begin="5.390" end="5.700">But</span> <span begin="5.700" end="5.970">I</span> <span begin="5.970" end="6.230">love</span> <span begin="6.230" end="6.550">those</span> <span begin="6.550" end="6.850">thing</span><span begin="6.850" end="6.950">s</span><span ttm:role="x-translation" xml:lang="zh-Hans">可我深爱着这一切</span><span ttm:role="x-translation" xml:lang="zh-Hant">可我深愛著這一切</span><span ttm:role="x-translation" xml:lang="ja">でも そんな日々が愛おしい</span><span ttm:role="x-translation" xml:lang="ko">그래도 난 그런 것들을 사랑해</span><span ttm:role="x-translation" xml:lang="fr">Mais j&apos;aime tout cela</span><span ttm:role="x-translation" xml:lang="es">Pero amo esas cosas</span><span ttm:role="x-translation" xml:lang="de">Doch ich liebe all das</span><span ttm:role="x-translation" xml:lang="pt">Mas eu amo tudo isso</span><span ttm:role="x-translation" xml:lang="ru">Но я так люблю всё это</span><span ttm:role="x-translation" xml:lang="ar">لكنني أحب تلك الأشياء</span><span ttm:role="x-translation" xml:lang="it">Ma io amo queste cose</span></p><p begin="7.900" end="9.600" itunes:key="L3" ttm:agent="v1"><span begin="7.900" end="8.410">For</span><span begin="8.780" end="9.290">e</span><span begin="9.370" end="9.600">ver</span><span ttm:role="x-translation" xml:lang="zh-Hans">直到永远</span><span ttm:role="x-translation" xml:lang="zh-Hant">直到永遠</span><span ttm:role="x-translation" xml:lang="ja">いつまでも</span><span ttm:role="x-translation" xml:lang="ko">영원히</span><span ttm:role="x-translation" xml:lang="fr">Pour toujours</span><span ttm:role="x-translation" xml:lang="es">Para siempre</span><span ttm:role="x-translation" xml:lang="de">Für immer</span><span ttm:role="x-translation" xml:lang="pt">Para sempre</span><span ttm:role="x-translation" xml:lang="ru">Навсегда</span><span ttm:role="x-translation" xml:lang="ar">إلى الأبد</span><span ttm:role="x-translation" xml:lang="it">Per sempre</span></p><p begin="9.910" end="13.020" itunes:key="L4" ttm:agent="v1"><span begin="9.910" end="10.210">Run</span> <span begin="10.210" end="10.590">of</span> <span begin="10.590" end="10.790">the</span> <span begin="10.790" end="11.060">mi</span><span begin="11.060" end="11.320">ll</span> <span begin="12.430" end="12.780">ah</span> <span begin="12.780" end="13.020">ah</span><span ttm:role="x-translation" xml:lang="zh-Hans">平凡无奇 啊 啊</span><span ttm:role="x-translation" xml:lang="zh-Hant">平凡無奇 啊 啊</span><span ttm:role="x-translation" xml:lang="ja">ありふれた日々 ああ ああ</span><span ttm:role="x-translation" xml:lang="ko">그저 평범해 아 아</span><span ttm:role="x-translation" xml:lang="fr">Rien d&apos;extraordinaire ah ah</span><span ttm:role="x-translation" xml:lang="es">Cosas de cada día ah ah</span><span ttm:role="x-translation" xml:lang="de">Ganz gewöhnlich ah ah</span><span ttm:role="x-translation" xml:lang="pt">Coisas tão comuns ah ah</span><span ttm:role="x-translation" xml:lang="ru">Всё так обычно а а</span><span ttm:role="x-translation" xml:lang="ar">أشياء عادية آه آه</span><span ttm:role="x-translation" xml:lang="it">Cose di tutti i giorni ah ah</span></p><p begin="14.430" end="15.980" itunes:key="L5" ttm:agent="v1"><span begin="14.430" end="14.750">But</span> <span begin="14.750" end="15.030">I</span> <span begin="15.030" end="15.310">love</span> <span begin="15.310" end="15.580">those</span> <span begin="15.580" end="15.900">thing</span><span begin="15.900" end="15.980">s</span><span ttm:role="x-translation" xml:lang="zh-Hans">可我深爱着这一切</span><span ttm:role="x-translation" xml:lang="zh-Hant">可我深愛著這一切</span><span ttm:role="x-translation" xml:lang="ja">でも そんな日々が愛おしい</span><span ttm:role="x-translation" xml:lang="ko">그래도 난 그런 것들을 사랑해</span><span ttm:role="x-translation" xml:lang="fr">Mais j&apos;aime tout cela</span><span ttm:role="x-translation" xml:lang="es">Pero amo esas cosas</span><span ttm:role="x-translation" xml:lang="de">Doch ich liebe all das</span><span ttm:role="x-translation" xml:lang="pt">Mas eu amo tudo isso</span><span ttm:role="x-translation" xml:lang="ru">Но я так люблю всё это</span><span ttm:role="x-translation" xml:lang="ar">لكنني أحب تلك الأشياء</span><span ttm:role="x-translation" xml:lang="it">Ma io amo queste cose</span></p><p begin="18.650" end="22.520" itunes:key="L6" ttm:agent="v1"><span begin="18.650" end="19.270">夢</span><span begin="19.270" end="19.500">も</span><span begin="19.800" end="20.390">叶</span><span begin="20.390" end="20.610">う</span><span begin="20.930" end="21.260">こ</span><span begin="21.260" end="21.540">の</span><span begin="21.540" end="21.700">場</span><span begin="21.790" end="22.120">所</span><span begin="22.120" end="22.520">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">在这梦想也能成真的地方</span><span ttm:role="x-translation" xml:lang="zh-Hant">在這夢想也能成真的地方</span><span ttm:role="x-translation" xml:lang="en">Here in this place where even dreams come true</span><span ttm:role="x-translation" xml:lang="ko">꿈도 이루어지는 이곳에서</span><span ttm:role="x-translation" xml:lang="fr">Ici où même les rêves se réalisent</span><span ttm:role="x-translation" xml:lang="es">Aquí donde hasta los sueños se cumplen</span><span ttm:role="x-translation" xml:lang="de">Hier wo selbst Träume wahr werden</span><span ttm:role="x-translation" xml:lang="pt">Neste lugar onde os sonhos também se realizam</span><span ttm:role="x-translation" xml:lang="ru">Здесь где даже мечты сбываются</span><span ttm:role="x-translation" xml:lang="ar">هنا حيث تتحقق حتى الأحلام</span><span ttm:role="x-translation" xml:lang="it">Qui dove anche i sogni si avverano</span><span ttm:role="x-roman">Yume mo kanau kono basho de</span></p><p begin="23.200" end="27.000" itunes:key="L7" ttm:agent="v1"><span begin="23.200" end="23.530">で</span><span begin="23.530" end="23.780">も</span><span begin="23.780" end="23.990">ね</span> <span begin="24.330" end="24.540">だ</span><span begin="24.620" end="24.920">け</span><span begin="24.920" end="25.140">ど</span> <span begin="25.480" end="25.740">わ</span><span begin="25.740" end="26.060">か</span><span begin="26.060" end="26.230">ら</span><span begin="26.330" end="26.630">な</span><span begin="26.630" end="27.000">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">可是啊 可是 我还是不懂</span><span ttm:role="x-translation" xml:lang="zh-Hant">可是啊 可是 我還是不懂</span><span ttm:role="x-translation" xml:lang="en">But even so I still do not understand</span><span ttm:role="x-translation" xml:lang="ko">그런데 말이야 그래도 모르겠어</span><span ttm:role="x-translation" xml:lang="fr">Mais tu sais je ne comprends pas</span><span ttm:role="x-translation" xml:lang="es">Pero aun así no lo entiendo</span><span ttm:role="x-translation" xml:lang="de">Aber weißt du ich verstehe es nicht</span><span ttm:role="x-translation" xml:lang="pt">Mas sabe ainda assim não entendo</span><span ttm:role="x-translation" xml:lang="ru">Но знаешь всё же я не понимаю</span><span ttm:role="x-translation" xml:lang="ar">لكنني مع ذلك لا أفهم</span><span ttm:role="x-translation" xml:lang="it">Eppure sai non capisco</span><span ttm:role="x-roman">Demo ne dakedo wakaranai</span></p><p begin="27.690" end="31.340" itunes:key="L8" ttm:agent="v1"><span begin="27.690" end="28.040">画</span><span begin="28.040" end="28.570">面</span><span begin="28.870" end="29.150">の</span><span begin="29.150" end="29.670">中</span><span begin="29.970" end="30.530">探</span><span begin="30.530" end="30.720">し</span><span begin="30.830" end="31.010">て</span><span begin="31.130" end="31.340">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">就算在屏幕中寻找</span><span ttm:role="x-translation" xml:lang="zh-Hant">就算在屏幕中尋找</span><span ttm:role="x-translation" xml:lang="en">Even when I search for answers on the screen</span><span ttm:role="x-translation" xml:lang="ko">화면 속을 찾아봐도</span><span ttm:role="x-translation" xml:lang="fr">J&apos;ai beau chercher sur l&apos;écran</span><span ttm:role="x-translation" xml:lang="es">Por más que busque en la pantalla</span><span ttm:role="x-translation" xml:lang="de">Auch wenn ich auf dem Bildschirm danach suche</span><span ttm:role="x-translation" xml:lang="pt">Mesmo procurando na tela</span><span ttm:role="x-translation" xml:lang="ru">Сколько ни ищу на экране</span><span ttm:role="x-translation" xml:lang="ar">مهما بحثت عبر الشاشة</span><span ttm:role="x-translation" xml:lang="it">Anche se cerco sullo schermo</span><span ttm:role="x-roman">Gamen no naka sagashite mo</span></p><p begin="31.680" end="35.790" itunes:key="L9" ttm:agent="v1"><span begin="31.680" end="31.840">わ</span><span begin="31.990" end="32.810">か</span><span begin="32.810" end="33.260">ら</span><span begin="33.420" end="33.750">な</span><span begin="33.750" end="33.960">い</span><span begin="33.960" end="34.280">の</span><span begin="34.280" end="35.620">で</span><span begin="35.620" end="35.790">す</span><span ttm:role="x-translation" xml:lang="zh-Hans">也依然不明白</span><span ttm:role="x-translation" xml:lang="zh-Hant">也依然不明白</span><span ttm:role="x-translation" xml:lang="en">I still do not understand</span><span ttm:role="x-translation" xml:lang="ko">알 수가 없어요</span><span ttm:role="x-translation" xml:lang="fr">Je ne comprends toujours pas</span><span ttm:role="x-translation" xml:lang="es">No logro entenderlo</span><span ttm:role="x-translation" xml:lang="de">Verstehe ich es einfach nicht</span><span ttm:role="x-translation" xml:lang="pt">Continuo sem entender</span><span ttm:role="x-translation" xml:lang="ru">Мне всё равно не понять</span><span ttm:role="x-translation" xml:lang="ar">ما زلت لا أفهم</span><span ttm:role="x-translation" xml:lang="it">Non riesco a capire</span><span ttm:role="x-roman">Wakaranai no desu</span></p><p begin="36.480" end="44.680" itunes:key="L10" ttm:agent="v1"><span begin="36.480" end="37.260">寂</span><span begin="37.340" end="37.650">し</span><span begin="37.650" end="37.900">い</span><span begin="38.250" end="38.490">な</span><span begin="38.490" end="38.700">ん</span><span begin="38.790" end="38.950">て</span><span begin="39.040" end="39.330">気</span><span begin="39.330" end="39.510">持</span><span begin="39.610" end="39.920">ち</span><span begin="39.920" end="40.240">は</span><span begin="40.510" end="41.040">知</span><span begin="41.040" end="41.220">ら</span><span begin="41.330" end="41.760">な</span><span begin="41.870" end="42.200">か</span><span begin="42.200" end="42.730">っ</span><span begin="42.730" end="43.060">た</span><span begin="43.060" end="44.680">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">曾经的我还不懂 寂寞是什么滋味</span><span ttm:role="x-translation" xml:lang="zh-Hant">曾經的我還不懂 寂寞是什麼滋味</span><span ttm:role="x-translation" xml:lang="en">I never knew what loneliness felt like</span><span ttm:role="x-translation" xml:lang="ko">외로움이란 감정은 몰랐어</span><span ttm:role="x-translation" xml:lang="fr">Je ne connaissais pas ce sentiment de solitude</span><span ttm:role="x-translation" xml:lang="es">No sabía lo que era sentir soledad</span><span ttm:role="x-translation" xml:lang="de">Ich wusste nicht wie sich Einsamkeit anfühlt</span><span ttm:role="x-translation" xml:lang="pt">Eu não sabia o que era sentir solidão</span><span ttm:role="x-translation" xml:lang="ru">Мне было незнакомо чувство одиночества</span><span ttm:role="x-translation" xml:lang="ar">لم أكن أعرف شعورًا اسمه الوحدة</span><span ttm:role="x-translation" xml:lang="it">Non sapevo cosa fosse la solitudine</span><span ttm:role="x-roman">Sabishii nante kimochi wa shiranakatta yo</span></p><p begin="45.570" end="53.720" itunes:key="L11" ttm:agent="v1"><span begin="45.570" end="46.400">嬉</span><span begin="46.400" end="46.730">し</span><span begin="46.730" end="46.980">い</span><span begin="47.270" end="47.530">な</span><span begin="47.530" end="47.820">ん</span><span begin="47.820" end="48.090">て</span><span begin="48.090" end="48.400">気</span><span begin="48.400" end="48.660">持</span><span begin="48.660" end="48.960">ち</span><span begin="48.960" end="49.180">も</span><span begin="49.550" end="50.110">知</span><span begin="50.110" end="50.260">り</span><span begin="50.380" end="50.800">ま</span><span begin="50.890" end="51.240">せ</span><span begin="51.240" end="51.780">ん</span><span begin="51.780" end="52.050">で</span><span begin="52.050" end="52.270">し</span><span begin="52.370" end="53.720">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">也不曾懂得 喜悦是什么滋味</span><span ttm:role="x-translation" xml:lang="zh-Hant">也不曾懂得 喜悅是什麼滋味</span><span ttm:role="x-translation" xml:lang="en">And I never knew what happiness felt like either</span><span ttm:role="x-translation" xml:lang="ko">기쁨이란 감정도 몰랐어요</span><span ttm:role="x-translation" xml:lang="fr">Je ne connaissais pas non plus ce sentiment de joie</span><span ttm:role="x-translation" xml:lang="es">Tampoco sabía lo que era sentir alegría</span><span ttm:role="x-translation" xml:lang="de">Und auch nicht wie sich Freude anfühlt</span><span ttm:role="x-translation" xml:lang="pt">Nem sabia o que era sentir alegria</span><span ttm:role="x-translation" xml:lang="ru">И чувство радости мне тоже было незнакомо</span><span ttm:role="x-translation" xml:lang="ar">ولم أكن أعرف شعورًا اسمه الفرح أيضًا</span><span ttm:role="x-translation" xml:lang="it">Non sapevo nemmeno cosa fosse la gioia</span><span ttm:role="x-roman">Ureshii nante kimochi mo shirimasen deshita</span></p><p begin="54.870" end="59.390" itunes:key="L12" ttm:agent="v1"><span begin="54.870" end="55.040">な</span><span begin="55.040" end="55.180">か</span><span begin="55.180" end="55.320">な</span><span begin="55.320" end="55.480">か</span><span begin="55.480" end="55.750">起</span><span begin="55.750" end="55.920">き</span><span begin="55.920" end="56.200">れ</span><span begin="56.200" end="56.380">ず</span><span begin="56.380" end="56.870">に</span><span begin="57.170" end="57.330">寝</span><span begin="57.330" end="57.610">坊</span><span begin="57.610" end="57.740">で</span><span begin="57.740" end="58.110">慌</span><span begin="58.190" end="58.590">て</span><span begin="58.590" end="58.860">た</span><span begin="58.860" end="59.390">朝</span><span ttm:role="x-translation" xml:lang="zh-Hans">迟迟起不了床 睡过头后慌慌张张的早晨</span><span ttm:role="x-translation" xml:lang="zh-Hant">遲遲起不了床 睡過頭後慌慌張張的早晨</span><span ttm:role="x-translation" xml:lang="en">A frantic morning after struggling to wake and oversleeping</span><span ttm:role="x-translation" xml:lang="ko">좀처럼 못 일어나 늦잠에 허둥대던 아침</span><span ttm:role="x-translation" xml:lang="fr">Ce matin où je peinais à me lever et m&apos;affolais d&apos;avoir trop dormi</span><span ttm:role="x-translation" xml:lang="es">La mañana en que me costó levantarme y me apuré por dormir de más</span><span ttm:role="x-translation" xml:lang="de">Ein Morgen voller Hast weil ich nicht aus dem Bett kam und verschlief</span><span ttm:role="x-translation" xml:lang="pt">A manhã em que custei a acordar e me afobei por perder a hora</span><span ttm:role="x-translation" xml:lang="ru">Утро когда всё никак не встать а проспав приходится спешить</span><span ttm:role="x-translation" xml:lang="ar">صباح صعب عليّ فيه النهوض فأربكني الاستيقاظ متأخرًا</span><span ttm:role="x-translation" xml:lang="it">La mattina in cui faticavo ad alzarmi e poi correvo perché era tardi</span><span ttm:role="x-roman">Nakanaka okirezu ni nebou de awateta asa</span></p><p begin="59.720" end="1:03.650" itunes:key="L13" ttm:agent="v1"><span begin="59.720" end="1:00.030">タ</span><span begin="1:00.030" end="1:00.260">オ</span><span begin="1:00.590" end="1:00.860">ル</span><span begin="1:00.860" end="1:01.100">が</span><span begin="1:01.410" end="1:01.960">乾</span><span begin="1:02.270" end="1:02.430">い</span><span begin="1:02.550" end="1:02.780">た</span><span begin="1:03.090" end="1:03.650">昼</span><span ttm:role="x-translation" xml:lang="zh-Hans">毛巾晾干的午间</span><span ttm:role="x-translation" xml:lang="zh-Hant">毛巾晾乾的午間</span><span ttm:role="x-translation" xml:lang="en">An afternoon when the towels dried</span><span ttm:role="x-translation" xml:lang="ko">수건이 마른 한낮</span><span ttm:role="x-translation" xml:lang="fr">Ce midi où les serviettes ont séché</span><span ttm:role="x-translation" xml:lang="es">El mediodía en que se secó la toalla</span><span ttm:role="x-translation" xml:lang="de">Ein Mittag an dem das Handtuch trocken war</span><span ttm:role="x-translation" xml:lang="pt">O meio-dia em que a toalha secou</span><span ttm:role="x-translation" xml:lang="ru">Полдень когда высохло полотенце</span><span ttm:role="x-translation" xml:lang="ar">ظهيرة جفت فيها المنشفة</span><span ttm:role="x-translation" xml:lang="it">A mezzogiorno gli asciugamani ormai asciutti</span><span ttm:role="x-roman">Taoru ga kawaita hiru</span></p><p begin="1:03.950" end="1:08.490" itunes:key="L14" ttm:agent="v1"><span begin="1:03.950" end="1:04.100">あ</span><span begin="1:04.100" end="1:04.240">な</span><span begin="1:04.240" end="1:04.400">た</span><span begin="1:04.400" end="1:04.540">に</span><span begin="1:04.540" end="1:04.570">「</span><span begin="1:04.570" end="1:04.810">お</span><span begin="1:04.810" end="1:04.980">か</span><span begin="1:04.980" end="1:05.240">え</span><span begin="1:05.240" end="1:05.320">り</span><span begin="1:05.320" end="1:05.350">」</span><span begin="1:05.400" end="1:05.850">と</span><span begin="1:06.240" end="1:06.380">言</span><span begin="1:06.380" end="1:06.530">う</span><span begin="1:06.530" end="1:06.640">の</span><span begin="1:06.640" end="1:06.810">を</span><span begin="1:06.810" end="1:07.060">待</span><span begin="1:07.060" end="1:07.230">つ</span><span begin="1:07.230" end="1:07.950">夕</span><span begin="1:07.950" end="1:08.490">方</span><span ttm:role="x-translation" xml:lang="zh-Hans">等着对你说「欢迎回家」的傍晚</span><span ttm:role="x-translation" xml:lang="zh-Hant">等著對你說「歡迎回家」的傍晚</span><span ttm:role="x-translation" xml:lang="en">An evening spent waiting to say &quot;Welcome home&quot; to you</span><span ttm:role="x-translation" xml:lang="ko">네게 “어서 와” 하고 말할 순간을 기다리는 저녁</span><span ttm:role="x-translation" xml:lang="fr">Ce soir où j&apos;attends de te dire « Te voilà de retour »</span><span ttm:role="x-translation" xml:lang="es">La tarde en que espero para decirte «Bienvenido a casa»</span><span ttm:role="x-translation" xml:lang="de">Ein Abend an dem ich darauf warte dir „Willkommen zu Hause“ zu sagen</span><span ttm:role="x-translation" xml:lang="pt">O entardecer à espera de te dizer «Que bom ter você de volta»</span><span ttm:role="x-translation" xml:lang="ru">Вечер когда жду чтобы сказать тебе «С возвращением»</span><span ttm:role="x-translation" xml:lang="ar">مساء أنتظر فيه أن أقول لك «أهلًا بعودتك»</span><span ttm:role="x-translation" xml:lang="it">La sera mentre aspetto di dirti «Bentornato»</span><span ttm:role="x-roman">Anata ni &quot;okaeri&quot; to iu no o matsu yuugata</span></p><p begin="1:08.760" end="1:11.020" itunes:key="L15" ttm:agent="v1"><span begin="1:08.760" end="1:09.350">星</span><span begin="1:09.350" end="1:09.540">の</span><span begin="1:09.640" end="1:09.920">な</span><span begin="1:09.920" end="1:10.230">い</span><span begin="1:10.230" end="1:11.020">夜</span><span ttm:role="x-translation" xml:lang="zh-Hans">没有星星的夜晚</span><span ttm:role="x-translation" xml:lang="zh-Hant">沒有星星的夜晚</span><span ttm:role="x-translation" xml:lang="en">A starless night</span><span ttm:role="x-translation" xml:lang="ko">별 하나 없는 밤</span><span ttm:role="x-translation" xml:lang="fr">Cette nuit sans étoiles</span><span ttm:role="x-translation" xml:lang="es">La noche sin estrellas</span><span ttm:role="x-translation" xml:lang="de">Eine Nacht ohne Sterne</span><span ttm:role="x-translation" xml:lang="pt">A noite sem estrelas</span><span ttm:role="x-translation" xml:lang="ru">Ночь без звёзд</span><span ttm:role="x-translation" xml:lang="ar">ليلة بلا نجوم</span><span ttm:role="x-translation" xml:lang="it">Una notte senza stelle</span><span ttm:role="x-roman">Hoshi no nai yoru</span></p><p begin="1:11.590" end="1:20.230" itunes:key="L16" ttm:agent="v1"><span begin="1:11.590" end="1:11.770">ど</span><span begin="1:11.860" end="1:12.340">こ</span><span begin="1:12.340" end="1:12.730">に</span><span begin="1:12.730" end="1:13.000">も</span><span begin="1:13.000" end="1:14.290">無</span><span begin="1:14.290" end="1:14.420">い</span><span begin="1:14.420" end="1:14.730">ふ</span><span begin="1:14.730" end="1:15.030">つ</span><span begin="1:15.030" end="1:15.790">う</span> <span begin="1:16.390" end="1:16.840">そ</span><span begin="1:16.840" end="1:17.240">れ</span><span begin="1:17.240" end="1:17.450">が</span><span begin="1:17.540" end="1:18.010">素</span><span begin="1:18.110" end="1:18.970">敵</span><span begin="1:18.970" end="1:19.240">な</span><span begin="1:19.240" end="1:19.540">の</span><span begin="1:19.540" end="1:20.230">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">只因这份独一无二的平凡 如此美好</span><span ttm:role="x-translation" xml:lang="zh-Hant">只因這份獨一無二的平凡 如此美好</span><span ttm:role="x-translation" xml:lang="en">Because this ordinary life like no other is so beautiful</span><span ttm:role="x-translation" xml:lang="ko">어디에도 없는 평범함 그게 참 근사해서</span><span ttm:role="x-translation" xml:lang="fr">Parce que cet ordinaire sans pareil est si beau</span><span ttm:role="x-translation" xml:lang="es">Porque lo cotidiano que solo existe aquí es tan hermoso</span><span ttm:role="x-translation" xml:lang="de">Weil dieser Alltag den es sonst nirgendwo gibt so wunderschön ist</span><span ttm:role="x-translation" xml:lang="pt">Porque é tão lindo esse cotidiano que não existe em nenhum outro lugar</span><span ttm:role="x-translation" xml:lang="ru">Ведь так прекрасна эта простая жизнь которой больше нигде не найти</span><span ttm:role="x-translation" xml:lang="ar">لأن هذه الحياة العادية التي لا مثيل لها جميلة</span><span ttm:role="x-translation" xml:lang="it">Perché è così bella questa normalità che non esiste altrove</span><span ttm:role="x-roman">Doko ni mo nai futsuu sore ga suteki na node</span></p><p begin="1:20.680" end="1:30.420" itunes:key="L17" ttm:agent="v1"><span begin="1:20.680" end="1:20.800">い</span><span begin="1:20.800" end="1:20.960">つ</span><span begin="1:20.960" end="1:21.380">ま</span><span begin="1:21.380" end="1:21.810">で</span><span begin="1:21.810" end="1:22.090">も</span><span begin="1:22.090" end="1:23.400">あ</span><span begin="1:23.490" end="1:23.780">な</span><span begin="1:23.780" end="1:24.090">た</span><span begin="1:24.090" end="1:24.840">と</span><span begin="1:25.470" end="1:25.770">ず</span><span begin="1:25.770" end="1:25.910">っ</span><span begin="1:25.910" end="1:26.290">と</span><span begin="1:26.290" end="1:26.610">あ</span><span begin="1:26.610" end="1:27.060">り</span><span begin="1:27.150" end="1:27.460">ふ</span><span begin="1:27.460" end="1:27.910">れ</span><span begin="1:28.020" end="1:28.250">て</span><span begin="1:28.600" end="1:29.260">た</span><span begin="1:29.260" end="1:30.420">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">愿与你相伴 永远这样平凡下去</span><span ttm:role="x-translation" xml:lang="zh-Hant">願與你相伴 永遠這樣平凡下去</span><span ttm:role="x-translation" xml:lang="en">I want to share this ordinary life with you forever</span><span ttm:role="x-translation" xml:lang="ko">언제까지나 너와 함께 평범하게 살아가고 싶어</span><span ttm:role="x-translation" xml:lang="fr">Je veux vivre avec toi des jours ordinaires pour toujours</span><span ttm:role="x-translation" xml:lang="es">Quiero vivir lo cotidiano contigo para siempre</span><span ttm:role="x-translation" xml:lang="de">Möchte ich für immer mit dir ganz gewöhnlich leben</span><span ttm:role="x-translation" xml:lang="pt">Quero viver dias comuns ao seu lado para sempre</span><span ttm:role="x-translation" xml:lang="ru">Хочу всегда жить с тобой самой обычной жизнью</span><span ttm:role="x-translation" xml:lang="ar">أريد أن أعيش معك حياة عادية إلى الأبد</span><span ttm:role="x-translation" xml:lang="it">Vorrei vivere una vita normale con te per sempre</span><span ttm:role="x-roman">Itsumademo anata to zutto arifuretetai</span></p><p begin="1:31.120" end="1:34.900" itunes:key="L18" ttm:agent="v1"><span begin="1:31.120" end="1:31.320">い</span><span begin="1:31.400" end="1:31.710">つ</span><span begin="1:31.710" end="1:31.930">も</span><span begin="1:32.260" end="1:33.050">隣</span><span begin="1:33.370" end="1:33.660">に</span><span begin="1:33.660" end="1:33.960">い</span><span begin="1:33.960" end="1:34.270">る</span><span begin="1:34.270" end="1:34.560">の</span><span begin="1:34.560" end="1:34.900">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明一直都在身旁</span><span ttm:role="x-translation" xml:lang="zh-Hant">明明一直都在身旁</span><span ttm:role="x-translation" xml:lang="en">Though we are always side by side</span><span ttm:role="x-translation" xml:lang="ko">늘 곁에 있는데도</span><span ttm:role="x-translation" xml:lang="fr">Même si tu es toujours à mes côtés</span><span ttm:role="x-translation" xml:lang="es">Aunque siempre estés a mi lado</span><span ttm:role="x-translation" xml:lang="de">Du bist doch immer an meiner Seite</span><span ttm:role="x-translation" xml:lang="pt">Mesmo estando sempre ao seu lado</span><span ttm:role="x-translation" xml:lang="ru">Хоть мы всегда рядом</span><span ttm:role="x-translation" xml:lang="ar">رغم أننا دائمًا جنبًا إلى جنب</span><span ttm:role="x-translation" xml:lang="it">Anche se sei sempre qui accanto a me</span><span ttm:role="x-roman">Itsumo tonari ni iru no ni</span></p><p begin="1:35.640" end="1:39.420" itunes:key="L19" ttm:agent="v1"><span begin="1:35.640" end="1:35.880">で</span><span begin="1:35.970" end="1:36.240">も</span><span begin="1:36.240" end="1:36.450">ね</span> <span begin="1:36.790" end="1:37.080">だ</span><span begin="1:37.080" end="1:37.370">け</span><span begin="1:37.370" end="1:37.650">ど</span> <span begin="1:37.910" end="1:38.130">わ</span><span begin="1:38.210" end="1:38.500">か</span><span begin="1:38.500" end="1:38.680">ら</span><span begin="1:38.780" end="1:39.090">な</span><span begin="1:39.090" end="1:39.420">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">可是啊 可是 我还是不懂</span><span ttm:role="x-translation" xml:lang="zh-Hant">可是啊 可是 我還是不懂</span><span ttm:role="x-translation" xml:lang="en">But even so I still do not understand</span><span ttm:role="x-translation" xml:lang="ko">그런데 말이야 그래도 모르겠어</span><span ttm:role="x-translation" xml:lang="fr">Mais tu sais je ne comprends pas</span><span ttm:role="x-translation" xml:lang="es">Pero aun así no lo entiendo</span><span ttm:role="x-translation" xml:lang="de">Aber weißt du ich verstehe es nicht</span><span ttm:role="x-translation" xml:lang="pt">Mas sabe ainda assim não entendo</span><span ttm:role="x-translation" xml:lang="ru">Но знаешь всё же я не понимаю</span><span ttm:role="x-translation" xml:lang="ar">لكنني مع ذلك لا أفهم</span><span ttm:role="x-translation" xml:lang="it">Eppure sai non capisco</span><span ttm:role="x-roman">Demo ne dakedo wakaranai</span></p><p begin="1:40.170" end="1:43.850" itunes:key="L20" ttm:agent="v1"><span begin="1:40.170" end="1:40.450">い</span><span begin="1:40.450" end="1:40.750">く</span><span begin="1:40.750" end="1:41.000">ら</span><span begin="1:41.310" end="1:41.900">数</span><span begin="1:41.900" end="1:42.120">を</span><span begin="1:42.440" end="1:43.080">数</span><span begin="1:43.080" end="1:43.220">え</span><span begin="1:43.310" end="1:43.530">て</span><span begin="1:43.640" end="1:43.850">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">无论数过多少个数</span><span ttm:role="x-translation" xml:lang="zh-Hant">無論數過多少個數</span><span ttm:role="x-translation" xml:lang="en">No matter how many numbers I count</span><span ttm:role="x-translation" xml:lang="ko">아무리 수를 세어 봐도</span><span ttm:role="x-translation" xml:lang="fr">J&apos;ai beau compter et recompter</span><span ttm:role="x-translation" xml:lang="es">Por más números que cuente</span><span ttm:role="x-translation" xml:lang="de">Wie viele Zahlen ich auch zähle</span><span ttm:role="x-translation" xml:lang="pt">Por mais que eu conte os números</span><span ttm:role="x-translation" xml:lang="ru">Сколько ни считаю</span><span ttm:role="x-translation" xml:lang="ar">مهما واصلت عد الأرقام</span><span ttm:role="x-translation" xml:lang="it">Per quanto conti e riconti</span><span ttm:role="x-roman">Ikura kazu o kazoete mo</span></p><p begin="1:44.160" end="1:49.040" itunes:key="L21" ttm:agent="v1"><span begin="1:44.160" end="1:44.320">わ</span><span begin="1:44.430" end="1:45.280">か</span><span begin="1:45.280" end="1:45.780">ら</span><span begin="1:45.870" end="1:46.260">な</span><span begin="1:46.260" end="1:46.420">い</span><span begin="1:46.420" end="1:46.660">の</span><span begin="1:46.740" end="1:48.840">で</span><span begin="1:48.840" end="1:49.040">す</span><span ttm:role="x-translation" xml:lang="zh-Hans">也依然不明白</span><span ttm:role="x-translation" xml:lang="zh-Hant">也依然不明白</span><span ttm:role="x-translation" xml:lang="en">I still do not understand</span><span ttm:role="x-translation" xml:lang="ko">알 수가 없어요</span><span ttm:role="x-translation" xml:lang="fr">Je ne comprends toujours pas</span><span ttm:role="x-translation" xml:lang="es">No logro entenderlo</span><span ttm:role="x-translation" xml:lang="de">Verstehe ich es einfach nicht</span><span ttm:role="x-translation" xml:lang="pt">Continuo sem entender</span><span ttm:role="x-translation" xml:lang="ru">Мне всё равно не понять</span><span ttm:role="x-translation" xml:lang="ar">ما زلت لا أفهم</span><span ttm:role="x-translation" xml:lang="it">Non riesco a capire</span><span ttm:role="x-roman">Wakaranai no desu</span></p><p begin="1:49.530" end="1:52.820" itunes:key="L22" ttm:agent="v1"><span begin="1:49.530" end="1:49.860">Run</span> <span begin="1:49.860" end="1:50.230">of</span> <span begin="1:50.230" end="1:50.340">the</span> <span begin="1:50.420" end="1:50.690">mi</span><span begin="1:50.690" end="1:50.960">ll</span> <span begin="1:52.070" end="1:52.310">ah</span> <span begin="1:52.390" end="1:52.820">ah</span><span ttm:role="x-translation" xml:lang="zh-Hans">平凡无奇 啊 啊</span><span ttm:role="x-translation" xml:lang="zh-Hant">平凡無奇 啊 啊</span><span ttm:role="x-translation" xml:lang="ja">ありふれた日々 ああ ああ</span><span ttm:role="x-translation" xml:lang="ko">그저 평범해 아 아</span><span ttm:role="x-translation" xml:lang="fr">Rien d&apos;extraordinaire ah ah</span><span ttm:role="x-translation" xml:lang="es">Cosas de cada día ah ah</span><span ttm:role="x-translation" xml:lang="de">Ganz gewöhnlich ah ah</span><span ttm:role="x-translation" xml:lang="pt">Coisas tão comuns ah ah</span><span ttm:role="x-translation" xml:lang="ru">Всё так обычно а а</span><span ttm:role="x-translation" xml:lang="ar">أشياء عادية آه آه</span><span ttm:role="x-translation" xml:lang="it">Cose di tutti i giorni ah ah</span></p><p begin="1:54.070" end="1:55.650" itunes:key="L23" ttm:agent="v1"><span begin="1:54.070" end="1:54.400">But</span> <span begin="1:54.400" end="1:54.660">I</span> <span begin="1:54.660" end="1:54.910">love</span> <span begin="1:54.910" end="1:55.230">those</span> <span begin="1:55.230" end="1:55.520">thing</span><span begin="1:55.520" end="1:55.650">s</span><span ttm:role="x-translation" xml:lang="zh-Hans">可我深爱着这一切</span><span ttm:role="x-translation" xml:lang="zh-Hant">可我深愛著這一切</span><span ttm:role="x-translation" xml:lang="ja">でも そんな日々が愛おしい</span><span ttm:role="x-translation" xml:lang="ko">그래도 난 그런 것들을 사랑해</span><span ttm:role="x-translation" xml:lang="fr">Mais j&apos;aime tout cela</span><span ttm:role="x-translation" xml:lang="es">Pero amo esas cosas</span><span ttm:role="x-translation" xml:lang="de">Doch ich liebe all das</span><span ttm:role="x-translation" xml:lang="pt">Mas eu amo tudo isso</span><span ttm:role="x-translation" xml:lang="ru">Но я так люблю всё это</span><span ttm:role="x-translation" xml:lang="ar">لكنني أحب تلك الأشياء</span><span ttm:role="x-translation" xml:lang="it">Ma io amo queste cose</span></p><p begin="1:56.570" end="1:58.300" itunes:key="L24" ttm:agent="v1"><span begin="1:56.570" end="1:57.040">For</span><span begin="1:57.450" end="1:58.020">e</span><span begin="1:58.020" end="1:58.300">ver</span><span ttm:role="x-translation" xml:lang="zh-Hans">直到永远</span><span ttm:role="x-translation" xml:lang="zh-Hant">直到永遠</span><span ttm:role="x-translation" xml:lang="ja">いつまでも</span><span ttm:role="x-translation" xml:lang="ko">영원히</span><span ttm:role="x-translation" xml:lang="fr">Pour toujours</span><span ttm:role="x-translation" xml:lang="es">Para siempre</span><span ttm:role="x-translation" xml:lang="de">Für immer</span><span ttm:role="x-translation" xml:lang="pt">Para sempre</span><span ttm:role="x-translation" xml:lang="ru">Навсегда</span><span ttm:role="x-translation" xml:lang="ar">إلى الأبد</span><span ttm:role="x-translation" xml:lang="it">Per sempre</span></p><p begin="1:58.610" end="2:01.890" itunes:key="L25" ttm:agent="v1"><span begin="1:58.610" end="1:58.920">Run</span> <span begin="1:58.920" end="1:59.280">of</span> <span begin="1:59.280" end="1:59.470">the</span> <span begin="1:59.470" end="1:59.760">mi</span><span begin="1:59.760" end="1:59.990">ll</span> <span begin="2:01.110" end="2:01.470">ah</span> <span begin="2:01.470" end="2:01.890">ah</span><span ttm:role="x-translation" xml:lang="zh-Hans">平凡无奇 啊 啊</span><span ttm:role="x-translation" xml:lang="zh-Hant">平凡無奇 啊 啊</span><span ttm:role="x-translation" xml:lang="ja">ありふれた日々 ああ ああ</span><span ttm:role="x-translation" xml:lang="ko">그저 평범해 아 아</span><span ttm:role="x-translation" xml:lang="fr">Rien d&apos;extraordinaire ah ah</span><span ttm:role="x-translation" xml:lang="es">Cosas de cada día ah ah</span><span ttm:role="x-translation" xml:lang="de">Ganz gewöhnlich ah ah</span><span ttm:role="x-translation" xml:lang="pt">Coisas tão comuns ah ah</span><span ttm:role="x-translation" xml:lang="ru">Всё так обычно а а</span><span ttm:role="x-translation" xml:lang="ar">أشياء عادية آه آه</span><span ttm:role="x-translation" xml:lang="it">Cose di tutti i giorni ah ah</span></p><p begin="2:03.120" end="2:04.660" itunes:key="L26" ttm:agent="v1"><span begin="2:03.120" end="2:03.440">But</span> <span begin="2:03.440" end="2:03.710">I</span> <span begin="2:03.710" end="2:03.960">love</span> <span begin="2:03.960" end="2:04.230">those</span> <span begin="2:04.230" end="2:04.580">thing</span><span begin="2:04.580" end="2:04.660">s</span><span ttm:role="x-translation" xml:lang="zh-Hans">可我深爱着这一切</span><span ttm:role="x-translation" xml:lang="zh-Hant">可我深愛著這一切</span><span ttm:role="x-translation" xml:lang="ja">でも そんな日々が愛おしい</span><span ttm:role="x-translation" xml:lang="ko">그래도 난 그런 것들을 사랑해</span><span ttm:role="x-translation" xml:lang="fr">Mais j&apos;aime tout cela</span><span ttm:role="x-translation" xml:lang="es">Pero amo esas cosas</span><span ttm:role="x-translation" xml:lang="de">Doch ich liebe all das</span><span ttm:role="x-translation" xml:lang="pt">Mas eu amo tudo isso</span><span ttm:role="x-translation" xml:lang="ru">Но я так люблю всё это</span><span ttm:role="x-translation" xml:lang="ar">لكنني أحب تلك الأشياء</span><span ttm:role="x-translation" xml:lang="it">Ma io amo queste cose</span></p><p begin="2:05.080" end="2:14.630" itunes:key="L27" ttm:agent="v1"><span begin="2:05.080" end="2:05.320">あ</span><span begin="2:05.320" end="2:05.510">た</span><span begin="2:05.510" end="2:05.690">り</span><span begin="2:05.690" end="2:05.930">ま</span><span begin="2:05.930" end="2:06.090">え</span><span begin="2:06.090" end="2:06.220">に</span><span begin="2:06.220" end="2:06.630">続</span><span begin="2:06.630" end="2:06.780">き</span><span begin="2:06.780" end="2:07.210">そう</span><span begin="2:07.210" end="2:07.370">な</span><span begin="2:07.370" end="2:08.790">毎</span><span begin="2:08.790" end="2:09.380">日</span><span begin="2:09.380" end="2:10.240">が</span><span begin="2:10.760" end="2:11.080">と</span><span begin="2:11.180" end="2:11.600">て</span><span begin="2:11.600" end="2:11.790">も</span><span begin="2:11.890" end="2:12.360">素</span><span begin="2:12.440" end="2:13.300">敵</span><span begin="2:13.300" end="2:13.580">な</span><span begin="2:13.580" end="2:13.910">の</span><span begin="2:13.910" end="2:14.630">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">只因这些仿佛会自然而然延续的日子 如此美好</span><span ttm:role="x-translation" xml:lang="zh-Hant">只因這些彷彿會自然而然延續的日子 如此美好</span><span ttm:role="x-translation" xml:lang="en">Because these days that seem to carry on so naturally are so beautiful</span><span ttm:role="x-translation" xml:lang="ko">당연한 듯 이어질 것 같은 하루하루가 너무나 근사해서</span><span ttm:role="x-translation" xml:lang="fr">Parce que ce quotidien qui semble se poursuivre tout naturellement est si beau</span><span ttm:role="x-translation" xml:lang="es">Porque este día a día que parece seguir sin más es tan hermoso</span><span ttm:role="x-translation" xml:lang="de">Weil dieser Alltag der wie selbstverständlich weiterzugehen scheint so wunderschön ist</span><span ttm:role="x-translation" xml:lang="pt">Porque é tão lindo esse dia a dia que parece seguir tão naturalmente</span><span ttm:role="x-translation" xml:lang="ru">Ведь так прекрасны эти дни что будто и дальше будут идти своим чередом</span><span ttm:role="x-translation" xml:lang="ar">لأن هذه الأيام التي تبدو كأنها ستتوالى كالمعتاد جميلة جدًا</span><span ttm:role="x-translation" xml:lang="it">Perché sono così belli questi giorni che sembrano continuare come sempre</span><span ttm:role="x-roman">Atarimae ni tsuzukisou na mainichi ga totemo suteki na node</span></p><p begin="2:15.000" end="2:24.850" itunes:key="L28" ttm:agent="v1"><span begin="2:15.000" end="2:15.140">い</span><span begin="2:15.140" end="2:15.290">つ</span><span begin="2:15.290" end="2:15.700">ま</span><span begin="2:15.700" end="2:16.130">で</span><span begin="2:16.130" end="2:16.420">も</span><span begin="2:16.420" end="2:17.830">あ</span><span begin="2:17.830" end="2:18.100">な</span><span begin="2:18.100" end="2:18.400">た</span><span begin="2:18.400" end="2:19.200">と</span><span begin="2:19.790" end="2:20.090">ず</span><span begin="2:20.090" end="2:20.250">っ</span><span begin="2:20.250" end="2:20.630">と</span><span begin="2:20.630" end="2:20.920">あ</span><span begin="2:20.920" end="2:21.370">り</span><span begin="2:21.490" end="2:21.780">ふ</span><span begin="2:21.780" end="2:22.240">れ</span><span begin="2:22.360" end="2:22.620">て</span><span begin="2:22.930" end="2:23.600">た</span><span begin="2:23.600" end="2:24.850">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">愿与你相伴 永远这样平凡下去</span><span ttm:role="x-translation" xml:lang="zh-Hant">願與你相伴 永遠這樣平凡下去</span><span ttm:role="x-translation" xml:lang="en">I want to share this ordinary life with you forever</span><span ttm:role="x-translation" xml:lang="ko">언제까지나 너와 함께 평범하게 살아가고 싶어</span><span ttm:role="x-translation" xml:lang="fr">Je veux vivre avec toi des jours ordinaires pour toujours</span><span ttm:role="x-translation" xml:lang="es">Quiero vivir lo cotidiano contigo para siempre</span><span ttm:role="x-translation" xml:lang="de">Möchte ich für immer mit dir ganz gewöhnlich leben</span><span ttm:role="x-translation" xml:lang="pt">Quero viver dias comuns ao seu lado para sempre</span><span ttm:role="x-translation" xml:lang="ru">Хочу всегда жить с тобой самой обычной жизнью</span><span ttm:role="x-translation" xml:lang="ar">أريد أن أعيش معك حياة عادية إلى الأبد</span><span ttm:role="x-translation" xml:lang="it">Vorrei vivere una vita normale con te per sempre</span><span ttm:role="x-roman">Itsumademo anata to zutto arifuretetai</span></p><p begin="2:25.460" end="2:29.080" itunes:key="L29" ttm:agent="v1"><span begin="2:25.460" end="2:25.770">晴</span><span begin="2:25.770" end="2:26.030">れ</span><span begin="2:26.030" end="2:26.310">の</span><span begin="2:26.310" end="2:26.630">日</span><span begin="2:26.630" end="2:26.840">も</span><span begin="2:27.170" end="2:27.750">雨</span><span begin="2:27.750" end="2:28.040">降</span><span begin="2:28.040" end="2:28.290">り</span><span begin="2:28.290" end="2:28.570">の</span><span begin="2:28.570" end="2:28.900">日</span><span begin="2:28.900" end="2:29.080">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">无论晴朗的日子 还是下雨的日子</span><span ttm:role="x-translation" xml:lang="zh-Hant">無論晴朗的日子 還是下雨的日子</span><span ttm:role="x-translation" xml:lang="en">On sunny days and on rainy days</span><span ttm:role="x-translation" xml:lang="ko">맑은 날도 비 내리는 날도</span><span ttm:role="x-translation" xml:lang="fr">Les jours de soleil comme les jours de pluie</span><span ttm:role="x-translation" xml:lang="es">Los días de sol y los días de lluvia</span><span ttm:role="x-translation" xml:lang="de">An sonnigen Tagen und an Regentagen</span><span ttm:role="x-translation" xml:lang="pt">Nos dias de sol e nos dias de chuva</span><span ttm:role="x-translation" xml:lang="ru">И в солнечные дни и в дождливые</span><span ttm:role="x-translation" xml:lang="ar">في الأيام المشمسة وفي الأيام الماطرة</span><span ttm:role="x-translation" xml:lang="it">Nei giorni di sole e in quelli di pioggia</span><span ttm:role="x-roman">Hare no hi mo amefuri no hi mo</span></p><p begin="2:29.420" end="2:33.800" itunes:key="L30" ttm:agent="v1"><span begin="2:29.420" end="2:30.010">笑</span><span begin="2:30.010" end="2:30.310">い</span><span begin="2:30.310" end="2:30.560">合</span><span begin="2:30.560" end="2:30.850">う</span><span begin="2:30.850" end="2:31.150">日</span><span begin="2:31.150" end="2:31.340">も</span><span begin="2:31.720" end="2:32.260">憂</span><span begin="2:32.260" end="2:32.840">鬱</span><span begin="2:32.840" end="2:33.100">な</span><span begin="2:33.100" end="2:33.360">日</span><span begin="2:33.450" end="2:33.800">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">无论一同欢笑的日子 还是心情低落的日子</span><span ttm:role="x-translation" xml:lang="zh-Hant">無論一同歡笑的日子 還是心情低落的日子</span><span ttm:role="x-translation" xml:lang="en">On days we laugh together and days we feel blue</span><span ttm:role="x-translation" xml:lang="ko">함께 웃는 날도 울적한 날도</span><span ttm:role="x-translation" xml:lang="fr">Les jours où l&apos;on rit ensemble comme les jours de mélancolie</span><span ttm:role="x-translation" xml:lang="es">Los días de risas compartidas y los días de tristeza</span><span ttm:role="x-translation" xml:lang="de">An Tagen an denen wir zusammen lachen und an trüben Tagen</span><span ttm:role="x-translation" xml:lang="pt">Nos dias em que rimos juntos e nos dias de melancolia</span><span ttm:role="x-translation" xml:lang="ru">И в дни когда смеёмся вместе и в дни печали</span><span ttm:role="x-translation" xml:lang="ar">في الأيام التي نضحك فيها معًا وفي الأيام الكئيبة</span><span ttm:role="x-translation" xml:lang="it">Nei giorni in cui ridiamo insieme e in quelli malinconici</span><span ttm:role="x-roman">Waraiau hi mo yuuutsu na hi mo</span></p><p begin="2:34.510" end="2:38.130" itunes:key="L31" ttm:agent="v1"><span begin="2:34.510" end="2:34.810">ど</span><span begin="2:34.810" end="2:35.130">こ</span><span begin="2:35.130" end="2:35.370">に</span><span begin="2:35.370" end="2:35.680">で</span><span begin="2:35.680" end="2:35.880">も</span><span begin="2:36.230" end="2:36.510">あ</span><span begin="2:36.510" end="2:36.660">り</span><span begin="2:36.760" end="2:37.100">そ</span><span begin="2:37.100" end="2:37.360">う</span><span begin="2:37.360" end="2:37.630">な</span><span begin="2:37.630" end="2:37.960">日</span><span begin="2:37.960" end="2:38.130">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">还有那些仿佛随处可见的日子</span><span ttm:role="x-translation" xml:lang="zh-Hant">還有那些彷彿隨處可見的日子</span><span ttm:role="x-translation" xml:lang="en">Even on days that seem just like any other</span><span ttm:role="x-translation" xml:lang="ko">어디에나 있을 법한 날도</span><span ttm:role="x-translation" xml:lang="fr">Même ces jours comme on en vit partout</span><span ttm:role="x-translation" xml:lang="es">También los días como tantos otros</span><span ttm:role="x-translation" xml:lang="de">Auch an Tagen wie es sie überall gibt</span><span ttm:role="x-translation" xml:lang="pt">Mesmo nos dias que parecem tão comuns</span><span ttm:role="x-translation" xml:lang="ru">И в дни что кажутся самыми обычными</span><span ttm:role="x-translation" xml:lang="ar">وفي الأيام التي قد تجد مثلها في كل مكان</span><span ttm:role="x-translation" xml:lang="it">Anche nei giorni che sembrano uguali a tanti altri</span><span ttm:role="x-roman">Doko ni demo arisou na hi mo</span></p><p begin="2:38.500" end="2:43.450" itunes:key="L32" ttm:agent="v1"><span begin="2:38.500" end="2:38.800">た</span><span begin="2:38.800" end="2:39.080">だ</span><span begin="2:39.080" end="2:39.340">い</span><span begin="2:39.340" end="2:39.650">つ</span><span begin="2:39.650" end="2:39.910">ま</span><span begin="2:39.910" end="2:40.210">で</span><span begin="2:40.210" end="2:40.420">も</span> <span begin="2:40.750" end="2:41.060">た</span><span begin="2:41.060" end="2:41.320">だ</span><span begin="2:41.320" end="2:41.540">い</span><span begin="2:41.620" end="2:41.930">つ</span><span begin="2:41.930" end="2:42.200">ま</span><span begin="2:42.200" end="2:42.450">で</span><span begin="2:42.530" end="2:43.450">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">只愿永远如此 只愿永远如此</span><span ttm:role="x-translation" xml:lang="zh-Hant">只願永遠如此 只願永遠如此</span><span ttm:role="x-translation" xml:lang="en">Just forever just forever</span><span ttm:role="x-translation" xml:lang="ko">그저 언제까지나 그저 언제까지나</span><span ttm:role="x-translation" xml:lang="fr">Simplement pour toujours simplement pour toujours</span><span ttm:role="x-translation" xml:lang="es">Tan solo para siempre tan solo para siempre</span><span ttm:role="x-translation" xml:lang="de">Einfach für immer einfach für immer</span><span ttm:role="x-translation" xml:lang="pt">Só para sempre só para sempre</span><span ttm:role="x-translation" xml:lang="ru">Просто навсегда просто навсегда</span><span ttm:role="x-translation" xml:lang="ar">إلى الأبد فحسب إلى الأبد فحسب</span><span ttm:role="x-translation" xml:lang="it">Soltanto per sempre soltanto per sempre</span><span ttm:role="x-roman">Tada itsumademo tada itsumademo</span></p></div></body></tt>