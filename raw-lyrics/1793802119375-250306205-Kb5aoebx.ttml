<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="1496089152"/><amll:meta key="qqMusicId" value="001csVKf12pKXN"/><amll:meta key="qqMusicId" value="000Bx7bT2cusGB"/><amll:meta key="qqMusicId" value="0011gtqV1AYyOO"/><amll:meta key="qqMusicId" value="127570280"/><amll:meta key="qqMusicId" value="375941589"/><amll:meta key="qqMusicId" value="334580848"/><amll:meta key="spotifyId" value="7mykoq6R3BArsSpNDjFQTm"/><amll:meta key="appleMusicId" value="1541001553"/><amll:meta key="appleMusicId" value="1540793097"/><amll:meta key="musicName" value="I Really Want to Stay At Your House"/><amll:meta key="musicName" value="I Really Want to Stay at Your House"/><amll:meta key="musicName" value="网络动画《赛博朋克：边缘行者》插曲"/><amll:meta key="artists" value="Rosa Walton"/><amll:meta key="artists" value="Hallie Coggins"/><amll:meta key="album" value="Cyberpunk 2077: Radio, Vol. 2 (Original Soundtrack)"/><amll:meta key="album" value="Cyberpunk : Edgerunners Soundtrack Vol.1 (Ep1+2)"/><amll:meta key="ttmlAuthorGithub" value="72502111"/><amll:meta key="ttmlAuthorGithub" value="250306205"/><amll:meta key="ttmlAuthorGithubLogin" value="Havenmab"/><amll:meta key="ttmlAuthorGithubLogin" value="kid141252010"/><amll:meta key="isrc" value="USLS52081705"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Rosa Walton</songwriter></songwriters><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">我等不及你来清理这橱柜</text><text for="L2">但如今你离去 只留下一处标记</text><text for="L3">又一个夜晚 我静坐品味你言外之意</text><text for="L4">因为我却时刻思念着你</text><text for="L5">所以 那就离开吧</text><text for="L6">只为让自己不愿了解真相</text><text for="L7">放任你自己走吧</text><text for="L8">你深知你并未失去自制力</text><text for="L9">让我们于彩虹之上开始</text><text for="L10">拒绝内心纷扰</text><text for="L11">另一种方式前往你不愿涉足半步的天地</text><text for="L12">放任你自己走吧</text><text for="L13">这是否等于妥协了呢</text><text for="L14">所以你想做什么呢 说出你的观点</text><text for="L15">这里有场狂欢派对 你是否想去呢</text><text for="L16">同你握手 询问你的看法</text><text for="L17">我全心倾覆于你 不愿离去</text><text for="L18">因为我真的想要呆在你家里</text><text for="L19">多希望能一直呆着</text><text for="L20">但你知道 你令我内心多么分崩离析</text><text for="L21">我已经受够你了 我要将你忽视</text><text for="L22">我不想再了解了 <span ttm:role="x-bg">(噢哦)</span></text><text for="L23">我意识到 你深陷于恶劣环境中</text><text for="L24">因为我已竭尽全力 只为陪伴你身旁</text><text for="L25">所以当你告诉我 我就是其中的原因时 对于这些谎言 我简直难以置信</text><text for="L26">为何我这么想给你打电话 <span ttm:role="x-bg">(呼叫你 呼叫你 呼叫你)</span></text><text for="L27">所以你想做什么呢 说出你的观点</text><text for="L28">这里有场狂欢派对 你是否想去呢</text><text for="L29">同你握手 询问你的看法</text><text for="L30">我全心倾覆于你 不愿离去</text><text for="L31">因为我真的想要呆在你家里</text><text for="L32">我希望这一切都会成功</text><text for="L33">但你知道 你令我内心多么分崩离析</text><text for="L34">我已经受够你了 我要将你忽视</text><text for="L35">我不想再了解你 <span ttm:role="x-bg">(噢哦)</span></text><text for="L36">哦哦 哦 哦哦</text><text for="L37">我不知为何 自己的内心犹如沉溺水下</text><text for="L38">所以 那就离开吧</text><text for="L39">只为让自己不愿了解真相</text><text for="L40">放任你自己走吧</text><text for="L41">你深知 你并未失去自制力 哦</text><text for="L42">让我们于彩虹之上开始</text><text for="L43">拒绝内心纷扰</text><text for="L44">只为让自己不愿继续前行</text><text for="L45">放任你自己走吧</text><text for="L46">这是否等于妥协了呢</text><text for="L47">所以你想做什么呢 说出你的观点</text><text for="L48">这里有场狂欢派对 你是否想去呢</text><text for="L49">同你握手 询问你的看法</text><text for="L50">我全心倾覆于你 不愿离去</text><text for="L51">因为我真的想要呆在你家里</text><text for="L52">我希望这一切都会成功</text><text for="L53">但你知道 你令我内心多么分崩离析</text><text for="L54">我已经受够你了 我要将你忽视</text><text for="L55">我不想再了解了</text><text for="L56">哦</text></translation></translations></iTunesMetadata></metadata></head><body dur="04:01.788"><div begin="00:01.217" end="00:26.586" itunes:songPart="Verse"><p begin="00:01.217" end="00:04.772" ttm:agent="v1" itunes:key="L1"><spa