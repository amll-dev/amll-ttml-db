<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:tts="http://www.w3.org/ns/ttml#styling"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="ウィアートル"/><amll:meta key="artists" value="rionos"/><amll:meta key="album" value="映画『さよならの朝に約束の花をかざろう』オリジナルサウンドトラック"/><amll:meta key="isrc" value="JPI101800134"/><amll:meta key="ncmMusicId" value="536623722"/><amll:meta key="qqMusicId" value="001CNiOJ3VyAHu"/><amll:meta key="spotifyId" value="1VAcUeeWrEqg7j1dwiBstH"/><amll:meta key="appleMusicId" value="1857550678"/><amll:meta key="ttmlAuthorGithubLogin" value="Mrs4s"/><amll:meta key="ttmlAuthorGithub" value="12137562"/><amll:meta key="ttmlAuthorGithubLogin" value="Mrs4s"/></metadata></head><body dur="04:48.000"><div begin="00:28.980" end="04:20.600"><p begin="00:28.980" end="00:35.140" ttm:agent="v1" itunes:key="L1"><span begin="00:28.980" end="00:30.860">ちっ</span><span begin="00:30.860" end="00:31.740">ぽ</span><span begin="00:32.300" end="00:32.520">け</span><span begin="00:32.520" end="00:32.800">な</span><span tts:ruby="container"><span tts:ruby="base">星</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:32.800" end="00:33.200">ほ</span><span tts:ruby="text" begin="00:33.200" end="00:33.700">し</span></span></span><span begin="00:33.700" end="00:35.140">よ</span><span ttm:role="x-translation">渺小的星尘啊</span><span ttm:role="x-roman">chippoke na hoshi yo</span></p><p begin="00:36.500" end="00:42.880" ttm:agent="v1" itunes:key="L2"><span begin="00:36.500" end="00:37.440">ま</span><span begin="00:37.440" end="00:38.400">わ</span><span begin="00:38.400" end="00:39.180">り</span><span tts:ruby="container"><span tts:ruby="base">続</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:39.760" end="00:40.260">つ</span><span tts:ruby="text" begin="00:40.260" end="00:40.720">づ</span></span></span><span begin="00:40.720" end="00:41.180">け</span><span begin="00:41.180" end="00:42.880">て...</span><span ttm:role="x-translation">持续巡回着…</span><span ttm:role="x-roman">mawari tsuzukete...</span></p><p begin="00:43.520" end="00:50.360" ttm:agent="v1" itunes:key="L3"><span begin="00:43.520" end="00:43.880">あ</span><span begin="00:43.880" end="00:44.480">ふ</span><span begin="00:44.480" end="00:44.900">れ</span><span begin="00:44.900" end="00:45.580">そ</span><span begin="00:45.580" end="00:45.920">う</span><span begin="00:45.920" end="00:46.780">に</span><span tts:ruby="container"><span tts:ruby="base">輝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:47.720" end="00:48.220">か</span><span tts:ruby="text" begin="00:48.220" end="00:48.700">が</span><span tts:ruby="text" begin="00:48.700" end="00:49.360">や</span></span></span><span begin="00:49.360" end="00:49.660">い</span><span begin="00:49.660" end="00:50.360">て</span><span ttm:role="x-translation">闪烁着满溢而出的光辉</span><span ttm:role="x-roman">afuresō ni kagayaite</span></p><p begin="00:51.060" end="00:54.140" ttm:agent="v1" itunes:key="L4"><span tts:ruby="container"><span tts:ruby="base">流</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:51.060" end="00:51.540">な</span><span tts:ruby="text" begin="00:51.540" end="00:51.960">が</span></span></span><span begin="00:51.960" end="00:52.460">れ</span><span begin="00:52.460" end="00:52.900">て</span><span tts:ruby="container"><span tts:ruby="base">行</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:52.900" end="00:53.373">い</span></span></span><span begin="00:53.373" end="00:54.140">く</span><span ttm:role="x-translation">在空中流转</span><span ttm:role="x-roman">nagarete iku</span></p><p begin="00:54.760" end="01:02.440" ttm:agent="v1" itunes:key="L5"><span tts:ruby="container"><span tts:ruby="base">綺</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:54.760" end="00:55.040">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">麗</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:55.040" end="00:55.400">れ</span><span tts:ruby="text" begin="00:55.400" end="00:56.220">い</span></span></span><span begin="00:56.220" end="00:57.840">な</span><span begin="00:58.560" end="00:59.040">ま</span><span begin="00:59.040" end="00:59.960">ま</span><span begin="00:59.960" end="01:02.440">で</span><span ttm:role="x-translation">美丽如常</span><span ttm:role="x-roman">kirei na mama de</span></p><p begin="01:25.840" end="01:34.060" ttm:agent="v1" itunes:key="L6"><span tts:ruby="container"><span tts:ruby="base">歩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:25.840" end="01:26.780">あ</span><span tts:ruby="text" begin="01:26.780" end="01:27.660">る</span></span></span><span begin="01:27.660" end="01:28.640">き</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:28.640" end="01:29.500">だ</span></span></span><span begin="01:29.500" end="01:30.380">す</span> <span tts:ruby="container"><span tts:ruby="base">愛</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:30.960" end="01:31.480">あ</span><span tts:ruby="text" begin="01:31.480" end="01:31.920">い</span></span></span><span begin="01:31.920" end="01:32.380">を</span><span tts:ruby="container"><span tts:ruby="base">連</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:32.380" end="01:33.100">つ</span></span></span><span begin="01:33.100" end="01:33.320">れ</span><span begin="01:33.320" end="01:34.060">て</span><span ttm:role="x-translation">携着爱恋 迈出步伐</span><span ttm:role="x-roman">arukidasu ai o tsurete</span></p><p begin="01:34.740" end="01:40.280" ttm:agent="v1" itunes:key="L7"><span tts:ruby="container"><span tts:ruby="base">奏</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:34.740" end="01:35.200">か</span><span tts:ruby="text" begin="01:35.200" end="01:36.420">な</span></span></span><span begin="01:36.620" end="01:37.140">で</span><span begin="01:37.140" end="01:38.020">る</span><span begin="01:38.520" end="01:38.780">よ</span><span begin="01:38.780" end="01:38.980">う</span><span begin="01:38.980" end="01:40.280">に</span><span ttm:role="x-translation">宛若奏响一曲乐章</span><span ttm:role="x-roman">kanaderu yō ni</span></p><p begin="01:40.760" end="01:51.080" ttm:agent="v1" itunes:key="L8"><span tts:ruby="container"><span tts:ruby="base">信</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:40.760" end="01:41.740">し</span><span tts:ruby="text" begin="01:41.740" end="01:42.660">ん</span></span></span><span begin="01:42.660" end="01:43.660">じ</span><span begin="01:43.660" end="01:44.600">て</span><span begin="01:44.600" end="01:45.480">る</span> <span begin="01:46.000" end="01:46.460">ど</span><span begin="01:46.460" end="01:46.960">ん</span><span begin="01:46.960" end="01:47.420">な</span><span tts:ruby="container"><span tts:ruby="base">形</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:47.420" end="01:47.860">か</span><span tts:ruby="text" begin="01:47.860" end="01:48.340">た</span><span tts:ruby="text" begin="01:48.340" end="01:49.040">ち</span></span></span><span begin="01:49.040" end="01:49.300">で</span><span begin="01:49.300" end="01:51.080">も</span><span ttm:role="x-translation">我坚信 不论是以何种姿态</span><span ttm:role="x-roman">shinjiteru donna katachi demo</span></p><p begin="01:51.600" end="02:02.820" ttm:agent="v1" itunes:key="L9"><span tts:ruby="container"><span tts:ruby="base">太</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:51.600" end="01:52.060">た</span><span tts:ruby="text" begin="01:52.060" end="01:52.540">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">陽</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:52.540" end="01:52.780">よ</span><span tts:ruby="text" begin="01:52.780" end="01:53.040">う</span></span></span><span begin="01:53.040" end="01:54.760">は</span><span tts:ruby="container"><span tts:ruby="base">昇</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:55.360" end="01:55.840">の</span><span tts:ruby="text" begin="01:55.840" end="01:56.280">ぼ</span></span></span><span begin="01:56.280" end="01:56.520">る</span><span begin="01:56.520" end="01:56.780">か</span><span begin="01:56.780" end="01:58.040">ら</span> <span begin="01:58.680" end="01:59.580">きっ</span><span begin="01:59.580" end="02:02.820">と</span><span ttm:role="x-translation">太阳一定都会升起</span><span ttm:role="x-roman">taiyō wa noboru kara kitto</span></p><p begin="02:16.460" end="02:22.860" ttm:agent="v1" itunes:key="L10"><span begin="02:16.460" end="02:18.320">ちっ</span><span begin="02:18.320" end="02:19.260">ぽ</span><span begin="02:19.720" end="02:19.960">け</span><span begin="02:19.960" end="02:20.220">な</span><span tts:ruby="container"><span tts:ruby="base">星</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:20.220" end="02:20.680">ほ</span><span tts:ruby="text" begin="02:20.680" end="02:21.180">し</span></span></span><span begin="02:21.180" end="02:22.860">に</span><span ttm:role="x-translation">仰望渺小的星尘</span><span ttm:role="x-roman">chippoke na hoshi ni</span></p><p begin="02:23.980" end="02:30.360" ttm:agent="v1" itunes:key="L11"><span tts:ruby="container"><span tts:ruby="base">落</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:23.980" end="02:24.860">お</span></span></span><span begin="02:24.860" end="02:25.800">ち</span><span begin="02:25.800" end="02:26.760">た</span><span tts:ruby="container"><span tts:ruby="base">涙</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:27.220" end="02:27.740">な</span><span tts:ruby="text" begin="02:27.740" end="02:28.200">み</span><span tts:ruby="text" begin="02:28.200" end="02:28.660">だ</span></span></span><span begin="02:28.660" end="02:30.360">は</span><span ttm:role="x-translation">流下的泪珠</span><span ttm:role="x-roman">ochita namida wa</span></p><p begin="02:30.980" end="02:37.780" ttm:agent="v1" itunes:key="L12"><span begin="02:30.980" end="02:31.360">あ</span><span begin="02:31.360" end="02:31.960">ふ</span><span begin="02:31.960" end="02:32.360">れ</span><span begin="02:32.360" end="02:33.020">そ</span><span begin="02:33.020" end="02:33.340">う</span><span begin="02:33.340" end="02:34.200">な</span><span tts:ruby="container"><span tts:ruby="base">優</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:35.200" end="02:35.660">や</span><span tts:ruby="text" begin="02:35.660" end="02:36.140">さ</span></span></span><span begin="02:36.140" end="02:36.780">し</span><span begin="02:36.780" end="02:37.080">さ</span><span begin="02:37.080" end="02:37.780">を</span><span ttm:role="x-translation">展现的是</span><span ttm:role="x-roman">afuresō na yasashisa o</span></p><p begin="02:38.540" end="02:41.500" ttm:agent="v1" itunes:key="L13"><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:38.540" end="02:38.900">み</span></span></span><span begin="02:38.900" end="02:39.440">せ</span><span begin="02:39.440" end="02:39.900">て</span><span begin="02:39.900" end="02:40.360">く</span><span begin="02:40.360" end="02:40.840">れ</span><span begin="02:40.840" end="02:41.500">る</span><span ttm:role="x-translation">满溢而出的温柔</span><span ttm:role="x-roman">misete kureru</span></p><p begin="02:42.260" end="02:50.380" ttm:agent="v1" itunes:key="L14"><span begin="02:42.260" end="02:42.500">も</span><span begin="02:42.500" end="02:42.800">う</span><span tts:ruby="container"><span tts:ruby="base">一</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:42.800" end="02:43.380">い</span><span tts:ruby="text" begin="02:43.380" end="02:43.700">ち</span></span></span><span tts:ruby="container"><span tts:ruby="base">度</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:43.700" end="02:45.240">ど</span></span></span> <span begin="02:46.000" end="02:47.400">笑っ</span><span begin="02:47.400" end="02:50.380">て</span><span ttm:role="x-translation">再一次展露笑颜吧</span><span ttm:role="x-roman">mō ichido waratte</span></p><p begin="03:24.260" end="03:39.480" ttm:agent="v1" itunes:key="L15"><span begin="03:24.260" end="03:25.300">そ</span><span begin="03:25.300" end="03:26.100">の</span><span tts:ruby="container"><span tts:ruby="base">胸</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:26.260" end="03:27.220">む</span><span tts:ruby="text" begin="03:27.220" end="03:28.120">ね</span></span></span><span begin="03:28.120" end="03:28.880">の</span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:29.540" end="03:30.000">な</span><span tts:ruby="text" begin="03:30.000" end="03:30.460">か</span></span></span><span begin="03:30.460" end="03:30.940">に</span><span begin="03:30.940" end="03:31.540">は</span><span tts:ruby="container"><span tts:ruby="base">何</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:31.640" end="03:32.020">な</span><span tts:ruby="text" begin="03:32.020" end="03:32.700">に</span></span></span><span begin="03:33.460" end="03:34.230">が</span><span begin="03:34.230" end="03:35.000">あ</span><span begin="03:35.340" end="03:35.620">る</span><span begin="03:35.620" end="03:39.480">の？</span><span ttm:role="x-translation">是什么存于你的心间呢？</span><span ttm:role="x-roman">sono mune no naka ni wa nani ga aru no?</span></p><p begin="03:43.100" end="03:51.340" ttm:agent="v1" itunes:key="L16"><span tts:ruby="container"><span tts:ruby="base">歩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:43.100" end="03:44.020">あ</span><span tts:ruby="text" begin="03:44.020" end="03:44.960">る</span></span></span><span begin="03:44.960" end="03:45.960">き</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:45.960" end="03:46.840">だ</span></span></span><span begin="03:46.840" end="03:47.660">す</span> <span tts:ruby="container"><span tts:ruby="base">愛</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:48.240" end="03:48.740">あ</span><span tts:ruby="text" begin="03:48.740" end="03:49.220">い</span></span></span><span begin="03:49.220" end="03:49.700">に</span><span begin="03:49.700" end="03:50.620">なっ</span><span begin="03:50.620" end="03:51.340">て</span><span ttm:role="x-translation">化身为爱 迈出步伐</span><span ttm:role="x-roman">arukidasu ai ni natte</span></p><p begin="03:52.000" end="03:57.600" ttm:agent="v1" itunes:key="L17"><span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:52.000" end="03:52.520">ひ</span><span tts:ruby="text" begin="03:52.520" end="03:53.880">か</span><span tts:ruby="text" begin="03:53.880" end="03:54.400">り</span></span></span><span begin="03:54.400" end="03:55.200">の</span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:55.800" end="03:56.040">な</span><span tts:ruby="text" begin="03:56.040" end="03:56.280">か</span></span></span><span begin="03:56.280" end="03:57.600">へ</span><span ttm:role="x-translation">迈向光芒之中</span><span ttm:role="x-roman">hikari no naka e</span></p><p begin="03:58.140" end="04:08.300" ttm:agent="v1" itunes:key="L18"><span tts:ruby="container"><span tts:ruby="base">大</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:58.140" end="03:58.980">だ</span><span tts:ruby="text" begin="03:58.980" end="03:59.960">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">丈</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:59.960" end="04:00.960">じょ</span><span tts:ruby="text" begin="04:00.960" end="04:01.900">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">夫</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:01.900" end="04:02.800">ぶ</span></span></span> <span begin="04:03.300" end="04:03.760">ど</span><span begin="04:03.760" end="04:04.240">ん</span><span begin="04:04.240" end="04:04.700">な</span><span tts:ruby="container"><span tts:ruby="base">未</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:04.700" end="04:05.160">み</span></span></span><span tts:ruby="container"><span tts:ruby="base">来</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:05.160" end="04:05.640">ら</span><span tts:ruby="text" begin="04:05.640" end="04:06.300">い</span></span></span><span begin="04:06.300" end="04:06.560">で</span><span begin="04:06.560" end="04:08.300">も</span><span ttm:role="x-translation">没事的 不论未来如何</span><span ttm:role="x-roman">daijōbu donna mirai demo</span></p><p begin="04:08.880" end="04:20.600" ttm:agent="v1" itunes:key="L19"><span tts:ruby="container"><span tts:ruby="base">太</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:08.880" end="04:09.340">た</span><span tts:ruby="text" begin="04:09.340" end="04:09.860">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">陽</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:09.860" end="04:10.100">よ</span><span tts:ruby="text" begin="04:10.100" end="04:10.340">う</span></span></span><span begin="04:10.340" end="04:11.960">は</span><span tts:ruby="container"><span tts:ruby="base">昇</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:12.640" end="04:13.120">の</span><span tts:ruby="text" begin="04:13.120" end="04:13.580">ぼ</span></span></span><span begin="04:13.580" end="04:13.800">る</span><span begin="04:13.800" end="04:14.060">か</span><span begin="04:14.060" end="04:15.240">ら</span> <span begin="04:15.880" end="04:16.840">きっ</span><span begin="04:16.840" end="04:20.600">と</span><span ttm:role="x-translation">太阳一定都会升起</span><span ttm:role="x-roman">taiyō wa noboru kara kitto</span></p></div></body></tt>