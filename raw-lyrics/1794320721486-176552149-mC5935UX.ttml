3.493">dark</span> <span begin="53.493" end="53.773">des</span><span begin="53.773" end="53.923">ert</span> <span begin="53.923" end="54.283">high</span><span begin="54.283" end="54.803">way,</span> <span begin="55.883" end="56.373">cool</span> <span begin="56.373" end="56.643">wind</span> <span begin="56.643" end="56.863">in</span> <span begin="56.863" end="57.173">my</span> <span begin="57.173" end="57.823">hair</span><span ttm:role="x-translation" xml:lang="zh-Hans">夜色浸染荒芜公路 风卷发梢微凉</span></p><p begin="59.203" end="1:04.493" itunes:key="L2" ttm:agent="v1"><span begin="59.203" end="59.553">Warm</span> <span begin="59.553" end="1:00.063">smell</span> <span begin="1:00.063" end="1:00.203">of</span> <span begin="1:00.203" end="1:00.403">co</span><span begin="1:00.403" end="1:00.723">li</span><span begin="1:00.723" end="1:01.433">tas,</span> <span begin="1:02.253" end="1:02.623">ri</span><span begin="1:02.623" end="1:02.923">sing</span> <span begin="1:02.923" end="1:03.123">up</span> <span begin="1:03.123" end="1:03.413">through</span> <span begin="1:03.413" end="1:03.653">the</span> <span begin="1:03.653" end="1:04.493">air</span><span ttm:role="x-translation" xml:lang="zh-Hans">奇异草香氤氲蒸腾 漫过旷野苍茫</span></p><p begin="1:05.769" end="1:10.719" itunes:key="L3" ttm:agent="v1"><span begin="1:05.769" end="1:05.979">Up</span> <span begin="1:05.979" end="1:06.139">a</span><span begin="1:06.139" end="1:06.589">head</span> <span begin="1:06.589" end="1:06.749">in</span> <span begin="1:06.749" end="1:06.899">the</span> <span begin="1:06.899" end="1:07.309">dis</span><span begin="1:07.309" end="1:07.999">tance,</span> <span begin="1:08.819" end="1:08.919">I</span> <span begin="1:08.919" end="1:09.259">saw</span> <span begin="1:09.259" end="1:09.329">a</span> <span begin="1:09.329" end="1:09.719">shimm</span><span begin="1:09.719" end="1:09.959">er</span><span begin="1:09.959" end="1:10.139">ing</span> <span begin="1:10.139" end="1:10.719">light</span><span ttm:role="x-translation" xml:lang="zh-Hans">远处光影摇曳处 忽现流萤微芒</span></p><p begin="1:12.047" end="1:14.687" itunes:key="L4" ttm:agent="v1"><span begin="1:12.047" end="1:12.207">My</span> <span begin="1:12.207" end="1:12.447">head</span> <span begin="1:12.447" end="1:12.647">grew</span> <span begin="1:12.647" end="1:12.917">heav</span><span begin="1:12.917" end="1:13.087">y</span> <span begin="1:13.087" end="1:13.277">and</span> <span begin="1:13.277" end="1:13.407">my</span> <span begin="1:13.407" end="1:13.817">sight</span> <span begin="1:13.817" end="1:14.077">grew</span> <span begin="1:14.077" end="1:14.687">dim</span><span ttm:role="x-translation" xml:lang="zh-Hans">头昏沉目眩 视线开始模糊</span></p><p begin="1:15.365" end="1:17.455" itunes:key="L5" ttm:agent="v1"><span begin="1:15.365" end="1:15.475">I</span> <span begin="1:15.475" end="1:15.715">had</span> <span begin="1:15.715" end="1:15.845">to</span> <span begin="1:15.845" end="1:16.235">stop</span> <span begin="1:16.235" end="1:16.555">for</span> <span begin="1:16.555" end="1:16.765">the</span> <span begin="1:16.765" end="1:17.455">night</span><span ttm:role="x-translation" xml:lang="zh-Hans">不得不停下过夜</span></p><p begin="1:18.635" end="1:23.565" itunes:key="L6" ttm:agent="v1"><span begin="1:18.635" end="1:18.955">There</span> <span begin="1:18.955" end="1:19.215">she</span> <span begin="1:19.215" end="1:19.635">stood</span> <span begin="1:19.635" end="1:19.835">in</span> <span begin="1:19.835" end="1:19.975">the</span> <span begin="1:19.975" end="1:20.355">door</span><span begin="1:20.355" end="1:20.915">way,</span> <span begin="1:21.865" end="1:22.005">I</span> <span begin="1:22.005" end="1:22.275">heard</span> <span begin="1:22.275" end="1:22.445">the</span> <span begin="1:22.445" end="1:22.625">mi</span><span begin="1:22.625" end="1:23.075">ssion</span> <span begin="1:23.075" end="1:23.565">bell</span><span ttm:role="x-translation" xml:lang="zh-Hans">钟声回荡廊前 倩影斜倚门畔</span></p><p begin="1:25.517" end="1:27.497" itunes:key="L7" ttm:agent="v1"><span begin="1:25.517" end="1:25.747">And</span> <span begin="1:25.747" end="1:25.837">I</span> <span begin="1:25.837" end="1:26.047">was</span> <span begin="1:26.047" end="1:26.247">thin</span><span begin="1:26.247" end="1:26.447">king</span> <span begin="1:26.447" end="1:26.677">to</span> <span begin="1:26.677" end="1:26.997">my</span><span begin="1:26.997" end="1:27.497">self</span><span ttm:role="x-translation" xml:lang="zh-Hans">恍惚自问此去</span></p><p begin="1:27.488" end="1:30.728" itunes:key="L8" ttm:agent="v1"><span begin="1:27.488" end="1:27.708">&quot;This</span> <span begin="1:27.708" end="1:27.898">could</span> <span begin="1:27.898" end="1:28.128">be</span> <span begin="1:28.128" end="1:28.498">Heav</span><span begin="1:28.498" end="1:28.778">en</span> <span begin="1:28.778" end="1:28.958">or</span> <span begin="1:28.958" end="1:29.188">this</span> <span begin="1:29.188" end="1:29.488">could</span> <span begin="1:29.488" end="1:29.888">be</span> <span begin="1:29.888" end="1:30.728">Hell&quot;</span><span ttm:role="x-translation" xml:lang="zh-Hans">这会是天堂，还是地狱模样？</span></p><p begin="1:31.801" end="1:37.021" itunes:key="L9" ttm:agent="v1"><span begin="1:31.801" end="1:32.001">Then</span> <span begin="1:32.001" end="1:32.251">she</span> <span begin="1:32.251" end="1:32.561">lit</span> <span begin="1:32.561" end="1:32.821">up</span> <span begin="1:32.821" end="1:32.961">a</span> <span begin="1:32.961" end="1:33.441">can</span><span begin="1:33.441" end="1:33.971">dle</span> <span begin="1:35.071" end="1:35.211">and</span> <span begin="1:35.211" end="1:35.391">she</span> <span begin="1:35.391" end="1:35.921">showed</span> <span begin="1:35.921" end="1:36.121">me</span> <span begin="1:36.121" end="1:36.321">the</span> <span begin="1:36.321" end="1:37.021">way</span><span ttm:role="x-translation" xml:lang="zh-Hans">她点燃蜡烛引路</span></p><p begin="1:38.171" end="1:43.641" itunes:key="L10" ttm:agent="v1"><span begin="1:38.171" end="1:38.511">There</span> <span begin="1:38.511" end="1:38.681">were</span> <span begin="1:38.681" end="1:38.941">voi</span><span begin="1:38.941" end="1:39.191">ces</span> <span begin="1:39.191" end="1:39.441">down</span> <span begin="1:39.441" end="1:39.591">the</span> <span begin="1:39.591" end="1:39.991">corr</span><span begin="1:39.991" end="1:40.141">i</span><span begin="1:40.141" end="1:40.811">dor,</span> <span begin="1:41.421" end="1:41.461">I</span> <span begin="1:41.461" end="1:41.831">thought</span> <span begin="1:41.831" end="1:41.991">I</span> <span begin="1:41.991" end="1:42.371">heard</span> <span begin="1:42.371" end="1:42.711">them</span> <span begin="1:42.711" end="1:43.641">say</span><span ttm:role="x-translation" xml:lang="zh-Hans">走廊传来低语 依稀听闻有人言</span></p><p begin="1:44.781" end="1:48.241" itunes:key="L11" ttm:agent="v1"><span begin="1:44.781" end="1:45.091">&quot;Wel</span><span begin="1:45.091" end="1:45.411">come</span> <span begin="1:45.411" end="1:45.681">to</span> <span begin="1:45.681" end="1:45.891">the</span> <span begin="1:45.891" end="1:46.201">Ho</span><span begin="1:46.201" end="1:46.771">tel</span> <span begin="1:46.771" end="1:47.991">Califor</span><span begin="1:47.991" end="1:48.241">nia</span><span ttm:role="x-translation" xml:lang="zh-Hans">“欢迎光临加州旅馆</span></p><p begin="1:50.400" end="1:52.123" itunes:key="L12" ttm:agent="v1"><span begin="1:50.400" end="1:50.840">Such</span> <span begin="1:50.840" end="1:50.980">a</span> <span begin="1:50.980" end="1:51.430">love</span><span begin="1:51.430" end="1:51.540">ly</span> <span begin="1:51.540" end="1:52.123">place</span><span ttm:role="x-translation" xml:lang="zh-Hans">多么美好的地方</span><span ttm:role="x-bg" begin="1:52.061" end="1:53.881"><span begin="1:52.061" end="1:52.286">(Such</span> <span begin="1:52.286" end="1:52.551">a</span> <span begin="1:52.551" end="1:53.051">love</span><span begin="1:53.051" end="1:53.171">ly</span> <span begin="1:53.171" end="1:53.881">place)</span><span ttm:role="x-translation" xml:lang="zh-Hans">多么美好的地方</span></span></p><p begin="1:53.738" end="1:55.508" itunes:key="L13" ttm:agent="v1"><span begin="1:53.738" end="1:54.088">Such</span> <span begin="1:54.088" end="1:54.218">a</span> <span begin="1:54.218" end="1:54.688">love</span><span begin="1:54.688" end="1:54.808">ly</span> <span begin="1:54.808" end="1:55.508">face</span><span ttm:role="x-translation" xml:lang="zh-Hans">如此可爱的脸庞</span></p><p begin="1:57.448" end="2:01.258" itunes:key="L14" ttm:agent="v1"><span begin="1:57.448" end="1:57.728">Plen</span><span begin="1:57.728" end="1:57.948">ty</span> <span begin="1:57.948" end="1:58.158">of</span> <span begin="1:58.158" end="1:58.558">room</span> <span begin="1:58.558" end="1:58.888">at</span> <span begin="1:58.888" end="1:59.118">the</span> <span begin="1:59.118" end="1:59.408">Ho</span><span begin="1:59.408" end="1:59.868">tel</span> <span begin="1:59.868" end="2:01.018">Califor</span><span begin="2:01.018" end="2:01.258">nia</span><span ttm:role="x-translation" xml:lang="zh-Hans">加州旅馆永远有空房</span></p><p begin="2:03.683" end="2:06.838" itunes:key="L15" ttm:agent="v1"><span begin="2:03.683" end="2:03.963">Any</span> <span begin="2:03.963" end="2:04.503">time</span> <span begin="2:04.503" end="2:04.663">of</span> <span begin="2:04.663" end="2:05.103">year</span><span ttm:role="x-translation" xml:lang="zh-Hans">一年四季 全年无休</span><span ttm:role="x-bg" begin="2:05.298" end="2:06.838"><span begin="2:05.298" end="2:05.608">(Any</span> <span begin="2:05.608" end="2:06.148">time</span> <span begin="2:06.148" end="2:06.318">of</span> <span begin="2:06.318" end="2:06.838">year)</span><span ttm:role="x-translation" xml:lang="zh-Hans">一年四季 全年无休</span></span></p><p begin="2:06.946" end="2:08.396" itunes:key="L16" ttm:agent="v1"><span begin="2:06.946" end="2:07.036">You</span> <span begin="2:07.036" end="2:07.256">can</span> <span begin="2:07.256" end="2:07.796">find</span> <span begin="2:07.796" end="2:07.916">it</span> <span begin="2:07.916" end="2:08.396">here&quot;</span><span ttm:role="x-translation" xml:lang="zh-Hans">你总能找到方向”</span></p><p begin="2:10.736" end="2:16.696" itunes:key="L17" ttm:agent="v1"><span begin="2:10.736" end="2:10.906">Her</span> <span begin="2:10.906" end="2:11.216">mind</span> <span begin="2:11.216" end="2:11.376">is</span> <span begin="2:11.376" end="2:11.686">Tiff</span><span begin="2:11.686" end="2:12.036">any</span> <span begin="2:12.036" end="2:12.496">twis</span><span begin="2:12.496" end="2:13.056">ted,</span> <span begin="2:13.866" end="2:14.186">she</span> <span begin="2:14.186" end="2:14.466">got</span> <span begin="2:14.466" end="2:14.616">the</span> <span begin="2:14.616" end="2:14.876">Mer</span><span begin="2:14.876" end="2:15.226">ce</span><span begin="2:15.226" end="2:15.556">des</span> <span begin="2:15.556" end="2:16.206">Benz,</span> <span begin="2:16.266" end="2:16.696">uh</span><span ttm:role="x-translation" xml:lang="zh-Hans">她被蒂芙尼迷惑 开着梅赛德斯奔驰</span></p><p begin="2:17.157" end="2:22.767" itunes:key="L18" ttm:agent="v1"><span begin="2:17.157" end="2:17.457">She</span> <span begin="2:17.457" end="2:17.727">got</span> <span begin="2:17.727" end="2:17.897">a</span> <span begin="2:17.897" end="2:18.157">lot</span> <span begin="2:18.157" end="2:18.287">of</span> <span begin="2:18.287" end="2:18.807">pretty,</span> <span begin="2:18.807" end="2:19.347">pretty</span> <span begin="2:19.347" end="2:20.077">boys,</span> <span begin="2:21.047" end="2:21.287">she</span> <span begin="2:21.287" end="2:21.737">calls</span> <span begin="2:21.737" end="2:22.767">friends</span><span ttm:role="x-translation" xml:lang="zh-Hans">她结识许多帅气男孩 只称他们为“朋友”</span></p><p begin="2:23.926" end="2:29.116" itunes:key="L19" ttm:agent="v1"><span begin="2:23.926" end="2:24.216">How</span> <span begin="2:24.216" end="2:24.376">they</span> <span begin="2:24.376" end="2:24.896">dance</span> <span begin="2:24.896" end="2:25.046">in</span> <span begin="2:25.046" end="2:25.176">the</span> <span begin="2:25.176" end="2:25.586">court</span><span begin="2:25.586" end="2:26.196">yard,</span> <span begin="2:26.606" end="2:27.786">sweet</span> <span begin="2:27.786" end="2:28.226">summ</span><span begin="2:28.226" end="2:28.366">er</span> <span begin="2:28.366" end="2:29.116">sweat</span><span ttm:role="x-translation" xml:lang="zh-Hans">庭院舞影蹁跹 夏夜香汗涔涔</span></p><p begin="2:30.341" end="2:35.851" itunes:key="L20" ttm:agent="v1"><span begin="2:30.341" end="2:30.931">Some</span> <span begin="2:30.931" end="2:31.301">dance</span> <span begin="2:31.301" end="2:31.511">to</span> <span begin="2:31.511" end="2:31.661">re</span><span begin="2:31.661" end="2:32.151">mem</span><span begin="2:32.151" end="2:32.721">ber,</span> <span begin="2:33.571" end="2:34.171">some</span> <span begin="2:34.171" end="2:34.521">dance</span> <span begin="2:34.521" end="2:34.731">to</span> <span begin="2:34.731" end="2:35.121">for</span><span begin="2:35.121" end="2:35.851">get</span><span ttm:role="x-translation" xml:lang="zh-Hans">有人翩翩求回忆 有人翩翩求忘记</span></p><p begin="2:36.909" end="2:42.319" itunes:key="L21" ttm:agent="v1"><span begin="2:36.909" end="2:37.289">So</span> <span begin="2:37.289" end="2:37.469">I</span> <span begin="2:37.469" end="2:37.889">called</span> <span begin="2:37.889" end="2:38.079">up</span> <span begin="2:38.079" end="2:38.219">the</span> <span begin="2:38.219" end="2:38.619">Cap</span><span begin="2:38.619" end="2:39.169">tain,</span> <span begin="2:40.019" end="2:40.749">&quot;Please</span> <span begin="2:40.749" end="2:41.129">bring</span> <span begin="2:41.129" end="2:41.319">me</span> <span begin="2:41.319" end="2:41.679">my</span> <span begin="2:41.679" end="2:42.319">wine&quot;</span><span ttm:role="x-translation" xml:lang="zh-Hans">我唤来侍者领班：&quot;请给我拿些酒来&quot;</span></p><p begin="2:42.517" end="2:48.907" itunes:key="L22" ttm:agent="v1"><span begin="2:42.517" end="2:42.687">He</span> <span begin="2:42.687" end="2:43.077">said,</span> <span begin="2:43.387" end="2:43.627">&quot;We</span> <spa