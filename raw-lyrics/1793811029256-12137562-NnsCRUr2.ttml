40">は</span></span></span><span begin="2:04.240" end="2:04.440">ぜ</span><span begin="2:04.440" end="2:04.860">ろ</span><span ttm:role="x-translation">绽放吧 绽放吧 爆裂吧</span><span ttm:role="x-roman">saite saite hazero</span></p><p begin="2:05.120" end="2:08.120" itunes:key="L33" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">識</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:05.120" end="2:05.400">し</span></span></span><span begin="2:05.400" end="2:05.600">り</span><span begin="2:05.600" end="2:06.020">た</span><span begin="2:06.020" end="2:06.160">い</span><span begin="2:06.160" end="2:06.400">な</span><span begin="2:06.400" end="2:06.940">ら</span><span tts:ruby="container"><span tts:ruby="base">目</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:06.940" end="2:07.140">め</span></span></span><span tts:ruby="container"><span tts:ruby="base">覚</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:07.140" end="2:07.360">ざ</span></span></span><span begin="2:07.360" end="2:07.520">め</span><span begin="2:07.520" end="2:08.120">よ</span><span ttm:role="x-translation">若想知晓就觉醒吧</span><span ttm:role="x-roman">shiritai nara mezameyo</span></p><p begin="2:08.540" end="2:11.080" itunes:key="L34" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">咲</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:08.540" end="2:09.140">さ</span></span></span><span begin="2:09.140" end="2:09.320">い</span><span begin="2:09.320" end="2:09.440">て</span><span tts:ruby="container"><span tts:ruby="base">咲</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:09.440" end="2:09.880">さ</span></span></span><span begin="2:09.880" end="2:10.080">い</span><span begin="2:10.080" end="2:10.260">て</span><span tts:ruby="container"><span tts:ruby="base">爆</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:10.260" end="2:10.480">は</span></span></span><span begin="2:10.480" end="2:10.680">ぜ</span><span begin="2:10.680" end="2:11.080">ろ</span><span ttm:role="x-translation">绽放吧 绽放吧 爆裂吧</span><span ttm:role="x-roman">saite saite hazero</span></p><p begin="2:11.380" end="2:14.360" itunes:key="L35" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">識</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:11.380" end="2:11.640">し</span></span></span><span begin="2:11.640" end="2:11.840">り</span><span begin="2:11.840" end="2:12.240">た</span><span begin="2:12.240" end="2:12.380">い</span><span begin="2:12.380" end="2:12.620">な</span><span begin="2:12.620" end="2:13.180">ら</span><span tts:ruby="container"><span tts:ruby="base">目</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:13.180" end="2:13.360">め</span></span></span><span tts:ruby="container"><span tts:ruby="base">覚</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:13.360" end="2:13.580">ざ</span></span></span><span begin="2:13.580" end="2:13.760">め</span><span begin="2:13.760" end="2:14.360">よ</span><span ttm:role="x-translation">若想知晓就觉醒吧</span><span ttm:role="x-roman">shiritai nara mezameyo</span></p><p begin="2:14.520" end="2:17.380" itunes:key="L36" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:14.520" end="2:14.740">か</span><span tts:ruby="text" begin="2:14.740" end="2:14.920">ら</span></span></span><span tts:ruby="container"><span tts:ruby="base">回</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:14.920" end="2:15.050">ま</span><span tts:ruby="text" begin="2:15.050" end="2:15.240">わ</span></span></span><span begin="2:15.240" end="2:15.420">り</span><span begin="2:15.420" end="2:15.540">し</span><span begin="2:15.540" end="2:15.860">た</span><span begin="2:16.280" end="2:16.460">ダ</span><span begin="2:16.460" end="2:16.570">サ</span><span begin="2:16.570" end="2:16.700">い</span><span begin="2:16.700" end="2:16.813">イ</span><span begin="2:16.813" end="2:17.020">メー</span><span begin="2:17.020" end="2:17.120">ジ</span><span begin="2:17.120" end="2:17.380">が</span><span ttm:role="x-translation">徒劳无功的土气形象</span><span ttm:role="x-roman">karamawari shita dasai imēji ga</span></p><p begin="2:17.660" end="2:19.700" itunes:key="L37" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">現</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:17.660" end="2:17.840">げ</span><span tts:ruby="text" begin="2:17.840" end="2:18.060">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">実</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:18.060" end="2:18.280">じ</span><span tts:ruby="text" begin="2:18.280" end="2:18.400">つ</span></span></span><span begin="2:18.400" end="2:18.640">を</span><span begin="2:18.640" end="2:19.020">ジャッ</span><span begin="2:19.020" end="2:19.120">ク</span><span begin="2:19.120" end="2:19.240">し</span><span begin="2:19.240" end="2:19.330">て</span><span begin="2:19.330" end="2:19.420">い</span><span begin="2:19.420" end="2:19.700">る?</span><span ttm:role="x-translation">正在劫持现实吗？</span><span ttm:role="x-roman">genjitsu o jakku shite iru?</span></p><p begin="2:20.780" end="2:25.000" itunes:key="L38" ttm:agent="v1"><span begin="2:20.780" end="2:21.020">で</span><span begin="2:21.020" end="2:21.180">も</span><span tts:ruby="container"><span tts:ruby="base">大</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:21.180" end="2:21.340">だ</span><span tts:ruby="text" begin="2:21.340" end="2:21.480">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">丈</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:21.480" end="2:21.580">じょ</span><span tts:ruby="text" begin="2:21.580" end="2:21.630">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">夫</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:21.630" end="2:21.793">ぶ</span></span></span> <span tts:ruby="container"><span tts:ruby="base">一</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:21.793" end="2:21.960">い</span><span tts:ruby="text" begin="2:21.960" end="2:22.260">ち</span></span></span><span tts:ruby="container"><span tts:ruby="base">番</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:22.260" end="2:22.420">ば</span><span tts:ruby="text" begin="2:22.420" end="2:22.560">ん</span></span></span><span begin="2:22.560" end="2:22.680">ダ</span><span begin="2:22.680" end="2:22.920">サ</span><span begin="2:22.920" end="2:23.040">い</span><span begin="2:23.040" end="2:23.320">の</span><span begin="2:23.320" end="2:25.000">は</span><span ttm:role="x-translation">但没关系 最土气的</span><span ttm:role="x-roman">demo daijōbu ichiban dasai no wa</span></p><p begin="2:25.640" end="2:27.520" itunes:key="L39" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">私</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:25.640" end="2:25.860">わ</span><span tts:ruby="text" begin="2:25.860" end="2:26.060">た</span><span tts:ruby="text" begin="2:26.060" end="2:26.160">し</span></span></span><span begin="2:26.160" end="2:26.480">と</span> <span begin="2:26.480" end="2:26.620">お</span><span tts:ruby="container"><span tts:ruby="base">前</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:26.620" end="2:26.780">ま</span><span tts:ruby="text" begin="2:26.780" end="2:26.920">え</span></span></span><span begin="2:26.920" end="2:27.200">だ</span><span begin="2:27.200" end="2:27.520">よ</span><span ttm:role="x-translation">是我 还有你啊</span><span ttm:role="x-roman">watashi to omae da yo</span></p><p begin="2:28.940" end="2:30.950" itunes:key="L40" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">何</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:28.940" end="2:29.160">な</span><span tts:ruby="text" begin="2:29.160" end="2:29.260">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">回</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:29.260" end="2:29.520">か</span><span tts:ruby="text" begin="2:29.520" end="2:29.620">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:29.620" end="2:29.760">う</span></span></span><span begin="2:29.760" end="2:29.960">ま</span><span begin="2:29.960" end="2:30.060">れ</span><span begin="2:30.060" end="2:30.360">たっ</span><span begin="2:30.360" end="2:30.540">て</span><span begin="2:30.540" end="2:30.843">きっ</span><span begin="2:30.843" end="2:30.950">と</span><span ttm:role="x-translation">无论出生多少次也一定</span><span ttm:role="x-roman">nankai umaretatte kitto</span></p><p begin="2:31.080" end="2:34.120" itunes:key="L41" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">足</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:31.080" end="2:31.300">た</span></span></span><span begin="2:31.300" end="2:31.600">り</span><span begin="2:31.600" end="2:31.760">な</span><span begin="2:31.760" end="2:31.900">い</span><span tts:ruby="container"><span tts:ruby="base">私</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:31.900" end="2:32.060">わ</span><span tts:ruby="text" begin="2:32.060" end="2:32.300">た</span><span tts:ruby="text" begin="2:32.300" end="2:32.440">し</span></span></span><span begin="2:32.440" end="2:32.620">よ</span> <span tts:ruby="container"><span tts:ruby="base">続</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:32.620" end="2:32.900">つ</span><span tts:ruby="text" begin="2:32.900" end="2:33.000">づ</span></span></span><span begin="2:33.000" end="2:33.160">い</span><span begin="2:33.160" end="2:33.420">て</span><span begin="2:33.420" end="2:33.663">ゆ</span><span begin="2:33.663" end="2:34.120">け</span><span ttm:role="x-translation">依然不够完美的我啊 继续走下去吧</span><span ttm:role="x-roman">tarinai watashi yo tsuzuite yuke</span></p><p begin="2:34.220" end="2:37.080" itunes:key="L42" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">怪</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:34.220" end="2:34.380">け</span></span></span><span tts:ruby="container"><span tts:ruby="base">我</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:34.380" end="2:34.600">が</span></span></span><span begin="2:34.600" end="2:34.720">し</span><span begin="2:34.720" end="2:35.040">たっ</span><span begin="2:35.040" end="2:35.540">て</span><span tts:ruby="container"><span tts:ruby="base">「気</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:35.760" end="2:35.980">き</span></span></span><span begin="2:35.980" end="2:36.180">が</span><span begin="2:36.180" end="2:36.300">し</span><span begin="2:36.300" end="2:36.580">た」っ</span><span begin="2:36.580" end="2:37.080">て</span><span ttm:role="x-translation">即便受伤了 即便“觉得受了伤”</span><span ttm:role="x-roman">kega shitatte 「ki ga shita」 tte</span></p><p begin="2:37.320" end="2:39.560" itunes:key="L43" ttm:agent="v1"><span begin="2:37.320" end="2:37.560">身</span><span begin="2:37.560" end="2:37.820">体</span><span begin="2:37.820" end="2:38.040">は</span><span begin="2:38.040" end="2:38.320">すっ</span><span tts:ruby="container"><span tts:ruby="base">呆</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:38.320" end="2:38.620">と</span><span tts:ruby="text" begin="2:38.620" end="2:38.880">ぼ</span></span></span><span begin="2:38.880" end="2:39.100">け</span><span begin="2:39.100" end="2:39.220">て</span><span begin="2:39.220" end="2:39.340">い</span><span begin="2:39.340" end="2:39.430">る</span><span begin="2:39.430" end="2:39.560">ぞ</span><span ttm:role="x-translation">身体也还在装傻充愣哦</span><span ttm:role="x-roman">karada wa suttobokete iru zo</span></p><p begin="2:39.560" end="2:41.000" itunes:key="L44" ttm:agent="v1"><span begin="2:39.560" end="2:39.860">お</span><span tts:ruby="container"><span tts:ruby="base">前</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:39.860" end="2:40.220">ま</span><span tts:ruby="text" begin="2:40.220" end="2:40.440">え</span></span></span><span begin="2:40.440" end="2:40.660">は</span><span begin="2:40.660" end="2:40.830">ど</span><span begin="2:40.830" end="2:41.000">う?</span><span ttm:role="x-translation">你又如何呢？</span><span ttm:role="x-roman">omae wa dō?</span></p><p begin="2:41.380" end="2:43.340" itunes:key="L45" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">冗</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:41.380" end="2:41.660">じょ</span><span tts:ruby="text" begin="2:41.660" end="2:41.740">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">談</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:41.740" end="2:41.880">だ</span><span tts:ruby="text" begin="2:41.880" end="2:42.020">ん</span></span></span><span begin="2:42.020" end="2:42.200">み</span><span begin="2:42.200" end="2:42.400">た</span><span begin="2:42.400" end="2:42.520">い</span><span begin="2:42.520" end="2:42.780">な</span><span begin="2:42.780" end="2:42.980">フィ</span><span begin="2:42.980" end="2:43.150">ナー</span><span begin="2:43.150" end="2:43.340">レ</span><span ttm:role="x-translation">如同玩笑般的谢幕</span><span ttm:role="x-roman">jōdan mitai na fināre</span></p><p begin="2:43.560" end="2:46.500" itunes:key="L46" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">私</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:43.560" end="2:43.780">わ</span><span tts:ruby="text" begin="2:43.780" end="2:44.000">た</span><span tts:ruby="text" begin="2:44.000" end="2:44.100">し</span></span></span><span begin="2:44.100" end="2:44.360">だ</span><span begin="2:44.360" end="2:44.580">け</span><span begin="2:44.580" end="2:44.860">が</span><span tts:ruby="container"><span tts:ruby="base">笑っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:45.120" end="2:45.320">わ</span><span tts:ruby="text" begin="2:45.320" end="2:45.440">ら</span><span tts:ruby="text" begin="2:45.440" end="2:45.560">っ</span></span></span><span begin="2:45.560" end="2:45.920">て</span><span begin="2:45.920" end="2:46.300">な</span><span begin="2:46.300" end="2:46.500">い</span><span ttm:role="x-translation">唯独我没有露出笑颜</span><span ttm:role="x-roman">watashi dake ga warattenai</span></p><p begin="2:46.700" end="2:49.540" itunes:key="L47" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">笑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:46.700" end="2:46.900">わ</span><span tts:ruby="text" begin="2:46.900" end="2:47.040">ら</span></span></span><span begin="2:47.040" end="2:47.200">え</span><span begin="2:47.200" end="2:47.320">な</span><span begin="2:47.320" end="2:47.420">い</span><span begin="2:47.420" end="2:47.500">ん</span><span begin="2:47.500" end="2:47.660">だ</span><span begin="2:47.660" end="2:47.980">よ</span> <span tts:ruby="container"><span tts:ruby="base">行</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:48.240" end="2:48.460">い</span></span></span><span begin="2:48.460" end="2:48.760">け</span><span begin="2:48.760" end="2:48.920">る</span><span begin="2:48.920" end="2:49.040">ん</span><span begin="2:49.040" end="2:49.220">だ</span><span begin="2:49.220" end="2:49.540">よ</span><span ttm:role="x-translation">笑不出来啊 还能走下去啊</span><span ttm:role="x-roman">waraenai n da yo ikeru n da yo</span></p><p begin="2:49.800" end="2:54.520" itunes:key="L48" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">命</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:49.800" end="2:50.020">い</span><span tts:ruby="text" begin="2:50.020" end="2:50.220">の</span><span tts:ruby="text" begin="2:50.220" end="2:50.320">ち</span></span></span><span begin="2:50.320" end="2:50.600">で</span><span begin="2:50.600" end="2:50.780">ボ</span><span begin="2:50.780" end="2:51.020">コ</span><span begin="2:51.020" end="2:51.920">れ</span><span tts:ruby="container"><span tts:ruby="base">頬</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:52.180" end="2:52.310">ほ</span><span tts:ruby="text" begin="2:52.310" end="2:52.663">ほ</span></span></span><span begin="2:52.663" end="2:52.920">と</span><span tts:ruby="container"><span tts:ruby="base">一</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:52.920" end="2:53.180">い</span><span tts:ruby="text" begin="2:53.180" end="2:53.300">っ</span></span></span><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:53.300" end="2:54.300">しょ</span><span tts:ruby="text" begin="2:54.300" end="2:54.520">う</span></span></span><span ttm:role="x-translation">用生命去扇那脸颊与一生的耳光</span><span ttm:role="x-roman">inochi de bokore hoho to isshō</span></p><p begin="2:54.820" end="2:59.920" itunes:key="L49" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">陽</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:54.820" end="2:55.100">ひ</span></span></span><span begin="2:55.100" end="2:55.240">は</span><span tts:ruby="container"><span tts:ruby="base">暮</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:55.240" end="2:55.480">く</span></span></span><span begin="2:55.480" end="2:56.000">れ</span><span begin="2:56.000" end="2:56.140">て</span><span begin="2:56.140" end="2:56.240">ゆ</span><span begin="2:56.240" end="2:56.760">く</span> <span begin="2:57.980" end="2:58.200">お</span><span begin="2:58.200" end="2:58.420">な</span><span begin="2:58.420" end="2:58.560">か</span><span tts:ruby="container"><span tts:ruby="base">減っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:58.560" end="2:59.080">へ</span><span tts:ruby="text" begin="2:59.080" end="2:59.183">っ</span></span></span><span begin="2:59.183" end="2:59.300">て</span><span begin="2:59.300" end="2:59.403">ゆ</span><span begin="2:59.403" end="2:59.920">く</span><span ttm:role="x-translation">夕阳西下 肚子渐渐饿了</span><span ttm:role="x-roman">hi wa kurete yuku onaka hette yuku</span></p><p begin="3:01.080" end="3:06.460" itunes:key="L50" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">歳</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:01.080" end="3:01.260">と</span><span tts:ruby="text" begin="3:01.260" end="3:01.520">し</span></span></span><span begin="3:01.520" end="3:01.720">を</span><span tts:ruby="container"><span tts:ruby="base">取っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:01.720" end="3:02.060">と</span><span tts:ruby="text" begin="3:02.060" end="3:02.280">っ</span></span></span><span begin="3:02.280" end="3:02.380">て</span><span begin="3:02.380" end="3:02.500">ゆ</span><span begin="3:02.500" end="3:03.000">く</span> <span begin="3:04.320" end="3:04.820">そ</span><span begin="3:04.820" end="3:05.400">れ</span><span begin="3:05.400" end="3:05.600">で</span><span begin="3:05.600" end="3:06.460">も</span><span ttm:role="x-translation">岁数渐渐增长 即便如此</span><span ttm:role="x-roman">toshi o totte yuku soredemo</span></p><p begin="3:07.340" end="3:12.540" itunes:key="L51" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:07.340" end="3:07.540">い</span></span></span><span begin="3:07.540" end="3:07.740">き</span><span tts:ruby="container"><span tts:ruby="base">残</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:07.740" end="3:07.920">の</span><span tts:ruby="text" begin="3:07.920" end="3:08.380">こ</span></span></span><span begin="3:08.380" end="3:08.520">し</span><span begin="3:08.520" end="3:08.640">て</span><span begin="3:08.640" end="3:08.740">い</span><span begin="3:08.740" end="3:09.260">る</span> <span tts:ruby="container"><span tts:ruby="base">情</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:10.420" end="3:10.620">な</span><span tts:ruby="text" begin="3:10.620" end="3:10.860">さ</span></span></span><span begin="3:10.860" end="3:11.040">け</span><span begin="3:11.040" end="3:11.460">な</span><span begin="3:11.460" end="3:11.620">い</span><span begin="3:11.620" end="3:11.840">ほ</span><span begin="3:11.840" end="3:12.540">ど</span><span ttm:role="x-translation">还苟延残喘着 到了令人难堪的程度</span><span ttm:role="x-roman">ikinokoshite iru nasakenai hodo</span></p><p begin="3:13.160" end="3:14.433" itunes:key="L52" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">行</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:13.160" end="3:13.400">い</span></span></span><span begin="3:13.400" end="3:13.680">け</span><span begin="3:13.680" end="3:13.880">る</span><span begin="3:13.880" end="3:13.980">ん</span><span begin="3:13.980" end="3:14.183">だ</span><span begin="3:14.183" end="3:14.433">な?</span><span ttm:role="x-translation">还能走下去吧？</span><span ttm:role="x-roman">ikeru n da na?</span></p><p begin="3:14.720" end="3:18.580" itunes:key="L53" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">命</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:14.720" end="3:14.960">い</span><span tts:ruby="text" begin="3:14.960" end="3:15.140">の</span><span tts:ruby="text" begin="3:15.140" end="3:15.220">ち</span></span></span><span begin="3:15.220" end="3:15.540">で</span><span begin="3:15.540" end="3:15.743">ボ</span><span begin="3:15.743" end="3:15.943">コ</span><span begin="3:15.943" end="3:16.860">れ</span><span tts:ruby="container"><span tts:ruby="base">頬</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:17.080" end="3:17.300">ほ</span><span tts:ruby="text" begin="3:17.300" end="3:17.580">ほ</span></span></span><span begin="3:17.580" end="3:17.860">と</span><span tts:ruby="container"><span tts:ruby="base">一</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:17.860" end="3:18.080">い</span><span tts:ruby="text" begin="3:18.080" end="3:18.220">っ</span></span></span><span tts:ruby="container"><span tts:ruby="base">生</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:18.220" end="3:18.400">しょ</span><span tts:ruby="text" begin="3:18.400" end="3:18.580">う</span></span></span><span ttm:role="x-translation">用生命去扇那脸颊与一生的耳光</span><span ttm:role="x-roman">inochi de bokore hoho to isshō</span></p></div></body></tt>