<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name>The Weeknd</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v2"><ttm:name>Faye Wong</ttm:name></ttm:agent><amll:meta key="musicName" value="Hong Kong (feat. 王菲季候風)"/><amll:meta key="musicName" value="Hong Kong (feat. 王菲季候风)"/><amll:meta key="artists" value="The Weeknd"/><amll:meta key="album" value="Hong Kong (feat. 王菲季候風) - Single"/><amll:meta key="isrc" value="USUG12611250"/><amll:meta key="appleMusicId" value="6829122414"/><amll:meta key="spotifyId" value="1824ElVTa8XiWOjOlujl81"/><amll:meta key="ncmMusicId" value="3456047164"/><amll:meta key="ttmlAuthorGithub" value="64765950"/><amll:meta key="ttmlAuthorGithubLogin" value="Thereallo1026"/><amll:meta key="ttmlAuthorLyricify" value="Thereallo"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><transliterations><transliteration xml:lang="zh-Latn-jyutping"><text for="L12"><span begin="1:09.650" end="1:09.939">ze</span> <span begin="1:09.939" end="1:10.160">ci</span> <span begin="1:10.160" end="1:10.381">gwai</span> <span begin="1:10.381" end="1:10.639">hau</span> <span begin="1:10.639" end="1:12.999">fung</span> <span begin="1:12.999" end="1:13.390">ceoi</span> <span begin="1:13.390" end="1:13.590">dak</span> <span begin="1:13.590" end="1:13.800">naa</span> <span begin="1:13.800" end="1:14.080">joeng</span> <span begin="1:14.080" end="1:15.160">hung</span></text><text for="L13"><span begin="1:16.640" end="1:16.800">fong</span> <span begin="1:16.800" end="1:17.050">fat</span> <span begin="1:17.050" end="1:17.300">sai</span> <span begin="1:17.300" end="1:17.570">soeng</span> <span begin="1:17.570" end="1:18.096">jat</span> <span begin="1:18.096" end="1:18.573">cit</span> <span begin="1:19.113" end="1:19.333">ji</span> <span begin="1:19.333" end="1:19.705">ging</span> <span begin="1:19.705" end="1:19.954">siu</span> <span begin="1:19.954" end="1:20.345">sat</span> <span begin="1:20.445" end="1:20.825">so</span> <span begin="1:20.825" end="1:23.215">zung</span></text><text for="L14"><span begin="1:23.630" end="1:23.830">nei</span> <span begin="1:23.830" end="1:24.090">ci</span> <span begin="1:24.090" end="1:24.259">gwai</span> <span begin="1:24.259" end="1:24.580">hau</span> <span begin="1:24.580" end="1:26.777">fung</span> <span begin="1:26.997" end="1:27.387">dai</span> <span begin="1:27.387" end="1:27.557">dong</span> <span begin="1:27.557" end="1:27.747">gai</span> <span begin="1:27.747" end="1:28.017">waak</span> <span begin="1:28.017" end="1:28.428">cyun</span> <span begin="1:28.428" end="1:28.887">jaa</span> <span begin="1:28.887" end="1:29.316">mou</span> <span begin="1:29.316" end="1:30.197">jung</span></text><text for="L15"><span begin="1:30.637" end="1:30.837">jin</span> <span begin="1:30.837" end="1:31.031">hau</span> <span begin="1:31.031" end="1:31.236">si</span> <span begin="1:31.236" end="1:31.517">coeng</span> <span begin="1:31.517" end="1:32.807">hung</span> <span begin="1:32.807" end="1:33.267">gaa</span> <span begin="1:33.267" end="1:33.737">soeng</span> <span begin="1:34.076" end="1:34.427">bat</span> <span begin="1:34.427" end="1:34.767">sei</span> <span begin="1:34.767" end="1:35.086">dik</span> <span begin="1:35.086" end="1:35.586">sam</span> <span begin="1:35.586" end="1:36.737">tung</span></text><text for="L25"><span begin="2:47.292" end="2:47.482">naa</span> <span begin="2:47.482" end="2:47.712">ci</span> <span begin="2:47.712" end="2:47.902">gwai</span> <span begin="2:47.902" end="2:48.212">hau</span> <span begin="2:48.212" end="2:50.582">fung</span> <span begin="2:50.582" end="2:51.002">ceoi</span> <span begin="2:51.002" end="2:51.202">dak</span> <span begin="2:51.202" end="2:51.382">naa</span> <span begin="2:51.382" end="2:51.711">joeng</span> <span begin="2:51.711" end="2:52.802">hung</span></text><text for="L26"><span begin="2:54.292" end="2:54.472">fong</span> <span begin="2:54.472" end="2:54.682">fat</span> <span begin="2:54.682" end="2:54.872">sai</span> <span begin="2:54.872" end="2:55.112">soeng</span> <span begin="2:55.112" end="2:55.652">jat</span> <span begin="2:55.652" end="2:56.102">cit</span> <span begin="2:56.642" end="2:56.882">ji</span> <span begin="2:56.882" end="2:57.292">ging</span> <span begin="2:57.292" end="2:57.542">siu</span> <span begin="2:57.542" end="2:57.982">sat</span> <span begin="2:57.982" end="2:58.482">so</span> <span begin="2:58.482" end="3:00.582">zung</span></text><text for="L27"><span begin="3:01.242" end="3:01.482">nei</span> <span begin="3:01.482" end="3:01.661">ci</span> <span begin="3:01.661" end="3:01.912">gwai</span> <span begin="3:01.912" end="3:02.192">hau</span> <span begin="3:02.192" end="3:04.522">fung</span> <span begin="3:04.522" end="3:04.982">dai</span> <span begin="3:04.982" end="3:05.162">dong</span> <span begin="3:05.162" end="3:05.352">gai</span> <span begin="3:05.352" end="3:05.632">waak</span> <span begin="3:05.632" end="3:06.042">cyun</span> <span begin="3:06.042" end="3:06.472">jaa</span> <span begin="3:06.472" end="3:06.902">mou</span> <span begin="3:06.902" end="3:07.762">jung</span></text><text for="L28"><span begin="3:08.216" end="3:08.442">jin</span> <span begin="3:08.442" end="3:08.642">hau</span> <span begin="3:08.642" end="3:08.852">si</span> <span begin="3:08.852" end="3:09.142">coeng</span> <span begin="3:09.142" end="3:10.412">hung</span> <span begin="3:10.412" end="3:10.852">gaa</span> <span begin="3:10.852" end="3:11.262">soeng</span> <span begin="3:11.672" end="3:12.032">bat</span> <span begin="3:12.032" end="3:12.332">sei</span> <span begin="3:12.332" end="3:12.702">dik</span> <span begin="3:12.702" end="3:13.229">sam</span> <span begin="3:13.229" end="3:14.630">tung</span></text></transliteration></transliterations><songwriters><songwriter>The Weeknd</songwriter><songwriter>Chen Xiaoxia</songwriter><songwriter>Yang Lide</songwriter><songwriter>Poon Yuen-Leung</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:14.630"><div begin="15.670" end="3:14.630"><p begin="15.670" end="19.730" itunes:key="L1" ttm:agent="v1"><span begin="15.670" end="16.050">There</span> <span begin="16.050" end="16.490">was</span> <span begin="16.490" end="17.390">something</span> <span begin="17.390" end="17.840">in</span> <span begin="17.840" end="18.270">the</span> <span begin="18.270" end="19.730">air</span><span ttm:role="x-translation" xml:lang="zh-CN">空氣中暗湧著某種悸動</span></p><p begin="21.610" end="28.779" itunes:key="L2" ttm:agent="v1"><span begin="21.610" end="21.770">I</span> <span begin="21.770" end="22.110">knew</span> <span begin="22.110" end="22.320">that</span> <span begin="22.320" end="22.800">in</span> <span begin="22.800" end="23.240">that</span> <span begin="23.240" end="24.090">moment</span> <span begin="24.090" end="24.560">I</span> <span begin="24.560" end="24.940">would</span> <span begin="25.230" end="25.629">burn</span> <span begin="25.629" end="25.900">the</span> <span begin="25.900" end="26.420">world</span> <span begin="26.420" end="26.700">to</span> <span begin="26.700" end="27.120">keep</span> <span begin="27.120" end="27.879">you</span> <span begin="27.879" end="28.779">warm</span><span ttm:role="x-translation" xml:lang="zh-CN">那一刻我就明白 願焚盡世界只為溫暖你</span></p><p begin="29.580" end="33.699" itunes:key="L3" ttm:agent="v1"><span begin="29.580" end="30.000">But</span> <span begin="30.000" end="30.449">my</span> <span begin="30.449" end="30.850">life</span> <span begin="30.850" end="31.290">won&apos;t</span> <span begin="31.290" end="31.720">let</span> <span begin="31.720" end="32.170">me</span> <span begin="32.170" end="33.699">stay</span><span ttm:role="x-translation" xml:lang="zh-CN">可我的生活 容不得我在此停留</span></p><p begin="35.540" end="38.860" itunes:key="L4" ttm:agent="v1"><span begin="35.540" end="35.720">So</span> <span begin="35.720" end="36.110">if</span> <span begin="36.110" end="36.339">we</span> <span begin="36.339" end="37.209">never</span> <span begin="37.209" end="37.640">speak</span> <span begin="37.640" end="38.860">again</span><span ttm:role="x-translation" xml:lang="zh-CN">所以就算往後不再聯絡</span></p><p begin="39.110" end="43.080" itunes:key="L5" ttm:agent="v1"><span begin="39.110" end="39.279">At</span> <span begin="39.279" end="39.629">least</span> <span begin="39.629" end="39.870">we</span> <span begin="39.870" end="40.240">still</span> <span begin="40.240" end="40.949">have</span> <span begin="40.949" end="43.080">soul</span><span ttm:role="x-translation" xml:lang="zh-CN">至少我們的靈魂依然相通</span></p><p begin="43.780" end="48.030" itunes:key="L6" ttm:agent="v1"><span begin="43.780" end="44.000">And</span> <span begin="44.000" end="44.440">only</span> <span begin="44.440" end="45.088">God</span> <span begin="45.088" end="45.320">could</span> <span begin="45.320" end="47.080">separate</span> <span begin="47.080" end="48.030">us</span><span ttm:role="x-translation" xml:lang="zh-CN">唯有上帝 才能將你我分開</span></p><p begin="49.620" end="53.330" itunes:key="L7" ttm:agent="v1"><span begin="49.620" end="50.029">On</span> <span begin="50.029" end="50.300">my</span> <span begin="50.300" end="50.800">skin</span> <span begin="50.800" end="51.200">you</span> <span begin="51.200" end="51.600">left</span> <span begin="51.600" end="52.010">your</span> <span begin="52.010" end="52.450">mark</span> <span begin="52.450" end="52.920">the</span> <span begin="52.920" end="53.330">night</span><span ttm:role="x-translation" xml:lang="zh-CN">你在我的肌膚上 留下了印記</span></p><p begin="53.330" end="56.719" itunes:key="L8" ttm:agent="v1"><span begin="53.330" end="53.810">You</span> <span begin="53.810" end="54.259">held</span> <span begin="54.259" end="54.930">me</span> <span begin="54.930" end="56.719">close</span><span ttm:role="x-translation" xml:lang="zh-CN">就在那一夜 你將我緊擁入懷</span></p><p begin="57.720" end="1:02.189" itunes:key="L9" ttm:agent="v1"><span begin="57.720" end="57.890">And</span> <span begin="57.890" end="58.080">in</span> <span begin="58.080" end="58.290">the</span> <span begin="58.290" end="59.150">morning</span> <span begin="59.150" end="59.529">we</span> <span begin="59.529" end="59.780">turned</span> <span begin="59.780" end="1:00.149">to</span> <span begin="1:00.149" end="1:01.020">stran</span><span begin="1:01.020" end="1:02.189">gers</span><span ttm:role="x-translation" xml:lang="zh-CN">可清晨一到 我們便形同陌路</span></p><p begin="1:03.379" end="1:06.641" itunes:key="L10" ttm:agent="v1"><span begin="1:03.379" end="1:03.569">But</span> <span begin="1:03.569" end="1:03.950">don&apos;t</span> <span begin="1:03.950" end="1:04.200">you</span> <span begin="1:04.200" end="1:05.540">hesitate</span> <span begin="1:05.540" end="1:05.989">to</span> <span begin="1:05.989" end="1:06.641">call</span><span ttm:role="x-translation" xml:lang="zh-CN">但只要你想 隨時都能打給我</span></p><p begin="1:06.820" end="1:10.700" itunes:key="L11" ttm:agent="v1"><span begin="1:06.820" end="1:07.060">I&apos;m</span> <span begin="1:07.060" end="1:07.719">posted</span> <span begin="1:07.719" end="1:08.130">in</span> <span begin="1:08.130" end="1:08.770">Hong</span> <span begin="1:08.770" end="1:10.700">Kong</span><span ttm:role="x-translation" xml:lang="zh-CN">我就留在香港</span></p><p begin="1:09.650" end="1:16.570" itunes:key="L12" ttm:agent="v2"><span begin="1:09.650" end="1:09.939">這</span><span begin="1:09.939" end="1:10.160">次</span><span begin="1:10.160" end="1:10.381">季</span><span begin="1:10.381" end="1:10.639">候</span><span begin="1:10.639" end="1:12.999">風</span> <span begin="1:12.999" end="1:13.390">吹</span><span begin="1:13.390" end="1:13.590">得</span><span begin="1:13.590" end="1:13.800">那</span><span begin="1:13.800" end="1:14.080">樣</span><span begin="1:14.080" end="1:15.160">空</span><span ttm:role="x-bg" begin="1:14.960" end="1:16.570"><span begin="1:14.960" end="1:15.770">(Oh,</span> <span begin="1:15.770" end="1:16.570">yeah)</span></span></p><p begin="1:16.640" end="1:23.638" itunes:key="L13" ttm:agent="v2"><span begin="1:16.640" end="1:16.800">彷</span><span begin="1:16.800" end="1:17.050">佛</span><span begin="1:17.050" end="1:17.300">世</span><span begin="1:17.300" end="1:17.570">上</span><span begin="1:17.570" end="1:18.096">一</span><span begin="1:18.096" end="1:18.573">切</span> <span begin="1:19.113" end="1:19.333">已</span><span begin="1:19.333" end="1:19.705">經</span><span begin="1:19.705" end="1:19.954">消</span><span begin="1:19.954" end="1:20.345">失</span><span begin="1:20.445" end="1:20.825">所</span><span begin="1:20.825" end="1:23.215">蹤</span><span ttm:role="x-bg" begin="1:21.838" end="1:23.638"><span begin="1:21.838" end="1:22.747">(Oh,</span> <span begin="1:22.747" end="1:23.638">whoa)</span></span></p><p begin="1:23.630" end="1:30.197" itunes:key="L14" ttm:agent="v2"><span begin="1:23.630" end="1:23.830">你</span><span begin="1:23.830" end="1:24.090">似</span><span begin="1:24.090" end="1:24.259">季</span><span begin="1:24.259" end="1:24.580">候</span><span begin="1:24.580" end="1:26.777">風</span> <span begin="1:26.997" end="1:27.387">抵</span><span begin="1:27.387" end="1:27.557">擋</span><span begin="1:27.557" end="1:27.747">計</span><span begin="1:27.747" end="1:28.017">劃</span><span begin="1:28.017" end="1:28.428">全</span><span begin="1:28.428" end="1:28.887">也</span><span begin="1:28.887" end="1:29.316">無</span><span begin="1:29.316" end="1:30.197">用</span><span ttm:role="x-bg" begin="1:25.397" end="1:27.887"><span begin="1:25.397" end="1:26.277">(Oh,</span> <span begin="1:26.277" end="1:27.887">whoa)</span></span></p><p begin="1:30.637" end="1:36.737" itunes:key="L15" ttm:agent="v2"><span begin="1:30.637" end="1:30.837">然</span><span begin="1:30.837" end="1:31.031">後</span><span begin="1:31.031" end="1:31.236">是</span><span begin="1:31.236" end="1:31.517">場</span><span begin="1:31.517" end="1:32.807">空</span> <span begin="1:32.807" end="1:33.267">加</span><span begin="1:33.267" end="1:33.737">上</span><span begin="1:34.076" end="1:34.427">不</span><span begin="1:34.427" end="1:34.767">死</span><span begin="1:34.767" end="1:35.086">的</span><span begin="1:35.086" end="1:35.586">心</span><span begin="1:35.586" end="1:36.737">痛</span></p><p begin="1:53.266" end="1:57.376" itunes:key="L16" ttm:agent="v1"><span begin="1:53.266" end="1:53.696">Still</span> <span begin="1:53.696" end="1:54.986">remember</span> <span begin="1:54.986" end="1:55.437">when</span> <span begin="1:55.437" end="1:55.886">we</span> <span begin="1:55.886" end="1:57.376">met</span><span ttm:role="x-translation" xml:lang="zh-CN">還記得我們初遇的時刻</span></p><p begin="1:59.166" end="2:06.566" itunes:key="L17" ttm:agent="v1"><span begin="1:59.166" end="1:59.366">We</span> <span begin="1:59.366" end="1:59.997">barely</span> <span begin="1:59.997" end="2:00.406">knew</span> <span begin="2:00.406" end="2:00.857">each</span> <span begin="2:00.857" end="2:01.757">other</span> <span begin="2:01.757" end="2:02.177">but</span> <span begin="2:02.177" end="2:02.696">that</span> <span begin="2:02.696" end="2:03.496">tension</span> <span begin="2:03.496" end="2:04.597">never</span> <span begin="2:04.597" end="2:06.566">left</span><span ttm:role="x-translation" xml:lang="zh-CN">明明才剛認識 彼此間的張力卻從未消散</span></p><p begin="2:07.166" end="2:11.386" itunes:key="L18" ttm:agent="v1"><span begin="2:07.166" end="2:07.596">Now</span> <span begin="2:07.596" end="2:08.065">you&apos;re</span> <span begin="2:08.065" end="2:08.926">sleeping</span> <span begin="2:08.926" end="2:09.376">in</span> <span begin="2:09.376" end="2:09.946">my</span> <span begin="2:09.946" end="2:11.386">bed</span><span ttm:role="x-translation" xml:lang="zh-CN">如今你正安睡在我的枕邊</span></p><p begin="2:13.096" end="2:20.546" itunes:key="L19" ttm:agent="v1"><span begin="2:13.096" end="2:13.296">A</span> <span begin="2:13.296" end="2:13.646">thing</span> <span begin="2:13.646" end="2:13.886">that</span> <span begin="2:13.886" end="2:14.776">never</span> <span begin="2:14.776" end="2:15.637">started</span> <span begin="2:15.637" end="2:16.996">already</span> <span begin="2:16.996" end="2:17.446">comes</span> <span begin="2:17.446" end="2:17.876">to</span> <span begin="2:17.876" end="2:18.537">an</span> <span begin="2:18.537" end="2:20.546">end</span><span ttm:role="x-translation" xml:lang="zh-CN">還沒來得及開始 卻已悄然走向終局</span></p><p begin="2:21.397" end="2:25.687" itunes:key="L20" ttm:agent="v1"><span begin="2:21.397" end="2:21.607">And</span> <span begin="2:21.607" end="2:21.777">I</span> <span begin="2:21.777" end="2:22.067">know</span> <span begin="2:22.067" end="2:22.624">God</span> <span begin="2:22.624" end="2:22.857">would</span> <span begin="2:22.857" end="2:24.666">separate</span> <span begin="2:24.666" end="2:25.687">us</span><span ttm:role="x-translation" xml:lang="zh-CN">可我知道 上帝終會將你我拆散</span></p><p begin="2:27.236" end="2:34.216" itunes:key="L21" ttm:agent="v1"><span begin="2:27.236" end="2:28.286">Anytime</span> <span begin="2:28.286" end="2:28.716">it</span> <span begin="2:28.716" end="2:29.127">felt</span> <span begin="2:29.127" end="2:29.566">this</span> <span begin="2:29.566" end="2:30.027">good</span> <span begin="2:30.027" end="2:30.516">it</span> <span begin="2:30.516" end="2:30.976">ends</span> <span begin="2:30.976" end="2:31.396">in</span> <span begin="2:31.396" end="2:32.436">tragic</span> <span begin="2:32.436" end="2:34.216">song</span><span ttm:role="x-translation" xml:lang="zh-CN">每當感覺如此美妙 結局總淪為一曲悲歌</span></p><p begin="2:35.224" end="2:39.548" itunes:key="L22" ttm:agent="v1"><span begin="2:35.224" end="2:35.474">I&apos;m</span> <span begin="2:35.474" end="2:35.914">so</span> <span begin="2:35.914" end="2:36.344">used</span> <span begin="2:36.344" end="2:36.814">to</span> <span begin="2:36.814" end="2:37.484">weathering</span> <span begin="2:37.484" end="2:38.557">chan</span><span begin="2:38.557" end="2:39.548">ges</span><span ttm:role="x-translation" xml:lang="zh-CN">我早已習慣 承受所有的變幻</span></p><p begin="2:40.937" end="2:44.278" itunes:key="L23" ttm:agent="v1"><span begin="2:40.937" end="2:41.228">So</span> <span begin="2:41.228" end="2:41.588">if</span> <span begin="2:41.588" end="2:41.828">you</span> <span begin="2:41.828" end="2:42.698">ever</span> <span begin="2:42.698" end="2:43.138">change</span> <span begin="2:43.138" end="2:43.568">your</span> <span begin="2:43.568" end="2:44.278">mind</span><span ttm:role="x-translation" xml:lang="zh-CN">所以若是哪天 你改變了心意</span></p><p begin="2:44.538" end="2:50.059" itunes:key="L24" ttm:agent="v1"><span begin="2:44.538" end="2:44.728">I&apos;m</span> <span begin="2:44.728" end="2:45.338">waiting</span> <span begin="2:45.338" end="2:45.758">in</span> <span begin="2:45.758" end="2:46.398">Hong</span> <span begin="2:46.398" end="2:50.059">Kong</span><span ttm:role="x-translation" xml:lang="zh-CN">我依然在香港等你</span></p><p begin="2:47.292" end="2:54.290" itunes:key="L25" ttm:agent="v2"><span begin="2:47.292" end="2:47.482">這</span><span begin="2:47.482" end="2:47.712">次</span><span begin="2:47.712" end="2:47.902">季</span><span begin="2:47.902" end="2:48.212">候</span><span begin="2:48.212" end="2:50.582">風</span> <span begin="2:50.582" end="2:51.002">吹</span><span begin="2:51.002" end="2:51.202">得</span><span begin="2:51.202" end="2:51.382">那</span><span begin="2:51.382" end="2:51.711">樣</span><span begin="2:51.711" end="2:52.802">空</span><span ttm:role="x-bg" begin="2:52.599" end="2:54.290"><span begin="2:52.599" end="2:53.409">(Oh,</span> <span begin="2:53.409" end="2:54.290">yeah)</span></span></p><p begin="2:54.292" end="3:00.582" itunes:key="L26" ttm:agent="v2"><span begin="2:54.292" end="2:54.472">彷</span><span begin="2:54.472" end="2:54.682">佛</span><span begin="2:54.682" end="2:54.872">世</span><span begin="2:54.872" end="2:55.112">上</span><span begin="2:55.112" end="2:55.652">一</span><span begin="2:55.652" end="2:56.