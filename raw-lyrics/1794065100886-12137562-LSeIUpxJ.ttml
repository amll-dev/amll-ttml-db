<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttx="urn:ttml:extensions:shared-ruby:1"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="夜空"/><amll:meta key="artists" value="鈴木みのり"/><amll:meta key="album" value="夜空"/><amll:meta key="isrc" value="JPVI01904402"/><amll:meta key="ncmMusicId" value="1423038384"/><amll:meta key="ttmlAuthorGithubLogin" value="Mrs4s"/><amll:meta key="ttmlAuthorGithub" value="12137562"/><amll:meta key="ttmlAuthorGithubLogin" value="Mrs4s"/></metadata></head><body dur="04:35.866"><div begin="00:14.620" end="04:25.780"><p begin="00:14.620" end="00:20.480" ttm:agent="v1" itunes:key="L1"><span begin="00:14.620" end="00:15.180" ttx:rubyGroup="1" ttx:rubyText="き|の|う" ttx:rubyTimes="00:14.620,00:14.860 00:14.860,00:15.180 00:15.180,00:15.360">昨</span><span begin="00:15.180" end="00:15.360" ttx:rubyGroup="1">日</span><span begin="00:15.360" end="00:15.900">よ</span><span begin="00:15.900" end="00:16.080">り</span><span begin="00:16.080" end="00:17.000">も</span><span begin="00:17.280" end="00:17.660">きっ</span><span begin="00:17.660" end="00:18.840">と</span><span tts:ruby="container"><span tts:ruby="base">強</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:18.840" end="00:19.080">つ</span><span tts:ruby="text" begin="00:19.080" end="00:19.740">よ</span></span></span><span begin="00:19.740" end="00:20.480">く</span><span ttm:role="x-translation">相比于昨天 我是否变得更坚强了呢</span><span ttm:role="x-roman">kinō yori mo kitto tsuyoku</span></p><p begin="00:20.480" end="00:26.100" ttm:agent="v1" itunes:key="L2"><span begin="00:20.480" end="00:20.860">な</span><span begin="00:20.860" end="00:21.040">れ</span><span begin="00:21.040" end="00:21.540">る</span><span begin="00:21.540" end="00:21.740">か</span><span begin="00:21.740" end="00:22.480">な</span><span begin="00:22.873" end="00:23.120">そ</span><span begin="00:23.120" end="00:23.320">ん</span><span begin="00:23.320" end="00:23.960">な</span><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:24.360" end="00:24.700">こ</span><span tts:ruby="text" begin="00:24.700" end="00:25.400">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">葉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:25.400" end="00:26.100">ば</span></span></span><span ttm:role="x-translation">重复着这几句话语</span><span ttm:role="x-roman">nareru kana sonna kotoba</span></p><p begin="00:26.100" end="00:37.380" ttm:agent="v1" itunes:key="L3"><span tts:ruby="container"><span tts:ruby="base">繰</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:26.100" end="00:26.480">く</span></span></span><span begin="00:26.480" end="00:26.680">り</span><span tts:ruby="container"><span tts:ruby="base">返</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:26.680" end="00:27.000">か</span><span tts:ruby="text" begin="00:27.000" end="00:27.180">え</span></span></span><span begin="00:27.180" end="00:28.200">し</span><span begin="00:28.540" end="00:28.940">ちっ</span><span begin="00:28.940" end="00:29.980">ぽ</span><span begin="00:29.980" end="00:30.360">け</span><span begin="00:30.360" end="00:31.020">な</span><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:31.420" end="00:31.766">こ</span><span tts:ruby="text" begin="00:31.766" end="00:32.840">こ</span><span tts:ruby="text" begin="00:32.840" end="00:33.240">ろ</span></span></span><span begin="00:33.240" end="00:33.980">を</span><span tts:ruby="container"><span tts:ruby="base">試</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:34.240" end="00:34.600">た</span><span tts:ruby="text" begin="00:34.600" end="00:35.480">め</span></span></span><span begin="00:35.480" end="00:35.660">し</span><span begin="00:35.660" end="00:36.020">て</span><span begin="00:36.020" end="00:37.380">る</span><span ttm:role="x-translation">试探着小小的内心</span><span ttm:role="x-roman">kurikaeshi chippoke na kokoro o tameshiteru</span></p><p begin="00:38.120" end="00:50.820" ttm:agent="v1" itunes:key="L4"><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:38.120" end="00:38.500">こ</span><span tts:ruby="text" begin="00:38.500" end="00:38.660">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">葉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:38.660" end="00:39.200">ば</span></span></span><span begin="00:39.200" end="00:39.400">は</span><span begin="00:39.400" end="00:39.900">い</span><span begin="00:39.900" end="00:40.100">ら</span><span begin="00:40.100" end="00:40.780">な</span><span begin="00:40.780" end="00:41.220">い</span><span tts:ruby="container"><span tts:ruby="base">顔</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:41.460" end="00:41.660">か</span><span tts:ruby="text" begin="00:41.660" end="00:42.000">お</span></span></span><span begin="00:42.000" end="00:42.200">を</span><span begin="00:42.200" end="00:42.720">あ</span><span begin="00:42.720" end="00:43.420">げ</span><span tts:ruby="container"><span tts:ruby="base">夜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:43.420" end="00:43.780">よ</span></span></span><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:43.780" end="00:44.796">ぞ</span><span tts:ruby="text" begin="00:44.800" end="00:45.180">ら</span></span></span><span begin="00:45.180" end="00:46.000">を</span><span tts:ruby="container"><span tts:ruby="base">旅</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:46.220" end="00:46.622">た</span><span tts:ruby="text" begin="00:46.622" end="00:47.460">び</span></span></span><span begin="00:47.560" end="00:48.020">し</span><span begin="00:48.020" end="00:49.630">よ</span><span begin="00:49.630" end="00:50.820">う</span><span ttm:role="x-translation">无需多言 抬起头来 踏上这夜空之旅吧</span><span ttm:role="x-roman">kotoba wa iranai kao o age yozora o tabi shiyō</span></p><p begin="00:51.160" end="01:02.240" ttm:agent="v1" itunes:key="L5"><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:51.160" end="00:51.520">ぼ</span><span tts:ruby="text" begin="00:51.520" end="00:51.900">く</span></span></span><span begin="00:51.900" end="00:52.100">ら</span><span begin="00:52.100" end="00:52.620">が</span><span tts:ruby="container"><span tts:ruby="base">描</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:52.620" end="00:52.820">え</span><span tts:ruby="text" begin="00:52.820" end="00:53.340">が</span></span></span><span begin="00:53.340" end="00:53.640">い</span><span begin="00:53.640" end="00:54.020">た</span><span tts:ruby="container"><span tts:ruby="base">未</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:54.020" end="00:54.240">み</span></span></span><span tts:ruby="container"><span tts:ruby="base">来</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:54.240" end="00:54.580">ら</span><span tts:ruby="text" begin="00:54.580" end="00:54.940">い</span></span></span><span begin="00:54.940" end="00:56.460">は</span><span tts:ruby="container"><span tts:ruby="base">遥</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:56.820" end="00:57.200">は</span><span tts:ruby="text" begin="00:57.200" end="00:57.560">る</span></span></span><span begin="00:57.560" end="00:57.720">か</span><span tts:ruby="container"><span tts:ruby="base">遠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:57.720" end="00:58.260">と</span><span tts:ruby="text" begin="00:58.260" end="00:58.620">お</span></span></span><span begin="00:58.620" end="00:58.980">い</span><span tts:ruby="container"><span tts:ruby="base">道</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:58.980" end="00:59.280">み</span><span tts:ruby="text" begin="00:59.280" end="00:59.680">ち</span></span></span><span begin="00:59.680" end="01:00.020">の</span><span tts:ruby="container"><span tts:ruby="base">途</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:00.020" end="01:00.260">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:00.260" end="01:00.540">ちゅ</span><span tts:ruby="text" begin="01:00.540" end="01:02.240">う</span></span></span><span ttm:role="x-translation">我们所描绘的未来 就在那遥远的路途中</span><span ttm:role="x-roman">bokura ga egaita mirai wa haruka tōi michi no tochū</span></p><p begin="01:02.460" end="01:13.540" ttm:agent="v1" itunes:key="L6"><span tts:ruby="container"><span tts:ruby="base">涙</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:02.460" end="01:02.840">な</span><span tts:ruby="text" begin="01:02.840" end="01:03.880">み</span><span tts:ruby="text" begin="01:03.880" end="01:04.240">だ</span></span></span><span begin="01:04.240" end="01:05.320">も</span><span tts:ruby="container"><span tts:ruby="base">笑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:05.320" end="01:05.680">え</span></span></span><span tts:ruby="container"><span tts:ruby="base">顔</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:05.680" end="01:06.680">が</span><span tts:ruby="text" begin="01:06.680" end="01:07.100">お</span></span></span><span begin="01:07.100" end="01:07.940">も</span><span tts:ruby="container"><span tts:ruby="base">分</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:08.100" end="01:08.300">わ</span></span></span><span begin="01:08.300" end="01:08.460">か</span><span begin="01:08.460" end="01:09.180">ち</span><span tts:ruby="container"><span tts:ruby="base">合</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:09.520" end="01:09.900">あ</span></span></span><span begin="01:09.900" end="01:10.260">え</span><span begin="01:10.260" end="01:10.640">た</span><span begin="01:10.640" end="01:10.960">ら</span><span begin="01:10.960" end="01:11.830">い</span><span begin="01:11.830" end="01:12.700">い</span><span begin="01:12.700" end="01:13.540">ね</span><span ttm:role="x-translation">无论泪水还是笑容 我都想与你分享</span><span ttm:role="x-roman">namida mo egao mo wakachiaetara ii ne</span></p><p begin="01:13.760" end="01:24.680" ttm:agent="v1" itunes:key="L7"><span tts:ruby="container"><span tts:ruby="base">遠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:13.760" end="01:14.140">と</span><span tts:ruby="text" begin="01:14.140" end="01:14.500">お</span></span></span><span begin="01:14.500" end="01:14.660">く</span><span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:14.660" end="01:15.200">ひ</span><span tts:ruby="text" begin="01:15.200" end="01:15.400">か</span></span></span><span begin="01:15.400" end="01:15.900">る</span><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:15.900" end="01:16.280">そ</span><span tts:ruby="text" begin="01:16.280" end="01:16.600">ら</span></span></span><span begin="01:16.600" end="01:16.800">の</span><span begin="01:16.800" end="01:17.497" ttx:rubyGroup="1" ttx:rubyText="か|な|た" ttx:rubyTimes="01:16.800,01:17.140 01:17.140,01:17.497 01:17.497,01:18.900">彼</span><span begin="01:17.497" end="01:18.900" ttx:rubyGroup="1">方</span><span tts:ruby="container"><span tts:ruby="base">探</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:19.380" end="01:19.800">さ</span><span tts:ruby="text" begin="01:19.800" end="01:20.120">が</span></span></span><span begin="01:20.120" end="01:20.320">し</span><span begin="01:20.320" end="01:20.840">た</span><span begin="01:20.840" end="01:21.200">い</span><span begin="01:21.200" end="01:21.560">も</span><span begin="01:21.560" end="01:21.920">の</span><span begin="01:21.920" end="01:22.260">が</span><span begin="01:22.260" end="01:22.600">あ</span><span begin="01:22.600" end="01:22.820">る</span><span begin="01:22.820" end="01:23.120">な</span><span begin="01:23.120" end="01:24.680">ら</span><span ttm:role="x-translation">若在闪烁的夜空彼岸 有着想要探寻之物</span><span ttm:role="x-roman">tōku hikaru sora no kanata sagashitai mono ga aru nara</span></p><p begin="01:25.020" end="01:39.480" ttm:agent="v1" itunes:key="L8"><span tts:ruby="container"><span tts:ruby="base">信</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:25.020" end="01:25.440">し</span><span tts:ruby="text" begin="01:25.440" end="01:26.440">ん</span></span></span><span begin="01:26.440" end="01:26.840">じ</span><span begin="01:26.840" end="01:27.180">よ</span><span begin="01:27.180" end="01:27.520">う</span><span begin="01:27.860" end="01:29.300" ttx:rubyGroup="1" ttx:rubyText="ひ|と|り" ttx:rubyTimes="01:27.860,01:28.240 01:28.240,01:29.300 01:29.300,01:29.640">一</span><span begin="01:29.300" end="01:29.640" ttx:rubyGroup="1">人</span><span begin="01:29.640" end="01:30.000">じゃ</span><span begin="01:30.000" end="01:30.400">な</span><span begin="01:30.400" end="01:30.700">い</span><span begin="01:30.700" end="01:31.080">か</span><span begin="01:31.080" end="01:33.160">ら</span><span tts:ruby="container"><span tts:ruby="base">歩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:33.560" end="01:33.920">あ</span><span tts:ruby="text" begin="01:33.920" end="01:34.940">る</span></span></span><span begin="01:34.940" end="01:35.320">き</span><span begin="01:35.320" end="01:36.280">だ</span><span begin="01:36.280" end="01:36.600">せ</span><span begin="01:36.600" end="01:39.480">る</span><span ttm:role="x-translation">那就相信吧 你并非孤身一人 所以继续前行吧</span><span ttm:role="x-roman">shinjiyō hitori ja nai kara arukidaseru</span></p><p begin="01:47.820" end="01:53.640" ttm:agent="v1" itunes:key="L9"><span tts:ruby="container"><span tts:ruby="base">離</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:47.820" end="01:48.020">は</span><span tts:ruby="text" begin="01:48.020" end="01:48.400">な</span></span></span><span begin="01:48.400" end="01:48.600">れ</span><span begin="01:48.600" end="01:49.040">な</span><span begin="01:49.040" end="01:49.300">い</span><span begin="01:49.300" end="01:50.100">よ</span><span begin="01:50.460" end="01:50.860">ぎゅっ</span><span begin="01:50.860" end="01:51.540">と</span><span tts:ruby="container"><span tts:ruby="base">誓</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:52.080" end="01:52.280">ち</span><span tts:ruby="text" begin="01:52.280" end="01:52.900">か</span></span></span><span begin="01:52.900" end="01:53.640">う</span><span ttm:role="x-translation">曾经立下誓言 希望永不分离</span><span ttm:role="x-roman">hanarenai yo gyutto chikau</span></p><p begin="01:53.640" end="01:59.260" ttm:agent="v1" itunes:key="L10"><span tts:ruby="container"><span tts:ruby="base">小</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:53.640" end="01:53.870">ち</span><span tts:ruby="text" begin="01:53.870" end="01:54.100">い</span></span></span><span begin="01:54.100" end="01:54.630">さ</span><span begin="01:54.630" end="01:54.924">な</span><span tts:ruby="container"><span tts:ruby="base">手</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:54.924" end="01:55.760">て</span></span></span><span tts:ruby="container"><span tts:ruby="base">結</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:56.100" end="01:56.260">む</span><span tts:ruby="text" begin="01:56.260" end="01:56.497">す</span></span></span><span begin="01:56.497" end="01:57.200">ぶ</span><span tts:ruby="container"><span tts:ruby="base">星</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:57.500" end="01:57.900">せ</span><span tts:ruby="text" begin="01:57.900" end="01:58.580">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">座</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:58.580" end="01:59.260">ざ</span></span></span><span ttm:role="x-translation">我们小小的手 连结成了星座</span><span ttm:role="x-roman">chiisana te musubu seiza</span></p><p begin="01:59.260" end="02:10.760" ttm:agent="v1" itunes:key="L11"><span tts:ruby="container"><span tts:ruby="base">藍</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:59.260" end="01:59.700">あ</span><span tts:ruby="text" begin="01:59.700" end="01:59.880">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">色</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:59.880" end="02:00.200">い</span><span tts:ruby="text" begin="02:00.200" end="02:00.400">ろ</span></span></span><span begin="02:00.400" end="02:01.500">の</span><span tts:ruby="container"><span tts:ruby="base">向</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:01.740" end="02:02.120">む</span></span></span><span begin="02:02.120" end="02:03.180">こ</span><span begin="02:03.180" end="02:03.560">う</span><span begin="02:03.560" end="02:04.280">に</span><span tts:ruby="container"><span tts:ruby="base">約</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:04.600" end="02:04.940">や</span><span tts:ruby="text" begin="02:04.940" end="02:05.940">く</span></span></span><span tts:ruby="container"><span tts:ruby="base">束</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:05.940" end="02:06.340">そ</span><span tts:ruby="text" begin="02:06.340" end="02:07.180">く</span></span></span><span begin="02:07.400" end="02:07.760">し</span><span begin="02:07.760" end="02:08.820">た</span><span begin="02:08.820" end="02:09.200">ん</span><span begin="02:09.200" end="02:10.760">だ</span><span ttm:role="x-translation">面向蔚蓝星空 许下这个约定</span><span ttm:role="x-roman">aiiro no mukō ni yakusoku shitan da</span></p><p begin="02:11.280" end="02:24.020" ttm:agent="v1" itunes:key="L12"><span begin="02:11.280" end="02:11.680">た</span><span begin="02:11.680" end="02:12.010">ぶ</span><span begin="02:12.010" end="02:12.340">ん</span><span tts:ruby="container"><span tts:ruby="base">絆</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:12.340" end="02:12.540">き</span><span tts:ruby="text" begin="02:12.540" end="02:13.080">ず</span><span tts:ruby="text" begin="02:13.080" end="02:13.260">な</span></span></span><span begin="02:13.260" end="02:14.300">は</span><span tts:ruby="container"><span tts:ruby="base">少</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:14.640" end="02:14.860">す</span><span tts:ruby="text" begin="02:14.860" end="02:15.160">こ</span></span></span><span begin="02:15.160" end="02:15.360">し</span><span begin="02:15.360" end="02:15.860">ず</span><span begin="02:15.860" end="02:16.400">つ</span><span tts:ruby="container"><span tts:ruby="base">降</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:16.560" end="02:16.940">ふ</span></span></span><span begin="02:16.940" end="02:17.780">り</span><span tts:ruby="container"><span tts:ruby="base">積</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:17.980" end="02:18.360">つ</span></span></span><span begin="02:18.360" end="02:19.440">もっ</span><span begin="02:19.440" end="02:19.760">て</span><span begin="02:19.760" end="02:20.560">い</span><span begin="02:20.560" end="02:20.870">く</span><span begin="02:20.870" end="02:21.200">も</span><span begin="02:21.200" end="02:24.020">の</span><span ttm:role="x-translation">所谓的羁绊 就是一点一滴累积而成的吧</span><span ttm:role="x-roman">tabun kizuna wa sukoshi zutsu furitsumotte iku mono</span></p><p begin="02:24.340" end="02:35.360" ttm:agent="v1" itunes:key="L13"><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:24.340" end="02:24.680">ぼ</span><span tts:ruby="text" begin="02:24.680" end="02:25.080">く</span></span></span><span begin="02:25.080" end="02:25.280">ら</span><span begin="02:25.280" end="02:25.780">が</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:25.780" end="02:25.960">み</span></span></span><span begin="02:25.960" end="02:26.480">つ</span><span begin="02:26.480" end="02:26.860">め</span><span begin="02:26.860" end="02:27.120">る</span><span tts:ruby="container"><span tts:ruby="base">世</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:27.120" end="02:27.380">せ</span></span></span><span tts:ruby="container"><span tts:ruby="base">界</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:27.380" end="02:27.720">か</span><span tts:ruby="text" begin="02:27.720" end="02:28.100">い</span></span></span><span begin="02:28.100" end="02:29.640">は</span><span tts:ruby="container"><span tts:ruby="base">憧</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:30.020" end="02:30.360">あ</span><span tts:ruby="text" begin="02:30.360" end="02:30.720">こ</span><span tts:ruby="text" begin="02:30.720" end="02:30.940">が</span></span></span><span begin="02:30.940" end="02:31.440">れ</span><span begin="02:31.440" end="02:31.800">に</span><span tts:ruby="container"><span tts:ruby="base">輝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:31.800" end="02:32.180">か</span><span tts:ruby="text" begin="02:32.180" end="02:32.520">が</span><span tts:ruby="text" begin="02:32.520" end="02:32.820">や</span></span></span><span begin="02:32.820" end="02:33.200">き</span><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:33.200" end="02:33.440">か</span></span></span><span begin="02:33.440" end="02:33.720">え</span><span begin="02:33.720" end="02:35.360">る</span><span ttm:role="x-translation">我们眼中的世界 因憧憬而变得光芒万丈</span><span ttm:role="x-roman">bokura ga mitsumeru sekai wa akogare ni kagayaki kaeru</span></p><p begin="02:35.640" end="02:46.740" ttm:agent="v1" itunes:key="L14"><span tts:ruby="container"><span tts:ruby="base">願</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:35.640" end="02:36.000">ね</span><span tts:ruby="text" begin="02:36.000" end="02:37.060">が</span></span></span><span begin="02:37.060" end="02:37.460">い</span><span begin="02:37.460" end="02:38.280">も</span><span tts:ruby="container"><span tts:ruby="base">迷</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:38.480" end="02:38.860">ま</span><span tts:ruby="text" begin="02:38.860" end="02:39.880">よ</span></span></span><span begin="02:39.880" end="02:40.260">い</span><span begin="02:40.260" end="02:41.020">も</span><span tts:ruby="container"><span tts:ruby="base">照</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:41.280" end="02:41.500">て</span></span></span><span begin="02:41.500" end="02:41.640">ら</span><span begin="02:41.640" end="02:42.380">し</span><span tts:ruby="container"><span tts:ruby="base">合</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:42.680" end="02:43.100">あ</span></span></span><span begin="02:43.100" end="02:43.440">え</span><span begin="02:43.440" end="02:43.780">た</span><span begin="02:43.780" end="02:44.180">ら</span><span begin="02:44.180" end="02:45.030">い</span><span begin="02:45.030" end="02:45.880">い</span><span begin="02:45.880" end="02:46.740">ね</span><span ttm:role="x-translation">无论希望还是迷茫 我都想与你分享</span><span ttm:role="x-roman">negai mo mayoi mo terashiaetara ii ne</span></p><p begin="02:46.960" end="02:57.920" ttm:agent="v1" itunes:key="L15"><span tts:ruby="container"><span tts:ruby="base">交</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:46.960" end="02:47.300">こ</span><span tts:ruby="text" begin="02:47.300" end="02:47.640">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">差</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:47.640" end="02:47.860">さ</span></span></span><span begin="02:47.860" end="02:48.360">し</span><span begin="02:48.360" end="02:48.580">て</span><span begin="02:48.580" end="02:49.060">る</span><span tts:ruby="container"><span tts:ruby="base">時</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:49.060" end="02:49.400">と</span><span tts:ruby="text" begin="02:49.400" end="02:49.780">き</span></span></span><span begin="02:49.780" end="02:49.980">の</span><span begin="02:49.980" end="02:50.692" ttx:rubyGroup="1" ttx:rubyText="か|な|た" ttx:rubyTimes="02:49.980,02:50.340 02:50.340,02:50.680 02:50.680,02:52.120">彼</span><span begin="02:50.692" end="02:52.120" ttx:rubyGroup="1">方</span><span tts:ruby="container"><span tts:ruby="base">叶</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:52.600" end="02:52.920">か</span><span tts:ruby="text" begin="02:52.920" end="02:53.300">な</span></span></span><span begin="02:53.300" end="02:53.520">え</span><span begin="02:53.520" end="02:54.040">た</span><span begin="02:54.040" end="02:54.380">い</span><span begin="02:54.380" end="02:54.740">も</span><span begin="02:54.740" end="02:55.080">の</span><span begin="02:55.080" end="02:55.440">が</span><span begin="02:55.440" end="02:55.800">あ</span><span begin="02:55.800" end="02:56.020">る</span><span begin="02:56.020" end="02:56.320">か</span><span begin="02:56.320" end="02:57.920">ら</span><span ttm:role="x-translation">因为在时空交错的彼方 还有想要去实现的愿望</span><span ttm:role="x-roman">kōsa shiteru toki no kanata kanaetai mono ga aru kara</span></p><p begin="02:58.240" end="03:12.960" ttm:agent="v1" itunes:key="L16"><span tts:ruby="container"><span tts:ruby="base">焦</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:58.240" end="02:58.620">こ</span></span></span><span begin="02:58.620" end="02:59.660">が</span><span begin="02:59.660" end="03:00.040">れ</span><span begin="03:00.040" end="03:00.410">よ</span><span begin="03:00.410" end="03:00.780">う</span><span tts:ruby="container"><span tts:ruby="base">夜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:01.040" end="03:01.403">よ</span></span></span><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:01.403" end="03:02.480">ぞ</span><span tts:ruby="text" begin="03:02.480" end="03:02.840">ら</span></span></span><span begin="03:02.840" end="03:03.240">を</span><span tts:ruby="container"><span tts:ruby="base">彩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:03.240" end="03:03.580">い</span><span tts:ruby="text" begin="03:03.580" end="03:03.920">ろ</span><span tts:ruby="text" begin="03:03.920" end="03:04.260">ど</span></span></span><span begin="03:04.260" end="03:06.420">る</span><span tts:ruby="container"><span tts:ruby="base">星</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:06.720" end="03:07.040">ほ</span><span tts:ruby="text" begin="03:07.040" end="03:08.140">し</span></span></span><span begin="03:08.140" end="03:08.480">み</span><span begin="03:08.480" end="03:09.540">た</span><span begin="03:09.540" end="03:09.740">い</span><span begin="03:09.740" end="03:12.960">に</span><span ttm:role="x-translation">一心向往吧 如同那点缀夜空的繁星</span><span ttm:role="x-roman">kogareyō yozora o irodoru hoshi mitai ni</span></p><p begin="03:14.060" end="03:23.480" ttm:agent="v1" itunes:key="L17"><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:14.060" end="03:14.340">き</span></span></span><span begin="03:14.340" end="03:14.500">え</span><span begin="03:14.500" end="03:14.720">な</span><span begin="03:14.720" end="03:14.880">い</span><span begin="03:14.880" end="03:15.060">よ</span><span begin="03:15.060" end="03:15.234">う</span><span begin="03:15.234" end="03:16.980">に</span><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:16.980" end="03:17.140">け</span></span></span><span begin="03:17.140" end="03:17.320">さ</span><span begin="03:17.320" end="03:17.520">な</span><span begin="03:17.520" end="03:17.680">い</span><span begin="03:17.680" end="03:17.860">よ</span><span begin="03:17.860" end="03:18.000">う</span><span begin="03:18.000" end="03:19.480">に</span><span tts:ruby="container"><span tts:ruby="base">確</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:19.720" end="03:19.960">た</span><span tts:ruby="text" begin="03:19.960" end="03:20.140">し</span></span></span><span begin="03:20.140" end="03:20.320">か</span><span begin="03:20.320" end="03:20.500">め</span><span tts:ruby="container"><span tts:ruby="base">合</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:20.500" end="03:20.880">あ</span></span></span><span begin="03:20.880" end="03:21.200">い</span><span begin="03:21.200" end="03:21.900">な</span><span begin="03:21.900" end="03:22.260">が</span><span begin="03:22.260" end="03:23.480">ら</span><span ttm:role="x-translation">为了不让光芒消失泯灭 我们小心翼翼地确认着</span><span ttm:role="x-roman">kienai yō ni kesanai yō ni tashikameai nagara</span></p><p begin="03:23.680" end="03:35.380" ttm:agent="v1" itunes:key="L18"><span begin="03:23.680" end="03:24.000">め</span><span begin="03:24.000" end="03:24.380">ぐ</span><span begin="03:24.380" end="03:24.720">り</span><span tts:ruby="container"><span tts:ruby="base">会</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:24.720" end="03:25.080">あ</span></span></span><span begin="03:25.080" end="03:26.180">う</span><span tts:ruby="container"><span tts:ruby="base">双</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:26.440" end="03:26.840">そ</span><span tts:ruby="text" begin="03:26.840" end="03:27.160">う</span></span></span><span tts:ruby="container"><span tts:ruby="base">曲</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:27.160" end="03:27.460">きょ</span><span tts:ruby="text" begin="03:27.460" end="03:27.860">く</span></span></span><span tts:ruby="container"><span tts:ruby="base">線</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:27.860" end="03:28.260">せ</span><span tts:ruby="text" begin="03:28.260" end="03:28.280">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">同</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:28.580" end="03:29.140">お</span><span tts:ruby="text" begin="03:29.140" end="03:29.640">な</span></span></span><span begin="03:29.640" end="03:29.860">じ</span><span tts:ruby="container"><span tts:ruby="base">時間</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:29.860" end="03:30.020">と</span><span tts:ruby="text" begin="03:30.020" end="03:31.789">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">越</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:32.120" end="03:32.340">こ</span></span></span><span begin="03:32.340" end="03:32.540">え</span><span begin="03:32.540" end="03:33.760">よ</span><span begin="03:33.760" end="03:35.380">う</span><span ttm:role="x-translation">终于交汇的双曲线 跨越过同一时刻</span><span ttm:role="x-roman">meguriau sōkyokusen onaji toki koeyō</span></p><p begin="03:37.780" end="03:48.840" ttm:agent="v1" itunes:key="L19"><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:37.780" end="03:38.100">ぼ</span><span tts:ruby="text" begin="03:38.100" end="03:38.500">く</span></span></span><span begin="03:38.500" end="03:38.700">ら</span><span begin="03:38.700" end="03:39.220">が</span><span tts:ruby="container"><span tts:ruby="base">描</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:39.220" end="03:39.400">え</span><span tts:ruby="text" begin="03:39.400" end="03:39.920">が</span></span></span><span begin="03:39.920" end="03:40.260">い</span><span begin="03:40.260" end="03:40.600">た</span><span tts:ruby="container"><span tts:ruby="base">未</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:40.600" end="03:40.820">み</span></span></span><span tts:ruby="container"><span tts:ruby="base">来</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:40.820" end="03:41.160">ら</span><span tts:ruby="text" begin="03:41.160" end="03:41.520">い</span></span></span><span begin="03:41.520" end="03:42.840">は</span><span tts:ruby="container"><span tts:ruby="base">遥</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:43.420" end="03:43.780">は</span><span tts:ruby="text" begin="03:43.780" end="03:44.141">る</span></span></span><span begin="03:44.141" end="03:44.320">か</span><span tts:ruby="container"><span tts:ruby="base">遠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:44.320" end="03:44.860">と</span><span tts:ruby="text" begin="03:44.860" end="03:45.220">お</span></span></span><span begin="03:45.220" end="03:45.580">い</span><span tts:ruby="container"><span tts:ruby="base">道</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:45.580" end="03:45.880">み</span><span tts:ruby="text" begin="03:45.880" end="03:46.240">ち</span></span></span><span begin="03:46.240" end="03:46.600">の</span><span tts:ruby="container"><span tts:ruby="base">途</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:46.600" end="03:46.840">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:46.840" end="03:47.135">ちゅ</span><span tts:ruby="text" begin="03:47.135" end="03:48.840">う</span></span></span><span ttm:role="x-translation">我们所描绘的未来 就在那遥远的路途中</span><span ttm:role="x-roman">bokura ga egaita mirai wa haruka tōi michi no tochū</span></p><p begin="03:49.080" end="04:00.160" ttm:agent="v1" itunes:key="L20"><span tts:ruby="container"><span tts:ruby="base">涙</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:49.080" end="03:49.440">な</span><span tts:ruby="text" begin="03:49.440" end="03:50.480">み</span><span tts:ruby="text" begin="03:50.480" end="03:50.840">だ</span></span></span><span begin="03:50.840" end="03:51.640">も</span><span tts:ruby="container"><span tts:ruby="base">笑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:51.920" end="03:52.280">え</span></span></span><span tts:ruby="container"><span tts:ruby="base">顔</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:52.280" end="03:53.300">が</span><span tts:ruby="text" begin="03:53.300" end="03:53.680">お</span></span></span><span begin="03:53.680" end="03:54.540">も</span><span tts:ruby="container"><span tts:ruby="base">分</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:54.700" end="03:54.900">わ</span></span></span><span begin="03:54.900" end="03:55.080">か</span><span begin="03:55.080" end="03:55.720">ち</span><span tts:ruby="container"><span tts:ruby="base">合</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:56.120" end="03:56.500">あ</span></span></span><span begin="03:56.500" end="03:56.840">え</span><span begin="03:56.840" end="03:57.200">た</span><span begin="03:57.200" end="03:57.560">ら</span><span begin="03:57.560" end="03:58.420">い</span><span begin="03:58.420" end="03:59.280">い</span><span begin="03:59.280" end="04:00.160">ね</span><span ttm:role="x-translation">无论泪水还是笑容 我都想与你分享</span><span ttm:role="x-roman">namida mo egao mo wakachiaetara ii ne</span></p><p begin="04:00.360" end="04:11.260" ttm:agent="v1" itunes:key="L21"><span tts:ruby="container"><span tts:ruby="base">遠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:00.360" end="04:00.740">と</span><span tts:ruby="text" begin="04:00.740" end="04:01.060">お</span></span></span><span begin="04:01.060" end="04:01.240">く</span><span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:01.240" end="04:01.780">ひ</span><span tts:ruby="text" begin="04:01.780" end="04:01.980">か</span></span></span><span begin="04:01.980" end="04:02.460">る</span><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:02.460" end="04:02.860">そ</span><span tts:ruby="text" begin="04:02.860" end="04:03.180">ら</span></span></span><span begin="04:03.180" end="04:03.380">の</span><span begin="04:03.380" end="04:04.104" ttx:rubyGroup="1" ttx:rubyText="か|な|た" ttx:rubyTimes="04:03.380,04:03.740 04:03.740,04:04.100 04:04.100,04:05.700">彼</span><span begin="04:04.104" end="04:05.700" ttx:rubyGroup="1">方</span><span tts:ruby="container"><span tts:ruby="base">探</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:05.960" end="04:06.380">さ</span><span tts:ruby="text" begin="04:06.380" end="04:06.680">が</span></span></span><span begin="04:06.680" end="04:06.920">し</span><span begin="04:06.920" end="04:07.460">た</span><span begin="04:07.460" end="04:07.800">い</span><span begin="04:07.800" end="04:08.160">も</span><span begin="04:08.160" end="04:08.500">の</span><span begin="04:08.500" end="04:08.850">が</span><span begin="04:08.850" end="04:09.200">あ</span><span begin="04:09.200" end="04:09.400">る</span><span begin="04:09.400" end="04:09.720">な</span><span begin="04:09.720" end="04:11.260">ら</span><span ttm:role="x-translation">若在闪烁的夜空彼岸 有着想要探寻之物</span><span ttm:role="x-roman">tōku hikaru sora no kanata sagashitai mono ga aru nara</span></p><p begin="04:11.600" end="04:25.780" ttm:agent="v1" itunes:key="L22"><span tts:ruby="container"><span tts:ruby="base">信</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:11.600" end="04:12.000">し</span><span tts:ruby="text" begin="04:12.000" end="04:13.080">ん</span></span></span><span begin="04:13.080" end="04:13.460">じ</span><span begin="04:13.460" end="04:13.800">よ</span><span begin="04:13.800" end="04:14.140">う</span><span begin="04:14.440" end="04:15.920" ttx:rubyGroup="1" ttx:rubyText="ひ|と|り" ttx:rubyTimes="04:14.440,04:14.840 04:14.840,04:15.920 04:15.920,04:16.240">一</span><span begin="04:15.920" end="04:16.240" ttx:rubyGroup="1">人</span><span begin="04:16.240" end="04:16.580">じゃ</span><span begin="04:16.580" end="04:17.000">な</span><span begin="04:17.000" end="04:17.320">い</span><span begin="04:17.320" end="04:17.680">か</span><span begin="04:17.680" end="04:19.820">ら</span><span tts:ruby="container"><span tts:ruby="base">歩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:20.140" end="04:20.520">あ</span><span tts:ruby="text" begin="04:20.520" end="04:21.540">る</span></span></span><span begin="04:21.540" end="04:21.900">き</span><span begin="04:21.900" end="04:22.860">だ</span><span begin="04:22.860" end="04:23.180">せ</span><span begin="04:23.180" end="04:25.780">る</span><span ttm:role="x-translation">那就相信吧 你并非孤身一人 所以继续前行吧</span><span ttm:role="x-roman">shinjiyō hitori ja nai kara arukidaseru</span></p></div></body></tt>