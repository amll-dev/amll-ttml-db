pan begin="00:40.840" end="00:41.120">か</span><span begin="00:41.120" end="00:41.880">きっ</span><span begin="00:41.880" end="00:42.260">と</span> <span tts:ruby="container"><span tts:ruby="base">会</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:42.440" end="00:42.740">あ</span></span></span><span begin="00:42.740" end="00:43.020">え</span><span begin="00:43.020" end="00:43.260">る</span><span begin="00:43.260" end="00:43.460">と</span><span tts:ruby="container"><span tts:ruby="base">信</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:43.460" end="00:43.780">し</span><span tts:ruby="text" begin="00:43.780" end="00:44.060">ん</span></span></span><span begin="00:44.060" end="00:44.340">じ</span><span begin="00:44.340" end="00:45.120">て</span><span ttm:role="x-translation">坚信未来终有一日能相逢</span><span ttm:role="x-roman">itsuka kitto aeru to shinjite</span></p><p begin="00:45.980" end="00:51.760" ttm:agent="v1" itunes:key="L3"><span tts:ruby="container"><span tts:ruby="base">聞</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:45.980" end="00:46.800">き</span></span></span><span begin="00:46.800" end="00:47.080">き</span><span begin="00:47.080" end="00:47.320">な</span><span begin="00:47.320" end="00:47.600">れ</span><span begin="00:47.600" end="00:48.420">た</span> <span begin="00:48.820" end="00:49.160">そ</span><span begin="00:49.160" end="00:49.940">の</span><span tts:ruby="container"><span tts:ruby="base">声</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:49.940" end="00:50.480">こ</span><span tts:ruby="text" begin="00:50.480" end="00:50.800">え</span></span></span><span begin="00:50.800" end="00:51.760">も</span><span ttm:role="x-translation">就连熟悉的那个声音</span><span ttm:role="x-roman">kikinareta sono koe mo</span></p><p begin="00:52.460" end="00:59.120" ttm:agent="v1" itunes:key="L4"><span begin="00:52.460" end="00:53.260">い</span><span begin="00:53.260" end="00:53.840">つ</span><span begin="00:53.840" end="00:54.100">の</span><span tts:ruby="container"><span tts:ruby="base">間</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:54.100" end="00:54.640">ま</span></span></span><span begin="00:54.640" end="00:54.920">に</span><span begin="00:54.920" end="00:55.260">か</span> <span tts:ruby="container"><span tts:ruby="base">儚</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:55.400" end="00:55.700">は</span><span tts:ruby="text" begin="00:55.700" end="00:55.980">か</span><span tts:ruby="text" begin="00:55.980" end="00:56.220">な</span></span></span><span begin="00:56.220" end="00:56.480">く</span><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:56.480" end="00:57.040">き</span></span></span><span begin="00:57.040" end="00:57.340">え</span><span begin="00:57.340" end="00:59.120">る</span><span ttm:role="x-translation">也在不知不觉间转瞬即逝</span><span ttm:role="x-roman">itsu no ma ni ka hakanaku kieru</span></p><p begin="01:00.020" end="01:06.160" ttm:agent="v1" itunes:key="L5"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:00.020" end="01:00.320">き</span><span tts:ruby="text" begin="01:00.320" end="01:00.600">み</span></span></span><span begin="01:00.600" end="01:01.060">を</span><span tts:ruby="container"><span tts:ruby="base">失っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:01.300" end="01:01.780">う</span><span tts:ruby="text" begin="01:01.780" end="01:02.140">し</span><span tts:ruby="text" begin="01:02.140" end="01:02.680">な</span><span tts:ruby="text" begin="01:02.680" end="01:03.000">っ</span></span></span><span begin="01:03.000" end="01:03.440">た</span><span tts:ruby="container"><span tts:ruby="base">世</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:03.440" end="01:03.780">せ</span></span></span><span tts:ruby="container"><span tts:ruby="base">界</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:03.780" end="01:04.600">か</span><span tts:ruby="text" begin="01:04.600" end="01:05.380">い</span></span></span><span begin="01:05.380" end="01:06.160">は</span><span ttm:role="x-translation">失去你后的世界</span><span ttm:role="x-roman">kimi o ushinatta sekai wa</span></p><p begin="01:06.440" end="01:12.600" ttm:agent="v1" itunes:key="L6"><span begin="01:06.440" end="01:06.760">ど</span><span begin="01:06.760" end="01:07.020">こ</span><span begin="01:07.020" end="01:07.440">か</span><span begin="01:07.820" end="01:08.320">ギ</span><span begin="01:08.320" end="01:08.620">コ</span><span begin="01:08.620" end="01:09.160">チ</span><span begin="01:09.160" end="01:09.460">ナ</span><span begin="01:09.460" end="01:09.980">ク</span><span begin="01:09.980" end="01:10.280">テ</span><span tts:ruby="container"><span tts:ruby="base">困</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:10.280" end="01:11.040">こ</span><span tts:ruby="text" begin="01:11.040" end="01:11.880">ま</span></span></span><span begin="01:11.880" end="01:12.600">る</span><span ttm:role="x-translation">总觉得有些束手无策</span><span ttm:role="x-roman">dokoka gikochinakute komaru</span></p><p begin="01:12.900" end="01:19.160" ttm:agent="v1" itunes:key="L7"><span begin="01:12.900" end="01:13.240">す</span><span begin="01:13.240" end="01:13.520">べ</span><span begin="01:13.520" end="01:13.980">て</span><span tts:ruby="container"><span tts:ruby="base">忘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:14.300" end="01:14.740">わ</span><span tts:ruby="text" begin="01:14.740" end="01:15.120">す</span></span></span><span begin="01:15.120" end="01:15.660">れ</span><span begin="01:15.660" end="01:15.900">て</span><span begin="01:15.900" end="01:16.520">し</span><span begin="01:16.520" end="01:17.560">まっ</span><span begin="01:17.560" end="01:18.100">た</span><span begin="01:18.100" end="01:18.260">よ</span><span begin="01:18.260" end="01:18.412">う</span><span begin="01:18.412" end="01:19.160">に</span><span ttm:role="x-translation">似乎将一切都遗忘了</span><span ttm:role="x-roman">subete wasurete shimatta yō ni</span></p><p begin="01:19.460" end="01:25.320" ttm:agent="v1" itunes:key="L8"><span begin="01:19.460" end="01:19.740" ttx:rubyGroup="1" ttx:rubyText="きょ|う" ttx:rubyTimes="01:19.460,01:19.740 01:19.740,01:20.000">今</span><span begin="01:19.740" end="01:20.000" ttx:rubyGroup="1">日</span><span begin="01:20.000" end="01:20.680">も</span><span tts:ruby="container"><span tts:ruby="base">朝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:21.060" end="01:21.320">あ</span><span tts:ruby="text" begin="01:21.320" end="01:21.600">さ</span></span></span><span begin="01:21.600" end="01:22.120">を</span><span tts:ruby="container"><span tts:ruby="base">迎</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:22.420" end="01:22.660">む</span><span tts:ruby="text" begin="01:22.660" end="01:22.940">か</span></span></span><span begin="01:22.940" end="01:23.240">え</span><span begin="01:23.240" end="01:25.320">て</span><span ttm:role="x-translation">今日也依然迎接晨光</span><span ttm:role="x-roman">kyō mo asa o mukaete</span></p><p begin="01:25.600" end="01:28.740" ttm:agent="v1" itunes:key="L9"><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:25.600" end="01:26.140">ぼ</span><span tts:ruby="text" begin="01:26.140" end="01:26.500">く</span></span></span><span begin="01:26.500" end="01:27.540">は</span><span tts:ruby="container"><span tts:ruby="base">待</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:27.540" end="01:27.820">ま</span></span></span><span begin="01:27.820" end="01:28.120">つ</span><span begin="01:28.120" end="01:28.740">よ</span><span ttm:role="x-translation">我等着哦</span><span ttm:role="x-roman">boku wa matsu yo</span></p><p begin="01:29.160" end="01:37.960" ttm:agent="v1" itunes:key="L10"><span begin="01:29.160" end="01:29.480">ど</span><span begin="01:29.480" end="01:29.740">ん</span><span begin="01:29.740" end="01:30.300">な</span><span begin="01:30.300" end="01:30.820">に</span><span tts:ruby="container"><span tts:ruby="base">時</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:30.820" end="01:31.080">と</span><span tts:ruby="text" begin="01:31.080" end="01:31.340">き</span></span></span><span begin="01:31.340" end="01:32.100">が</span><span tts:ruby="container"><span tts:ruby="base">経っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:32.680" end="01:33.220">た</span><span tts:ruby="text" begin="01:33.220" end="01:33.540">っ</span></span></span><span begin="01:33.540" end="01:34.540">て</span><span begin="01:34.540" end="01:35.120">し</span><span begin="01:35.120" end="01:35.940">まっ</span><span begin="01:35.940" end="01:36.220">て</span><span begin="01:36.220" end="01:37.960">も</span><span ttm:role="x-translation">纵使时光长流飞逝</span><span ttm:role="x-roman">donna ni toki ga tatte shimatte mo</span></p><p begin="01:38.840" end="01:44.960" ttm:agent="v1" itunes:key="L11"><span tts:ruby="container"><span tts:ruby="base">二</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:38.840" end="01:39.180">に</span></span></span><span tts:ruby="container"><span tts:ruby="base">度</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:39.180" end="01:39.460">ど</span></span></span><span begin="01:39.460" end="01:39.900">と</span><span tts:ruby="container"><span tts:ruby="base">叶</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:40.220" end="01:40.540">か</span><span tts:ruby="text" begin="01:40.540" end="01:40.780">な</span></span></span><span begin="01:40.780" end="01:41.080">わ</span><span begin="01:41.080" end="01:41.520">ぬ</span><span tts:ruby="container"><span tts:ruby="base">愿</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:41.840" end="01:42.380">ね</span><span tts:ruby="text" begin="01:42.380" end="01:42.720">が</span></span></span><span begin="01:42.720" end="01:43.500">い</span><span begin="01:43.500" end="01:43.820">な</span><span begin="01:43.820" end="01:44.080">ん</span><span begin="01:44.080" end="01:44.340">だ</span><span begin="01:44.340" end="01:44.620">ろ</span><span begin="01:44.620" end="01:44.960">う</span><span ttm:role="x-translation">无法实现的心愿是什么呢</span><span ttm:role="x-roman">nido to kanawanu negai nan darō</span></p><p begin="01:45.380" end="01:51.140" ttm:agent="v1" itunes:key="L12"><span tts:ruby="container"><span tts:ruby="base">長</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:45.380" end="01:45.700">な</span><span tts:ruby="text" begin="01:45.700" end="01:46.000">が</span></span></span><span begin="01:46.000" end="01:46.760">い</span><span tts:ruby="container"><span tts:ruby="base">夜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:46.760" end="01:47.320">よ</span><span tts:ruby="text" begin="01:47.320" end="01:47.560">る</span></span></span><span begin="01:47.560" end="01:48.080">を</span><span tts:ruby="container"><span tts:ruby="base">包</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:48.080" end="01:48.400">つ</span><span tts:ruby="text" begin="01:48.400" end="01:48.960">つ</span></span></span><span begin="01:48.960" end="01:49.220">ん</span><span begin="01:49.220" end="01:51.140">で</span><span ttm:role="x-translation">笼罩长夜</span><span ttm:role="x-roman">nagai yoru o tsutsunde</span></p><p begin="01:51.540" end="01:54.860" ttm:agent="v1" itunes:key="L13"><span begin="01:51.540" end="01:51.880">そ</span><span begin="01:51.880" end="01:52.160">れ</span><span begin="01:52.160" end="01:52.420">で</span><span begin="01:52.420" end="01:53.540">も</span><span tts:ruby="container"><span tts:ruby="base">全</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:53.540" end="01:53.860">ぜ</span><span tts:ruby="text" begin="01:53.860" end="01:54.100">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">部</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:54.100" end="01:54.860">ぶ</span></span></span><span ttm:role="x-translation">即便如此</span><span ttm:role="x-roman">sore demo zenbu</span></p><p begin="01:55.060" end="01:58.240" ttm:agent="v1" itunes:key="L14"><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:55.060" end="01:55.400">ゆ</span><span tts:ruby="text" begin="01:55.400" end="01:55.700">め</span></span></span><span begin="01:55.700" end="01:56.220">の</span><span tts:ruby="container"><span tts:ruby="base">途</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:56.220" end="01:56.720">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="01:56.720" end="01:57.000">ちゅ</span><span tts:ruby="text" begin="01:57.000" end="01:57.280">う</span></span></span><span begin="01:57.280" end="01:58.240">で</span><span ttm:role="x-translation">在追逐梦想的途中</span><span ttm:role="x-roman">yume no tochū de</span></p><p begin="01:58.600" end="02:03.900" ttm:agent="v1" itunes:key="L15"><span begin="01:58.600" end="01:59.040">「ホ</span><span begin="01:59.040" end="01:59.460">ン</span><span begin="01:59.460" end="02:00.520">ト」</span><span begin="02:00.520" end="02:01.060">じゃ</span><span begin="02:01.060" end="02:01.360">な</span><span begin="02:01.360" end="02:01.880">け</span><span begin="02:01.880" end="02:02.180">れ</span><span begin="02:02.180" end="02:03.900">ば</span><span ttm:role="x-translation">一切却是飘渺虚无</span><span ttm:role="x-roman">honto ja nakereba</span></p><p begin="02:04.740" end="02:07.520" ttm:agent="v1" itunes:key="L16"><span begin="02:04.740" end="02:05.160">そ</span><span begin="02:05.160" end="02:05.440">ば</span><span begin="02:05.440" end="02:05.900">に</span><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:06.200" end="02:06.480">か</span></span></span><span begin="02:06.480" end="02:06.760">わ</span><span begin="02:06.760" end="02:07.040">ら</span><span begin="02:07.040" end="02:07.320">な</span><span begin="02:07.320" end="02:07.520">い</span><span ttm:role="x-translation">明明</span><span ttm:role="x-roman">soba ni kawaranai</span></p><p begin="02:07.800" end="02:11.020" ttm:agent="v1" itunes:key="L17"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:07.800" end="02:08.360">き</span><span tts:ruby="text" begin="02:08.360" end="02:08.640">み</span></span></span><span begin="02:08.640" end="02:09.480">が</span><span begin="02:09.480" end="02:10.300">い</span><span begin="02:10.300" end="02:11.020">て</span><span ttm:role="x-translation">你一直在我身边</span><span ttm:role="x-roman">kimi ga ite</span></p><p begin="02:11.340" end="02:16.920" ttm:agent="v1" itunes:key="L18"><span begin="02:11.340" end="02:11.900">ずっ</span><span begin="02:11.900" end="02:12.780">と</span><span tts:ruby="container"><span tts:ruby="base">笑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:12.780" end="02:13.280">わ</span><span tts:ruby="text" begin="02:13.280" end="02:13.560">ら</span></span></span><span begin="02:13.560" end="02:14.080">え</span><span begin="02:14.080" end="02:14.340">て</span><span begin="02:14.340" end="02:14.860">た</span><span begin="02:14.860" end="02:15.140">の</span><span begin="02:15.140" end="02:16.920">に</span><span ttm:role="x-translation">笑容依旧</span><span ttm:role="x-roman">zutto waraeteta no ni</span></p><p begin="02:44.340" end="02:49.920" ttm:agent="v1" itunes:key="L19"><span tts:ruby="container"><span tts:ruby="base">遠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:44.340" end="02:44.670">と</span><span tts:ruby="text" begin="02:44.670" end="02:45.140">お</span></span></span><span begin="02:45.140" end="02:45.380">く</span><span tts:ruby="container"><span tts:ruby="base">霞</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:45.380" end="02:45.600">か</span><span tts:ruby="text" begin="02:45.600" end="02:45.960">す</span></span></span><span begin="02:45.960" end="02:46.580">む</span> <span tts:ruby="container"><span tts:ruby="base">何</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:47.280" end="02:47.820">な</span><span tts:ruby="text" begin="02:47.820" end="02:48.320">に</span></span></span><span begin="02:48.320" end="02:48.840">も</span><span begin="02:48.840" end="02:49.140">か</span><span begin="02:49.140" end="02:49.920">も</span><span ttm:role="x-translation">万物在远方失色</span><span ttm:role="x-roman">tōku kasumu nani mo kamo</span></p><p begin="02:50.800" end="02:56.480" ttm:agent="v1" itunes:key="L20"><span tts:ruby="container"><span tts:ruby="base">過</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:50.800" end="02:51.580">か</span></span></span><span tts:ruby="container"><span tts:ruby="base">去</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:51.580" end="02:52.140">こ</span></span></span><span begin="02:52.140" end="02:52.400">の</span><span tts:ruby="container"><span tts:ruby="base">記</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:52.400" end="02:52.960">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">憶</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:52.960" end="02:53.220">お</span><span tts:ruby="text" begin="02:53.220" end="02:53.740">く</span></span></span><span begin="02:53.740" end="02:54.040">も</span><span tts:ruby="container"><span tts:ruby="base">澄</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:54.040" end="02:54.320">す</span></span></span><span begin="02:54.320" end="02:54.580">ん</span><span begin="02:54.580" end="02:54.880">だ</span><span tts:ruby="container"><span tts:ruby="base">歌</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="02:54.880" end="02:55.380">う</span><span tts:ruby="text" begin="02:55.380" end="02:55.680">た</span></span></span><span begin="02:55.680" end="02:56.480">も</span><span ttm:role="x-translation">就连过去的记忆与悦耳的歌声</span><span ttm:role="x-roman">kako no kioku mo sunda uta mo</span></p><p begin="02:57.300" end="02:59.660" ttm:agent="v1" itunes:key="L21"><span begin="02:57.300" end="02:57.880">こ</span><span begin="02:57.880" end="02:58.120">ん</span><span begin="02:58.120" end="02:58.380">な</span><span begin="02:58.380" end="02:58.660">ふ</span><span begin="02:58.660" end="02:58.940">う</span><span begin="02:58.940" end="02:59.660">に</span><span ttm:role="x-translation">也在模糊</span><span ttm:role="x-roman">konna fū ni</span></p><p begin="03:00.160" end="03:03.040" ttm:agent="v1" itunes:key="L22"><span tts:ruby="container"><span tts:ruby="base">人</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:00.160" end="03:00.540">ひ</span><span tts:ruby="text" begin="03:00.540" end="03:01.300">と</span></span></span><span begin="03:01.300" end="03:01.860">は</span><span begin="03:01.860" end="03:02.140">み</span><span begin="03:02.140" end="03:03.040">な</span><span ttm:role="x-translation">人们</span><span ttm:role="x-roman">hito wa mina</span></p><p begin="03:03.800" end="03:10.800" ttm:agent="v1" itunes:key="L23"><span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:03.800" end="03:04.560">お</span><span tts:ruby="text" begin="03:04.560" end="03:05.120">も</span></span></span><span begin="03:05.120" end="03:05.380">い</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:05.380" end="03:05.900">で</span></span></span> <span tts:ruby="container"><span tts:ruby="base">舎</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:05.900" end="03:06.260">す</span></span></span><span begin="03:06.260" end="03:06.760">て</span><span begin="03:06.760" end="03:06.980">て</span><span begin="03:06.980" end="03:07.300">し</span><span begin="03:07.300" end="03:07.580">ま</span><span begin="03:07.580" end="03:07.840">う</span><span begin="03:07.840" end="03:08.360">の</span><span begin="03:08.360" end="03:08.680">か</span><span begin="03:08.680" end="03:10.800">な</span><span ttm:role="x-translation">将回忆都舍弃了吗</span><span ttm:role="x-roman">omoide sutete shimau no kana</span></p><p begin="03:11.340" end="03:17.460" ttm:agent="v1" itunes:key="L24"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:11.340" end="03:11.640">き</span><span tts:ruby="text" begin="03:11.640" end="03:11.900">み</span></span></span><span begin="03:11.900" end="03:12.400">に</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:12.660" end="03:13.140">み</span></span></span><span begin="03:13.140" end="03:13.500">せ</span><span begin="03:13.500" end="03:14.020">た</span><span begin="03:14.020" end="03:14.860">かっ</span><span begin="03:14.860" end="03:15.100">た</span><span tts:ruby="container"><span tts:ruby="base">景</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:15.100" end="03:15.860">け</span></span></span><span tts:ruby="container"><span tts:ruby="base">色</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:15.860" end="03:16.700">し</span><span tts:ruby="text" begin="03:16.700" end="03:17.460">き</span></span></span><span ttm:role="x-translation">曾经想要让你欣赏的景色</span><span ttm:role="x-roman">kimi ni misetakatta keshiki</span></p><p begin="03:17.800" end="03:23.940" ttm:agent="v1" itunes:key="L25"><span tts:ruby="container"><span tts:ruby="base">荒</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:17.800" end="03:18.080">あ</span></span></span><span begin="03:18.080" end="03:18.340">れ</span><span tts:ruby="container"><span tts:ruby="base">果</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:18.340" end="03:18.860">は</span></span></span><span begin="03:19.120" end="03:19.680">て</span><span begin="03:19.680" end="03:19.900">た</span><span tts:ruby="container"><span tts:ruby="base">大</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:19.900" end="03:20.480">だ</span><span tts:ruby="text" begin="03:20.480" end="03:20.740">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">地</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:20.740" end="03:21.300">ち</span></span></span><span begin="03:21.300" end="03:21.580">に</span><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:21.580" end="03:22.360">か</span></span></span><span begin="03:22.360" end="03:23.260">わ</span><span begin="03:23.260" end="03:23.940">る</span><span ttm:role="x-translation">如今已然成为一片荒芜的大地</span><span ttm:role="x-roman">arehateta daichi ni kawaru</span></p><p begin="03:24.300" end="03:30.460" ttm:agent="v1" itunes:key="L26"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:24.300" end="03:24.600">き</span><span tts:ruby="text" begin="03:24.600" end="03:24.860">み</span></span></span><span begin="03:24.860" end="03:25.360">に</span><span tts:ruby="container"><span tts:ruby="base">伝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:25.620" end="03:26.200">つ</span><span tts:ruby="text" begin="03:26.200" end="03:26.500">た</span></span></span><span begin="03:26.500" end="03:27.040">え</span><span begin="03:27.040" end="03:27.300">た</span><span begin="03:27.300" end="03:28.100">かっ</span><span begin="03:28.100" end="03:28.640">た</span><span tts:ruby="container"><span tts:ruby="base">想</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:28.640" end="03:28.920">お</span><span tts:ruby="text" begin="03:28.920" end="03:29.400">も</span></span></span><span begin="03:29.400" end="03:29.740">い</span><span begin="03:29.740" end="03:30.460">は</span><span ttm:role="x-translation">曾经想要传达给你的思念</span><span ttm:role="x-roman">kimi ni tsutaetakatta omoi wa</span></p><p begin="03:30.800" end="03:36.560" ttm:agent="v1" itunes:key="L27"><span begin="03:30.800" end="03:31.080">ど</span><span begin="03:31.080" end="03:31.380">ん</span><span begin="03:31.380" end="03:31.920">な</span><span begin="03:32.400" end="03:32.660">カ</span><span begin="03:32.660" end="03:32.960">タ</span><span begin="03:32.960" end="03:33.440">チ</span><span begin="03:33.740" end="03:34.240">だっ</span><span begin="03:34.240" end="03:34.560">け</span><span begin="03:34.560" end="03:36.560">なぁ?</span><span ttm:role="x-translation">如今究竟变成了怎样的形状呢</span><span ttm:role="x-roman">donna katachi dakke nā?</span></p><p begin="03:37.000" end="03:40.080" ttm:agent="v1" itunes:key="L28"><span tts:ruby="container"><span tts:ruby="base">時</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:37.000" end="03:37.520">と</span><span tts:ruby="text" begin="03:37.520" end="03:37.840">き</span></span></span><span begin="03:37.840" end="03:38.820">は</span><span tts:ruby="container"><span tts:ruby="base">過</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:38.820" end="03:39.160">す</span></span></span><span begin="03:39.160" end="03:39.440">ぎ</span><span begin="03:39.440" end="03:40.080">る</span><span ttm:role="x-translation">岁月荏苒</span><span ttm:role="x-roman">toki wa sugiru</span></p><p begin="03:40.520" end="03:49.540" ttm:agent="v1" itunes:key="L29"><span tts:ruby="container"><span tts:ruby="base">残</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:40.520" end="03:40.740">ざ</span><span tts:ruby="text" begin="03:40.740" end="03:41.140">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">酷</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:41.140" end="03:41.560">こ</span><span tts:ruby="text" begin="03:41.560" end="03:42.160">く</span></span></span><span begin="03:42.160" end="03:42.460">な</span><span begin="03:42.460" end="03:42.700">ほ</span><span begin="03:42.700" end="03:43.480">ど</span><span tts:ruby="container"><span tts:ruby="base">当</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:44.000" end="03:44.360">あ</span></span></span><span begin="03:44.360" end="03:44.840">た</span><span begin="03:44.840" end="03:45.920">り</span><span tts:ruby="container"><span tts:ruby="base">前</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:45.920" end="03:46.440">ま</span><span tts:ruby="text" begin="03:46.440" end="03:46.780">え</span></span></span><span begin="03:46.780" end="03:47.220">の</span><span begin="03:47.220" end="03:47.470">よ</span><span begin="03:47.470" end="03:47.720">う</span><span begin="03:47.720" end="03:49.540">に</span><span ttm:role="x-translation">仿佛时光流逝的残酷已是寻常</span><span ttm:role="x-roman">zankoku na hodo atarimae no yō ni</span></p><p begin="03:50.220" end="03:56.320" ttm:agent="v1" itunes:key="L30"><span tts:ruby="container"><span tts:ruby="base">声</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:50.220" end="03:50.520">こ</span><span tts:ruby="text" begin="03:50.520" end="03:50.820">え</span></span></span><span begin="03:50.820" end="03:51.280">を</span><span tts:ruby="container"><span tts:ruby="base">殺</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:51.600" end="03:51.880">こ</span><span tts:ruby="text" begin="03:51.880" end="03:52.120">ろ</span></span></span><span begin="03:52.120" end="03:52.440">し</span><span begin="03:52.440" end="03:52.920">て</span><span tts:ruby="container"><span tts:ruby="base">泣</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:53.220" end="03:53.740">な</span></span></span><span begin="03:53.740" end="03:54.040">い</span><span begin="03:54.040" end="03:54.600">た</span><span begin="03:54.600" end="03:55.160">あ</span><span begin="03:55.160" end="03:55.360">の</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:55.360" end="03:55.720">ひ</span></span></span><span begin="03:55.720" end="03:56.320">も</span><span ttm:role="x-translation">就连低声哭泣的那日</span><span ttm:role="x-roman">koe o koroshite naita ano hi mo</span></p><p begin="03:56.740" end="04:02.320" ttm:agent="v1" itunes:key="L31"><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:56.740" end="03:57.020">み</span></span></span><span begin="03:57.020" end="03:57.300">え</span><span begin="03:57.300" end="03:57.860">な</span><span begin="03:57.860" end="03:58.100">い</span> <span tts:ruby="container"><span tts:ruby="base">傷</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:58.100" end="03:58.600">き</span><span tts:ruby="text" begin="03:58.600" end="03:58.920">ず</span></span></span><span begin="03:58.920" end="03:59.420">に</span><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="03:59.420" end="03:59.720">か</span></span></span><span begin="03:59.720" end="04:00.240">わ</span><span begin="04:00.240" end="04:00.540">る</span><span begin="04:00.540" end="04:02.320">よ</span><span ttm:role="x-translation">也化为看不见的伤痕</span><span ttm:role="x-roman">mienai kizu ni kawaru yo</span></p><p begin="04:02.800" end="04:06.200" ttm:agent="v1" itunes:key="L32"><span begin="04:02.800" end="04:03.240">そ</span><span begin="04:03.240" end="04:03.520">れ</span><span begin="04:03.520" end="04:03.780">で</span><span begin="04:03.780" end="04:04.860">も</span><span tts:ruby="container"><span tts:ruby="base">全</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:04.860" end="04:05.180">ぜ</span><span tts:ruby="text" begin="04:05.180" end="04:05.420">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">部</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:05.420" end="04:06.200">ぶ</span></span></span><span ttm:role="x-translation">即便如此</span><span ttm:role="x-roman">sore demo zenbu</span></p><p begin="04:06.420" end="04:09.400" ttm:agent="v1" itunes:key="L33"><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:06.420" end="04:06.760">ゆ</span><span tts:ruby="text" begin="04:06.760" end="04:07.040">め</span></span></span><span begin="04:07.040" end="04:07.540">の</span><span tts:ruby="container"><span tts:ruby="base">途</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:07.540" end="04:08.060">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:08.060" end="04:08.350">ちゅ</span><span tts:ruby="text" begin="04:08.350" end="04:08.640">う</span></span></span><span begin="04:08.640" end="04:09.400">で</span><span ttm:role="x-translation">在追逐梦想的途中</span><span ttm:role="x-roman">yume no tochū de</span></p><p begin="04:09.940" end="04:15.460" ttm:agent="v1" itunes:key="L34"><span begin="04:09.940" end="04:10.320">「ホ</span><span begin="04:10.320" end="04:10.800">ン</span><span begin="04:10.800" end="04:11.860">ト」</span><span begin="04:11.860" end="04:12.400">じゃ</span><span begin="04:12.400" end="04:12.700">な</span><span begin="04:12.700" end="04:13.200">け</span><span begin="04:13.200" end="04:13.520">れ</span><span begin="04:13.520" end="04:15.460">ば</span><span ttm:role="x-translation">一切却是飘渺虚无</span><span ttm:role="x-roman">honto ja nakereba</span></p><p begin="04:16.180" end="04:18.820" ttm:agent="v1" itunes:key="L35"><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:16.180" end="04:16.480">こ</span><span tts:ruby="text" begin="04:16.480" end="04:16.800">こ</span><span tts:ruby="text" begin="04:16.800" end="04:17.280">ろ</span></span></span><span tts:ruby="container"><span tts:ruby="base">交</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:17.540" end="04:17.840">か</span></span></span><span begin="04:17.840" end="04:18.100">わ</span><span begin="04:18.100" end="04:18.400">し</span><span begin="04:18.400" end="04:18.820">た</span><span ttm:role="x-translation">心心相印</span><span ttm:role="x-roman">kokoro kawashita</span></p><p begin="04:19.180" end="04:22.380" ttm:agent="v1" itunes:key="L36"><span begin="04:19.180" end="04:19.700">あ</span><span begin="04:19.700" end="04:19.960">の</span><span tts:ruby="container"><span tts:ruby="base">頃</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:19.960" end="04:20.840">こ</span><span tts:ruby="text" begin="04:20.840" end="04:21.640">ろ</span></span></span><span begin="04:21.640" end="04:22.380">を</span><span ttm:role="x-translation">那个时候</span><span ttm:role="x-roman">ano koro o</span></p><p begin="04:22.640" end="04:28.320" ttm:agent="v1" itunes:key="L37"><span begin="04:22.640" end="04:23.240">ずっ</span><span begin="04:23.240" end="04:24.020">と</span><span tts:ruby="container"><span tts:ruby="base">忘</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:24.020" end="04:24.500">わ</span><span tts:ruby="text" begin="04:24.500" end="04:24.880">す</span></span></span><span begin="04:24.880" end="04:25.400">れ</span><span begin="04:25.400" end="04:25.720">な</span><span begin="04:25.720" end="04:26.180">い</span><span begin="04:26.180" end="04:26.460">だ</span><span begin="04:26.460" end="04:27.390">ろ</span><span begin="04:27.390" end="04:28.320">う</span><span ttm:role="x-translation">也会一直铭记吧</span><span ttm:role="x-roman">zutto wasurenai darō</span></p><p begin="04:29.700" end="04:35.000" ttm:agent="v1" itunes:key="L38"><span tts:ruby="container"><span tts:ruby="base">古</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:29.700" end="04:30.500">ふ</span><span tts:ruby="text" begin="04:30.500" end="04:31.340">る</span></span></span><span begin="04:31.340" end="04:31.920">び</span><span begin="04:31.920" end="04:32.180">た</span><span tts:ruby="container"><span tts:ruby="base">筆</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:32.180" end="04:32.680">ふ</span><span tts:ruby="text" begin="04:32.680" end="04:32.980">で</span></span></span><span begin="04:32.980" end="04:35.000">で</span><span ttm:role="x-translation">让我们用陈旧的笔</span><span ttm:role="x-roman">furubita fude de</span></p><p begin="04:36.063" end="04:41.200" ttm:agent="v1" itunes:key="L39"><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:36.063" end="04:37.000">そ</span><span tts:ruby="text" begin="04:37.000" end="04:37.540">ら</span></span></span><span begin="04:37.540" end="04:37.840">に</span><span tts:ruby="container"><span tts:ruby="base">虹</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:37.840" end="04:38.340">に</span><span tts:ruby="text" begin="04:38.340" end="04:38.620">じ</span></span></span><span begin="04:38.620" end="04:39.161">を</span><span tts:ruby="container"><span tts:ruby="base">描</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:39.161" end="04:39.440">が</span></span></span><span begin="04:39.440" end="04:39.800">こ</span><span begin="04:39.800" end="04:41.200">う</span><span ttm:role="x-translation">在空中描绘彩虹吧</span><span ttm:role="x-roman">sora ni niji o egakō</span></p><p begin="04:41.860" end="04:48.280" ttm:agent="v1" itunes:key="L40"><span begin="04:41.860" end="04:42.140">こ</span><span begin="04:42.140" end="04:42.400">の</span><span tts:ruby="container"><span tts:ruby="base">世</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:42.400" end="04:42.720">よ</span></span></span><span begin="04:42.720" end="04:43.220">の</span><span begin="04:43.460" end="04:43.800" ttx:rubyGroup="1" ttx:rubyText="ど|こ" ttx:rubyTimes="04:43.460,04:43.800 04:43.800,04:44.060">何</span><span begin="04:43.800" end="04:44.060" ttx:rubyGroup="1">処</span><span begin="04:44.060" end="04:44.320">か</span><span begin="04:44.320" end="04:45.020">で</span><span tts:ruby="container"><span tts:ruby="base">眠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:45.360" end="04:45.660">ね</span><span tts:ruby="text" begin="04:45.660" end="04:46.000">む</span></span></span><span begin="04:46.000" end="04:46.480">る</span><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:46.720" end="04:47.040">き</span><span tts:ruby="text" begin="04:47.040" end="04:47.300">み</span></span></span><span begin="04:47.300" end="04:47.600">に</span><span begin="04:47.600" end="04:48.280">も</span><span ttm:role="x-translation">描绘在世界某处沉睡的你</span><span ttm:role="x-roman">kono yo no dokoka de nemuru kimi ni mo</span></p><p begin="04:48.620" end="04:55.220" ttm:agent="v1" itunes:key="L41"><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:48.620" end="04:48.920">み</span></span></span><span begin="04:48.920" end="04:49.220">え</span><span begin="04:49.220" end="04:49.880">る</span><span begin="04:50.280" end="04:50.560">く</span><span begin="04:50.560" end="04:50.840">ら</span><span begin="04:50.840" end="04:51.300">い</span><span tts:ruby="container"><span tts:ruby="base">綺</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:51.580" end="04:51.900">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">麗</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="04:51.900" end="04:52.220">れ</span><span tts:ruby="text" begin="04:52.220" end="04:52.500">い</span></span></span><span begin="04:52.500" end="04:55.220">に</span><span ttm:role="x-translation">也能看见的美丽</span><span ttm:role="x-roman">mieru kurai kirei ni</span></p><p begin="05:20.780" end="05:23.840" ttm:agent="v1" itunes:key="L42"><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:20.780" end="05:21.280">ぼ</span><span tts:ruby="text" begin="05:21.280" end="05:21.620">く</span></span></span><span begin="05:21.620" end="05:22.640">は</span><span tts:ruby="container"><span tts:ruby="base">待</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:22.640" end="05:22.920">ま</span></span></span><span begin="05:22.920" end="05:23.220">つ</span><span begin="05:23.220" end="05:23.840">よ</span><span ttm:role="x-translation">我等着哦</span><span ttm:role="x-roman">boku wa matsu yo</span></p><p begin="05:24.280" end="05:33.460" ttm:agent="v1" itunes:key="L43"><span begin="05:24.280" end="05:24.600">ど</span><span begin="05:24.600" end="05:24.860">ん</span><span begin="05:24.860" end="05:25.400">な</span><span begin="05:25.400" end="05:25.940">に</span><span tts:ruby="container"><span tts:ruby="base">時</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:25.940" end="05:26.200">と</span><span tts:ruby="text" begin="05:26.200" end="05:26.480">き</span></span></span><span begin="05:26.480" end="05:27.200">が</span><span tts:ruby="container"><span tts:ruby="base">経っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:27.760" end="05:28.300">た</span><span tts:ruby="text" begin="05:28.300" end="05:28.620">っ</span></span></span><span begin="05:28.620" end="05:29.660">て</span><span begin="05:29.660" end="05:30.260">し</span><span begin="05:30.260" end="05:31.080">まっ</span><span begin="05:31.080" end="05:31.360">て</span><span begin="05:31.360" end="05:33.460">も</span><span ttm:role="x-translation">纵使时光长流飞逝</span><span ttm:role="x-roman">donna ni toki ga tatte shimatte mo</span></p><p begin="05:34.000" end="05:40.100" ttm:agent="v1" itunes:key="L44"><span tts:ruby="container"><span tts:ruby="base">二</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:34.000" end="05:34.340">に</span></span></span><span tts:ruby="container"><span tts:ruby="base">度</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:34.340" end="05:34.620">ど</span></span></span><span begin="05:34.620" end="05:35.080">と</span><span tts:ruby="container"><span tts:ruby="base">叶</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:35.380" end="05:35.680">か</span><span tts:ruby="text" begin="05:35.680" end="05:35.920">な</span></span></span><span begin="05:35.920" end="05:36.220">わ</span><span begin="05:36.220" end="05:36.640">ぬ</span><span tts:ruby="container"><span tts:ruby="base">愿</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:36.980" end="05:37.520">ね</span><span tts:ruby="text" begin="05:37.520" end="05:37.820">が</span></span></span><span begin="05:37.820" end="05:38.660">い</span><span begin="05:38.660" end="05:38.940">な</span><span begin="05:38.940" end="05:39.200">ん</span><span begin="05:39.200" end="05:39.440">だ</span><span begin="05:39.440" end="05:39.840">ろ</span><span begin="05:39.840" end="05:40.100">う</span><span ttm:role="x-translation">无法实现的心愿是什么呢</span><span ttm:role="x-roman">nido to kanawanu negai nan darō</span></p><p begin="05:40.500" end="05:46.160" ttm:agent="v1" itunes:key="L45"><span tts:ruby="container"><span tts:ruby="base">長</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:40.500" end="05:40.800">な</span><span tts:ruby="text" begin="05:40.800" end="05:41.120">が</span></span></span><span begin="05:41.120" end="05:41.860">い</span><span tts:ruby="container"><span tts:ruby="base">夜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:41.860" end="05:42.420">よ</span><span tts:ruby="text" begin="05:42.420" end="05:42.700">る</span></span></span><span begin="05:42.700" end="05:43.180">を</span><span tts:ruby="container"><span tts:ruby="base">包</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:43.180" end="05:43.500">つ</span><span tts:ruby="text" begin="05:43.500" end="05:44.060">つ</span></span></span><span begin="05:44.060" end="05:44.320">ん</span><span begin="05:44.320" end="05:46.160">で</span><span ttm:role="x-translation">笼罩长夜</span><span ttm:role="x-roman">nagai yoru o tsutsunde</span></p><p begin="05:46.583" end="05:49.920" ttm:agent="v1" itunes:key="L46"><span begin="05:46.583" end="05:47.020">そ</span><span begin="05:47.020" end="05:47.280">れ</span><span begin="05:47.280" end="05:47.560">で</span><span begin="05:47.560" end="05:48.620">も</span><span tts:ruby="container"><span tts:ruby="base">全</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:48.620" end="05:48.980">ぜ</span><span tts:ruby="text" begin="05:48.980" end="05:49.180">ん</span></span></span><span tts:ruby="container"><span tts:ruby="base">部</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:49.180" end="05:49.920">ぶ</span></span></span><span ttm:role="x-translation">即便如此</span><span ttm:role="x-roman">sore demo zenbu</span></p><p begin="05:50.180" end="05:53.260" ttm:agent="v1" itunes:key="L47"><span tts:ruby="container"><span tts:ruby="base">夢</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:50.180" end="05:50.540">ゆ</span><span tts:ruby="text" begin="05:50.540" end="05:50.840">め</span></span></span><span begin="05:50.840" end="05:51.340">の</span><span tts:ruby="container"><span tts:ruby="base">途</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:51.340" end="05:51.860">と</span></span></span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="05:51.860" end="05:52.140">ちゅ</span><span tts:ruby="text" begin="05:52.140" end="05:52.420">う</span></span></span><span begin="05:52.420" end="05:53.260">で</span><span ttm:role="x-translation">在追逐梦想的途中</span><span ttm:role="x-roman">yume no tochū de</span></p><p begin="05:53.720" end="05:59.340" ttm:agent="v1" itunes:key="L48"><span begin="05:53.720" end="05:54.100">「ホ</span><span begin="05:54.100" end="05:54.560">ン</span><span begin="05:54.560" end="05:55.620">ト」</span><span begin="05:55.620" end="05:56.200">じゃ</span><span begin="05:56.200" end="05:56.500">な</span><span begin="05:56.500" end="05:57.000">け</span><span begin="05:57.000" end="05:57.300">れ</span><span begin="05:57.300" end="05:59.340">ば</span><span ttm:role="x-translation">一切却是飘渺虚无</span><span ttm:role="x-roman">honto ja nakereba</span></p><p begin="05:59.900" end="06:02.640" ttm:agent="v1" itunes:key="L49"><span begin="05:59.900" end="06:00.280">そ</span><span begin="06:00.280" end="06:00.540">ば</span><span begin="06:00.540" end="06:01.080">に</span><span tts:ruby="container"><span tts:ruby="base">変</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="06:01.280" end="06:01.580">か</span></span></span><span begin="06:01.580" end="06:01.860">わ</span><span begin="06:01.860" end="06:02.160">ら</span><span begin="06:02.160" end="06:02.420">な</span><span begin="06:02.420" end="06:02.640">い</span><span ttm:role="x-translation">明明</span><span ttm:role="x-roman">soba ni kawaranai</span></p><p begin="06:02.920" end="06:06.120" ttm:agent="v1" itunes:key="L50"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="06:02.920" end="06:03.500">き</span><span tts:ruby="text" begin="06:03.500" end="06:03.780">み</span></span></span><span begin="06:03.780" end="06:04.640">が</span><span begin="06:04.640" end="06:05.380">い</span><span begin="06:05.380" end="06:06.120">て</span><span ttm:role="x-translation">你一直在我身边</span><span ttm:role="x-roman">kimi ga ite</span></p><p begin="06:06.440" end="06:12.480" ttm:agent="v1" itunes:key="L51"><span begin="06:06.440" end="06:06.980">ずっ</span><span begin="06:06.980" end="06:07.800">と</span><span tts:ruby="container"><span tts:ruby="base">笑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="06:07.800" end="06:08.360">わ</span><span tts:ruby="text" begin="06:08.360" end="06:08.660">ら</span></span></span><span begin="06:08.660" end="06:09.180">え</span><span begin="06:09.180" end="06:09.480">て</span><span begin="06:09.480" end="06:09.980">た</span><span begin="06:09.980" end="06:10.260">の</span><span begin="06:10.260" end="06:12.480">に</span><span ttm:role="x-translation">笑容依旧</span><span ttm:role="x-roman">zutto waraeteta no ni</span></p><p begin="06:13.440" end="06:19.160" ttm:agent="v1" itunes:key="L52"><span tts:ruby="container"><span tts:ruby="base">遠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="06:13.440" end="06:13.820">と</span><span tts:ruby="text" begin="06:13.820" end="06:14.240">お</span></span></span><span begin="06:14.240" end="06:14.560">く</span><span tts:ruby="container"><span tts:ruby="base">揺</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="06:14.560" end="06:14.820">ゆ</span></span></span><span begin="06:14.820" end="06:15.120">れ</span><span begin="06:15.120" end="06:15.700">る</span> <span tts:ruby="container"><span tts:ruby="base">何</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="06:16.435" end="06:16.820">な</span><span tts:ruby="text" begin="06:16.820" end="06:17.540">に</span></span></span><span begin="06:17.540" end="06:18.040">も</span><span begin="06:18.040" end="06:18.360">か</span><span begin="06:18.360" end="06:19.160">も</span><span ttm:role="x-translation">万物在远方摇曳</span><span ttm:role="x-roman">tōku yureru nani mo kamo</span></p><p begin="06:20.080" end="06:25.600" ttm:agent="v1" itunes:key="L53"><span begin="06:20.080" end="06:20.820">い</span><span begin="06:20.820" end="06:21.400">つ</span><span begin="06:21.400" end="06:21.660">か</span><span begin="06:21.660" end="06:22.440">きっ</span><span begin="06:22.440" end="06:22.780">と</span> <span tts:ruby="container"><span tts:ruby="base">会</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="06:22.980" end="06:23.260">あ</span></span></span><span begin="06:23.260" end="06:23.560">え</span><span begin="06:23.560" end="06:23.820">る</span><span begin="06:23.820" end="06:24.020">と</span><span tts:ruby="container"><span tts:ruby="base">信</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="06:24.020" end="06:24.340">し</span><span tts:ruby="text" begin="06:24.340" end="06:24.600">ん</span></span></span><span begin="06:24.600" end="06:24.880">じ</span><span begin="06:24.880" end="06:25.600">て</span><span ttm:role="x-translation">坚信未来终有一日能相逢</span><span ttm:role="x-roman">itsuka kitto aeru to shinjite</span></p><p begin="06:26.500" end="06:28.940" ttm:agent="v1" itunes:key="L54"><span tts:ruby="container"><span tts:ruby="base">聞</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="06:26.500" end="06:27.300">き</span></span></span><span begin="06:27.300" end="06:27.600">き</span><span begin="06:27.600" end="06:27.880">な</span><span begin="06:27.880" end="06:28.160">れ</span><span begin="06:28.160" end="06:28.940">た</span><span ttm:role="x-translation">就连</span><span ttm:role="x-roman">kikinareta</span></p><p begin="06:29.343" end="06:32.240" ttm:agent="v1" itunes:key="L55"><span begin="06:29.343" end="06:29.720">そ</span><span begin="06:29.720" end="06:30.480">の</span><span tts:ruby="container"><span tts:ruby="base">声</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="06:30.480" end="06:31.020">こ</span><span tts:ruby="text" begin="06:31.020" end="06:31.360">え</span></span></span><span begin="06:31.360" end="06:32.240">も</span><span ttm:role="x-translation">熟悉的那个声音</span><span ttm:role="x-roman">sono koe mo</span></p><p begin="06:33.020" end="06:41.020" ttm:agent="v1" itunes:key="L56"><span begin="06:33.020" end="06:33.840">い</span><span begin="06:33.840" end="06:34.420">つ</span><span begin="06:34.420" end="06:34.720">の</span><span tts:ruby="container"><span tts:ruby="base">間</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="06:34.720" end="06:35.320">ま</span></span></span><span begin="06:35.320" end="06:35.620">に</span><span begin="06:35.620" end="06:35.980">か</span> <span tts:ruby="container"><span tts:ruby="base">儚</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="06:36.220" end="06:36.540">は</span><span tts:ruby="text" begin="06:36.540" end="06:36.880">か</span><span tts:ruby="text" begin="06:36.880" end="06:37.160">な</span></span></span><span begin="06:37.160" end="06:37.500">く</span><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="06:37.500" end="06:38.200">き</span></span></span><span begin="06:38.200" end="06:38.600">え</span><span begin="06:38.600" end="06:41.020">る</span><span ttm:role="x-translation">也在不知不觉间转瞬即逝</span><span ttm:role="x-roman">itsu no ma ni ka hakanaku kieru</span></p></div></body></tt>