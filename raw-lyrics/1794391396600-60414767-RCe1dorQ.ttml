by="textContainer"><span tts:ruby="text" begin="2:49.709" end="2:49.880">うご</span></span></span><span begin="2:49.880" end="2:50.136">き</span><span begin="2:50.136" end="2:50.338">だ</span><span begin="2:50.338" end="2:50.545">す</span><span begin="2:50.545" end="2:50.726">こ</span><span begin="2:50.726" end="2:51.013">と</span><span begin="2:51.013" end="2:51.151">を</span><span tts:ruby="container"><span tts:ruby="base">拒</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:51.151" end="2:51.505">こば</span></span></span><span begin="2:51.505" end="2:51.685">ん</span><span begin="2:51.685" end="2:51.884">で</span><span begin="2:51.884" end="2:52.133">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">就算心底抗拒着动身</span><span ttm:role="x-roman">ko ko ro no o ku ga u go ki da su ko to wo ko ba n de mo</span></p><p begin="2:52.133" end="2:55.566" itunes:key="L40" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">夜</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:52.133" end="2:52.576">よる</span></span></span><span begin="2:52.576" end="2:52.749">が</span><span begin="2:52.749" end="2:52.949">こ</span><span begin="2:52.949" end="2:53.125">の</span><span tts:ruby="container"><span tts:ruby="base">世</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:53.125" end="2:53.316">せ</span></span></span><span tts:ruby="container"><span tts:ruby="base">界</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:53.316" end="2:53.716">かい</span></span></span><span begin="2:53.716" end="2:54.085">を</span><span tts:ruby="container"><span tts:ruby="base">包</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:54.085" end="2:54.834">つつ</span></span></span><span begin="2:54.834" end="2:54.973">ん</span><span begin="2:54.973" end="2:55.181">で</span><span begin="2:55.181" end="2:55.566">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">就算黑夜将世界包裹</span><span ttm:role="x-roman">yo ru ga ko no se ka i wo tsu tsu n de mo</span></p><p begin="2:55.886" end="2:57.262" itunes:key="L41" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">無</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:55.886" end="2:56.150">む</span></span></span><span tts:ruby="container"><span tts:ruby="base">駄</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:56.150" end="2:56.799">だ</span></span></span><span begin="2:56.799" end="2:57.014">だ</span><span begin="2:57.014" end="2:57.262">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">那也无所谓</span><span ttm:role="x-roman">mu da da yo</span></p><p begin="2:57.502" end="3:05.380" itunes:key="L42" ttm:agent="v1"><span begin="2:57.502" end="2:57.758">こ</span><span begin="2:57.758" end="2:58.430">の</span><span tts:ruby="container"><span tts:ruby="base">火</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:58.430" end="2:58.638">ひ</span></span></span><span begin="2:58.638" end="2:59.231">に</span><span begin="2:59.231" end="2:59.425">は</span><span begin="2:59.425" end="2:59.586">も</span><span begin="2:59.586" end="2:59.764">う</span><span tts:ruby="container"><span tts:ruby="base">抗</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:00.065" end="3:01.071">あらが</span></span></span><span begin="3:01.071" end="3:01.476">え</span><span begin="3:01.476" end="3:01.558">な</span><span begin="3:01.558" end="3:01.742">い</span><span begin="3:01.742" end="3:01.810">ん</span><span begin="3:01.810" end="3:05.380">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">因为我已无法抗拒这团火焰</span><span ttm:role="x-roman">ko no hi ni ha mo u a ra ga e na i n da</span></p><p begin="3:02.146" end="3:04.442" itunes:key="L43" ttm:agent="v2"><span tts:ruby="container"><span tts:ruby="base">何</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:02.146" end="3:02.518">なん</span></span></span><span tts:ruby="container"><span tts:ruby="base">度</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:02.518" end="3:02.729">ど</span></span></span><span begin="3:02.729" end="3:02.930">だ</span><span begin="3:02.930" end="3:03.066">っ</span><span begin="3:03.066" end="3:03.386">て</span><span tts:ruby="container"><span tts:ruby="base">感</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:03.386" end="3:03.746">かん</span></span></span><span tts:ruby="container"><span tts:ruby="base">動</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:03.746" end="3:04.154">どう</span></span></span><span begin="3:04.154" end="3:04.442">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">那悸动一次又一次</span><span ttm:role="x-roman">na n do da &apos;t te ka n do u ga</span></p><p begin="3:04.600" end="3:07.818" itunes:key="L44" ttm:agent="v2"><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:04.600" end="3:05.106">ぼく</span></span></span><span begin="3:05.106" end="3:05.328">ら</span><span begin="3:05.328" end="3:05.644">の</span><span tts:ruby="container"><span tts:ruby="base">日</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:05.773" end="3:05.940">ひ</span></span></span><span tts:ruby="container"><span tts:ruby="base">々</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:05.940" end="3:06.196">び</span></span></span><span begin="3:06.196" end="3:06.404">を</span><span tts:ruby="container"><span tts:ruby="base">灯</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:06.404" end="3:07.105">とも</span></span></span><span begin="3:07.105" end="3:07.150">し</span><span begin="3:07.150" end="3:07.337">た</span><span begin="3:07.337" end="3:07.601">ん</span><span begin="3:07.601" end="3:07.818">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">将我们的每一天点亮</span><span ttm:role="x-roman">bo ku ra no hi bi wo to mo shi ta n da</span></p><p begin="3:07.318" end="3:11.874" itunes:key="L45" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">灯</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:07.318" end="3:07.857">とも</span></span></span><span begin="3:07.857" end="3:08.020">し</span><span begin="3:08.020" end="3:08.046">た</span><span begin="3:08.046" end="3:08.370">ん</span><span begin="3:08.370" end="3:11.874">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">已经点亮了</span><span ttm:role="x-roman">to mo shi ta n da</span></p><p begin="3:07.851" end="3:11.107" itunes:key="L46" ttm:agent="v2"><span tts:ruby="container"><span tts:ruby="base">道</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:07.851" end="3:08.329">みち</span></span></span><span tts:ruby="container"><span tts:ruby="base">端</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:08.329" end="3:08.915">ばた</span></span></span><span begin="3:08.915" end="3:09.142">の</span><span tts:ruby="container"><span tts:ruby="base">石</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:09.142" end="3:09.641">いし</span></span></span><span begin="3:09.641" end="3:09.738">が</span><span begin="3:09.738" end="3:09.939">い</span><span begin="3:09.939" end="3:10.431">つ</span><span begin="3:10.431" end="3:10.809">か</span><span begin="3:10.809" end="3:11.107">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">路边的石子不知从何时起</span><span ttm:role="x-roman">mi chi ba ta no i shi ga i tsu ka ra</span></p><p begin="3:11.150" end="3:14.402" itunes:key="L47" ttm:agent="v2"><span tts:ruby="container"><span tts:ruby="base">宝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:11.150" end="3:11.510">ほう</span></span></span><span tts:ruby="container"><span tts:ruby="base">石</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:11.510" end="3:12.226">せき</span></span></span><span begin="3:12.226" end="3:12.424">の</span><span begin="3:12.424" end="3:12.444">よ</span><span begin="3:12.444" end="3:12.846">う</span><span begin="3:12.846" end="3:13.016">に</span><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:13.016" end="3:13.206">み</span></span></span><span begin="3:13.206" end="3:13.660">え</span><span begin="3:13.660" end="3:13.770">た</span><span begin="3:13.770" end="3:13.940">ん</span><span begin="3:13.940" end="3:14.402">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">已如宝石一般璀璨生光</span><span ttm:role="x-roman">ho u se ki no yo u ni mi e ta n da</span></p><p begin="3:13.901" end="3:17.396" itunes:key="L48" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">何</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:13.901" end="3:14.429">なん</span></span></span><span tts:ruby="container"><span tts:ruby="base">度</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:14.429" end="3:14.633">ど</span></span></span><span begin="3:14.633" end="3:14.855">で</span><span begin="3:14.855" end="3:17.396">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">不管多少次</span><span ttm:role="x-roman">na n do de mo</span></p><p begin="3:14.273" end="3:17.420" itunes:key="L49" ttm:agent="v2"><span begin="3:14.273" end="3:14.841">き</span><span begin="3:14.841" end="3:14.900">っ</span><span begin="3:14.900" end="3:15.074">と</span><span tts:ruby="container"><span tts:ruby="base">何</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:15.074" end="3:15.485">なん</span></span></span><span tts:ruby="container"><span tts:ruby="base">度</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:15.485" end="3:15.685">ど</span></span></span><span begin="3:15.685" end="3:15.865">だ</span><span begin="3:15.865" end="3:16.045">っ</span><span begin="3:16.045" end="3:16.389">て</span><span tts:ruby="container"><span tts:ruby="base">感</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:16.389" end="3:16.725">かん</span></span></span><span tts:ruby="container"><span tts:ruby="base">動</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:16.725" end="3:17.149">どう</span></span></span><span begin="3:17.149" end="3:17.420">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">必是如此啊 那悸动一次又一次</span><span ttm:role="x-roman">ki &apos;t to na n do da &apos;t te ka n do u ga</span></p><p begin="3:17.612" end="3:20.608" itunes:key="L50" ttm:agent="v2"><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:17.612" end="3:17.932">ぼく</span></span></span><span begin="3:17.932" end="3:18.132">ら</span><span begin="3:18.132" end="3:18.372">の</span><span tts:ruby="container"><span tts:ruby="base">火</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:18.612" end="3:18.895">ひ</span></span></span><span tts:ruby="container"><span tts:ruby="base">々</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:18.895" end="3:19.286">び</span></span></span><span begin="3:19.286" end="3:19.501">を</span><span tts:ruby="container"><span tts:ruby="base">灯</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:19.501" end="3:20.003">とも</span></span></span><span begin="3:20.003" end="3:20.116">し</span><span begin="3:20.116" end="3:20.192">た</span><span begin="3:20.192" end="3:20.547">ん</span><span begin="3:20.547" end="3:20.608">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">将我们的火焰点亮</span><span ttm:role="x-roman">bo ku ra no hi bi wo to mo shi ta n da</span></p><p begin="3:20.838" end="3:23.886" itunes:key="L51" ttm:agent="v2"><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:20.838" end="3:21.006">き</span></span></span><span begin="3:21.006" end="3:21.150">え</span><span begin="3:21.150" end="3:21.438">か</span><span begin="3:21.438" end="3:21.642">か</span><span begin="3:21.642" end="3:21.846">っ</span><span begin="3:21.846" end="3:22.054">た</span><span tts:ruby="container"><span tts:ruby="base">意</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:22.054" end="3:22.214">い</span></span></span><span tts:ruby="container"><span tts:ruby="base">志</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:22.214" end="3:22.518">し</span></span></span><span begin="3:22.518" end="3:22.734">が</span><span begin="3:22.734" end="3:22.910">い</span><span begin="3:22.910" end="3:23.198">つ</span><span begin="3:23.198" end="3:23.606">か</span><span begin="3:23.606" end="3:23.886">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">行将溃散的意志不知何时</span><span ttm:role="x-roman">ki e ka ka &apos;t ta i shi ga i tsu ka ra</span></p><p begin="3:24.096" end="3:27.210" itunes:key="L52" ttm:agent="v2"><span begin="3:24.096" end="3:24.324">こ</span><span begin="3:24.324" end="3:24.552">ん</span><span begin="3:24.552" end="3:24.777">な</span><span begin="3:24.777" end="3:25.136">に</span><span tts:ruby="container"><span tts:ruby="base">熱</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:25.136" end="3:25.803">ねつ</span></span></span><span begin="3:25.803" end="3:26.000">を</span><span tts:ruby="container"><span tts:ruby="base">纏</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:26.000" end="3:26.568">まと</span></span></span><span begin="3:26.568" end="3:26.651">っ</span><span begin="3:26.651" end="3:27.210">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">竟又被如此热情裹缠</span><span ttm:role="x-roman">ko n na ni ne tsu wo ma to &apos;t ta</span></p></div></body></tt>