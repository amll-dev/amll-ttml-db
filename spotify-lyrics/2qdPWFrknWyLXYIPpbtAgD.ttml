base">書</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="27.841" end="28.080">か</span></span></span><span begin="28.080" end="28.241">い</span><span begin="28.241" end="28.391">た</span><span begin="28.391" end="28.660">あ</span><span begin="28.660" end="28.841">の</span><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="28.841" end="29.011">こと</span></span></span><span tts:ruby="container"><span tts:ruby="base">葉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="29.011" end="29.400">ば</span></span></span><span begin="29.400" end="29.621">た</span><span begin="29.621" end="29.811">ち</span><span begin="29.811" end="30.060">は</span><span ttm:role="x-translation" xml:lang="zh-Hans">那些曾写下的那些话语</span><span ttm:role="x-roman">kaita ano kotobatachi wa</span></p><p begin="30.691" end="33.940" itunes:key="L3" ttm:agent="v1"><span begin="30.691" end="31.161">きっ</span><span begin="31.161" end="31.741">と</span> <span tts:ruby="container"><span tts:ruby="base">泡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="31.741" end="32.171">あわ</span></span></span><span begin="32.171" end="32.341">に</span><span begin="32.341" end="32.731">なっ</span><span begin="32.731" end="32.911">て</span><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="32.911" end="33.300">き</span></span></span><span begin="33.300" end="33.531">え</span><span begin="33.531" end="33.940">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">肯定也将化作泡沫逝去</span><span ttm:role="x-roman">kitto awa ni natte kieta</span></p><p begin="34.871" end="37.060" itunes:key="L4" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">行</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="34.871" end="35.251">ゆくえ</span></span></span><span begin="35.251" end="35.461">方</span><span begin="35.461" end="35.640">な</span><span begin="35.640" end="35.821">ん</span><span begin="35.821" end="35.911">て</span><span tts:ruby="container"><span tts:ruby="base">知</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="35.911" end="36.451">し</span></span></span><span begin="36.451" end="36.651">ら</span><span begin="36.651" end="36.880">な</span><span begin="36.880" end="37.060">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">从此无影无踪</span><span ttm:role="x-roman">yukue nante shiranai</span></p><p begin="37.321" end="40.080" itunes:key="L5" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">擦</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="37.321" end="37.611">す</span></span></span><span begin="37.611" end="37.781">り</span><span tts:ruby="container"><span tts:ruby="base">切っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="37.781" end="38.201">き</span></span></span><span begin="38.201" end="38.431">た</span><span tts:ruby="container"><span tts:ruby="base">白</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="38.431" end="38.770">しろ</span></span></span><span begin="38.770" end="39.131">い</span><span begin="39.131" end="39.520">チョー</span><span begin="39.520" end="39.761">ク</span><span begin="39.761" end="40.080">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">一支破旧的白色粉笔</span><span ttm:role="x-roman">surikitta shiroi chōku ga</span></p><p begin="40.331" end="42.580" itunes:key="L6" ttm:agent="v1"><span begin="40.331" end="40.541">は</span><span begin="40.541" end="40.720">ら</span><span begin="40.720" end="40.911">は</span><span begin="40.911" end="41.120">ら</span><span begin="41.120" end="41.320">と</span><span tts:ruby="container"><span tts:ruby="base">落</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="41.320" end="41.501">お</span></span></span><span begin="41.501" end="41.701">ち</span><span begin="41.701" end="41.920">て</span><span begin="41.920" end="42.271">いっ</span><span begin="42.271" end="42.580">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">静静地从桌面落下</span><span ttm:role="x-roman">harahara to ochite itta</span></p><p begin="43.261" end="46.420" itunes:key="L7" ttm:agent="v1"><span begin="43.261" end="43.460">ま</span><span begin="43.460" end="43.651">る</span><span begin="43.651" end="44.211">で</span> <span tts:ruby="container"><span tts:ruby="base">星</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="44.211" end="44.591">ほし</span></span></span><span tts:ruby="container"><span tts:ruby="base">屑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="44.591" end="45.211">くず</span></span></span><span begin="45.211" end="45.381">み</span><span begin="45.381" end="45.640">た</span><span begin="45.640" end="45.781">い</span><span begin="45.781" end="45.991">だ</span><span begin="45.991" end="46.420">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">宛如星尘般美丽</span><span ttm:role="x-roman">marude hoshikuzu mitai da to</span></p><p begin="46.951" end="50.160" itunes:key="L8" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">見</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="46.951" end="47.121">み</span></span></span><span begin="47.121" end="47.460">と</span><span begin="47.460" end="47.741">れ</span><span begin="47.741" end="47.960">て</span><span begin="47.960" end="48.080">い</span><span begin="48.080" end="48.320">た</span><span begin="48.320" end="48.521">ん</span><span begin="48.521" end="49.431">だ</span> <span tts:ruby="container"><span tts:ruby="base">嗚</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="49.431" end="49.770">ああ</span></span></span><span begin="49.770" end="50.160">呼</span><span ttm:role="x-translation" xml:lang="zh-Hans">深深地将我吸引</span><span ttm:role="x-roman">mitorete ita n da ā</span></p><p begin="50.160" end="52.680" itunes:key="L9" ttm:agent="v1"><span begin="50.160" end="50.481">い</span><span begin="50.481" end="50.640">つ</span><span begin="50.640" end="50.840">か</span><span begin="50.840" end="51.021">は</span><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="51.021" end="51.240">き</span></span></span><span begin="51.240" end="51.431">え</span><span begin="51.431" end="51.531">て</span><span begin="51.531" end="51.831">し</span><span begin="51.831" end="52.020">ま</span><span begin="52.020" end="52.211">う</span><span begin="52.211" end="52.451">け</span><span begin="52.451" end="52.680">ど</span><span ttm:role="x-translation" xml:lang="zh-Hans">即便终有一日会消逝</span><span ttm:role="x-roman">itsuka wa kiete shimau kedo</span></p><p begin="52.821" end="57.300" itunes:key="L10" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">誰</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="52.821" end="53.181">だれ</span></span></span><span begin="53.181" end="53.401">か</span><span begin="53.401" end="53.561">の</span><span tts:ruby="container"><span tts:ruby="base">記</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="53.561" end="53.800">き</span></span></span><span tts:ruby="container"><span tts:ruby="base">憶</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="53.800" end="54.171">おく</span></span></span><span begin="54.171" end="54.420">に</span><span begin="54.420" end="54.751">は</span><span tts:ruby="container"><span tts:ruby="base">残</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="54.751" end="55.341">のこ</span></span></span><span begin="55.341" end="55.551">れ</span><span begin="55.551" end="56.111">る</span><span begin="56.111" end="56.511">か</span><span begin="56.511" end="57.300">な</span><span ttm:role="x-translation" xml:lang="zh-Hans">是否能将它留在某人的记忆中呢</span><span ttm:role="x-roman">dareka no kioku ni wa nokoreru kana</span></p><p begin="57.651" end="1:02.680" itunes:key="L11" ttm:agent="v1"><span begin="57.651" end="58.071">こ</span><span begin="58.071" end="58.291">の</span><span tts:ruby="container"><span tts:ruby="base">瞬</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="58.291" end="59.211">しゅん</span></span></span><span tts:ruby="container"><span tts:ruby="base">間</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="59.211" end="1:00.020">かん</span></span></span><span begin="1:00.020" end="1:00.401">を</span><span tts:ruby="container"><span tts:ruby="base">切</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:00.401" end="1:00.801">き</span></span></span><span begin="1:00.801" end="1:01.131">り</span><span tts:ruby="container"><span tts:ruby="base">取っ</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:01.131" end="1:01.640">と</span></span></span><span begin="1:01.640" end="1:01.851">て</span><span begin="1:01.851" end="1:02.680">さ</span><span ttm:role="x-translation" xml:lang="zh-Hans">将这美好的瞬间</span><span ttm:role="x-roman">kono shunkan o kiritotte sa</span></p><p begin="1:03.431" end="1:07.860" itunes:key="L12" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:03.431" end="1:05.081">ひか</span></span></span><span begin="1:05.081" end="1:05.791">る</span><span tts:ruby="container"><span tts:ruby="base">朝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:05.791" end="1:06.281">あさ</span></span></span><span begin="1:06.281" end="1:07.001">が</span> <span tts:ruby="container"><span tts:ruby="base">朝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:07.001" end="1:07.461">あさ</span></span></span><span begin="1:07.461" end="1:07.860">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">闪耀着阳光的早晨</span><span ttm:role="x-roman">hikaru asa ga asa ga</span></p><p begin="1:08.160" end="1:12.060" itunes:key="L13" ttm:agent="v1"><span begin="1:08.160" end="1:08.411">あ</span><span begin="1:08.411" end="1:08.591">ま</span><span begin="1:08.591" end="1:08.800">り</span><span begin="1:08.800" end="1:09.001">に</span><span tts:ruby="container"><span tts:ruby="base">眩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:09.001" end="1:09.281">まぶ</span></span></span><span begin="1:09.281" end="1:09.540">し</span><span begin="1:09.540" end="1:10.121">い</span> <span tts:ruby="container"><span tts:ruby="base">眩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:10.121" end="1:10.441">まぶ</span></span></span><span begin="1:10.441" end="1:10.860">し</span><span begin="1:10.860" end="1:11.291">い</span><span begin="1:11.291" end="1:11.520">か</span><span begin="1:11.520" end="1:11.631">ら</span><span begin="1:11.631" end="1:12.060">さ</span><span ttm:role="x-translation" xml:lang="zh-Hans">实在是太过耀眼</span><span ttm:role="x-roman">amari ni mabushii mabushii kara sa</span></p><p begin="1:12.311" end="1:14.800" itunes:key="L14" ttm:agent="v1"><span begin="1:12.311" end="1:12.540">な</span><span begin="1:12.540" end="1:12.691">ん</span><span begin="1:12.691" end="1:12.881">か</span><span begin="1:12.881" end="1:13.160">も</span><span begin="1:13.160" end="1:13.371">う</span> <span begin="1:13.371" end="1:13.641">そ</span><span begin="1:13.641" end="1:13.941">れ</span><span begin="1:13.941" end="1:14.251">だ</span><span begin="1:14.251" end="1:14.431">け</span><span begin="1:14.431" end="1:14.800">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">但总觉仅是如此</span><span ttm:role="x-roman">nanka mō sore dake de</span></p><p begin="1:14.991" end="1:18.280" itunes:key="L15" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:14.991" end="1:15.971">こころ</span></span></span><span begin="1:15.971" end="1:16.291">が</span><span tts:ruby="container"><span tts:ruby="base">宙</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:16.291" end="1:17.151">ちゅう</span></span></span><span begin="1:17.151" end="1:17.531">に</span><span tts:ruby="container"><span tts:ruby="base">舞</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:17.531" end="1:17.800">ま</span></span></span><span begin="1:17.800" end="1:18.280">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的心也已浮于空中</span><span ttm:role="x-roman">kokoro ga chū ni mau</span></p><p begin="1:18.691" end="1:21.220" itunes:key="L16" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:18.691" end="1:19.101">きみ</span></span></span><span begin="1:19.101" end="1:19.871">の</span><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:19.871" end="1:20.271">こと</span></span></span><span tts:ruby="container"><span tts:ruby="base">葉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:20.271" end="1:20.471">ば</span></span></span><span begin="1:20.471" end="1:20.611">が</span><span begin="1:20.611" end="1:21.031">ずっ</span><span begin="1:21.031" end="1:21.220">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">你的话语总是那样</span><span ttm:role="x-roman">kimi no kotoba ga zutto</span></p><p begin="1:21.220" end="1:24.120" itunes:key="L17" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">離</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:21.220" end="1:21.640">はな</span></span></span><span begin="1:21.640" end="1:21.820">れ</span><span begin="1:21.820" end="1:22.080">な</span><span begin="1:22.080" end="1:22.571">い</span> <span tts:ruby="container"><span tts:ruby="base">離</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:22.571" end="1:23.360">はな</span></span></span><span begin="1:23.360" end="1:23.560">れ</span><span begin="1:23.560" end="1:23.830">な</span><span begin="1:23.830" end="1:24.120">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">不离不弃 伴我左右</span><span ttm:role="x-roman">hanarenai hanarenai</span></p><p begin="1:24.381" end="1:26.980" itunes:key="L18" ttm:agent="v1"><span begin="1:24.381" end="1:24.561">フ</span><span begin="1:24.561" end="1:25.161">ラッ</span><span begin="1:25.161" end="1:25.701">シュ</span><span begin="1:25.701" end="1:26.451">バッ</span><span begin="1:26.451" end="1:26.980">カー</span><span ttm:role="x-translation" xml:lang="zh-Hans">它总能在不觉间闪现于心头</span><span ttm:role="x-roman">furasshubakkā</span></p><p begin="1:27.281" end="1:31.120" itunes:key="L19" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">今</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:27.281" end="1:27.721">いま</span></span></span><span begin="1:27.721" end="1:28.921">も</span><span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:28.921" end="1:29.611">おも</span></span></span><span begin="1:29.611" end="1:29.831">い</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:29.831" end="1:30.051">だ</span></span></span><span begin="1:30.051" end="1:30.211">し</span><span begin="1:30.211" end="1:30.400">て</span><span begin="1:30.400" end="1:31.120">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">就像此刻也是一样</span><span ttm:role="x-roman">ima mo omoidashiteru</span></p><p begin="1:42.821" end="1:45.540" itunes:key="L20" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">薄</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:42.821" end="1:43.241">はく</span></span></span><span tts:ruby="container"><span tts:ruby="base">明</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:43.241" end="1:43.661">めい</span></span></span><span begin="1:43.661" end="1:43.901">に</span><span tts:ruby="container"><span tts:ruby="base">染</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:43.901" end="1:44.241">そ</span></span></span><span begin="1:44.241" end="1:44.440">ま</span><span begin="1:44.440" end="1:44.531">る</span><span tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:44.531" end="1:45.191">そら</span></span></span><span begin="1:45.191" end="1:45.540">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">薄暮染上天空</span><span ttm:role="x-roman">hakumei ni somaru sora ga</span></p><p begin="1:45.761" end="1:48.000" itunes:key="L21" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">淡</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:45.761" end="1:46.080">あわ</span></span></span><span begin="1:46.080" end="1:46.361">い</span><span tts:ruby="container"><span tts:ruby="base">彩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:46.361" end="1:46.751">いろど</span></span></span><span begin="1:46.751" end="1:47.121">り</span><span begin="1:47.121" end="1:47.341">こ</span><span begin="1:47.341" end="1:47.511">ぼ</span><span begin="1:47.511" end="1:47.711">し</span><span begin="1:47.711" end="1:48.000">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">溢出淡淡彩色</span><span ttm:role="x-roman">awai irodori koboshite</span></p><p begin="1:48.631" end="1:51.900" itunes:key="L22" ttm:agent="v1"><span begin="1:48.631" end="1:48.880">こ</span><span begin="1:48.880" end="1:49.081">ん</span><span begin="1:49.081" end="1:49.651">な</span><span begin="1:49.651" end="1:50.071">ちっ</span><span begin="1:50.071" end="1:50.271">ぽ</span><span begin="1:50.271" end="1:50.620">け</span><span begin="1:50.620" end="1:50.851">な</span><span tts:ruby="container"><span tts:ruby="base">僕</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:50.851" end="1:51.441">ぼく</span></span></span><span begin="1:51.441" end="1:51.900">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">它将无比渺小的我</span><span ttm:role="x-roman">konna chippoke na boku no</span></p><p begin="1:52.661" end="1:54.900" itunes:key="L23" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">背</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:52.661" end="1:52.971">せ</span></span></span><span tts:ruby="container"><span tts:ruby="base">中</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:52.971" end="1:53.360">なか</span></span></span><span begin="1:53.360" end="1:53.731">を</span><span tts:ruby="container"><span tts:ruby="base">包</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:53.731" end="1:54.060">つつ</span></span></span><span begin="1:54.060" end="1:54.320">ん</span><span begin="1:54.320" end="1:54.511">で</span><span begin="1:54.511" end="1:54.900">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">从背后轻轻地包裹</span><span ttm:role="x-roman">senaka o tsutsundeku</span></p><p begin="1:55.331" end="1:58.100" itunes:key="L24" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">透</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:55.331" end="1:55.721">とう</span></span></span><span tts:ruby="container"><span tts:ruby="base">明</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:55.721" end="1:56.120">めい</span></span></span><span begin="1:56.120" end="1:56.481">な</span><span begin="1:56.481" end="1:56.711">こ</span><span begin="1:56.711" end="1:56.891">の</span><span tts:ruby="container"><span tts:ruby="base">体</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:56.891" end="1:57.680">からだ</span></span></span><span begin="1:57.680" end="1:58.100">は</span><span ttm:role="x-translation" xml:lang="zh-Hans">这透明的身体</span><span ttm:role="x-roman">tōmei na kono karada wa</span></p><p begin="1:58.441" end="2:00.840" itunes:key="L25" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">何</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:58.441" end="1:58.840">なに</span></span></span><span tts:ruby="container"><span tts:ruby="base">色</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:58.840" end="1:59.241">いろ</span></span></span><span begin="1:59.241" end="1:59.411">に</span><span tts:ruby="container"><span tts:ruby="base">成</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="1:59.411" end="1:59.611">な</span></span></span><span begin="1:59.611" end="1:59.820">れ</span><span begin="1:59.820" end="1:59.991">る</span><span begin="1:59.991" end="2:00.840">の？</span><span ttm:role="x-translation" xml:lang="zh-Hans">会变成什么颜色呢？</span><span ttm:role="x-roman">naniiro ni nareru no?</span></p><p begin="2:01.151" end="2:04.380" itunes:key="L26" ttm:agent="v1"><span begin="2:01.151" end="2:01.411">た</span><span begin="2:01.411" end="2:02.030">だ</span> <span tts:ruby="container"><span tts:ruby="base">水</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:02.030" end="2:02.500">みず</span></span></span><span begin="2:02.500" end="2:02.721">の</span><span begin="2:02.721" end="2:02.900">よ</span><span begin="2:02.900" end="2:03.121">う</span><span begin="2:03.121" end="2:03.321">に</span><span tts:ruby="container"><span tts:ruby="base">流</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:03.321" end="2:03.900">なが</span></span></span><span begin="2:03.900" end="2:04.380">れ</span><span ttm:role="x-translation" xml:lang="zh-Hans">还是像水流一样流淌</span><span ttm:role="x-roman">tada mizu no yō ni nagare</span></p><p begin="2:04.881" end="2:08.080" itunes:key="L27" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:04.881" end="2:05.080">き</span></span></span><span begin="2:05.080" end="2:05.411">え</span><span begin="2:05.411" end="2:05.711">て</span><span begin="2:05.711" end="2:06.020">ゆ</span><span begin="2:06.020" end="2:06.231">く</span><span begin="2:06.231" end="2:06.431">だ</span><span begin="2:06.431" end="2:07.401">け？</span> <span begin="2:07.401" end="2:08.080">ねぇ</span><span ttm:role="x-translation" xml:lang="zh-Hans">然后消逝呢？呐</span><span ttm:role="x-roman">kiete yuku dake? nē</span></p><p begin="2:08.171" end="2:10.560" itunes:key="L28" ttm:agent="v1"><span begin="2:08.171" end="2:08.400">「ぼ</span><span begin="2:08.400" end="2:08.601">や</span><span begin="2:08.601" end="2:08.771">け</span><span begin="2:08.771" end="2:08.981">た</span><span begin="2:08.981" end="2:09.161">ま</span><span begin="2:09.161" end="2:09.361">ま</span><span begin="2:09.361" end="2:09.561">の</span><span begin="2:09.561" end="2:09.951">フォー</span><span begin="2:09.951" end="2:10.171">カ</span><span begin="2:10.171" end="2:10.351">ス</span><span begin="2:10.351" end="2:10.560">じゃ</span><span ttm:role="x-translation" xml:lang="zh-Hans">「如此模糊的焦点</span><span ttm:role="x-roman">boyaketa mama no fōkasu ja</span></p><p begin="2:10.731" end="2:15.280" itunes:key="L29" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:10.731" end="2:11.111">きみ</span></span></span><span begin="2:11.111" end="2:11.320">の</span><span begin="2:11.320" end="2:11.500">ホ</span><span begin="2:11.500" end="2:11.681">ン</span><span begin="2:11.681" end="2:11.881">モ</span><span begin="2:11.881" end="2:12.091">ノ</span><span begin="2:12.091" end="2:12.491">は</span><span tts:ruby="container"><span tts:ruby="base">写</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:12.491" end="2:13.151">うつ</span></span></span><span begin="2:13.151" end="2:13.471">せ</span><span begin="2:13.471" end="2:14.060">な</span><span begin="2:14.060" end="2:14.441">い</span><span begin="2:14.441" end="2:15.280">よ」</span><span ttm:role="x-translation" xml:lang="zh-Hans">根本拍不到你最真实的样子嘛」</span><span ttm:role="x-roman">kimi no honmono wa utsusenai yo</span></p><p begin="2:15.521" end="2:20.836" itunes:key="L30" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">寂</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:15.521" end="2:16.221">さび</span></span></span><span begin="2:16.221" end="2:16.741">し</span><span begin="2:16.741" end="2:17.141">げ</span><span begin="2:17.141" end="2:17.501">な</span><span tts:ruby="container"><span tts:ruby="base">顔</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:17.501" end="2:18.321">かお</span></span></span><span begin="2:18.321" end="2:18.881">で</span> <span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:18.881" end="2:19.421">きみ</span></span></span><span begin="2:19.421" end="2:19.750">が</span><span tts:ruby="container"><span tts:ruby="base">笑</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:19.750" end="2:20.290">わら</span></span></span><span begin="2:20.290" end="2:20.836">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">你带着落寞的表情对我笑道</span><span ttm:role="x-roman">sabishige na kao de kimi ga warau</span></p><p begin="2:21.371" end="2:25.780" itunes:key="L31" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:21.371" end="2:22.981">ひか</span></span></span><span begin="2:22.981" end="2:23.721">る</span><span tts:ruby="container"><span tts:ruby="base">朝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:23.721" end="2:24.211">あさ</span></span></span><span begin="2:24.211" end="2:24.941">が</span> <span tts:ruby="container"><span tts:ruby="base">朝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:24.941" end="2:25.371">あさ</span></span></span><span begin="2:25.371" end="2:25.780">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">闪耀着阳光的早晨</span><span ttm:role="x-roman">hikaru asa ga asa ga</span></p><p begin="2:26.100" end="2:30.040" itunes:key="L32" ttm:agent="v1"><span begin="2:26.100" end="2:26.321">あ</span><span begin="2:26.321" end="2:26.521">ま</span><span begin="2:26.521" end="2:26.680">り</span><span begin="2:26.680" end="2:26.901">に</span><span tts:ruby="container"><span tts:ruby="base">眩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:26.901" end="2:27.211">まぶ</span></span></span><span begin="2:27.211" end="2:27.500">し</span><span begin="2:27.500" end="2:28.051">い</span> <span tts:ruby="container"><span tts:ruby="base">眩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:28.051" end="2:28.381">まぶ</span></span></span><span begin="2:28.381" end="2:28.840">し</span><span begin="2:28.840" end="2:29.221">い</span><span begin="2:29.221" end="2:29.390">か</span><span begin="2:29.390" end="2:29.581">ら</span><span begin="2:29.581" end="2:30.040">さ</span><span ttm:role="x-translation" xml:lang="zh-Hans">实在是太过耀眼</span><span ttm:role="x-roman">amari ni mabushii mabushii kara sa</span></p><p begin="2:30.221" end="2:32.760" itunes:key="L33" ttm:agent="v1"><span begin="2:30.221" end="2:30.530">ちょっ</span><span begin="2:30.530" end="2:30.721">と</span><span begin="2:30.721" end="2:31.310">さ</span> <span begin="2:31.310" end="2:31.441">ら</span><span begin="2:31.441" end="2:31.851">し</span><span begin="2:31.851" end="2:32.161">く</span><span begin="2:32.161" end="2:32.380">は</span><span begin="2:32.380" end="2:32.620">な</span><span begin="2:32.620" end="2:32.760">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">即便还不是完全</span><span ttm:role="x-roman">chotto sa rashiku wa nai</span></p><p begin="2:32.900" end="2:36.280" itunes:key="L34" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">未</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:32.900" end="2:33.151">み</span></span></span><span tts:ruby="container"><span tts:ruby="base">来</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:33.151" end="2:33.911">らい</span></span></span><span begin="2:33.911" end="2:34.131">も</span><span tts:ruby="container"><span tts:ruby="base">信</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:34.131" end="2:35.011">しん</span></span></span><span begin="2:35.011" end="2:35.411">じ</span><span begin="2:35.411" end="2:35.680">ちゃ</span><span begin="2:35.680" end="2:35.860">う</span><span begin="2:35.860" end="2:36.280">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">但我也开始尝试相信未来了</span><span ttm:role="x-roman">mirai mo shinjichau yo</span></p><p begin="2:36.651" end="2:39.140" itunes:key="L35" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:36.651" end="2:37.031">きみ</span></span></span><span begin="2:37.031" end="2:37.771">の</span><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:37.771" end="2:38.181">こと</span></span></span><span tts:ruby="container"><span tts:ruby="base">葉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:38.181" end="2:38.381">ば</span></span></span><span begin="2:38.381" end="2:38.541">が</span><span begin="2:38.541" end="2:38.961">ずっ</span><span begin="2:38.961" end="2:39.140">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">你的话语总是那样</span><span ttm:role="x-roman">kimi no kotoba ga zutto</span></p><p begin="2:39.160" end="2:42.040" itunes:key="L36" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">離</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:39.160" end="2:39.560">はな</span></span></span><span begin="2:39.560" end="2:39.771">れ</span><span begin="2:39.771" end="2:40.040">な</span><span begin="2:40.040" end="2:40.501">い</span> <span tts:ruby="container"><span tts:ruby="base">離</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:40.501" end="2:41.301">はな</span></span></span><span begin="2:41.301" end="2:41.521">れ</span><span begin="2:41.521" end="2:41.750">な</span><span begin="2:41.750" end="2:42.040">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">不离不弃 伴我身旁</span><span ttm:role="x-roman">hanarenai hanarenai</span></p><p begin="2:42.301" end="2:44.960" itunes:key="L37" ttm:agent="v1"><span begin="2:42.301" end="2:42.481">フ</span><span begin="2:42.481" end="2:43.121">ラッ</span><span begin="2:43.121" end="2:43.631">シュ</span><span begin="2:43.631" end="2:44.431">バッ</span><span begin="2:44.431" end="2:44.960">カー</span><span ttm:role="x-translation" xml:lang="zh-Hans">它总能在不觉间现于心头</span><span ttm:role="x-roman">furasshubakkā</span></p><p begin="2:45.191" end="2:49.200" itunes:key="L38" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">今</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:45.191" end="2:45.611">いま</span></span></span><span begin="2:45.611" end="2:46.961">も</span> <span tts:ruby="container"><span tts:ruby="base">思</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:46.961" end="2:47.501">おも</span></span></span><span begin="2:47.501" end="2:47.751">い</span><span tts:ruby="container"><span tts:ruby="base">出</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="2:47.751" end="2:47.981">だ</span></span></span><span begin="2:47.981" end="2:48.131">し</span><span begin="2:48.131" end="2:48.320">て</span><span begin="2:48.320" end="2:49.200">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">就像此时此刻也是一样</span><span ttm:role="x-roman">ima mo omoidashiteru</span></p><p begin="3:14.331" end="3:18.700" itunes:key="L39" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:14.331" end="3:15.981">ひか</span></span></span><span begin="3:15.981" end="3:16.591">る</span><span tts:ruby="container"><span tts:ruby="base">朝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:16.591" end="3:17.221">あさ</span></span></span><span begin="3:17.221" end="3:17.891">が</span> <span tts:ruby="container"><span tts:ruby="base">朝</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:17.891" end="3:18.341">あさ</span></span></span><span begin="3:18.341" end="3:18.700">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">闪耀着阳光的早晨</span><span ttm:role="x-roman">hikaru asa ga asa ga</span></p><p begin="3:19.020" end="3:22.940" itunes:key="L40" ttm:agent="v1"><span begin="3:19.020" end="3:19.281">あ</span><span begin="3:19.281" end="3:19.491">ま</span><span begin="3:19.491" end="3:19.691">り</span><span begin="3:19.691" end="3:19.871">に</span><span tts:ruby="container"><span tts:ruby="base">眩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:19.871" end="3:20.191">まぶ</span></span></span><span begin="3:20.191" end="3:20.420">し</span><span begin="3:20.420" end="3:21.001">い</span> <span tts:ruby="container"><span tts:ruby="base">眩</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:21.001" end="3:21.321">まぶ</span></span></span><span begin="3:21.321" end="3:21.780">し</span><span begin="3:21.780" end="3:22.171">い</span><span begin="3:22.171" end="3:22.350">か</span><span begin="3:22.350" end="3:22.521">ら</span><span begin="3:22.521" end="3:22.940">さ</span><span ttm:role="x-translation" xml:lang="zh-Hans">实在是太过耀眼</span><span ttm:role="x-roman">amari ni mabushii mabushii kara sa</span></p><p begin="3:23.201" end="3:25.660" itunes:key="L41" ttm:agent="v1"><span begin="3:23.201" end="3:23.420">な</span><span begin="3:23.420" end="3:23.551">ん</span><span begin="3:23.551" end="3:23.761">か</span><span begin="3:23.761" end="3:24.020">も</span><span begin="3:24.020" end="3:24.131">う</span> <span begin="3:24.131" end="3:24.541">そ</span><span begin="3:24.541" end="3:24.841">れ</span><span begin="3:24.841" end="3:25.111">だ</span><span begin="3:25.111" end="3:25.331">け</span><span begin="3:25.331" end="3:25.660">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">但总觉仅是如此</span><span ttm:role="x-roman">nanka mō sore dake de</span></p><p begin="3:25.891" end="3:29.120" itunes:key="L42" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">心</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:25.891" end="3:26.871">こころ</span></span></span><span begin="3:26.871" end="3:27.181">が</span><span tts:ruby="container"><span tts:ruby="base">宙</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:27.181" end="3:28.031">ちゅう</span></span></span><span begin="3:28.031" end="3:28.441">に</span><span tts:ruby="container"><span tts:ruby="base">舞</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:28.441" end="3:28.680">ま</span></span></span><span begin="3:28.680" end="3:29.120">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的心也已浮于空中</span><span ttm:role="x-roman">kokoro ga chū ni mau</span></p><p begin="3:29.601" end="3:32.140" itunes:key="L43" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:29.601" end="3:30.021">きみ</span></span></span><span begin="3:30.021" end="3:30.771">の</span><span tts:ruby="container"><span tts:ruby="base">言</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:30.771" end="3:31.171">こと</span></span></span><span tts:ruby="container"><span tts:ruby="base">葉</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:31.171" end="3:31.340">ば</span></span></span><span begin="3:31.340" end="3:31.541">を</span><span begin="3:31.541" end="3:31.941">ぎゅっ</span><span begin="3:31.941" end="3:32.140">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">你的话语总是那样</span><span ttm:role="x-roman">kimi no kotoba o gyutto</span></p><p begin="3:32.140" end="3:35.080" itunes:key="L44" ttm:agent="v1"><span tts:ruby="container"><span tts:ruby="base">離</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:32.140" end="3:32.461">はな</span></span></span><span begin="3:32.461" end="3:32.741">さ</span><span begin="3:32.741" end="3:33.080">な</span><span begin="3:33.080" end="3:33.491">い</span> <span tts:ruby="container"><span tts:ruby="base">離</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="3:33.491" end="3:34.261">はな</span></span></span><span begin="3:34.261" end="3:34.500">さ</span><span begin="3:34.500" end="3:34.850">な</span><span begin="3:34.85