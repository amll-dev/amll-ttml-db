<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="GAMBIT 险棋"/><amll:meta key="musicName" value="Gambit 险棋"/><amll:meta key="musicName" value="Gambit (feat. Mishon)"/><amll:meta key="musicName" value="Gambit"/><amll:meta key="musicName" value="《绝区零》赛维里安EP"/><amll:meta key="artists" value="三Z-STUDIO"/><amll:meta key="artists" value="Sān-Z"/><amll:meta key="artists" value="HOYO-MiX"/><amll:meta key="artists" value="Mishon"/><amll:meta key="artists" value="マイショーン"/><amll:meta key="album" value="绝区零-GAMBIT 险棋"/><amll:meta key="album" value="Gambit - Single"/><amll:meta key="album" value="Gambit"/><amll:meta key="album" value="《绝区零》赛维里安EP"/><amll:meta key="ncmMusicId" value="3459318233"/><amll:meta key="qqMusicId" value="740980552"/><amll:meta key="qqMusicId" value="001YNDd93HJ1PF"/><amll:meta key="spotifyId" value="2uQnS8vuEXahhOdnfX9jVi"/><amll:meta key="appleMusicId" value="6832504485"/><amll:meta key="isrc" value="DGA052668905"/><amll:meta key="Arranger" value="周斌 Zhou Bin"/><amll:meta key="Composer" value="周斌 Zhou Bin"/><amll:meta key="Mastering Engineer" value="周斌 Zhou Bin"/><amll:meta key="Mixing Engineer" value="周斌 Zhou Bin"/><amll:meta key="Performer" value="Sān-Z"/><amll:meta key="Producer" value="周斌 Zhou Bin"/><amll:meta key="Vocals" value="HOYO-MiX"/><amll:meta key="Vocals" value="Mishon"/><amll:meta key="Vocals" value="マイショーン"/><amll:meta key="アレンジャー" value="周斌 Zhou Bin"/><amll:meta key="ソングライター" value="Mishon"/><amll:meta key="ソングライター" value="マイショーン"/><amll:meta key="パフォーマー" value="Sān-Z"/><amll:meta key="プロデューサー" value="周斌 Zhou Bin"/><amll:meta key="ボーカル" value="HOYO-MiX"/><amll:meta key="ボーカル" value="Mishon"/><amll:meta key="ボーカル" value="マイショーン"/><amll:meta key="マスタリングエンジニア" value="周斌 Zhou Bin"/><amll:meta key="ミキシングエンジニア" value="周斌 Zhou Bin"/><amll:meta key="主唱" value="HOYO-MiX"/><amll:meta key="主唱" value="Mishon"/><amll:meta key="主唱" value="マイショーン"/><amll:meta key="作曲" value="周斌 Zhou Bin"/><amll:meta key="作曲家" value="周斌 Zhou Bin"/><amll:meta key="作曲者" value="周斌 Zhou Bin"/><amll:meta key="制作人" value="周斌 Zhou Bin"/><amll:meta key="声乐" value="HOYO-MiX"/><amll:meta key="声乐" value="Mishon"/><amll:meta key="声乐" value="マイショーン"/><amll:meta key="母带工程师" value="周斌 Zhou Bin"/><amll:meta key="母帶工程師" value="周斌 Zhou Bin"/><amll:meta key="混音工程师" value="周斌 Zhou Bin"/><amll:meta key="混音工程師" value="周斌 Zhou Bin"/><amll:meta key="監製" value="周斌 Zhou Bin"/><amll:meta key="編曲" value="周斌 Zhou Bin"/><amll:meta key="编曲" value="周斌 Zhou Bin"/><amll:meta key="表演者" value="Sān-Z"/><amll:meta key="词曲作者" value="Mishon"/><amll:meta key="词曲作者" value="マイショーン"/><amll:meta key="音樂創作人" value="Mishon"/><amll:meta key="音樂創作人" value="マイショーン"/><amll:meta key="마스터링 엔지니어" value="周斌 Zhou Bin"/><amll:meta key="믹싱 엔지니어" value="周斌 Zhou Bin"/><amll:meta key="보컬" value="HOYO-MiX"/><amll:meta key="보컬" value="Mishon"/><amll:meta key="보컬" value="マイショーン"/><amll:meta key="실연자" value="Sān-Z"/><amll:meta key="작곡가" value="周斌 Zhou Bin"/><amll:meta key="작사가 겸 작곡가" value="Mishon"/><amll:meta key="작사가 겸 작곡가" value="マイショーン"/><amll:meta key="편곡자" value="周斌 Zhou Bin"/><amll:meta key="프로듀서" value="周斌 Zhou Bin"/><amll:meta key="ttmlAuthorGithub" value="68000793"/><amll:meta key="ttmlAuthorGithubLogin" value="planegenes"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="de"><text for="L1">Ich stand schon Auge in Auge</text><text for="L2">Mit größeren Risiken.</text><text for="L3">Blicke der Gefahr ins Gesicht und erzittere nie.</text><text for="L4">Ich gebe den Ton an.</text><text for="L5">Ich bestimme das Tempo.</text><text for="L6">Noch ehe sie handeln</text><text for="L7">Heißt es schon Schach und Matt.</text><text for="L8">Du kannst mich nicht durchschauen.</text><text for="L9">Ich lasse mir nichts anmerken.</text><text for="L10">Ich kann nicht auf Nummer sicher gehen</text><text for="L11">Bei nichts, was ich tue.</text><text for="L12">Stehe in den Flammen</text><text for="L13">Eis in meinen Venen, yeah.</text><text for="L14">Rein und raus</text><text for="L15">Hinterlasse nie eine Spur, yeah.</text><text for="L16">Habe das Gefühl, ich sei gestolpert.</text><text for="L17">Was fehlt noch?</text><text for="L18">Erledige noch die Arbeit</text><text for="L19">Doch es fühlt sich anders an.</text><text for="L20">Scheine einen Auslöser zu haben</text><text for="L21">Eine Last.</text><text for="L22">Es ist das Einzige, das ich kenne!</text><text for="L23">Ich schwöre, dieses Leben ist irre</text><text for="L24">Ist irre.</text><text for="L25">Ich bin verloren und du kannst mich nicht retten</text><text for="L26">Kannst mich nicht retten.</text><text for="L27">Man sagt, ich sei wahnsinnig, yeah.</text><text for="L28">Wahnsinnig, yeah.</text><text for="L29">Sie werden nie wissen, was ich durchmache.</text><text for="L30">Ich weiß, sie lieben es, mir die Schuld zu geben</text><text for="L31">Die Schuld zu geben. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Ich weiß es doch)</span></text><text for="L32">Für alles, was sie aus mir gemacht haben</text><text for="L33">Aus mir gemacht haben. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Für alles)</span></text><text for="L34">Für mich ist es weit zu spät, mich zu ändern <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Ich bin zu weit gegangen)</span></text><text for="L35">Zu ändern.</text><text for="L36">Also mache ich immer so weiter, wie ich es gewohnt bin.</text><text for="L37">Ich ziehe mich sauber an</text><text for="L38">Mache mich werktags aber an die Drecksarbeit.</text><text for="L39">Wenn es wild wird</text><text for="L40">Bleibe ich innerlich ruhig</text><text for="L41">Und lasse es mühelos aussehen.</text><text for="L42">Ich kreuze auf, in Anzug und Krawatte</text><text for="L43">Mache ihnen die Hölle heiß, ziehe dann ab</text><text for="L44">Und verschwinde einfach in der Nacht.</text><text for="L45">Du kannst mich nicht durchschauen.</text><text for="L46">Ich lasse mir nichts anmerken.</text><text for="L47">Ich kann nicht auf Nummer sicher gehen</text><text for="L48">Bei nichts, was ich tue.</text><text for="L49">Stehe in den Flammen</text><text for="L50">Eis in meinen Venen, yeah.</text><text for="L51">Rein und raus</text><text for="L52">Hinterlasse nie eine Spur, yeah.</text><text for="L53">Habe das Gefühl, ich sei gestolpert.</text><text for="L54">Was fehlt noch?</text><text for="L55">Erledige noch die Arbeit, oh.</text><text for="L56">Doch es fühlt sich anders an.</text><text for="L57">Mein Finger ist am Auslöser</text><text for="L58">Weil ich diese Last trage.</text><text for="L59">Sagte, es ist das Einzige, das ich kenne!</text><text for="L60">Ich schwöre, dieses Leben ist irre</text><text for="L61">Ist irre.</text><text for="L62">Ich bin verloren und du kannst mich nicht retten</text><text for="L63">Kannst mich nicht retten.</text><text for="L64">Man sagt, ich sei wahnsinnig, yeah.</text><text for="L65">Wahnsinnig, yeah.</text><text for="L66">Sie werden nie wissen, was ich durchmache.</text><text for="L67">Ich weiß, sie lieben es, mir die Schuld zu geben <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Ich weiß es doch)</span></text><text for="L68">Die Schuld zu geben. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Ich weiß es doch)</span></text><text for="L69">Für alles, was sie aus mir gemacht haben</text><text for="L70">Aus mir gemacht haben. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Aus mir gemacht haben.)</span></text><text for="L71">Für mich ist es weit zu spät, mich zu ändern</text><text for="L72">Zu ändern.</text><text for="L73">Also mache ich immer so weiter, wie ich es gewohnt bin.</text><text for="L74">Ich akzeptiere mein Schicksal.</text><text for="L75">Los doch und erhöhe das Risiko für mich.</text><text for="L76">Ich könnte gar nicht anders leben.</text><text for="L78">So ist es vom Schicksal gewollt</text><text for="L79">Also lasse ich den Würfel rollen und spiele meine Karten aus.</text><text for="L80">Ich schwöre, dieses Leben ist irre</text><text for="L81">Ist irre.</text><text for="L82">So irre, irre.</text><text for="L83">Ich bin verloren und du kannst mich nicht retten</text><text for="L84">Kannst mich nicht retten.</text><text for="L85">Man sagt, ich sei wahnsinnig, yeah.</text><text for="L86">Man sagt, ich sei wahnsinnig, yeah.</text><text for="L87">Wahnsinnig, yeah.</text><text for="L88">Sie werden nie wissen, was ich durchmache.</text><text for="L89">Sie werden nie wissen, was ich durchmache.</text><text for="L90">Ich weiß, sie lieben es, mir die Schuld zu geben.</text><text for="L91">Die Schuld zu geben.</text><text for="L92">Für alles, was sie aus mir gemacht haben. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Aus mir gemacht haben.)</span></text><text for="L93">Für mich ist es weit zu spät, mich zu ändern. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Zu ändern.)</span></text><text for="L94">Also mache ich immer so weiter, wie ich es gewohnt bin.</text><text for="L95">Wie ich es gewohnt bin.</text><text for="L96">Wie ich es gewohnt bin.</text><text for="L97">Wie ich es gewohnt bin.</text><text for="L98">Wie ich es gewohnt bin.</text></translation><translation type="subtitle" xml:lang="es"><text for="L1">Me he enfrentado cara a cara</text><text for="L2">A apuestas más arriesgadas.</text><text for="L3">Miro al peligro a los ojos sin temblar.</text><text for="L4">Aquí mando yo.</text><text for="L5">Yo decido el ritmo.</text><text for="L6">Antes de que muevan ficha</text><text for="L7">Ya les he hecho jaque mate.</text><text for="L8">No puedes leer mi expresión.</text><text for="L9">No doy ninguna pista.</text><text for="L10">No puedo ir a lo seguro</text><text for="L11">En nada de lo que hago.</text><text for="L12">De pie sobre las llamas</text><text for="L13">El hielo recorre mis venas, yeah.</text><text for="L14">Entrar y salir</text><text for="L15">Sin nunca dejar rastro, yeah.</text><text for="L16">Siento que he tropezado.</text><text for="L17">¿Qué falta?</text><text for="L18">Sigo ocupándome del trabajo, oh</text><text for="L19">Pero siento una extraña sensación</text><text for="L20">Una especie de impulso</text><text for="L21">Una aflicción.</text><text for="L22">¡Es lo único que conozco!</text><text for="L23">Juro que esta vida es una locura</text><text for="L24">Una locura.</text><text for="L25">Me he ido, y tú no puedes salvarme.</text><text for="L26">No puedes salvarme.</text><text for="L27">Dicen que estoy loco, yeah.</text><text for="L28">Loco, yeah.</text><text for="L29">Ellos jamás entenderían por lo que tengo que pasar.</text><text for="L30">Sé que les encanta culparme</text><text for="L31">Culparme <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Les encanta)</span></text><text for="L32">De todo lo que me hicieron</text><text for="L33">Lo que me hicieron <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(De todo)</span></text><text for="L34">He llegado demasiado lejos para cambiar <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Demasiado lejos)</span></text><text for="L35">Para cambiar.</text><text for="L36">Así que siempre actuaré como actúo.</text><text for="L37">Visto ropa impecable</text><text for="L38">Pero todos los días hago el trabajo sucio.</text><text for="L39">Cuando la situación está fuera de control</text><text for="L40">Mantengo la calma en mi interior.</text><text for="L41">Hago que parezca fácil.</text><text for="L42">Aparezco con traje y corbata.</text><text for="L43">Los hago sufrir, y después me retiro</text><text for="L44">Desaparezco entre la noche.</text><text for="L45">No puedes leer mi expresión.</text><text for="L46">No doy ninguna pista.</text><text for="L47">No puedo ir a lo seguro</text><text for="L48">En nada de lo que hago.</text><text for="L49">De pie sobre las llamas</text><text for="L50">El hielo recorre mis venas, yeah.</text><text for="L51">Entrar y salir</text><text for="L52">Sin nunca dejar rastro, yeah.</text><text for="L53">Siento que he tropezado</text><text for="L54">¿Qué falta?</text><text for="L55">Sigo ocupándome del trabajo, oh</text><text for="L56">Pero siento una extraña sensación</text><text for="L57">Una especie de impulso</text><text for="L58">Una aflicción.</text><text for="L59">¡Es lo único que conozco!</text><text for="L60">Juro que esta vida es una locura</text><text for="L61">Una locura.</text><text for="L62">Me he ido, y tú no puedes salvarme.</text><text for="L63">No puedes salvarme.</text><text for="L64">Dicen que estoy loco, yeah.</text><text for="L65">Loco, yeah.</text><text for="L66">Ellos jamás entenderían por lo que tengo que pasar.</text><text for="L67">Sé que les encanta culparme <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Les encanta)</span></text><text for="L68">Culparme <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Les encanta)</span></text><text for="L69">De todo lo que me hicieron</text><text for="L70">Lo que me hicieron. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Lo que me hicieron.)</span></text><text for="L71">He llegado demasiado lejos para cambiar</text><text for="L72">Para cambiar.</text><text for="L73">Así que siempre actuaré como actúo.</text><text for="L74">Acepto mi destino.</text><text for="L75">Vamos, sube la apuesta por mí.</text><text for="L76">No podría vivir de otra manera.</text><text for="L78">Está escrito en las estrellas.</text><text for="L79">Voy a tirar el dado y a jugar mis cartas.</text><text for="L80">Juro que esta vida es una locura</text><text for="L81">Una locura</text><text for="L82">Lo juro, es una locura</text><text for="L83">Me he ido, y tú no puedes salvarme.</text><text for="L84">No puedes salvarme.</text><text for="L85">Dicen que estoy loco, yeah.</text><text for="L86">Dicen que estoy loco, yeah.</text><text for="L87">Loco, yeah.</text><text for="L88">Ellos jamás entenderían por lo que tengo que pasar.</text><text for="L89">Ellos jamás entenderían por lo que tengo que pasar.</text><text for="L90">Sé que les encanta culparme</text><text for="L91">Culparme</text><text for="L92">De todo lo que me hicieron <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Lo que me hicieron)</span></text><text for="L93">He llegado demasiado lejos para cambiar <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Para cambiar)</span></text><text for="L94">Así que siempre actuaré como actúo.</text><text for="L95">Tal y como actúo.</text><text for="L96">Tal y como actúo.</text><text for="L97">Tal y como actúo.</text><text for="L98">Tal y como actúo.</text></translation><translation type="subtitle" xml:lang="fr"><text for="L1">J&apos;ai dû affronter</text><text for="L2">Des enjeux élevés.</text><text for="L3">Je fais face au danger sans ciller.</text><text for="L4">C&apos;est moi qui matte</text><text for="L5">Et qui impose la durée.</text><text for="L6">Avant même qu&apos;ils ne puissent bouger</text><text for="L7">Ils sont déjà échec et mat.</text><text for="L8">Mon visage reste impassible</text><text for="L9">Il est toujours illisible.</text><text for="L10">Je ne peux jouer la sécurité</text><text for="L11">Dans tout ce que je fais.</text><text for="L12">Je reste dans les flammes</text><text for="L13">La glace coulant dans mes veines, yeah.</text><text for="L14">Entrer et sortir</text><text for="L15">Sans jamais laisser de trace, yeah.</text><text for="L16">Quelque chose m&apos;échappe des mains...</text><text for="L17">Qu&apos;est-ce qui manque ?</text><text for="L18">La mission continue son chemin</text><text for="L19">Mais j&apos;ai une drôle de sensation</text><text for="L20">Une sorte d&apos;impulsion</text><text for="L21">De consternation.</text><text for="L22">C&apos;est mon seul instinct !</text><text for="L23">Je jure que cette vie est insensée</text><text for="L24">Trop insensée.</text><text for="L25">J&apos;ai été trop loin pour être sauvé.</text><text for="L26">Être sauvé.</text><text for="L27">Le monde entier me trouve fou à lier, yeah.</text><text for="L28">Fou à lier, yeah.</text><text for="L29">Qui peut comprendre le poids que je dois porter ?</text><text for="L30">Ils adorent me blâmer.</text><text for="L31">Me blâmer. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Ils adorent me blâmer.)</span></text><text for="L32">Pour tout ce qu&apos;ils m&apos;ont fait.</text><text for="L33">Ce qu&apos;ils m&apos;ont fait. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Tout ce qu&apos;ils m&apos;ont fait.)</span></text><text for="L34">J&apos;ai été trop loin pour changer <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Trop loin)</span></text><text for="L35">Pour changer.</text><text for="L36">Je continue juste d&apos;avancer.</text><text for="L37">Je suis toujours soigné</text><text for="L38">Mais je m&apos;occupe des sales besognes la journée.</text><text for="L39">Quand la situation devient incontrôlable</text><text for="L40">Je reste imperturbable</text><text for="L41">Et donne l&apos;impression que tout est faisable.</text><text for="L42">J&apos;arrive bien habillé</text><text for="L43">Et leur fait vivre l&apos;enfer avant de me retirer</text><text for="L44">En disparaissant dans l&apos;obscurité.</text><text for="L45">Mon visage reste impassible</text><text for="L46">Il est toujours illisible.</text><text for="L47">Je ne peux jouer la sécurité</text><text for="L48">Dans tout ce que je fais.</text><text for="L49">Je reste dans les flammes</text><text for="L50">La glace coulant dans mes veines, yeah.</text><text for="L51">Entrer et sortir</text><text for="L52">Sans jamais laisser de trace, yeah.</text><text for="L53">Quelque chose m&apos;échappe des mains...</text><text for="L54">Qu&apos;est-ce qui manque ?</text><text for="L55">La mission continue son chemin, oh.</text><text for="L56">Mais j&apos;ai une drôle de sensation...</text><text for="L57">Une sorte d&apos;impulsion</text><text for="L58">De consternation.</text><text for="L59">C&apos;est mon seul instinct !</text><text for="L60">Je jure que cette vie est insensée</text><text for="L61">Trop insensée.</text><text for="L62">J&apos;ai été trop loin pour être sauvé.</text><text for="L63">Être sauvé.</text><text for="L64">Le monde entier me trouve fou à lier, yeah.</text><text for="L65">Fou à lier, yeah.</text><text for="L66">Qui peut comprendre le poids que je dois porter ?</text><text for="L67">Ils adorent me blâmer. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Ils adorent me blâmer.)</span></text><text for="L68">Me blâmer. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Ils adorent me blâmer.)</span></text><text for="L69">Pour tout ce qu&apos;ils m&apos;ont fait.</text><text for="L70">Tout ce qu&apos;ils m&apos;ont fait. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Tout ce qu&apos;ils m&apos;ont fait.)</span></text><text for="L71">J&apos;ai été trop loin pour changer.</text><text for="L72">Pour changer.</text><text for="L73">Je continue juste d&apos;avancer.</text><text for="L74">J&apos;accepte mon destin</text><text for="L75">En prenant le risque de faire monter les gains.</text><text for="L76">Je ne sais vivre autrement.</text><text for="L78">Puisque les étoiles l&apos;ont déjà décidé</text><text for="L79">Je pose mes cartes et lance le dé.</text><text for="L80">Je jure que cette vie est insensée</text><text for="L81">Trop insensée.</text><text for="L82">Vraiment trop insensée.</text><text for="L83">J&apos;ai été trop loin pour être sauvé.</text><text for="L84">Être sauvé.</text><text for="L85">Le monde entier me trouve fou à lier, yeah.</text><text for="L86">Le monde entier me trouve fou à lier, yeah.</text><text for="L87">Fou à lier, yeah.</text><text for="L88">Qui peut comprendre le poids que je dois porter ?</text><text for="L89">Qui peut comprendre le poids que je dois porter ?</text><text for="L90">Ils adorent me blâmer.</text><text for="L91">Me blâmer.</text><text for="L92">Pour tout ce qu&apos;ils m&apos;ont fait. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Ce qu&apos;ils m&apos;ont fait.)</span></text><text for="L93">Je suis allé trop loin pour changer. <span xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttm:role="x-bg" xmlns="http://www.w3.org/ns/ttml">(Pour changer.)</span></text><text for="L94">Je continue juste d&apos;avancer.</text><text for="L95">D&apos;avancer.</text><text for="L96">D&apos;avancer.</text><text for="L97">D&apos;avancer.</text><text for="L98">D&apos;avancer.</text></translation><translation type="subtitle" xml:lang="id"><text for="L1">Aku menghadapi secara 