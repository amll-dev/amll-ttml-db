<tt xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><iTunesMetadata><songwriters><songwriter>TATSUNE</songwriter><songwriter>Michael Super Lassie</songwriter><songwriter>佐藤厚仁</songwriter></songwriters></iTunesMetadata><amll:meta key="musicName" value="アイシイ"/><amll:meta key="artists" value="DOLLCHESTRA"/><amll:meta key="artists" value="村野さやか"/><amll:meta key="artists" value="村野沙耶香"/><amll:meta key="artists" value="Murano Sayaka"/><amll:meta key="artists" value="徒町小鈴"/><amll:meta key="artists" value="徒町小铃"/><amll:meta key="artists" value="Kachimachi Kosuzu"/><amll:meta key="album" value="アイシイ"/><amll:meta key="ncmMusicId" value="3357192661"/><amll:meta key="qqMusicId" value="649894256"/><amll:meta key="qqMusicId" value="003HCakb1wMjkH"/><amll:meta key="spotifyId" value="45EVWNkwd9j5inCftNPfHe"/><amll:meta key="appleMusicId" value="1883618804"/><amll:meta key="isrc" value="JPI102600606"/><amll:meta key="ttmlAuthorGithub" value="86943191"/><amll:meta key="ttmlAuthorGithubLogin" value="bywhite0"/></metadata></head><body dur="02:55.907"><div begin="00:02.248" end="02:55.907"><p begin="00:02.248" end="00:06.425" ttm:agent="v1" itunes:key="L1"><span begin="00:02.248" end="00:02.816">アイ</span><span begin="00:02.816" end="00:03.758">シイ</span>　<span begin="00:04.131" end="00:04.463">○</span><span begin="00:04.463" end="00:04.627">と</span><span begin="00:04.627" end="00:04.937">×</span><span begin="00:04.937" end="00:05.153">が</span><span begin="00:05.245" end="00:05.937">並</span><span begin="00:05.937" end="00:06.028">ん</span><span begin="00:06.028" end="00:06.425">だ</span><span ttm:role="x-translation" xml:lang="zh-CN">Icy 将排满对错的</span><span ttm:role="x-roman">Aishii maru to batsu ga naranda</span></p><p begin="00:06.490" end="00:08.395" ttm:agent="v1" itunes:key="L2"><span begin="00:06.490" end="00:06.886">答案用紙</span>　<span begin="00:06.958" end="00:07.458">凍</span><span begin="00:07.458" end="00:07.739">ら</span><span begin="00:07.739" end="00:07.920">せ</span><span begin="00:07.920" end="00:08.395">て</span><span ttm:role="x-translation" xml:lang="zh-CN">答题纸（当下）冻结起来</span><span ttm:role="x-roman">Ima koorasete</span></p><p begin="00:09.044" end="00:11.393" ttm:agent="v1" itunes:key="L3"><span begin="00:09.044" end="00:09.189">い</span><span begin="00:09.189" end="00:09.375">つ</span><span begin="00:09.375" end="00:09.508">か</span>　<span begin="00:09.508" end="00:09.670">溶</span><span begin="00:09.670" end="00:09.893">か</span><span begin="00:09.893" end="00:09.999">し</span><span begin="00:09.999" end="00:10.298">て</span><span begin="00:10.298" end="00:10.409">ほ</span><span begin="00:10.409" end="00:10.863">し</span><span begin="00:10.863" end="00:11.393">い</span><span ttm:role="x-translation" xml:lang="zh-CN">希望有一天能融化</span><span ttm:role="x-roman">Itsuka tokashite hoshii</span></p><p begin="00:11.660" end="00:13.258" ttm:agent="v2" itunes:key="L4"><span begin="00:11.660" end="00:12.305">Ah</span> <span begin="00:12.305" end="00:12.521">未</span><span begin="00:12.521" end="00:12.841">来</span><span begin="00:12.841" end="00:13.258">へ…</span><span ttm:role="x-translation" xml:lang="zh-CN">Ah 向未来…</span><span ttm:role="x-roman">Ah mirai e...</span></p><p begin="00:12.947" end="00:14.171" ttm:agent="v1" itunes:key="L5"><span begin="00:12.947" end="00:13.007">「</span><span begin="00:13.007" end="00:13.147">そ</span><span begin="00:13.147" end="00:13.276">こ</span><span begin="00:13.276" end="00:13.370">で</span><span begin="00:13.370" end="00:13.464">生</span><span begin="00:13.464" end="00:13.577">き</span><span begin="00:13.577" end="00:13.721">る</span><span begin="00:13.721" end="00:13.854">貴</span><span begin="00:13.854" end="00:13.936">方</span><span begin="00:13.936" end="00:14.117">へ</span><span begin="00:14.117" end="00:14.171">」</span><span ttm:role="x-translation" xml:lang="zh-CN">「向在未来生活的你」</span><span ttm:role="x-roman">"Soko de ikiru anata e"</span></p><p begin="00:14.237" end="00:15.624" ttm:agent="v2" itunes:key="L6"><span begin="00:14.237" end="00:14.907">問</span><span begin="00:14.907" end="00:15.577">う</span><span begin="00:15.577" end="00:15.624">。</span><span ttm:role="x-translation" xml:lang="zh-CN">发问。</span><span ttm:role="x-roman">tou.</span></p><p begin="00:24.956" end="00:27.260" ttm:agent="v1" itunes:key="L7"><span begin="00:24.956" end="00:25.397">違</span><span begin="00:25.397" end="00:25.535">う</span><span begin="00:25.535" end="00:25.596">、</span><span begin="00:25.596" end="00:25.875">と</span><span begin="00:26.220" end="00:26.563">何</span><span begin="00:26.563" end="00:26.720">度</span><span begin="00:26.720" end="00:26.916">だ</span><span begin="00:26.916" end="00:27.034">っ</span><span begin="00:27.034" end="00:27.260">て</span><span ttm:role="x-translation" xml:lang="zh-CN">不对 千百次说</span><span ttm:role="x-roman">Chigau, to nando datte</span></p><p begin="00:27.344" end="00:29.999" ttm:agent="v1" itunes:key="L8"><span begin="00:27.344" end="00:27.484">書</span><span begin="00:27.484" end="00:27.673">き</span><span begin="00:27.673" end="00:28.015">直</span><span begin="00:28.015" end="00:28.142">し</span><span begin="00:28.142" end="00:28.388">た</span><span begin="00:28.626" end="00:28.939">夢</span><span begin="00:28.939" end="00:29.062">の</span><span begin="00:29.062" end="00:29.180">予</span><span begin="00:29.180" end="00:29.588">想</span><span begin="00:29.588" end="00:29.745">図</span><span begin="00:29.745" end="00:29.999">を</span><span ttm:role="x-translation" xml:lang="zh-CN">梦想的蓝图 千百次重绘</span><span ttm:role="x-roman">Kakinaoshita yume no yosouzu o</span></p><p begin="00:30.347" end="00:34.578" ttm:agent="v1" itunes:key="L9"><span begin="00:30.347" end="00:30.981">丸</span><span begin="00:30.981" end="00:31.136">め</span><span begin="00:31.136" end="00:31.437">て</span><span begin="00:31.437" end="00:31.611">捨</span><span begin="00:31.611" end="00:32.351">て</span><span begin="00:32.351" end="00:32.452">よ</span><span begin="00:32.452" end="00:32.553">う</span><span begin="00:32.553" end="00:32.807">と</span><span begin="00:33.036" end="00:33.415">思</span><span begin="00:33.415" end="00:33.527">っ</span><span begin="00:33.527" end="00:33.681">た</span><span begin="00:33.681" end="00:34.132">朝</span><span begin="00:34.132" end="00:34.578">も</span><span ttm:role="x-translation" xml:lang="zh-CN">在那个想把一切揉成一团丢掉的清晨</span><span ttm:role="x-roman">Marumete suteyou to omotta asa mo</span></p><p begin="00:35.076" end="00:37.346" ttm:agent="v2" itunes:key="L10"><span begin="00:35.076" end="00:35.214">理</span><span begin="00:35.214" end="00:35.676">想</span><span begin="00:35.676" end="00:36.119">が</span><span begin="00:36.324" end="00:36.665">灰</span><span begin="00:36.665" end="00:36.801">に</span><span begin="00:36.801" end="00:37.024">な</span><span begin="00:37.024" end="00:37.133">っ</span><span begin="00:37.133" end="00:37.346">て</span><span ttm:role="x-translation" xml:lang="zh-CN">理想 化成灰烬</span><span ttm:role="x-roman">Risou ga hai ni natte</span></p><p begin="00:37.446" end="00:40.230" ttm:agent="v2" itunes:key="L11"><span begin="00:37.446" end="00:37.624">目</span><span begin="00:37.624" end="00:37.783">の</span><span begin="00:37.783" end="00:38.238">前</span><span begin="00:38.238" end="00:38.551">に</span><span begin="00:38.688" end="00:38.877">敷</span><span begin="00:38.877" end="00:39.042">か</span><span begin="00:39.042" end="00:39.203">れ</span><span begin="00:39.203" end="00:39.349">た</span><span begin="00:39.349" end="00:39.513">レ</span><span begin="00:39.513" end="00:39.678">ー</span><span begin="00:39.678" end="00:39.842">ル</span><span begin="00:39.842" end="00:40.230">を</span><span ttm:role="x-translation" xml:lang="zh-CN">铺好的轨道 被灰烬掩埋</span><span ttm:role="x-roman">Me no mae ni shikareta reeru o</span></p><p begin="00:40.451" end="00:44.729" ttm:agent="v2" itunes:key="L12"><span begin="00:40.451" end="00:40.610">も</span><span begin="00:40.610" end="00:40.768">う</span><span begin="00:40.768" end="00:41.245">一</span><span begin="00:41.245" end="00:41.482">度</span>　<span begin="00:41.482" end="00:42.511">進</span><span begin="00:42.511" end="00:42.594">も</span><span begin="00:42.594" end="00:42.670">う</span><span begin="00:42.670" end="00:42.911">と</span><span begin="00:43.147" end="00:43.521">迷</span><span begin="00:43.521" end="00:43.627">っ</span><span begin="00:43.627" end="00:43.774">た</span><span begin="00:43.774" end="00:44.245">夜</span><span begin="00:44.245" end="00:44.729">も</span><span ttm:role="x-translation" xml:lang="zh-CN">在那个纠结是否还能继续向前的夜晚</span><span ttm:role="x-roman">Mou ichido susumou to mayotta yoru mo</span></p><p begin="00:45.172" end="00:49.907" ttm:agent="v1" itunes:key="L13"><span begin="00:45.172" end="00:45.522">絶</span><span begin="00:45.522" end="00:45.827">え</span><span begin="00:45.827" end="00:46.168">ず</span><span begin="00:46.419" end="00:47.084">注</span><span begin="00:47.084" end="00:47.461">ぐ</span>　<span begin="00:47.714" end="00:48.343">色</span><span begin="00:48.343" end="00:48.833">が</span><span begin="00:48.833" end="00:49.600">凍</span><span begin="00:49.600" end="00:49.907">る</span><span ttm:role="x-translation" xml:lang="zh-CN">倾泻而下 颜色（声音）逐渐冻结</span><span ttm:role="x-roman">Taezu sosogu koe ga kooru</span></p><p begin="00:50.212" end="00:53.918" ttm:agent="v2" itunes:key="L14"><span begin="00:50.212" end="00:50.388">ま</span><span begin="00:50.388" end="00:50.553">た</span><span begin="00:50.553" end="00:50.869">胸</span><span begin="00:50.869" end="00:51.168">を</span><span begin="00:51.168" end="00:51.821">貫</span><span begin="00:51.821" end="00:53.449">く</span><span begin="00:53.449" end="00:53.918">…</span><span ttm:role="x-translation" xml:lang="zh-CN">再次贯穿胸口…</span><span ttm:role="x-roman">Mata mune o tsuranuku...</span></p><p begin="00:54.682" end="00:55.685" ttm:agent="v1" itunes:key="L15"><span begin="00:54.682" end="00:55.685">Ah</span></p><p begin="00:55.766" end="00:58.148" ttm:agent="v1" itunes:key="L16"><span begin="00:55.773" end="00:55.923">分</span><span begin="00:55.923" end="00:56.133">か</span><span begin="00:56.133" end="00:56.251">っ</span><span begin="00:56.251" end="00:56.416">て</span><span begin="00:56.416" end="00:56.671">る</span>　<span begin="00:56.735" end="00:56.881">自</span><span begin="00:56.881" end="00:57.137">分</span><span begin="00:57.137" end="00:57.358">次</span><span begin="00:57.358" end="00:57.670">第</span><span begin="00:57.670" end="00:57.832">だ</span><span begin="00:57.832" end="00:57.990">か</span><span begin="00:57.990" end="00:58.148">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">我其实明白 一切取决于自己</span><span ttm:role="x-roman">Wakatteru jibun shidai dakara</span></p><p begin="00:58.303" end="01:00.651" ttm:agent="v1" itunes:key="L17"><span begin="00:58.303" end="00:58.623">数</span><span begin="00:58.623" end="00:58.776">え</span><span begin="00:58.776" end="00:58.936">て</span><span begin="00:58.936" end="00:59.256">く</span><span begin="00:59.256" end="00:59.412">理</span><span begin="00:59.412" end="00:59.715">由</span>　<span begin="00:59.715" end="00:59.892">そ</span><span begin="00:59.892" end="00:59.999">の</span><span begin="00:59.999" end="01:00.508">行方</span><span begin="01:00.508" end="01:00.651">が</span><span ttm:role="x-translation" xml:lang="zh-CN">细数着理由 还有前方的道路</span><span ttm:role="x-roman">Kazoeteku riyuu sono yukue ga</span></p><p begin="01:00.816" end="01:03.103" ttm:agent="v1" itunes:key="L18"><span begin="01:00.816" end="01:00.963">分</span><span begin="01:00.963" end="01:01.307">か</span><span begin="01:01.307" end="01:01.457">ら</span><span begin="01:01.457" end="01:01.609">な</span><span begin="01:01.609" end="01:01.777">い</span><span begin="01:01.777" end="01:01.903">ま</span><span begin="01:01.903" end="01:03.103">ま</span><span ttm:role="x-translation" xml:lang="zh-CN">但一无所知</span><span ttm:role="x-roman">Wakaranai mama</span></p><p begin="01:02.106" end="01:03.616" ttm:agent="v2" itunes:key="L19"><span begin="01:02.106" end="01:02.240">止</span><span begin="01:02.240" end="01:02.554">ま</span><span begin="01:02.554" end="01:02.686">れ</span><span begin="01:02.686" end="01:02.856">な</span><span begin="01:02.856" end="01:03.024">い</span><span begin="01:03.024" end="01:03.186">ま</span><span begin="01:03.186" end="01:03.616">ま</span><span ttm:role="x-translation" xml:lang="zh-CN">也无法停下</span><span ttm:role="x-roman">tomarenai mama</span></p><p begin="01:03.347" end="01:05.743" ttm:agent="v1" itunes:key="L20"><span begin="01:03.347" end="01:03.497">こ</span><span begin="01:03.497" end="01:03.847">こ</span><span begin="01:03.847" end="01:03.988">ま</span><span begin="01:03.988" end="01:04.272">で</span><span begin="01:04.272" end="01:04.424">来</span><span begin="01:04.424" end="01:05.122">た</span><span begin="01:05.122" end="01:05.243">…</span>　<span begin="01:05.243" end="01:05.390">け</span><span begin="01:05.390" end="01:05.743">ど</span><span ttm:role="x-translation" xml:lang="zh-CN">就走到了这里… 可是</span><span ttm:role="x-roman">Koko made kita... kedo</span></p><p begin="01:05.843" end="01:08.233" ttm:agent="v1" itunes:key="L21"><span begin="01:05.843" end="01:06.213">探</span><span begin="01:06.213" end="01:06.355">し</span><span begin="01:06.355" end="01:06.482">て</span><span begin="01:06.482" end="01:06.777">る</span>　<span begin="01:06.777" end="01:07.129">淡</span><span begin="01:07.129" end="01:07.301">い</span><span begin="01:07.301" end="01:07.618">夢</span><span begin="01:07.618" end="01:07.740">の</span><span begin="01:07.740" end="01:07.929">在</span><span begin="01:07.929" end="01:08.096">り</span><span begin="01:08.096" end="01:08.233">処</span><span ttm:role="x-translation" xml:lang="zh-CN">我还在寻找 浅淡梦想的归处</span><span ttm:role="x-roman">Sagashiteru awai yume no ari ka</span></p><p begin="01:08.376" end="01:10.796" ttm:agent="v1" itunes:key="L22"><span begin="01:08.376" end="01:08.782">奪</span><span begin="01:08.782" end="01:08.885">っ</span><span begin="01:08.885" end="01:09.040">て</span><span begin="01:09.040" end="01:09.366">よ</span>　<span begin="01:09.366" end="01:09.657">願</span><span begin="01:09.657" end="01:09.794">い</span><span begin="01:09.794" end="01:09.994">秘</span><span begin="01:09.994" end="01:10.119">め</span><span begin="01:10.119" end="01:10.265">た</span><span begin="01:10.265" end="01:10.600">空</span><span begin="01:10.600" end="01:10.796">が</span><span ttm:role="x-translation" xml:lang="zh-CN">夺走一切吧 承载梦想的天空</span><span ttm:role="x-roman">Ubatte yo negai himeta sora ga</span></p><p begin="01:10.914" end="01:13.152" ttm:agent="v1" itunes:key="L23"><span begin="01:10.914" end="01:11.411">濁</span><span begin="01:11.411" end="01:11.564">る</span><span begin="01:11.564" end="01:12.033">前</span><span begin="01:12.033" end="01:13.152">に</span><span ttm:role="x-translation" xml:lang="zh-CN">变浑浊之前</span><span ttm:role="x-roman">Nigoru mae ni</span></p><p begin="01:12.175" end="01:13.643" ttm:agent="v2" itunes:key="L24"><span begin="01:12.175" end="01:12.327">こ</span><span begin="01:12.327" end="01:12.620">の</span><span begin="01:12.620" end="01:13.108">刹</span><span begin="01:13.108" end="01:13.289">那</span><span begin="01:13.289" end="01:13.643">を</span><span ttm:role="x-translation" xml:lang="zh-CN">将这一瞬间</span><span ttm:role="x-roman">kono setsuna o</span></p><p begin="01:13.453" end="01:15.759" ttm:agent="v1" itunes:key="L25"><span begin="01:13.453" end="01:13.589">閉</span><span begin="01:13.589" end="01:13.924">じ</span><span begin="01:13.924" end="01:14.069">込</span><span begin="01:14.069" end="01:14.349">め</span><span begin="01:14.349" end="01:14.580">れ</span><span begin="01:14.580" end="01:15.343">ば</span><span begin="01:15.343" end="01:15.759">永遠</span><span ttm:role="x-translation" xml:lang="zh-CN">封存为刹那的永远</span><span ttm:role="x-roman">Tojikomereba towa</span></p><p begin="01:15.964" end="01:18.738" ttm:agent="v1" itunes:key="L26"><span begin="01:15.964" end="01:16.138">不</span><span begin="01:16.138" end="01:16.607">安</span><span begin="01:16.607" end="01:17.090">定</span><span begin="01:17.090" end="01:17.748">な</span><span begin="01:17.998" end="01:18.186">世</span><span begin="01:18.186" end="01:18.502">界</span><span begin="01:18.502" end="01:18.738">で</span><span ttm:role="x-translation" xml:lang="zh-CN">在这不稳定的世界</span><span ttm:role="x-roman">Fuantei na sekai de</span></p><p begin="01:28.111" end="01:30.421" ttm:agent="v2" itunes:key="L27"><span begin="01:28.111" end="01:28.304">無</span><span begin="01:28.304" end="01:28.778">謀</span><span begin="01:28.778" end="01:29.208">な</span><span begin="01:29.399" end="01:29.555">ル</span><span begin="01:29.555" end="01:29.728">ー</span><span begin="01:29.728" end="01:29.880">ト</span><span begin="01:29.880" end="01:30.055">だ</span><span begin="01:30.055" end="01:30.120">、</span><span begin="01:30.120" end="01:30.187">っ</span><span begin="01:30.187" end="01:30.421">て</span><span ttm:role="x-translation" xml:lang="zh-CN">「这是条无谋的道路」</span><span ttm:role="x-roman">Mubou na ruuto da, tte</span></p><p begin="01:30.486" end="01:33.280" ttm:agent="v2" itunes:key="L28"><span begin="01:30.486" end="01:30.641">聞</span><span begin="01:30.641" end="01:30.823">か</span><span begin="01:30.823" end="01:31.128">な</span><span begin="01:31.128" end="01:31.265">い</span><span begin="01:31.265" end="01:31.606">で</span>　<span begin="01:31.770" end="01:31.927">ま</span><span begin="01:31.927" end="01:32.071">た</span><span begin="01:32.071" end="01:32.393">傷</span><span begin="01:32.393" end="01:32.551">付</span><span begin="01:32.551" end="01:32.716">い</span><span begin="01:32.716" end="01:32.875">て</span><span begin="01:32.875" end="01:33.280">る</span><span ttm:role="x-translation" xml:lang="zh-CN">快捂上耳朵 又会因此受伤</span><span ttm:role="x-roman">Kikanai de mata kizutsuiteru</span></p><p begin="01:33.514" end="01:37.936" ttm:agent="v2" itunes:key="L29"><span begin="01:33.514" end="01:34.142">誰</span><span begin="01:34.142" end="01:34.312">か</span><span begin="01:34.312" end="01:34.542">の</span><span begin="01:34.542" end="01:34.777">言</span><span begin="01:34.777" end="01:35.553">う</span><span begin="01:35.553" end="01:35.732">通</span><span begin="01:35.732" end="01:35.967">り</span>　<span begin="01:36.189" end="01:36.481">思</span><span begin="01:36.481" end="01:36.656">え</span><span begin="01:36.656" end="01:36.815">な</span><span begin="01:36.815" end="01:37.062">か</span><span begin="01:37.062" end="01:37.141">っ</span><span begin="01:37.141" end="01:37.281">た</span><span begin="01:37.281" end="01:37.823">の</span><span begin="01:37.823" end="01:37.936">？</span><span ttm:role="x-translation" xml:lang="zh-CN">难道不能像别人说的那样去想吗？</span><span ttm:role="x-roman">Dareka no iu toori omoenakatta no?</span></p><p begin="01:38.211" end="01:43.096" ttm:agent="v1" itunes:key="L30"><span begin="01:38.211" end="01:38.454">そ</span><span begin="01:38.454" end="01:38.677">う</span>　<span begin="01:38.677" end="01:39.050">認</span><span begin="01:39.050" end="01:39.208">め</span><span begin="01:39.208" end="01:39.334">る</span><span begin="01:39.334" end="01:39.838">方</span><span begin="01:39.838" end="01:40.068">が</span><span begin="01:40.068" end="01:40.447">本</span><span begin="01:40.447" end="01:40.589">当</span><span begin="01:40.589" end="01:40.772">は</span><span begin="01:40.772" end="01:41.077">楽</span><span begin="01:41.077" end="01:41.343">だ</span><span begin="01:41.343" end="01:41.398">っ</span><span begin="01:41.398" end="01:42.572">た</span><span begin="01:42.572" end="01:42.667">ん</span><span begin="01:42.667" end="01:43.096">だ</span><span ttm:role="x-translation" xml:lang="zh-CN">是啊 承认下来会更轻松吧</span><span ttm:role="x-roman">Sou mitomeru hou ga hontou wa raku dattan da</span></p><p begin="01:43.288" end="01:48.016" ttm:agent="v2" itunes:key="L31"><span begin="01:43.288" end="01:43.614">絶</span><span begin="01:43.614" end="01:43.918">え</span><span begin="01:43.918" end="01:44.297">ず</span><span begin="01:44.541" end="01:45.184">注</span><span begin="01:45.184" end="01:45.623">ぐ</span>　<span begin="01:45.800" end="01:46.438">色</span><span begin="01:46.438" end="01:46.911">が</span><span begin="01:46.911" end="01:47.700">凍</span><span begin="01:47.700" end="01:48.016">る</span><span ttm:role="x-translation" xml:lang="zh-CN">倾泻而下 颜色（声音）逐渐冻结</span><span ttm:role="x-roman">Taezu sosogu koe ga kooru</span></p><p begin="01:48.330" end="01:51.753" ttm:agent="v1" itunes:key="L32"><span begin="01:48.330" end="01:48.530">そ</span><span begin="01:48.530" end="01:48.687">れ</span><span begin="01:48.687" end="01:48.898">が</span><span begin="01:48.898" end="01:49.306">嫌</span><span begin="01:49.306" end="01:49.453">に</span><span begin="01:49.453" end="01:49.696">な</span><span begin="01:49.696" end="01:49.783">っ</span><span begin="01:49.783" end="01:49.921">て</span><span begin="01:49.921" end="01:51.451">も</span><span begin="01:51.451" end="01:51.753">…</span><span ttm:role="x-translation" xml:lang="zh-CN">即便已经厌倦…</span><span ttm:role="x-roman">Sore ga iya ni natte mo...</span></p><p begin="01:52.150" end="01:52.605" ttm:agent="v2" itunes:key="L33"><span begin="01:52.150" end="01:52.605">Pray</span></p><p begin="01:52.605" end="01:55.034" ttm:agent="v1" itunes:key="L34"><span begin="01:52.605" end="01:52.773">分</span><span begin="01:52.773" end="01:52.998">か</span><span begin="01:52.998" end="01:53.096">っ</span><span begin="01:53.096" end="01:53.255">て</span><span begin="01:53.255" end="01:53.508">る</span>　<span begin="01:53.570" end="01:53.726">期</span><span begin="01:53.726" end="01:54.023">待</span>　<span begin="01:54.023" end="01:54.357">応</span><span begin="01:54.357" end="01:54.520">え</span><span begin="01:54.520" end="01:54.667">な</span><span begin="01:54.667" end="01:54.846">が</span><span begin="01:54.846" end="01:55.034">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">我其实明白 回应着那份期待</span><span ttm:role="x-roman">Wakatteru kitai kotae nagara</span></p><p begin="01:55.143" end="01:57.513" ttm:agent="v1" itunes:key="L35"><span begin="01:55.143" end="01:55.285">手</span><span begin="01:55.285" end="01:55.733">放</span><span begin="01:55.733" end="01:55.898">そ</span><span begin="01:55.898" end="01:56.049">う</span>　<span begin="01:56.094" end="01:56.248">希</span><span begin="01:56.248" end="01:56.547">望</span><span begin="01:56.547" end="01:56.724">寄</span><span begin="01:56.724" end="01:56.870">り</span><span begin="01:56.870" end="01:57.028">の</span><span begin="01:57.028" end="01:57.186">エ</span><span begin="01:57.186" end="01:57.312">ゴ</span><span begin="01:57.312" end="01:57.513">は</span><span ttm:role="x-translation" xml:lang="zh-CN">放手一搏吧 倾向希望的自我</span><span ttm:role="x-roman">Tebanasou kibou yori no ego wa</span></p><p begin="01:57.656" end="01:59.979" ttm:agent="v2" itunes:key="L36"><span begin="01:57.656" end="01:58.127">次</span><span begin="01:58.127" end="01:58.309">は</span><span begin="01:58.309" end="01:58.762">何</span><span begin="01:58.762" end="01:59.979">を</span><span ttm:role="x-translation" xml:lang="zh-CN">但再下一次</span><span ttm:role="x-roman">Tsugi wa nani o</span></p><p begin="01:58.887" end="02:00.956" ttm:agent="v1" itunes:key="L37"><span begin="01:58.887" end="01:59.057">捨</span><span begin="01:59.057" end="01:59.416">て</span><span begin="01:59.416" end="01:59.581">る</span><span begin="01:59.581" end="01:59.852">べ</span><span begin="01:59.852" end="01:59.999">き</span><span begin="01:59.999" end="02:00.956">か</span><span ttm:role="x-translation" xml:lang="zh-CN">该舍弃什么</span><span ttm:role="x-roman">suteru beki ka</span></p><p begin="02:00.145" end="02:04.160" ttm:agent="v1" itunes:key="L38"><span begin="02:00.145" end="02:00.343">捨</span><span begin="02:00.343" end="02:00.675">て</span><span begin="02:00.675" end="02:00.813">る</span><span begin="02:00.813" end="02:01.113">意</span><span begin="02:01.113" end="02:01.294">味</span><span begin="02:01.294" end="02:01.968">は</span><span begin="02:02.081" end="02:02.259">あ</span><span begin="02:02.259" end="02:02.409">る</span><span begin="02:02.409" end="02:02.535">で</span><span begin="02:02.535" end="02:02.697">しょ</span><span begin="02:02.697" end="02:02.868">う</span><span begin="02:02.868" end="02:04.062">か</span><span begin="02:04.062" end="02:04.160">？</span><span ttm:role="x-translation" xml:lang="zh-CN">含弃的意义真的存在吗？</span><span ttm:role="x-roman">Suteru imi wa aru deshou ka?</span></p><p begin="02:03.373" end="02:08.239" ttm:agent="v2" itunes:key="L39"><span begin="02:03.373" end="02:03.442">「</span><span begin="02:03.442" end="02:03.570">こ</span><span begin="02:03.570" end="02:03.690">れ</span><span begin="02:03.690" end="02:03.786">ま</span><span begin="02:03.786" end="02:03.883">で</span><span begin="02:03.883" end="02:04.152">何</span><span begin="02:04.152" end="02:04.273">を</span><span begin="02:04.273" end="02:04.354">捨</span><span begin="02:04.354" end="02:04.451">て</span><span begin="02:04.451" end="02:04.610">て</span><span begin="02:04.610" end="02:04.718">、</span><span begin="02:05.000" end="02:05.199">何</span><span begin="02:05.199" end="02:05.298">を</span><span begin="02:05.298" end="02:05.435">手</span><span begin="02:05.435" end="02:05.526">に</span><span begin="02:05.526" end="02:05.625">し</span><span begin="02:05.625" end="02:05.777">て</span><span begin="02:05.777" end="02:05.876">…</span>　<span begin="02:06.154" end="02:06.496">私</span><span begin="02:06.496" end="02:06.595">は</span><span begin="02:06.595" end="02:06.750">一</span><span begin="02:06.750" end="02:06.954">体</span><span begin="02:06.954" end="02:07.084">、</span><span begin="02:07.191" end="02:07.377">何</span><span begin="02:07.377" end="02:07.485">が</span><span begin="02:07.485" end="02:07.556">し</span><span begin="02:07.556" end="02:07.646">た</span><span begin="02:07.646" end="02:07.746">か</span><span begin="02:07.746" end="02:07.813">っ</span><span begin="02:07.813" end="02:07.898">た</span><span begin="02:07.898" end="02:08.120">の</span><span begin="02:08.120" end="02:08.239">？」</span><span ttm:role="x-translation" xml:lang="zh-CN">「迄今为止放弃了什么，又得到了什么… 我到底，想要做什么？」</span><span ttm:role="x-roman">"Kore made nani o sutete, nani o te ni shite... watashi wa ittai, nani ga shitakatta no?"</span></p><p begin="02:08.425" end="02:12.820" ttm:agent="v1" itunes:key="L40"><span begin="02:08.425" end="02:08.501">「</span><span begin="02:08.501" end="02:08.715">答</span><span begin="02:08.715" end="02:08.822">え</span><span begin="02:08.822" end="02:08.926">な</span><span begin="02:08.926" end="02:09.003">ん</span><span begin="02:09.003" end="02:09.153">か</span><span begin="02:09.153" end="02:09.219">知</span><span begin="02:09.219" end="02:09.344">り</span><span begin="02:09.344" end="02:09.461">た</span><span begin="02:09.461" end="02:09.539">く</span><span begin="02:09.539" end="02:09.666">な</span><span begin="02:09.666" end="02:09.732">い</span><span begin="02:09.732" end="02:09.826">。</span><span begin="02:10.099" end="02:10.399">全</span><span begin="02:10.399" end="02:10.488">て</span><span begin="02:10.488" end="02:10.686">を</span><span begin="02:10.686" end="02:10.788">凍</span><span begin="02:10.788" end="02:10.944">ら</span><span begin="02:10.944" end="02:11.032">せ</span><span begin="02:11.032" end="02:11.123">て</span><span begin="02:11.123" end="02:11.206">、</span><span begin="02:11.581" end="02:11.744">い</span><span begin="02:11.744" end="02:11.793">っ</span><span begin="02:11.793" end="02:11.959">そ</span><span begin="02:11.959" end="02:12.182">永遠</span><span begin="02:12.182" end="02:12.322">の</span><span begin="02:12.322" end="02:12.574">中</span><span begin="02:12.574" end="02:12.698">に</span><span begin="02:12.698" end="02:12.820">…」</span><span ttm:role="x-translation" xml:lang="zh-CN">「我不想知道什么答案。干脆把一切都冻结吧，都沉入永恒之中…」</span><span ttm:role="x-roman">"Kotae nanka shiritakunai. Subete o koorasete, isso towa no naka ni..."</span></p><p begin="02:13.211" end="02:17.792" ttm:agent="v1" itunes:key="L41"><span begin="02:13.211" end="02:13.281">「</span><span begin="02:13.281" end="02:13.465">だ</span><span begin="02:13.465" end="02:13.540">け</span><span begin="02:13.540" end="02:13.737">ど</span><span begin="02:13.737" end="02:13.815">…</span><span begin="02:14.147" end="02:14.349">今</span><span begin="02:14.349" end="02:14.422">、</span><span begin="02:14.422" end="02:14.661">時</span><span begin="02:14.661" end="02:14.804">が</span><span begin="02:14.804" end="02:14.926">止</span><span begin="02:14.926" end="02:15.008">ま</span><span begin="02:15.008" end="02:15.099">れ</span><span begin="02:15.099" end="02:15.277">ば</span><span begin="02:15.277" end="02:15.376">、</span><span begin="02:15.609" end="02:15.697">こ</span><span begin="02:15.697" end="02:15.795">ん</span><span begin="02:15.795" end="02:15.889">な</span><span begin="02:15.889" end="02:15.985">に</span><span begin="02:15.985" end="02:16.098">も</span><span begin="02:16.098" end="02:16.349">悲</span><span begin="02:16.349" end="02:16.438">し</span><span begin="02:16.438" end="02:16.534">い</span><span begin="02:16.534" end="02:16.732">瞬</span><span begin="02:16.732" end="02:16.881">間</span><span begin="02:16.881" end="02:17.069">が</span><span begin="02:17.069" end="02:17.224">残</span><span begin="02:17.224" end="02:17.269">っ</span><span begin="02:17.269" end="02:17.360">て</span><span begin="02:17.360" end="02:17.446">し</span><span begin="02:17.446" end="02:17.584">ま</span><span begin="02:17.584" end="02:17.711">う</span><span begin="02:17.711" end="02:17.792">」</span><span ttm:role="x-translation" xml:lang="zh-CN">「但是…如果此刻停滞不前，如此悲伤的瞬间也会永远留存」</span><span ttm:role="x-roman">"Dakedo...ima, toki ga tomareba, konna ni mo kanashii shunkan ga nokotte shimau"</span></p><p begin="02:18.025" end="02:21.621" ttm:agent="v2" itunes:key="L42"><span begin="02:18.025" end="02:18.173">「</span><span begin="02:18.173" end="02:18.304">上</span><span begin="02:18.304" end="02:18.435">手</span><span begin="02:18.435" end="02:18.547">く</span><span begin="02:18.547" end="02:18.759">笑</span><span begin="02:18.759" end="02:18.861">え</span><span begin="02:18.861" end="02:18.948">な</span><span begin="02:18.948" end="02:19.041">く</span><span begin="02:19.041" end="02:19.133">て</span><span begin="02:19.133" end="02:19.322">も</span><span begin="02:19.322" end="02:19.413">、</span><span begin="02:19.642" end="02:19.854">苦</span><span begin="02:19.854" end="02:19.929">し</span><span begin="02:19.929" end="02:20.009">く</span><span begin="02:20.009" end="02:20.098">て</span><span begin="02:20.098" end="02:20.256">も</span><span begin="02:20.256" end="02:20.346">、</span><span begin="02:20.479" end="02:20.768">傷</span><span begin="02:20.768" end="02:20.861">付</span><span begin="02:20.861" end="02:20.939">き</span><span begin="02:20.939" end="02:21.046">な</span><span begin="02:21.046" end="02:21.146">が</span><span begin="02:21.146" end="02:21.236">ら</span><span begin="02:21.236" end="02:21.349">で</span><span begin="02:21.349" end="02:21.541">も</span><span begin="02:21.541" end="02:21.621">」</span><span ttm:role="x-translation" xml:lang="zh-CN">「就算无法欢笑、就算痛苦万分、就算遍体鳞伤」</span><span ttm:role="x-roman">"Umaku waraenakute mo, kurushikute mo, kizutsuki nagara demo"</span></p><p begin="02:21.753" end="02:22.741" ttm:agent="v1" itunes:key="L43"><span begin="02:21.753" end="02:21.817">「</span><span begin="02:21.817" end="02:22.040">今</span><span begin="02:22.040" end="02:22.168">を</span><span begin="02:22.168" end="02:22.317">生</span><span begin="02:22.317" end="02:22.415">き</span><span begin="02:22.415" end="02:22.536">よ</span><span begin="02:22.536" end="02:22.659">う</span><span begin="02:22.659" end="02:22.741">」</span><span ttm:role="x-translation" xml:lang="zh-CN">「也要活在当下」</span><span ttm:role="x-roman">"Ima o ikiyou"</span></p><p begin="02:22.930" end="02:25.395" ttm:agent="v1" itunes:key="L44"><span begin="02:22.930" end="02:23.079">分</span><span begin="02:23.079" end="02:23.300">か</span><span begin="02:23.300" end="02:23.406">っ</span><span begin="02:23.406" end="02:23.578">て</span><span begin="02:23.578" end="02:23.784">る</span>　<span begin="02:23.873" end="02:24.052">自</span><span begin="02:24.052" end="02:24.312">分</span><span begin="02:24.312" end="02:24.529">次</span><span begin="02:24.529" end="02:24.841">第</span><span begin="02:24.841" end="02:24.987">だ</span><span begin="02:24.987" end="02:25.144">か</span><span begin="02:25.144" end="02:25.395">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">我其实明白 一切取决于自己</span><span ttm:role="x-roman">Wakatteru jibun shidai dakara</span></p><p begin="02:25.440" end="02:27.871" ttm:agent="v2" itunes:key="L45"><span begin="02:25.440" end="02:25.707">数</span><span begin="02:25.707" end="02:25.929">え</span><span begin="02:25.929" end="02:26.077">て</span><span begin="02:26.077" end="02:26.408">く</span><span begin="02:26.408" end="02:26.549">理</span><span begin="02:26.549" end="02:26.797">由</span>　<span begin="02:26.851" end="02:27.046">そ</span><span begin="02:27.046" end="02:27.184">の</span><span begin="02:27.184" end="02:27.678">行方</span><span begin="02:27.678" end="02:27.871">が</span><span ttm:role="x-translation" xml:lang="zh-CN">细数着理由 还有前方的道路</span><span ttm:role="x-roman">Kazoeteku riyuu sono yukue ga</span></p><p begin="02:27.995" end="02:29.868" ttm:agent="v1" itunes:key="L46"><span begin="02:27.995" end="02:28.136">分</span><span begin="02:28.136" end="02:28.475">か</span><span begin="02:28.475" end="02:28.631">ら</span><span begin="02:28.631" end="02:28.749">な</span><span begin="02:28.749" end="02:28.866">い</span><span begin="02:28.951" end="02:29.101">ま</span><span begin="02:29.101" end="02:29.868">ま</span><span ttm:role="x-translation" xml:lang="zh-CN">但一无所知</span><span ttm:role="x-roman">Wakaranai mama</span></p><p begin="02:29.264" end="02:30.968" ttm:agent="v2" itunes:key="L47"><span begin="02:29.264" end="02:29.405">止</span><span begin="02:29.405" end="02:29.736">ま</span><span begin="02:29.736" end="02:29.892">れ</span><span begin="02:29.892" end="02:30.027">な</span><span begin="02:30.027" end="02:30.147">い</span><span begin="02:30.147" end="02:30.306">ま</span><span begin="02:30.306" end="02:30.968">ま</span><span ttm:role="x-translation" xml:lang="zh-CN">也无法停下</span><span ttm:role="x-roman">tomarenai mama</span></p><p begin="02:30.497" end="02:32.111" ttm:agent="v1" itunes:key="L48"><span begin="02:30.497" end="02:30.658">こ</span><span begin="02:30.658" end="02:30.984">こ</span><span begin="02:30.984" end="02:31.146">ま</span><span begin="02:31.146" end="02:31.442">で</span><span begin="02:31.442" end="02:31.604">来</span><span begin="02:31.604" end="02:32.024">た</span><span begin="02:32.024" end="02:32.111">。</span><span ttm:role="x-translation" xml:lang="zh-CN">我走到了这里。</span><span ttm:role="x-roman">Koko made kita.</span></p><p begin="02:33.023" end="02:35.435" ttm:agent="v1" itunes:key="L49"><span begin="02:33.023" end="02:33.435">探</span><span begin="02:33.435" end="02:33.516">し</span><span begin="02:33.516" end="02:33.686">て</span><span begin="02:33.686" end="02:33.903">る</span>　<span begin="02:33.962" end="02:34.256">淡</span><span begin="02:34.256" end="02:34.390">い</span><span begin="02:34.438" end="02:34.783">夢</span><span begin="02:34.783" end="02:34.930">の</span><span begin="02:34.930" end="02:35.086">在</span><span begin="02:35.086" end="02:35.225">り</span><span begin="02:35.225" end="02:35.435">処</span><span ttm:role="x-translation" xml:lang="zh-CN">我还在寻找 浅淡梦想的归处</span><span ttm:role="x-roman">Sagashiteru awai yume no ari ka</span></p><p begin="02:35.536" end="02:37.957" ttm:agent="v1" itunes:key="L50"><span begin="02:35.536" end="02:35.958">奪</span><span begin="02:35.958" end="02:36.038">っ</span><span begin="02:36.038" end="02:36.184">て</span><span begin="02:36.184" end="02:36.438">よ</span>　<span begin="02:36.519" end="02:36.801">願</span><span begin="02:36.801" end="02:36.937">い</span><span begin="02:36.986" end="02:37.145">秘</span><span begin="02:37.145" end="02:37.305">め</span><span begin="02:37.305" end="02:37.441">た</span><span begin="02:37.441" end="02:37.774">空</span><span begin="02:37.774" end="02:37.957">が</span><span ttm:role="x-translation" xml:lang="zh-CN">夺走一切吧 承载梦想的天空</span><span ttm:role="x-roman">Ubatte yo negai himeta sora ga</span></p><p begin="02:38.097" end="02:40.085" ttm:agent="v1" itunes:key="L51"><span begin="02:38.097" end="02:38.574">濁</span><span begin="02:38.574" end="02:38.712">る</span><span begin="02:38.712" end="02:39.211">前</span><span begin="02:39.211" end="02:40.085">に</span><span ttm:role="x-translation" xml:lang="zh-CN">变浑浊之前</span><span ttm:role="x-roman">Nigoru mae ni</span></p><p begin="02:39.354" end="02:41.014" ttm:agent="v2" itunes:key="L52"><span begin="02:39.354" end="02:39.486">こ</span><span begin="02:39.486" end="02:39.813">の</span><span begin="02:39.813" end="02:40.293">刹</span><span begin="02:40.293" end="02:40.413">那</span><span begin="02:40.413" end="02:41.014">を</span><span ttm:role="x-translation" xml:lang="zh-CN">将这一瞬间</span><span ttm:role="x-roman">kono setsuna o</span></p><p begin="02:40.599" end="02:42.873" ttm:agent="v1" itunes:key="L53"><span begin="02:40.599" end="02:40.750">閉</span><span begin="02:40.750" end="02:41.081">じ</span><span begin="02:41.081" end="02:41.195">込</span><span begin="02:41.195" end="02:41.541">め</span><span begin="02:41.541" end="02:41.719">れ</span><span begin="02:41.719" end="02:42.366">ば</span><span begin="02:42.511" end="02:42.873">永遠</span><span ttm:role="x-translation" xml:lang="zh-CN">封存为刹那的永远</span><span ttm:role="x-roman">Tojikomereba towa</span></p><p begin="02:43.154" end="02:45.238" ttm:agent="v1" itunes:key="L54"><span begin="02:43.154" end="02:43.293">で</span><span begin="02:43.293" end="02:43.674">も</span><span begin="02:43.674" end="02:43.742">、</span><span begin="02:43.742" end="02:43.926">良</span><span begin="02:43.926" end="02:44.223">い</span><span begin="02:44.223" end="02:45.238">の</span><span ttm:role="x-translation" xml:lang="zh-CN">但是没关系的</span><span ttm:role="x-roman">Demo, ii no</span></p><p begin="02:45.674" end="02:51.102" ttm:agent="v1" itunes:key="L55"><span begin="02:45.674" end="02:45.813">こ</span><span begin="02:45.813" end="02:46.282">の</span><span begin="02:46.282" end="02:46.754">瞬</span><span begin="02:46.754" end="02:47.923">間</span>　<span begin="02:48.196" end="02:48.327">生</span><span begin="02:48.327" end="02:48.829">き</span><span begin="02:48.829" end="02:49.123">た</span><span begin="02:49.123" end="02:49.323">い</span><span begin="02:49.323" end="02:49.962">の</span><span begin="02:49.962" end="02:50.088">…</span>　<span begin="02:50.088" end="02:50.211">止</span><span begin="02:50.211" end="02:50.367">め</span><span begin="02:50.367" end="02:50.548">な</span><span begin="02:50.548" end="02:50.703">い</span><span begin="02:50.703" end="02:51.102">で</span><span ttm:role="x-translation" xml:lang="zh-CN">在这一瞬间 我想活下去… 不要阻止我</span><span ttm:role="x-roman">Kono shunkan ikitai no... tomenai de</span></p><p begin="02:53.092" end="02:55.907" ttm:agent="v1" itunes:key="L56"><span begin="02:53.092" end="02:53.372">アイ</span><span begin="02:53.372" end="02:55.907">シイ</span><span ttm:role="x-translation" xml:lang="zh-CN">Icy</span><span ttm:role="x-roman">Aishii</span></p></div></body></tt>